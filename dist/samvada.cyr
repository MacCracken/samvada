fn dbus_session_map_error(p, n) {
    if (_dbs_has_prefix(p, n, "System.Error.") != 0) {
        var en = _dbs_errno_named(p + 13, n - 13);
        if (en > 0) { return 0 - en; }
        return -5;
    }
    if (_dbs_name_is(p, n, "org.freedesktop.DBus.Error.Failed") != 0) { return -13; }
    if (_dbs_name_is(p, n, "org.freedesktop.DBus.Error.NoMemory") != 0) { return -12; }
    if (_dbs_name_is(p, n, "org.freedesktop.DBus.Error.ServiceUnknown") != 0) { return -113; }
    if (_dbs_name_is(p, n, "org.freedesktop.DBus.Error.NameHasNoOwner") != 0) { return -6; }
    if (_dbs_name_is(p, n, "org.freedesktop.DBus.Error.NoReply") != 0) { return -110; }
    if (_dbs_name_is(p, n, "org.freedesktop.DBus.Error.BadAddress") != 0) { return -99; }
    if (_dbs_name_is(p, n, "org.freedesktop.DBus.Error.NotSupported") != 0) { return -95; }
    if (_dbs_name_is(p, n, "org.freedesktop.DBus.Error.LimitsExceeded") != 0) { return -105; }
    if (_dbs_name_is(p, n, "org.freedesktop.DBus.Error.AccessDenied") != 0) { return -13; }
    if (_dbs_name_is(p, n, "org.freedesktop.DBus.Error.AuthFailed") != 0) { return -13; }
    if (_dbs_name_is(p, n, "org.freedesktop.DBus.Error.NoServer") != 0) { return -112; }
    if (_dbs_name_is(p, n, "org.freedesktop.DBus.Error.Timeout") != 0) { return -110; }
    if (_dbs_name_is(p, n, "org.freedesktop.DBus.Error.NoNetwork") != 0) { return -64; }
    if (_dbs_name_is(p, n, "org.freedesktop.DBus.Error.AddressInUse") != 0) { return -98; }
    if (_dbs_name_is(p, n, "org.freedesktop.DBus.Error.Disconnected") != 0) { return -104; }
    if (_dbs_name_is(p, n, "org.freedesktop.DBus.Error.InvalidArgs") != 0) { return -22; }
    if (_dbs_name_is(p, n, "org.freedesktop.DBus.Error.FileNotFound") != 0) { return -2; }
    if (_dbs_name_is(p, n, "org.freedesktop.DBus.Error.FileExists") != 0) { return -17; }
    if (_dbs_name_is(p, n, "org.freedesktop.DBus.Error.UnknownMethod") != 0) { return -53; }
    if (_dbs_name_is(p, n, "org.freedesktop.DBus.Error.UnknownObject") != 0) { return -53; }
    if (_dbs_name_is(p, n, "org.freedesktop.DBus.Error.UnknownInterface") != 0) { return -53; }
    if (_dbs_name_is(p, n, "org.freedesktop.DBus.Error.UnknownProperty") != 0) { return -53; }
    if (_dbs_name_is(p, n, "org.freedesktop.DBus.Error.PropertyReadOnly") != 0) { return -30; }
    if (_dbs_name_is(p, n, "org.freedesktop.DBus.Error.UnixProcessIdUnknown") != 0) { return -3; }
    if (_dbs_name_is(p, n, "org.freedesktop.DBus.Error.InvalidSignature") != 0) { return -22; }
    if (_dbs_name_is(p, n, "org.freedesktop.DBus.Error.InconsistentMessage") != 0) { return -74; }
    if (_dbs_name_is(p, n, "org.freedesktop.DBus.Error.TimedOut") != 0) { return -110; }
    if (_dbs_name_is(p, n, "org.freedesktop.DBus.Error.MatchRuleNotFound") != 0) { return -2; }
    if (_dbs_name_is(p, n, "org.freedesktop.DBus.Error.MatchRuleInvalid") != 0) { return -22; }
    if (_dbs_name_is(p, n, "org.freedesktop.DBus.Error.InteractiveAuthorizationRequired") != 0) { return -13; }
    if (_dbs_name_is(p, n, "org.freedesktop.DBus.Error.InvalidFileContent") != 0) { return -22; }
    if (_dbs_name_is(p, n, "org.freedesktop.DBus.Error.SELinuxSecurityContextUnknown") != 0) { return -3; }
    if (_dbs_name_is(p, n, "org.freedesktop.DBus.Error.ObjectPathInUse") != 0) { return -16; }
    if (_dbs_name_is(p, n, "org.freedesktop.login1.BlockedByInhibitorLock") != 0) { return -13; }
    if (_dbs_name_is(p, n, "org.freedesktop.login1.DeviceIsTaken") != 0) { return -22; }
    if (_dbs_name_is(p, n, "org.freedesktop.login1.DeviceNotTaken") != 0) { return -22; }
    if (_dbs_name_is(p, n, "org.freedesktop.login1.NoSessionForPID") != 0) { return -6; }
    if (_dbs_name_is(p, n, "org.freedesktop.login1.NoSuchSeat") != 0) { return -6; }
    if (_dbs_name_is(p, n, "org.freedesktop.login1.NoSuchSession") != 0) { return -6; }
    if (_dbs_name_is(p, n, "org.freedesktop.login1.NoSuchUser") != 0) { return -6; }
    if (_dbs_name_is(p, n, "org.freedesktop.login1.NoUserForPID") != 0) { return -6; }
    if (_dbs_name_is(p, n, "org.freedesktop.login1.NotInControl") != 0) { return -22; }
    if (_dbs_name_is(p, n, "org.freedesktop.login1.NotYourDevice") != 0) { return -1; }
    if (_dbs_name_is(p, n, "org.freedesktop.login1.OperationInProgress") != 0) { return -115; }
    if (_dbs_name_is(p, n, "org.freedesktop.login1.SessionBusy") != 0) { return -16; }
    if (_dbs_name_is(p, n, "org.freedesktop.login1.SessionNotOnSeat") != 0) { return -22; }
    if (_dbs_name_is(p, n, "org.freedesktop.login1.SleepVerbNotSupported") != 0) { return -95; }
    return -5;                                   # -EIO for anything unmapped
}

# ---- the clock ----
# clock_gettime has no stdlib name, so it is spelled the way the
# stdlib's own lib/chrono.cyr spells it: the x86_64 number, 228, as a
# literal at the call site, on EVERY arch. On ELF-aarch64 the compiler
# folds it to the native 113 through its x86-compat row 228→113 — the
# row chrono's monotonic clock and lib/bench.cyr's timer stand on, so
# cyrius cannot break it without breaking its own clock.
#
# Until 1.1.0 this was a native 113 under `#ifdef CYRIUS_ARCH_AARCH64`.
# That was correct and fragile: the compat chain matches a NUMBER, and
# 113 is also x86's setreuid, free as a row source only because no row
# has claimed it yet (cyrius 6.7.12 DW-1). struct timespec is 16 bytes,
# tv_sec at +0 and tv_nsec at +8, on both arches — verified on the
# host, not copied from a header.

# CLOCK_MONOTONIC, deliberately: a deadline must not be extendable
# (or fired early) by an NTP step or a suspend/resume adjusting the
# wall clock.
fn dbus_session_clock_monotonic() { return 1; }

var _dbs_ts = 0;

# Test hook (1.1.2): the clock answers `n` more times, then fails with
# -EFAULT, so the deadline paths' clock-failure branches are reachable
# from a test. 0 = off; reset by dbus_session_reset().
var _dbs_clock_fail = 0;
fn dbus_session_fail_clock_after(n) {
    if (n < 0) { _dbs_clock_fail = 0; return 0; }
    _dbs_clock_fail = n + 1;
    return 0;
}

# Monotonic milliseconds, or a negative errno if the clock fails.
fn dbus_session_now_ms() {
    if (_dbs_clock_fail == 1) { return -14; }
    if (_dbs_clock_fail > 1) { _dbs_clock_fail = _dbs_clock_fail - 1; }
    if (_dbs_ts == 0) { _dbs_ts = alloc(16); }
    if (_dbs_ts == 0) { return -12; }
    store64(_dbs_ts + 0, 0);
    store64(_dbs_ts + 8, 0);
    var rc = syscall(228, dbus_session_clock_monotonic(), _dbs_ts);
    if (rc < 0) { return rc; }
    var sec  = load64(_dbs_ts + 0);
    var nsec = load64(_dbs_ts + 8);
    return sec * 1000 + nsec / 1000000;
}

# Matches DBUS_DEFAULT_TIMEOUT / sd-bus's BUS_DEFAULT_TIMEOUT, so
# samvada gives up on the same schedule as every other bus client.
var _dbs_timeout_ms = 25000;

fn dbus_session_timeout_ms() { return _dbs_timeout_ms; }

# @internal, and it exists for a specific reason: without it the
# deadline branch below could only be reached by a test willing to
# wait 25 seconds, and an untestable guard is how AUDIT-4 shipped.
# dbus_session_reset() restores the default so no test can leak a
# short timeout into another.
#
# CORRECTION (A-6): an earlier version of this comment claimed it was
# "not reachable from the public API". That is false and was worth
# fixing rather than leaving. dist/samvada.cyr exports 198 functions
# against a documented public surface of eight — `@internal` is a
# comment with no mechanical meaning — so a consumer CAN call this
# and set every subsequent call's budget to 0. It is in the same
# position as dbus_frame_close_fds and the whole dbus_unmarshal_*
# surface, which is the premise AUDIT-1 already rests on. The real
# contract is now stated in public-api.md instead of denied here.
# (Since 1.1.1 the bundle is private-by-default — src/visibility.cyr —
# so a Cyrius consumer can no longer name this, or any other internal fn
# of the bundle; C code linked against an `object;` build still can.)
#
# One day, well past any bus's patience and far below the point where
# `t0 + timeout` could overflow i64. The cap is not cosmetic: the
# deadline is armed as `deadline = t0 + timeout` and gated on
# `deadline > 0`, so a large enough value wraps the sum NEGATIVE and
# SILENTLY DISARMS the guard — it switches itself off instead of
# firing. A bound that can be turned off by its own argument is not a
# bound.
fn dbus_session_timeout_max_ms() { return 86400000; }

fn dbus_session_set_timeout_ms(ms) {
    if (ms < 0) { return -22; }
    if (ms > dbus_session_timeout_max_ms()) { return -22; }
    _dbs_timeout_ms = ms;
    return 0;
}

# -EAGAIN and -EWOULDBLOCK are the same value on Linux (11), which
# is what SO_RCVTIMEO reports when the receive budget expires.
fn dbus_session_eagain() { return -11; }

# ONE cached scratch block, instead of an alloc() per call and per
# message.
#
# alloc() is a bump allocator that NEVER frees, and pump_signals runs
# at 60 Hz inside a compositor for days. Measured before this change,
# on the IDLE path where nothing is even read:
#
#   pump x100000 heap delta = 800000 bytes
#   per idle pump           = 8 bytes
#   per DAY at 60 Hz        = 41472000 bytes     (~41 MB)
#
# Unbounded, and invisible to every test because a test process exits
# long before it matters.
#
# Offsets are fixed and documented so two users cannot alias. Each is
# a scratch OUT-parameter whose value dies within a few statements;
# none is live across another's use.
#   +0,+8  dest_ok       — find_field out, str_at out
#   +16    take_device   — find_field sig out, UNIX_FDS
#   +24    reply loop    — find_field sig out
#   +32    reply loop    — ERROR name ptr
#   +40    take_device   — body signature ptr
#   +48    (free since 1.1.2: the receive no longer has an fd out-slot)
#   +56    a reply body's string — Hello's unique name, GetSessionByPID's path
var _dbs_scr = 0;
fn _dbs_scratch() {
    if (_dbs_scr == 0) { _dbs_scr = alloc(64); }
    return _dbs_scr;
}

# Is this reply addressed to US?
#
# This mirrors sd-bus's async guard (sd-bus.c:2790,
# `m->destination && bus->unique_name && !streq(...)` -> drop) and
# is deliberately the ONLY provenance check samvada makes, because
# it is the only one that is both correct and stateless. See the
# note on SENDER above for the two checks that look attractive and
# are not.
#
# Permissive when the field is ABSENT, exactly as sd-bus is. That is
# not laxity, it is required: the Hello reply is matched BEFORE the
# bus has told us our own name, so there is nothing to compare
# against yet — _dbs_uniqn is still 0 and this returns 1.
fn dbus_session_dest_ok(p) {
    if (_dbs_uniqn <= 0) { return 1; }        # name not learned yet
    var sc = _dbs_scratch();
    var off = dbus_unmarshal_find_field(p, dbus_marshal_f_dest(), sc);
    if (off == dbus_unmarshal_notfound()) { return 1; }
    if (off < 0) { return 0; }                # malformed field array
    var n = dbus_unmarshal_str_at(p, off, sc + 8);
    if (n < 0) { return 0; }
    return _dbs_bytes_eq(load64(sc + 8), n, _dbs_uniq, _dbs_uniqn);
}

# ---- session-path validation ----
# EVERY native fn that accepts a session path must call this, and the
# reason is a lesson learned twice in one release.
#
# These fns ship in dist/samvada.cyr — 198 exported functions against
# a documented public surface of seven, when this was written — so a
# consumer we do not control reached them directly (private-by-default
# since 1.1.1, but C linked against an `object;` build still can). strlen(sess) on a null pointer is a
# segfault, not an error code. The PUBLIC path survives only because
# samvada_init happens to allocate _samvada_sess as a zeroed buffer,
# so it is never null there: luck, not design, which is the exact
# shape AUDIT-1 was filed under.
#
# It was first applied to take_device and release_device only. The
# A-6 lane then found dbus_native_take_control(0, 0) still exiting
# 139, because take_control and release_control take a session path
# too. Measured: exit=139 before, -22 after. Hence ONE predicate that
# all four call, rather than four copies of a guard that can be
# half-applied again.
#
# 1.1.2: and it must be a valid object path. It goes on the wire as the
# PATH field, and an empty, relative or trailing-slash path was sent as
# given — a message sd-bus refuses to build (-EINVAL) and a broker may
# treat as a protocol violation (P(-1) re-verification).
fn dbus_session_sess_ok(sess) {
    if (sess == 0) { return 0; }
    return dbus_unmarshal_path_ok(sess, strlen(sess));
}

# ---- device-number validation ----
# The C shim gates both TakeDevice and ReleaseDevice on
# devnum_ok(v) == (v >= 0 && v <= UINT32_MAX) BEFORE the 64->32
# narrowing, added at 0.5.1 as audit MED-2 because the cast
# truncated silently. CLAUDE.md says in as many words that a
# PURE_CYRIUS backend must RE-SUPPLY that check.
#
# It did not. The native backend checked only `v < 0`, so a major of
# 2^32 + 1 was marshalled by _dbm_u32 — which writes the low four
# bytes and nothing else — as major 1. samvada would have opened a
# DIFFERENT DEVICE than the consumer asked for, silently, and
# returned success. The differential harness never caught it because
# it compares error codes for in-range values only.
fn dbus_session_devnum_ok(v) {
    if (v < 0)          { return 0; }
    if (v > 4294967295) { return 0; }         # UINT32_MAX
    return 1;
}

# ---- descriptors belong to the message they arrived with ----
# Twice now a descriptor has reached take_device from the wrong message.
# 1.0.1: a ResumeDevice SIGNAL's descriptor sat at the head of the one
# fd queue until the next take_device collected it — measured, signal
# fd inode 3201875, reply fd 3201877, take_fd() 3201875. The fix counted
# each consumed message's descriptors from its own UNIX_FDS field and
# closed that many. 1.1.2: that count is only as good as the parse, and
# a message samvada cannot walk — any big-endian one, or one with an
# unknown field type ahead of UNIX_FDS — counted as carrying NONE, so a
# bus peer could plant a descriptor of its choosing ahead of the
# TakeDevice reply's and have it returned as the device (P(-1) audit,
# H1). Now the framer owns attribution (dbus_frame_fdq_cap): every read
# stops at the end of the head message, and advancing past a message
# closes every descriptor it did not hand out. Nothing about the
# message's own contents is consulted.

# Consume the reply dbus_session_call left at the frame base; every
# descriptor it carried is closed with it (dbus_frame_advance).
fn dbus_session_done() {
    var r = dbus_frame_next();
    if (r <= 0) { return 0; }
    dbus_frame_advance(r);
    return 0;
}

# ONE receive, bounded to the message at the head of the buffer, and the
# descriptors that came with it queued as that message's. Shared by the
# call path and pump_signals so the two cannot attribute differently.
#
#   returns > 0  bytes received
#           0    the peer closed (EOF is now recorded in the framer)
#           < 0  the receive's errno, untouched
fn _dbs_recv(fd, flags) {
    var want = dbus_frame_prepare(dbus_frame_want());
    # Nothing can be read without crossing a message boundary — an
    # impossible state once dbus_frame_next has said need_more. Treat it
    # as a cut stream rather than read past the boundary.
    if (want <= 0) { dbus_frame_set_eof(); return 0; }
    var got = dbus_sys_recv(fd, dbus_frame_tail(), want, flags);
    if (got < 0) { return got; }
    if (got == 0) { dbus_frame_set_eof(); return 0; }
    dbus_frame_commit(got);
    var n = dbus_sys_rx_count();
    var i = 0;
    while (i < n) {
        # Never on a stdio number (1.1.2): in a consumer that closed
        # stdout, a device on 1 would take every later print — and on an
        # evdev node a write is injected input. A move that fails loses
        # the descriptor, so the message's count no longer matches and a
        # TakeDevice reply is refused.
        var rfd = dbus_sys_rx_fd(i);
        if (rfd <= 2) { rfd = dbus_socket_above_stdio(rfd); }
        dbus_frame_push_fd(rfd);
        i = i + 1;
    }
    if (dbus_sys_rx_truncated() != 0) { dbus_frame_fds_incomplete(); }
    return got;
}

# Reads a call may make when the clock has failed and there is no
# deadline: the bound of last resort. With a working clock (always, on
# Linux) the deadline is the only bound.
fn dbus_session_read_backstop() { return 65536; }

# ---- a write the deadline bounds (1.1.2) ----
# Write all `len` bytes, or give up at `deadline` (monotonic ms; 0 = no
# clock: SO_SNDTIMEO, armed at connect, is the bound). With a deadline
# every send is MSG_DONTWAIT, and a full send buffer is a poll for
# writability for the time left.
#
# Until 1.1.2 the send was outside every bound: dbus_socket_write_all
# blocked, retried EINTR without limit, and no SO_SNDTIMEO was set, so a
# broker that stopped reading blocked the call for ever once the send
# buffer filled — "the call ends at its deadline" held only for the
# receive (P(-1) re-verification).
#
#   returns len, -110 at the deadline, or a send errno. A request cut off
#   part-way leaves half a message in the stream, which can never be
#   resynchronised: the connection is then latched closed.
fn _dbs_write(fd, buf, len, deadline) {
    if (buf == 0) { return -22; }
    if (len < 0)  { return -22; }
    var sent = 0;
    var now = 0;
    while (sent < len) {
        var flags = dbus_socket_msg_nosignal();
        if (deadline > 0) { flags = flags | dbus_sys_msg_dontwait(); }
        var n = sys_sendto(fd, buf + sent, len - sent, flags, 0, 0);
        if (n == -4) { continue; }                # EINTR
        var full = 0;
        if (n == dbus_session_eagain()) { full = 1; }
        if (full == 1) {
            var out = 0;
            if (deadline <= 0) { out = 1; }       # SO_SNDTIMEO expired
            if (out == 0) {
                now = dbus_session_now_ms();
                if (now < 0) { out = 1; }
                if (out == 0) {
                    if (now >= deadline) { out = 1; }
                }
                if (out == 0) {
                    var ready = fd_wait_ready(fd, 1, deadline - now);
                    if (ready == 0) { out = 1; }
                    if (ready < 0) {
                        if (ready != -4) { return _dbs_cut(sent, ready); }
                    }
                }
            }
            if (out == 1) { return _dbs_cut(sent, -110); }
            continue;
        }
        if (n < 0) { return _dbs_cut(sent, n); }
        if (n == 0) { return _dbs_cut(sent, -32); }   # -EPIPE: no progress possible
        sent = sent + n;
    }
    return sent;
}

# A send that stops part-way left half a message in the stream, which no
# later write can resynchronise: latch the connection closed, whatever
# stopped it (1.1.2 final pass: only the timeout latched).
fn _dbs_cut(sent, err) {
    if (sent > 0) { _dbs_closed = 1; }
    return err;
}

# ---- the call/reply cycle ----
# Send whatever the marshaller has built, then read until the reply
# whose REPLY_SERIAL matches. Unsolicited traffic is DISCARDED, not
# treated as an error: the bus emits NameAcquired on the connect
# path before any match rule exists, and a reader that treats the
# first message as its answer gets the signal instead.
#
# Returns 0 on a METHOD_RETURN (whose message is left addressable
# via dbus_frame_base()), or a negative errno on an ERROR reply or
# transport failure.
fn dbus_session_call(fd, serial) {
    # Refuse to transmit a message the marshaller could not build.
    # Without this, an over-long or negative length poisons the buffer
    # and dbus_marshal_len() still reports a total — which would put
    # adjacent heap on the wire.
    if (dbus_marshal_bad() != 0) { return -22; }
    if (_dbs_closed != 0) { return -107; }        # -ENOTCONN: see _dbs_closed

    # Nor is a request written onto a stream that can no longer be framed
    # (1.1.2). A bad endian byte, a bad version or a header declaring
    # >= 128 MiB is never consumed, so every later read stops at it; until
    # 1.1.2 each later call still SENT its request — a TakeControl, say,
    # that logind then acted on — and only afterwards reported the fault.
    # The fault's errno is unchanged, and it is not a disconnect: sd-bus
    # does not close the bus for -EBADMSG either.
    var lost = dbus_frame_next();
    if (lost < 0) {
        if (lost != dbus_frame_need_more()) {
            var lf = _dbs_frame_fault(lost);
            if (lf < 0) { return lf; }
        }
    }

    # SEND-TIME WATERMARK, captured before the request goes out. Bytes
    # already received cannot be a reply to a request that has not been
    # sent yet — no peer can answer before it receives. sd-bus gets this
    # by remembering the receive queue's length at send time
    # (sd-bus.c:2448). This closes the pre-plant window sequential serials
    # would otherwise leave open: bytes an attacker gets into the buffer
    # early cannot answer a later call.
    #
    # A STREAM POSITION since 1.1.2: a message whose first byte arrived
    # before `wm` predates the request, including one that straddles it.
    # Until then it was a count of pending bytes, decremented by each
    # message consumed — and not by the bytes an over-cap drain discarded,
    # so after a drain the count never reached 0 and the genuine reply
    # was refused as stale (P(-1) audit, M3).
    var wm = dbus_frame_received();

    # WALL-CLOCK DEADLINE for the whole call, and since 1.1.2 the ONLY
    # bound on it. SO_RCVTIMEO bounds a single receive, not the call: a
    # peer that dribbles one byte per read satisfies every individual
    # timeout while the call runs unbounded. So every wait is a poll for
    # the time that is LEFT, and the call ends at the deadline — not at
    # deadline + one more SO_RCVTIMEO, as it could before.
    #
    # Until 1.1.2 the loop was also capped at 64 reads. That counted
    # MESSAGES, and a bus peer can send messages: 64 one-descriptor
    # signals (or 512 KiB of junk) ahead of the reply failed the call
    # with -ETIMEDOUT at once (P(-1) audit, M2).
    #
    # A clock that fails at t0 leaves the call without a deadline rather
    # than failing it; the read backstop and SO_RCVTIMEO are what is
    # left. One that fails mid-call ends it (-ETIMEDOUT): see the wait.
    var deadline = 0;
    var t0 = dbus_session_now_ms();
    if (t0 >= 0) { deadline = t0 + dbus_session_timeout_ms(); }

    var total = dbus_marshal_len();
    var w = _dbs_write(fd, dbus_marshal_buf(), total, deadline);
    # The deadline's own -ETIMEDOUT is not a disconnect (see
    # dbus_session_is_disconnect); a send errno is classified.
    if (w == -110) { return -110; }
    if (w < 0) { return _dbs_io_fail(w); }

    var reads = 0;
    var now = 0;
    while (1 == 1) {
        var r = dbus_frame_next();
        while (r > 0) {
            var p = dbus_frame_base();
            # dbus_frame_next() returned the message's exact on-wire
            # length; handing it to the unmarshaller is what makes its
            # bounds checks real (pre-1.0 audit, AUDIT-1..3).
            dbus_unmarshal_set_limit(r);
            var ty = dbus_unmarshal_type(p);
            var sig = _dbs_scratch() + 24;
            # The whole field array is validated before anything is read
            # from it (1.1.2), so acceptance cannot depend on field order.
            # An invalid message is nobody's reply: it is dropped, as
            # sd-bus drops it, and the call waits on.
            var rs_off = (0 - 1);
            if (dbus_unmarshal_validate(p) == 0) {
                rs_off = dbus_unmarshal_find_field(p, dbus_marshal_f_replyser(), sig);
            }
            var mine = 0;
            if (rs_off > 0) {
                if (dbus_unmarshal_u32(p, rs_off) == serial) { mine = 1; }
            }
            # Predates the request: it started arriving before we wrote,
            # so whatever it is answering, it is not this.
            if (mine == 1) {
                if (dbus_frame_pos() < wm) { mine = 0; }
            }
            # Addressed to someone else, whatever its REPLY_SERIAL says.
            if (mine == 1) {
                var dok = dbus_session_dest_ok(p);
                if (dok == 0) { mine = 0; }
            }
            if (mine == 1) {
                if (ty == dbus_marshal_type_return()) { return 0; }
                if (ty == dbus_marshal_type_error()) {
                    var eo = dbus_unmarshal_find_field(p, dbus_marshal_f_errname(), sig);
                    var rc = -5;
                    if (eo > 0) {
                        var ptr = _dbs_scratch() + 32;
                        var n = dbus_unmarshal_str_at(p, eo, ptr);
                        rc = dbus_session_map_error(load64(ptr), n);
                    }
                    dbus_frame_advance(r);        # and its descriptors
                    return rc;
                }
            }
            # Not ours — a signal, a pre-existing message, or a reply to
            # something else. Its descriptors go with it.
            dbus_frame_advance(r);
            r = dbus_frame_next();
        }
        var fault = _dbs_frame_fault(r);
        if (fault < 0) { return fault; }

        # THE REPLY IS AN FD-BEARING MESSAGE, so this read must be a
        # recvmsg. TakeDevice's entire purpose is the descriptor, and
        # Inhibit returns one too. sys_read() delivers the BYTES and lets
        # the kernel discard the SCM_RIGHTS payload: the reply parses
        # perfectly, its UNIX_FDS field still says 1, and the descriptor
        # is simply gone. It survived five releases because an unseated
        # host answers TakeDevice with AccessDenied, which carries no fd.
        # With a deadline the receive never blocks: the poll waited, and a
        # poll can report a socket readable with nothing to read — one
        # MSG_OOB byte does it — so a blocking receive there would sit out
        # SO_RCVTIMEO past the deadline, or for ever without it (P(-1)
        # re-verification). -EAGAIN after a ready poll is a poll again.
        var flags = 0;
        if (deadline > 0) {
            now = dbus_session_now_ms();
            # A clock that worked at t0 and fails now cannot be allowed to
            # disarm the bound mid-call — `deadline - now` with a negative
            # `now` is a poll of ~24 days. The call times out instead.
            if (now < 0) { return -110; }
            if (now >= deadline) { return -110; }
            var ready = fd_wait_ready(fd, 0, deadline - now);
            if (ready == 0) { return -110; }      # the deadline passed first
            if (ready == -4) { continue; }        # EINTR: re-check the clock
            if (ready < 0) { return _dbs_io_fail(ready); }
            flags = dbus_sys_msg_dontwait();
        }
        if (deadline <= 0) {
            reads = reads + 1;
            if (reads > dbus_session_read_backstop()) { return -110; }
        }
        var got = _dbs_recv(fd, flags);
        # EINTR is retried, not returned (1.1.2): SO_RCVTIMEO makes the
        # kernel refuse to restart an interrupted receive, so any signal
        # the consumer handles arrived here as -EINTR and failed the call
        # (P(-1) audit, M4). The deadline still bounds the retry.
        if (got == -4) { continue; }
        if (got == dbus_session_eagain()) {
            if (deadline > 0) { continue; }
            # SO_RCVTIMEO expired, on the clock-failed path: the whole
            # receive budget passed with nothing arriving. A timeout, not
            # the raw -EAGAIN, which would reach the consumer as a
            # nonsensical "try again" on a blocking API.
            return -110;
        }
        if (got < 0) { return _dbs_io_fail(got); }
    }
    return -110;                                  # -ETIMEDOUT (unreachable)
}

# ---- no allocation per call (1.1.1, A-1) ----
# Every logind call used to alloc() a buffer, copy a string LITERAL into
# it and hand the copy to the marshaller — 128 bytes in begin_call plus
# 64-200 per method, so take_device and release_device each grew the
# never-freeing heap by 200 bytes, and every init/release cycle by ~250
# more in the connect path. A literal is already a static pointer and
# the marshaller copies from what it is given, so the literal is passed
# straight through. Same bytes on the wire (checked byte for byte before
# and after); nothing allocated.
# Build a logind method call. `path`/`plen` name the object; the
# interface is chosen by `on_mgr`.
fn dbus_session_begin_call(path, plen, member, mlen, on_mgr, serial) {
    dbus_marshal_begin(dbus_marshal_type_call(), 0, serial);
    dbus_marshal_field_str(dbus_marshal_f_path(), 111, path, plen);
    dbus_marshal_field_str(dbus_marshal_f_member(), 115, member, mlen);
    var itf = "org.freedesktop.login1.Session";
    if (on_mgr != 0) { itf = "org.freedesktop.login1.Manager"; }
    dbus_marshal_field_str(dbus_marshal_f_interface(), 115, itf, strlen(itf));
    var dst = "org.freedesktop.login1";
    dbus_marshal_field_str(dbus_marshal_f_dest(), 115, dst, strlen(dst));
    return 0;
}

# Allocated once, on first connect, and reused by every later one.
var _dbs_sa = 0;
var _dbs_blob = 0;

# ================= FFI-shaped native backend =================
# Every fn below matches a frozen fncallN shape exactly. The
# `bus` argument is the connected socket fd.

# Does the message at `p` (limit already set) carry body signature `lit`?
# An absent SIGNATURE field is the empty signature.
fn _dbs_body_sig_is(p, lit) {
    var sc = _dbs_scratch() + 16;
    var so = dbus_unmarshal_find_field(p, dbus_marshal_f_signature(), sc);
    if (so == dbus_unmarshal_notfound()) {
        if (strlen(lit) == 0) { return 1; }
        return 0;
    }
    if (so < 0) { return 0; }
    var sp = _dbs_scratch() + 40;
    var sn = dbus_unmarshal_sig_at(p, so, sp);
    return _dbs_name_is(load64(sp), sn, lit);
}

# Reads the SASL handshake may make when the clock has failed.
fn dbus_session_sasl_backstop() { return 4096; }

# The SASL EXTERNAL exchange on a connected socket: write the pipelined
# blob, then read server lines until AGREE_UNIX_FD.
#
#   returns 0              authenticated, fd passing agreed
#           -13 (EACCES)   the server said REJECTED or ERROR
#           -110           the deadline passed
#           -104           the server closed the connection
#           -71 (EPROTO)   the buffer filled with no complete exchange
#           other < 0      the receive's errno
#
# Bounded like the call path (1.1.2): one deadline, every wait a poll
# for the time left, a non-blocking receive after it, EINTR retried
# without using up anything. Until 1.1.2 the loop was also capped at 32
# reads — a server that sent its 58-byte reply in more than 32 pieces
# failed the connect — every failure was reported -13, and a signal
# used up one of the 32 (P(-1) re-verification).
fn dbus_session_sasl(fd) {
    if (_dbs_blob == 0) { _dbs_blob = alloc(64); }
    if (_dbs_blob == 0) { return -12; }
    var deadline = 0;
    var t0 = dbus_session_now_ms();
    if (t0 >= 0) { deadline = t0 + dbus_session_timeout_ms(); }
    var bn = dbus_auth_write_blob(_dbs_blob);
    var w = _dbs_write(fd, _dbs_blob, bn, deadline);
    if (w < 0) { return w; }
    var reads = 0;
    var now = 0;
    while (1 == 1) {
        # A buffer full of lines with no end will never complete: say so
        # now, rather than wait out the deadline for room that cannot come.
        var space = dbus_frame_space();
        if (space <= 0) { return -71; }
        var flags = 0;
        if (deadline > 0) {
            now = dbus_session_now_ms();
            if (now < 0) { return -110; }         # the clock failed mid-way
            if (now >= deadline) { return -110; }
            var ready = fd_wait_ready(fd, 0, deadline - now);
            if (ready == 0) { return -110; }
            if (ready == -4) { continue; }
            if (ready < 0) { return ready; }
            flags = dbus_sys_msg_dontwait();
        }
        if (deadline <= 0) {
            reads = reads + 1;
            if (reads > dbus_session_sasl_backstop()) { return -110; }
        }
        # recvmsg, not read(): the same receive the call path uses. A
        # descriptor here would be a server breaking the protocol; it is
        # closed, not queued — no message owns it.
        var got = dbus_sys_recv(fd, dbus_frame_tail(), space, flags);
        var i = 0;
        while (i < dbus_sys_rx_count()) { sys_close(dbus_sys_rx_fd(i)); i = i + 1; }
        if (got == -4) { continue; }
        if (got == dbus_session_eagain()) {
            if (deadline > 0) { continue; }
            return -110;                          # SO_RCVTIMEO, no clock
        }
        if (got < 0) { return got; }
        if (got == 0) { return -104; }            # -ECONNRESET, as sd-bus
        dbus_frame_commit(got);
        var st = dbus_auth_drain_lines();
        if (st == dbus_auth_ok()) { return 0; }
        if (st != dbus_auth_need_more()) { return -13; }
    }
    return -110;
}

# The connect handshake on a connected socket: SASL, then Hello, whose
# reply names us. Split out of dbus_native_open_system_bus (1.1.2) so it
# can be driven over a socketpair: until then it ran only against the
# real system bus, and none of its failure paths had a test.
#
#   returns 0 or a negative errno; the caller closes `fd` on failure.
fn dbus_session_handshake(fd) {
    var sr = dbus_session_sasl(fd);
    if (sr < 0) { return sr; }
    return dbus_session_hello(fd);
}

# Hello, so the bus assigns a unique name. Without it every subsequent
# call is refused. A failure closes whatever descriptors it left queued
# (1.1.2: they stayed open until the next init).
fn dbus_session_hello(fd) {
    var rc = _dbs_hello(fd);
    if (rc < 0) { dbus_frame_close_fds(); }
    return rc;
}

fn _dbs_hello(fd) {
    var serial = dbus_session_next_serial();
    var hpath = "/org/freedesktop/DBus";
    dbus_marshal_begin(dbus_marshal_type_call(), 0, serial);
    dbus_marshal_field_str(dbus_marshal_f_path(), 111, hpath, strlen(hpath));
    var hm = "Hello";
    dbus_marshal_field_str(dbus_marshal_f_member(), 115, hm, strlen(hm));
    var bus_name = "org.freedesktop.DBus";
    dbus_marshal_field_str(dbus_marshal_f_interface(), 115, bus_name, strlen(bus_name));
    dbus_marshal_field_str(dbus_marshal_f_dest(), 115, bus_name, strlen(bus_name));
    dbus_marshal_end_fields();
    dbus_marshal_finish();
    var rc = dbus_session_call(fd, serial);
    if (rc < 0) { return rc; }

    # KEEP the assigned unique name. The Hello reply's body is a
    # single STRING and samvada used to advance straight past it —
    # which is precisely why it could not tell whether any later
    # reply was addressed to it. Everything dbus_session_dest_ok()
    # does rests on this one string.
    #
    # And check it (1.1.2): an `s` body, a name that starts ':' (a unique
    # name, sd-bus's hello_callback), with no NUL inside. -EPROTO if not.
    var hlen = dbus_frame_next();
    dbus_unmarshal_set_limit(hlen);
    var hp = dbus_frame_base();
    var ok = _dbs_body_sig_is(hp, "s");
    dbus_unmarshal_body_begin(hp);
    var uptr = _dbs_scratch() + 56;
    var un = dbus_unmarshal_next_str(uptr);
    if (un < 2) { ok = 0; }
    if (ok == 1) {
        if (load8(load64(uptr)) != 58) { ok = 0; }               # ':'
        if (_dbu_no_nul(load64(uptr), un) == 0) { ok = 0; }
    }
    if (ok == 0) {
        dbus_frame_advance(hlen);
        return -71;                               # -EPROTO: no unique name
    }
    var su = dbus_session_set_unique(load64(uptr), un);
    dbus_frame_advance(hlen);
    if (su < 0) { return su; }
    return 0;
}

# fncall1(slot, bus_out) -> 0 | -err
fn dbus_native_open_system_bus(bus_out) {
    dbus_frame_init();
    dbus_auth_reset();
    dbus_session_reset();

    if (_dbs_sa == 0) { _dbs_sa = alloc(dbus_socket_sockaddr_un_size()); }
    if (_dbs_sa == 0) { return -12; }
    var sa = _dbs_sa;
    var sp = "/run/dbus/system_bus_socket";
    var alen = dbus_socket_addr_path(sa, sp, strlen(sp));
    if (alen < 0) { return alen; }
    var fd = dbus_socket_connect(sa, alen);
    if (fd < 0) { return fd; }

    var rc = dbus_session_handshake(fd);
    if (rc < 0) {
        sys_close(fd);
        return rc;
    }
    store64(bus_out, fd);
    return 0;
}

# fncall4(slot, bus, pid, out_buf, out_buf_len) -> 0 | -err
fn dbus_native_get_session_path(bus, pid, out_buf, out_len) {
    if (out_buf == 0)  { return -22; }
    if (out_len <= 0)  { return -22; }
    var serial = dbus_session_next_serial();
    var mpath = "/org/freedesktop/login1";
    var m = "GetSessionByPID";
    dbus_session_begin_call(mpath, strlen(mpath), m, strlen(m), 1, serial);
    var sg = "u";
    dbus_marshal_field_sig(dbus_marshal_f_signature(), sg, strlen(sg));
    dbus_marshal_end_fields();
    dbus_marshal_body_u32(pid);
    dbus_marshal_finish();

    var rc = dbus_session_call(bus, serial);
    if (rc < 0) { return rc; }
    var p = dbus_frame_base();
    dbus_unmarshal_set_limit(dbus_frame_next());
    # An `o` body holding a valid object path (1.1.2). The C shim's
    # sd_bus_message_read("o") checks both; the native backend checked
    # neither, so a path with an embedded NUL was copied out and later
    # cut short by strlen().
    var sig_ok = _dbs_body_sig_is(p, "o");
    dbus_unmarshal_body_begin(p);
    var ptr = _dbs_scratch() + 56;
    var n = dbus_unmarshal_next_str(ptr);
    if (n < 0) { dbus_session_done(); return -71; }
    if (sig_ok == 0) { dbus_session_done(); return -71; }
    if (dbus_unmarshal_path_ok(load64(ptr), n) == 0) { dbus_session_done(); return -71; }
    if (n + 1 > out_len) {
        dbus_session_done();
        return -105;                              # -ENOBUFS
    }
    var src = load64(ptr);
    var i = 0;
    while (i < n) { store8(out_buf + i, load8(src + i)); i = i + 1; }
    store8(out_buf + n, 0);
    dbus_session_done();
    return 0;
}

# fncall2(slot, bus, sess_cstr) -> 0 | -err
fn dbus_native_take_control(bus, sess) {
    if (dbus_session_sess_ok(sess) == 0) { return -22; }
    var t = "TakeControl";
    var serial = dbus_session_next_serial();
    dbus_session_begin_call(sess, strlen(sess), t, strlen(t), 0, serial);
    var sg = "b";
    dbus_marshal_field_sig(dbus_marshal_f_signature(), sg, strlen(sg));
    dbus_marshal_end_fields();
    dbus_marshal_body_bool(0);                    # force = false
    dbus_marshal_finish();
    var rc = dbus_session_call(bus, serial);
    if (rc == 0) { dbus_session_done(); }
    return rc;
}

# fncall2(slot, bus, sess_cstr) -> 0 | -err
fn dbus_native_release_control(bus, sess) {
    if (dbus_session_sess_ok(sess) == 0) { return -22; }
    var t = "ReleaseControl";
    var serial = dbus_session_next_serial();
    dbus_session_begin_call(sess, strlen(sess), t, strlen(t), 0, serial);
    dbus_marshal_end_fields();                    # empty body: NO signature field
    dbus_marshal_finish();
    var rc = dbus_session_call(bus, serial);
    if (rc == 0) { dbus_session_done(); }
    return rc;
}

# ---- is this descriptor the device that was asked for? (1.1.2) ----
# logind opens the device node for the requested devnum — read-write,
# O_RDWR|O_CLOEXEC|O_NOCTTY|O_NONBLOCK (logind-session-device.c) — and
# hands the descriptor over, so a genuine TakeDevice descriptor is a
# CHARACTER device whose rdev is exactly (major, minor), open O_RDWR and
# not O_PATH. take_device asks the kernel, which no message can argue
# with: a wrong attribution can no longer hand out a different device, a
# socket, or a descriptor nobody could read.
#
# What it does NOT prove is provenance. A descriptor naming the same
# node, opened read-write by anyone who may open it (renderD128 is
# 0666), passes too — the attribution fix (dbus_frame_fdq_cap) is what
# keeps such a descriptor from being handed out. The first cut checked
# only the type and rdev, and an O_PATH descriptor — which any user can
# open on any node, readable or not — passed (P(-1) final pass).
#
# statx, not fstat: struct statx has ONE layout on every Linux arch
# (include/uapi/linux/stat.h — u16 stx_mode @28, u32 stx_rdev_major
# @128, u32 stx_rdev_minor @132), where struct stat's differs between
# x86_64 and aarch64. AT_EMPTY_PATH with "" stats the descriptor itself.
var _dbs_stx = 0;                 # 256 bytes, allocated on first take

fn dbus_session_fd_is_device(fd, major, minor) {
    if (_dbs_stx == 0) { return 0; }
    var i = 0;
    while (i < 256) { store64(_dbs_stx + i, 0); i = i + 8; }
    # Read-write, as logind opens it. This also refuses O_PATH: F_GETFL
    # reports an O_PATH descriptor's access mode as O_RDONLY (a separate
    # O_PATH test was mutation-tested and is subsumed by this one).
    var fl = sys_fcntl(fd, 3, 0);                     # F_GETFL
    if (fl < 0) { return 0; }
    if ((fl & 3) != 2) { return 0; }                  # O_ACCMODE != O_RDWR
    var rc = sys_statx(fd, "", 4096, 1, _dbs_stx);   # AT_EMPTY_PATH, STATX_TYPE
    if (rc < 0) { return 0; }
    var mode = load16(_dbs_stx + 28);
    if ((mode & 61440) != 8192) { return 0; }         # S_IFMT, S_IFCHR
    if (load32(_dbs_stx + 128) != major) { return 0; }
    if (load32(_dbs_stx + 132) != minor) { return 0; }
    return 1;
}

# fncall6(slot, bus, sess_cstr, major, minor, fd_out, active_out) -> 0 | -err
fn dbus_native_take_device(bus, sess, major, minor, fd_out, active_out) {
    if (_dbs_stx == 0) { _dbs_stx = alloc(256); }
    if (_dbs_stx == 0) { return -12; }
    if (dbus_session_sess_ok(sess) == 0) { return -22; }
    var maj_ok = dbus_session_devnum_ok(major);
    var min_ok = dbus_session_devnum_ok(minor);
    if (maj_ok == 0) { return -22; }
    if (min_ok == 0) { return -22; }
    var t = "TakeDevice";
    var serial = dbus_session_next_serial();
    dbus_session_begin_call(sess, strlen(sess), t, strlen(t), 0, serial);
    var sg = "uu";
    dbus_marshal_field_sig(dbus_marshal_f_signature(), sg, strlen(sg));
    dbus_marshal_end_fields();
    dbus_marshal_body_u32(major);
    dbus_marshal_body_u32(minor);
    dbus_marshal_finish();

    var rc = dbus_session_call(bus, serial);
    if (rc < 0) { return rc; }
    var p = dbus_frame_base();
    var r = dbus_frame_next();
    dbus_unmarshal_set_limit(r);
    # The reply must be the one logind sends, `(hb)`, with exactly the
    # descriptors it says it carries — sd-bus's own rule (bus-message.c:
    # a UNIX_FDS that disagrees with what arrived is -EBADMSG, and an
    # `h` index past the descriptors is -EBADMSG). The queue holds this
    # reply's descriptors and no other message's (dbus_frame_fdq_cap);
    # the body's `h` is an INDEX into them, and it is honoured, not
    # assumed to be 0. Anything else is the peer-bus contract violation
    # public-api.md calls -EBADF, and nothing is handed out (1.1.2: until
    # then the index and the signature were ignored, and a malformed
    # `inactive` reached active_out as -1201).
    var ok = 1;
    var sc = _dbs_scratch() + 16;
    var so = dbus_unmarshal_find_field(p, dbus_marshal_f_signature(), sc);
    if (so < 0) { ok = 0; }
    if (ok == 1) {
        var sp = _dbs_scratch() + 40;
        var sn = dbus_unmarshal_sig_at(p, so, sp);
        if (_dbs_name_is(load64(sp), sn, "hb") == 0) { ok = 0; }
    }
    var declared = 0;
    var uo = dbus_unmarshal_find_field(p, dbus_marshal_f_unixfds(), sc);
    if (uo == dbus_unmarshal_malformed()) { ok = 0; }
    if (uo > 0) { declared = dbus_unmarshal_u32(p, uo); }
    if (declared != dbus_frame_fd_total()) { ok = 0; }
    if (dbus_frame_fd_bad() != 0) { ok = 0; }
    dbus_unmarshal_body_begin(p);
    var idx = dbus_unmarshal_next_fd_index();
    var inactive = dbus_unmarshal_next_bool();
    if (idx < 0) { ok = 0; }
    if (inactive < 0) { ok = 0; inactive = 0; }
    var fd = (0 - 1);
    if (ok == 1) { fd = dbus_frame_claim_fd(idx); }
    if (fd >= 0) {
        if (dbus_session_fd_is_device(fd, major, minor) == 0) {
            sys_close(fd);
            fd = (0 - 1);
        }
    }
    store64(fd_out, fd);
    store64(active_out, inactive);
    dbus_frame_advance(r);                        # closes every other one
    if (fd < 0) { return -9; }                    # -EBADF: no usable fd
    return 0;
}

# fncall4(slot, bus, sess_cstr, major, minor) -> 0 | -err
fn dbus_native_release_device(bus, sess, major, minor) {
    if (dbus_session_sess_ok(sess) == 0) { return -22; }
    var maj_ok = dbus_session_devnum_ok(major);
    var min_ok = dbus_session_devnum_ok(minor);
    if (maj_ok == 0) { return -22; }
    if (min_ok == 0) { return -22; }
    var t = "ReleaseDevice";
    var serial = dbus_session_next_serial();
    dbus_session_begin_call(sess, strlen(sess), t, strlen(t), 0, serial);
    var sg = "uu";
    dbus_marshal_field_sig(dbus_marshal_f_signature(), sg, strlen(sg));
    dbus_marshal_end_fields();
    dbus_marshal_body_u32(major);
    dbus_marshal_body_u32(minor);
    dbus_marshal_finish();
    var rc = dbus_session_call(bus, serial);
    if (rc == 0) { dbus_session_done(); }
    return rc;
}

# fncall1(slot, bus) -> events | -err
# Drains whatever is readable without blocking, and reports how many
# whole messages went past. Bounded like the C shim's, and for the
# same reason: the frozen signature takes no cap argument.
#
# The read is NOT optional, and leaving it out is how the 0.11.0
# differential caught this module diverging from the C shim: the C
# side's sd_bus_process pulls from the socket, so it reported 1
# event where this reported 0 having only looked at an already-empty
# buffer. Same call, same session, two different answers — precisely
# the silent error-parity breach N6 exists to find.
#
# MSG_DONTWAIT is per-call. Setting O_NONBLOCK on the socket instead
# would make the request/reply path non-blocking too and turn every
# method call into a busy-wait.
fn dbus_native_pump_signals(bus) {
    var drained = 0;
    var io = 0;
    var reads = 0;
    var more = 1;
    var r = 0;
    while (more == 1) {
        r = dbus_frame_next();
        while (r > 0) {
            drained = drained + 1;
            # Signals are not surfaced (ADR-0004), so a descriptor riding
            # on one has no owner: advancing past the message closes it.
            dbus_frame_advance(r);
            if (drained >= 256) { return drained; }
            r = dbus_frame_next();
        }
        more = 0;
        # Read until the socket is empty, one bounded receive at a time
        # (1.1.2: it read once per call, which with reads bounded to one
        # message would report at most one event per pump). Capped per
        # call like the C shim's drain, and for the same reason: the
        # frozen signature has no cap argument. A drain the cap cuts off
        # continues on the next pump.
        if (r == dbus_frame_need_more()) {
            if (bus > 2) {
                if (reads < 1024) { more = 1; }
            }
        }
        if (more == 1) {
            reads = reads + 1;
            var got = _dbs_recv(bus, dbus_sys_msg_dontwait());
            # -EAGAIN is the normal "nothing more to read", and an
            # interrupted receive simply ends this pump. A disconnect errno
            # is the connection going; any other failure is returned
            # (1.1.2: it was swallowed, so a pump on a broken descriptor
            # reported a quiet bus forever).
            if (got < 0) {
                more = 0;
                var quiet = 0;
                if (got == dbus_session_eagain()) { quiet = 1; }
                if (got == -4) { quiet = 1; }
                if (quiet == 0) { io = _dbs_io_fail(got); }
            }
        }
    }
    # A dead or corrupt stream is an ERROR, not "no events" (1.1.1,
    # A-4). Until 1.1.1 this returned `drained` whatever stopped the
    # loop, so once the bus closed every pump returned 0 forever: a
    # consumer pumping at 60 Hz could not tell a quiet bus from a gone
    # one. Once a connection has closed, sd_bus_process answers
    # -ECONNRESET (BUS_CLOSED, sd-bus.c), and the C shim's pump passes
    # that straight through. So does this, via _dbs_closed. One
    # deliberate difference: events drained before the failure are
    # reported first and the failure on the next call, which finds the
    # same state; the shim returns the error at once and drops the
    # count. An unreadable stream is -EPROTO, as on the call path.
    if (drained > 0) { return drained; }
    var fault = _dbs_frame_fault(r);
    if (fault < 0) { return fault; }
    if (io < 0) { return io; }
    if (_dbs_closed != 0) { return -104; }      # sd-bus: BUS_CLOSED -> -ECONNRESET
    return 0;
}

# fncall1(slot, bus) -> 0
fn dbus_native_close_bus(bus) {
    dbus_frame_close_fds();
    if (bus > 2) { sys_close(bus); }              # never stdio: see dbus_socket_connect
    return 0;
}

# ---- the public native entry point (0.11.0, N6 cutover) ----
# @public
#
# The ONLY way a consumer should reach the native backend. It exists
# because CLAUDE.md forbids exposing FFI types in public signatures:
# without it a native consumer would have to write
#
#     var t = samvada_ffi_alloc();
#     dbus_native_populate(t);
#     samvada_init(t);
#
# which hands them a fn-table pointer — the exact thing the rule
# exists to prevent, and the thing that would make the eventual
# removal of the FFI layer a breaking change for them.
#
# Additive, so nothing that exists today changes: `samvada_init` and
# its frozen signature are untouched, and a consumer still linking
# the C shim keeps working unchanged.
#
#   returns 0, or a negative sd-bus errno
# The table is allocated ONCE and reused.
#
# public-api.md documents init-after-release as the supported
# recovery path, and alloc() never frees — so a fresh 88-byte table
# per call is a permanent leak on a path consumers are told to use.
# Measured across live init/release cycles: 744 bytes per cycle,
# linear and unbounded, of which this is the table's share. Same
# class as the 60 Hz pump leak, just slower.
#
# Repopulating on every call is deliberate: it costs nothing and it
# means a caller that scribbled on the table gets a clean one back
# rather than a stale dispatch.
var _dbs_table = 0;

public fn samvada_native_init() {
    if (_dbs_table == 0) { _dbs_table = samvada_ffi_alloc(); }
    if (_dbs_table == 0) { return -12; }
    var rc = dbus_native_populate(_dbs_table);
    if (rc < 0) { return rc; }
    return samvada_init(_dbs_table);
}

# Populate an FFI table with the native backend. kind = PURE_CYRIUS.
fn dbus_native_populate(t) {
    if (t == 0) { return -22; }
    samvada_ffi_set_slot(t, samvada_slot_open_system_bus(),  &dbus_native_open_system_bus);
    samvada_ffi_set_slot(t, samvada_slot_get_session_path(), &dbus_native_get_session_path);
    samvada_ffi_set_slot(t, samvada_slot_take_device(),      &dbus_native_take_device);
    samvada_ffi_set_slot(t, samvada_slot_release_device(),   &dbus_native_release_device);
    samvada_ffi_set_slot(t, samvada_slot_pump_signals(),     &dbus_native_pump_signals);
    samvada_ffi_set_slot(t, samvada_slot_close_bus(),        &dbus_native_close_bus);
    samvada_ffi_set_slot(t, samvada_slot_take_control(),     &dbus_native_take_control);
    samvada_ffi_set_slot(t, samvada_slot_release_control(),  &dbus_native_release_control);
    samvada_ffi_set_slot(t, samvada_slot_kind(), samvada_backend_kind_pure_cyrius());
    return 0;
}

# --- samvada.cyr ---

# @public — samvada API surface (stable across v0.x)
# samvada.cyr — entry point for the dbus / logind subset.
#
# Consumer-facing surface:
#   samvada_init(fn_table_ptr)                 -> 0|err
#   samvada_session_take_device(major, minor)  -> fd | -err
#   samvada_session_release_device(major, minor) -> 0|err
#   samvada_pump_signals()                     -> events_drained|negative_err
#   samvada_release()                          -> 0
#   samvada_version()                          -> packed u32
#
# `samvada_main(table)` is the C-shim entry point. It calls
# `samvada_init(table)` and then returns immediately — consumers
# (mabda's _backend_native_surface_configure_logind) drive the
# rest from their own code paths. The "consume samvada" half of
# the contract is invoked synchronously below the public API.
#
# Implementation: every public fn dispatches through the fn-table
# stashed by samvada_init() via fncallN from lib/fnptr.cyr.
#
# LIFETIME CONTRACT: we BORROW the table, we never copy it —
# `_samvada_slot()` re-reads `load64(_samvada_table + off)` on every
# call. The caller must keep the table valid and unmodified from
# samvada_init() until samvada_release(). The C shim satisfies this
# with a file-scope `static int64_t samvada_fn_table[]`.

# ---- module-scope state ----
# Set by samvada_init; read by the rest of the API. Declared with
# explicit zero to dodge the global-init-order silent-zero gotcha
# AND the uninitialized-var rejection.
var _samvada_table = 0;
var _samvada_bus   = 0;
var _samvada_sess  = 0;     # heap ptr to NUL-terminated session path
var _samvada_outs  = 0;     # heap ptr to 16-byte (fd_out, active_out) scratch
# Session control is acquired LAZILY, on the first successful device take —
# never at init. logind's TakeControl runs session_prepare_vt(), which on any
# session with vtnr >= 1 does KDSKBMODE=K_OFF (keyboard off) and
# KDSETMODE=KD_GRAPHICS (console blanks). Taking control at init therefore
# muted the user's console before any device was requested, and left it muted
# if the take then failed. See ADR-0004.
# 0: control is not held. 1: held. 2: it MAY be held — a TakeControl or
# ReleaseControl timed out, so logind's state is unknown and logind is
# not answering (1.1.2). ReleaseControl is owed in states 1 and 2.
var _samvada_control = 0;
# The devices we hold, by number (1.1.2). Until then this was a bare count,
# and a count cannot tell WHICH device a release is for: a take that failed
# on our side after logind granted it, followed by a release of that
# device, decremented the count for a device it never counted — and when
# the count reached 0 samvada dropped control, which revokes every device,
# including the one the consumer was still drawing to.
var _samvada_held  = 0;     # heap: (major << 32) | minor, one word each
var _samvada_heldn = 0;

# Sized to fit any logind session path (`/org/freedesktop/login1/session/_NN`
# is ~46 chars; 512 leaves headroom for any future scheme).
var _SAMVADA_SESS_BUFLEN = 512;
var _SAMVADA_OUTS_BUFLEN = 16;

# A compositor holds a DRM node and its input devices; 256 is far past
# any seat, and a fixed table is the only kind alloc() does not leak.
fn _samvada_held_cap() { return 256; }

# Version triple packed into a u32 (major << 16 | minor << 8 | patch).
# Bumps lock-step with VERSION; consumers can do
# `if (samvada_version() < ((1<<16)|(0<<8)|0)) { ... }` for gates.
public fn samvada_version() {
    return (1 << 16) | (1 << 8) | 2;
}

# ---- private helpers ----

fn _samvada_have_table() {
    if (_samvada_table == 0) { return 0; }
    return 1;
}

fn _samvada_slot(off) {
    return samvada_ffi_get_slot(_samvada_table, off);
}

# dbus carries device numbers as `u`. Checked HERE, before any wire
# traffic (1.1.2): both backends check too, but only after the public
# layer had already sent TakeControl — muting a seated VT for a request
# that could never have been made.
fn _samvada_devnum_ok(v) {
    if (v < 0)          { return 0; }
    if (v > 4294967295) { return 0; }         # UINT32_MAX
    return 1;
}

fn _samvada_held_find(major, minor) {
    var key = (major << 32) | minor;
    var i = 0;
    while (i < _samvada_heldn) {
        if (load64(_samvada_held + i * 8) == key) { return i; }
        i = i + 1;
    }
    return (0 - 1);
}

fn _samvada_held_add(major, minor) {
    if (_samvada_heldn >= _samvada_held_cap()) { return -24; }
    store64(_samvada_held + _samvada_heldn * 8, (major << 32) | minor);
    _samvada_heldn = _samvada_heldn + 1;
    return 0;
}

fn _samvada_held_del(i) {
    if (i < 0) { return 0; }
    if (i >= _samvada_heldn) { return 0; }
    var last = _samvada_heldn - 1;
    store64(_samvada_held + i * 8, load64(_samvada_held + last * 8));
    _samvada_heldn = last;
    return 0;
}

# Is this the bus itself failing, rather than logind refusing? Then no
# follow-up call is worth making on it.
fn _samvada_bus_failed(rc) {
    if (rc == -104) { return 1; }             # ECONNRESET
    if (rc == -107) { return 1; }             # ENOTCONN
    if (rc == -110) { return 1; }             # ETIMEDOUT
    return 0;
}

# ---- public API ----

# Stash the fn-table, open the system bus, look up the session
# object path for our own pid. Returns 0 on success or a negative
# sd-bus errno on failure (-EINVAL if table is null or its kind
# doesn't match a known backend).
public fn samvada_init(table) {
    if (table == 0) { return -22; }   # -EINVAL
    # Reject re-init without an intervening release (HIGH-1 in
    # 2026-05-01 hardening review). _samvada_table != 0 catches
    # both successful prior init and partial-init-fail states;
    # samvada_release() clears it back to 0.
    if (_samvada_table != 0) { return -16; }   # -EBUSY
    # Whitelist known backends. Accepting "any non-zero" meant an
    # uninitialised or wrongly-shaped table whose +64 word happened to be
    # non-zero got dispatched as function pointers instead of rejected
    # (0.5.1, audit MED-6).
    var k = samvada_ffi_kind(table);
    var k_ok = 0;
    if (k == samvada_backend_kind_libsystemd())  { k_ok = 1; }
    if (k == samvada_backend_kind_pure_cyrius()) { k_ok = 1; }
    if (k_ok == 0) { return -22; }
    _samvada_table = table;

    # Allocate scratch buffers on first init only; subsequent
    # init-after-release reuses them (the bump allocator never
    # frees, so re-allocating would leak the previous bytes).
    if (_samvada_sess == 0) {
        _samvada_sess = alloc(_SAMVADA_SESS_BUFLEN);
        if (_samvada_sess == 0) { samvada_release(); return -12; }   # -ENOMEM
    }
    if (_samvada_outs == 0) {
        _samvada_outs = alloc(_SAMVADA_OUTS_BUFLEN);
        if (_samvada_outs == 0) { samvada_release(); return -12; }
    }
    if (_samvada_held == 0) {
        _samvada_held = alloc(_samvada_held_cap() * 8);
        if (_samvada_held == 0) { samvada_release(); return -12; }
    }
    _samvada_heldn = 0;
    # Zero the scratch on every init so stale data from a previous
    # cycle never leaks into a successful read.
    var i = 0;
    while (i < _SAMVADA_SESS_BUFLEN) { store64(_samvada_sess + i, 0); i = i + 8; }
    store64(_samvada_outs + 0, 0);
    store64(_samvada_outs + 8, 0);

    # Open the system bus. The C wrapper writes the bus pointer
    # into the address we hand it.
    var bus_slot = _samvada_slot(samvada_slot_open_system_bus());
    if (bus_slot == 0) { samvada_release(); return -38; }   # -ENOSYS
    var bus_out = _samvada_outs;          # reuse 8 bytes of scratch
    store64(bus_out, 0);
    var rc = fncall1(bus_slot, bus_out);
    if (rc < 0) { samvada_release(); return rc; }
    _samvada_bus = load64(bus_out);
    if (_samvada_bus == 0) { samvada_release(); return -107; }   # -ENOTCONN

    # Look up the session path for our PID. logind speaks
    # GetSessionByPID(uint32) -> object_path; the C wrapper writes
    # the cstr into _samvada_sess.
    var sp_slot = _samvada_slot(samvada_slot_get_session_path());
    # This path LEAKED THE BUS until 0.5.1 (see CHANGELOG 0.5.1, audit
    # MED-8): _samvada_bus is live by this point, so returning without
    # releasing left an open sd_bus AND an armed public API.
    if (sp_slot == 0) { samvada_release(); return -38; }
    var pid = sys_getpid();
    rc = fncall4(sp_slot, _samvada_bus, pid, _samvada_sess,
      _SAMVADA_SESS_BUFLEN);
    if (rc < 0) { samvada_release(); return rc; }

    # NOTE: session control is NOT taken here. 0.5.1 did take it here, to fix
    # CRIT-1 (TakeDevice fails with NotInControl without it) — but logind's
    # TakeControl also runs session_prepare_vt(), muting the keyboard and
    # blanking the console on any seated VT session, before any device was
    # asked for. samvada_session_take_device() now acquires control lazily
    # instead, so a consumer that inits and never takes a device never
    # touches the user's VT. ADR-0004.
    #
    # The slot is still validated at init so a pre-0.5.1 backend table fails
    # loudly here rather than at the first device take.
    var tc_slot = _samvada_slot(samvada_slot_take_control());
    if (tc_slot == 0) { samvada_release(); return -38; }
    return 0;
}

# Take session control. Sent whenever no device is held, even if a
# previous ReleaseControl failed and control may still be ours: logind
# answers success when the caller already is the controller
# (session_set_controller: `if (session_is_controller(s, sender)) return
# 0;`), so asking again is free and it means a failed release can never
# leave samvada believing it holds control it lost.
#
# A TakeControl that TIMES OUT may still have been granted — logind may
# have muted the console and answered late — so it is recorded as
# "may be held" (state 2), and a ReleaseControl is owed (1.1.2: it was
# forgotten, and only the connection's close restored the VT).
fn _samvada_take_control() {
    var tc_slot = _samvada_slot(samvada_slot_take_control());
    if (tc_slot == 0) { return -38; }
    var rc = fncall2(tc_slot, _samvada_bus, _samvada_sess);
    if (rc == -110) {
        if (_samvada_control == 0) { _samvada_control = 2; }
        return rc;
    }
    if (rc < 0) { return rc; }
    _samvada_control = 1;
    return 0;
}

# Drop session control if it is, or may be, held. logind restores the
# VT (session_restore_vt) when the controller is released, so this is
# what un-mutes the console.
#
# What a failed ReleaseControl leaves (1.1.2):
#   timed out (-110)            state 2: logind is not answering; asked
#                               again at the next last-device release
#   NotInControl (-22), or the  state 0: control is not ours, or the
#   bus gone (-104 / -107)      connection's close released it
#   anything else               kept: asked again at the next last-device
#                               release, or at samvada_release
# At `closing` (samvada_release), a controller logind did not answer last
# time is not asked again: the connection is about to close, and closing
# it releases control — logind tracks its controller's bus name — so the
# call would only add another full budget to the release.
fn _samvada_drop_control(closing) {
    if (_samvada_control == 0) { return 0; }
    if (closing != 0) {
        if (_samvada_control == 2) {
            _samvada_control = 0;
            return 0;
        }
    }
    var rc_slot = _samvada_slot(samvada_slot_release_control());
    var rc = 0;
    if (rc_slot != 0) { rc = fncall2(rc_slot, _samvada_bus, _samvada_sess); }
    if (rc >= 0) {
        _samvada_control = 0;
        return 0;
    }
    if (rc == -110) {
        _samvada_control = 2;
        return rc;
    }
    var gone = 0;
    if (rc == -22) { gone = 1; }
    if (_samvada_bus_failed(rc) != 0) { gone = 1; }
    if (gone == 1) { _samvada_control = 0; }
    return rc;
}

# Ask logind for DRM-master delegation on /dev/dri/card<N>. Returns
# the dup'd unix_fd on success, or a negative sd-bus errno on
# failure. The fd's lifetime is the caller's; close() it (or pass
# it to ReleaseDevice + close) on teardown.
public fn samvada_session_take_device(major, minor) {
    if (_samvada_have_table() == 0) { return -22; }
    if (_samvada_bus == 0)          { return -107; }
    var slot = _samvada_slot(samvada_slot_take_device());
    if (slot == 0) { return -38; }
    var maj_ok = _samvada_devnum_ok(major);
    var min_ok = _samvada_devnum_ok(minor);
    if (maj_ok == 0) { return -22; }
    if (min_ok == 0) { return -22; }
    # A device we already hold: logind would answer DeviceIsTaken, which
    # sd-bus maps to -EINVAL. Answered here, without the round trip — and
    # without the failure path below, which must never touch a device the
    # consumer is using.
    if (_samvada_held_find(major, minor) >= 0) { return -22; }
    if (_samvada_heldn >= _samvada_held_cap()) { return -24; }   # -EMFILE

    # logind answers NotInControl unless this connection holds control, so
    # acquire it here rather than at init (ADR-0004).
    if (_samvada_heldn == 0) {
        var tc = _samvada_take_control();
        if (tc < 0) { return tc; }
    }

    # 16-byte scratch: [+0] fd_out (i32), [+8] active_out (i32).
    # store64 the whole word; the C side writes only the low 32
    # bits, so high half stays zero.
    store64(_samvada_outs + 0, 0);
    store64(_samvada_outs + 8, 0);

    var rc = fncall6(slot, _samvada_bus, _samvada_sess,
      major, minor,
      _samvada_outs + 0, _samvada_outs + 8);
    var fd = load64(_samvada_outs + 0) & 0xFFFFFFFF;
    # Sign-extend the i32 fd back to a Cyrius-native int, so a negative
    # can never read as a huge positive descriptor.
    if ((fd & 0x80000000) != 0) { fd = fd - 0x100000000; }
    if (rc >= 0) {
        if (fd >= 0) {
            _samvada_held_add(major, minor);
            return fd;
        }
        # A backend that says success and hands back no descriptor broke
        # the contract: -EBADF, not the negative number it returned
        # (1.1.2: that number surfaced as an errno — -1 read as -EPERM).
        rc = -9;
    }
    # The take failed. logind may still have GRANTED it — the reply was
    # malformed, or the shim's dup failed — so put logind's view back in
    # step with ours. With nothing held, handing control back does that
    # wholesale (logind releases every device with it) and un-mutes the
    # console for a device we never got. With other devices held, release
    # just this one: it is not in our table, so it is not a descriptor the
    # consumer has, and the worst logind can say is DeviceNotTaken.
    #
    # With nothing held, control goes back even when the take TIMED OUT:
    # this call's TakeControl just succeeded, so the console is muted now,
    # and nothing else would un-mute it — a consumer that falls back to
    # kiosk keeps samvada initialised and takes nothing more (ADR-0004's
    # defect shape, which the 1.1.2 re-verification's one-budget version
    # reintroduced; P(-1) final pass). That costs a second budget only on
    # this path, where logind just answered.
    if (_samvada_heldn == 0) {
        _samvada_drop_control(0);
        return rc;
    }
    # With other devices held, not when logind is not answering (-110):
    # another call would only cost another full budget. Control is
    # recorded as "may be held"; a device logind granted late is released
    # when the consumer next takes it (logind answers DeviceIsTaken, and
    # this path releases it) — or by release_device.
    if (rc == -110) {
        _samvada_control = 2;
        return rc;
    }
    if (_samvada_bus_failed(rc) == 0) {
        var rd = _samvada_slot(samvada_slot_release_device());
        if (rd != 0) { fncall4(rd, _samvada_bus, _samvada_sess, major, minor); }
    }
    return rc;
}

# Tell logind we're done with the device. Pairs with TakeDevice
# at teardown (and on PauseDevice if the consumer chooses to drop).
#
# The device leaves samvada's table WHATEVER logind answers (1.1.2): the
# consumer has said it is done with it. Until then a release that failed
# kept it — and a device logind had already dropped (hot-unplugged, or
# released by an earlier call that timed out) answers DeviceNotTaken, so
# it stayed held for ever: control was never given back, the console
# stayed muted, and the replugged device could not be taken again
# (P(-1) re-verification). If logind does still hold it, the next take
# gets DeviceIsTaken and the take's failure path releases it.
public fn samvada_session_release_device(major, minor) {
    if (_samvada_have_table() == 0) { return -22; }
    if (_samvada_bus == 0)          { return -107; }
    var slot = _samvada_slot(samvada_slot_release_device());
    if (slot == 0) { return -38; }
    # Checked here too (1.1.2), before the held-set key is formed: out of
    # range, (major << 32) | minor aliases another device's key.
    var maj_ok = _samvada_devnum_ok(major);
    var min_ok = _samvada_devnum_ok(minor);
    if (maj_ok == 0) { return -22; }
    if (min_ok == 0) { return -22; }
    # sd_bus_call_method returns 1 on success; the documented contract here
    # is `0 | -err`. The C wrapper normalises too — this is the belt to its
    # braces, and it also covers a PURE_CYRIUS backend (0.5.1, audit MED-4).
    var rc = fncall4(slot, _samvada_bus, _samvada_sess, major, minor);
    _samvada_held_del(_samvada_held_find(major, minor));
    # Once the consumer has given every device back, give session control
    # back too — logind runs session_restore_vt(), so the console and
    # keyboard return immediately rather than staying muted until the
    # process exits. This is the path mabda takes when the logind attempt
    # fails and it falls back to kiosk while leaving samvada initialized
    # (ADR-0004).
    if (_samvada_heldn == 0) { _samvada_drop_control(0); }
    if (rc < 0) { return rc; }
    return 0;
}

# Drain any pending bus messages. Returns the number of events
# processed (>=0) or a negative sd-bus errno on failure. Consumers
# typically call this once per frame / event-loop tick.
public fn samvada_pump_signals() {
    if (_samvada_have_table() == 0) { return -22; }
    if (_samvada_bus == 0)          { return -107; }
    var slot = _samvada_slot(samvada_slot_pump_signals());
    if (slot == 0) { return -38; }
    return fncall1(slot, _samvada_bus);
}

# Close the bus and clear module state. Idempotent — safe to call
# on a partially-initialized samvada (e.g. after samvada_init returned
# an error). Buffers are not freed (bump allocator).
public fn samvada_release() {
    if (_samvada_bus != 0) {
        # Drop session control before closing, so logind restores the VT
        # (session_restore_vt) rather than leaving it in graphics mode until
        # the connection drops. Failure is not fatal and is ignored.
        _samvada_drop_control(1);
        var slot = _samvada_slot(samvada_slot_close_bus());
        if (slot != 0) { fncall1(slot, _samvada_bus); }
        _samvada_bus = 0;
    }
    # Zero the scratch. Closes LOW-2 from the 2026-05-01 review: _samvada_outs
    # held a raw sd_bus* that is DANGLING once close_bus has run, and
    # _samvada_sess held the session path. Neither should survive release
    # (0.5.1, audit LOW-5).
    if (_samvada_outs != 0) {
        store64(_samvada_outs + 0, 0);
        store64(_samvada_outs + 8, 0);
    }
    if (_samvada_sess != 0) {
        var i = 0;
        while (i < _SAMVADA_SESS_BUFLEN) { store64(_samvada_sess + i, 0); i = i + 8; }
    }
    _samvada_control = 0;
    _samvada_heldn = 0;
    _samvada_table = 0;
    return 0;
}

# C-shim entry point. The libsystemd shim's `main()` calls into
# this with the fn-table pointer. We init samvada and return —
# the consumer drives all subsequent calls. Smoke build (no shim)
# never reaches this; `src/main.cyr` keeps its own pure-Cyrius
# entry for `cyrius build`.
public fn samvada_main(table) {
    var r = samvada_init(table);
    return r;
}
