# --- samvada_ffi.cyr ---

# @internal — samvada FFI fn-table layout
# samvada_ffi.cyr — slot offsets and helpers for the C-shim
# function table.
#
# The C side (`deps/samvada_main.c`) builds an 88-byte fn-table in
# FILE-SCOPE STATIC storage, populates each slot with an
# `sd_bus_*`-backed wrapper, then calls `samvada_main(fn_table_ptr)`.
# The Cyrius side reaches into the table via `samvada_ffi_get_slot`
# and dispatches with `fncallN` from `lib/fnptr.cyr`.
#
# Static storage is REQUIRED, not incidental: samvada borrows this
# pointer and re-reads it on every dispatch for the life of the
# process. Before 0.5.1 the table was a stack local in the shim's
# `main()`, justified by a comment claiming `samvada_main()` never
# returns — it does (audit CRIT-2).
#
# Layout (v1) — same shape pattern as mabda's Backend struct.
# Append-after-kind invariant: every future v(N+1) slot lands at
# offset 72 + 8*K. `kind` stays at 64 forever so a v0 caller
# scanning a v(N+1) table never misreads a fnptr as the kind word.
#
# Wire-level:
#   [+0]   sb_open_system_bus(bus_out_ptr)                                    -> 0|err
#   [+8]   sb_get_session_path(bus, pid, out_buf, out_buf_len)                -> 0|err
#   [+16]  sb_take_device(bus, sess_cstr, major, minor, fd_out, active_out)   -> 0|err
#   [+24]  sb_release_device(bus, sess_cstr, major, minor)                    -> 0|err
#   [+32]  sb_pump_signals(bus)                                               -> events|negative_err
#   [+40]  sb_close_bus(bus)                                                  -> 0
#   [+48]  sb_subscribe_pause_resume(bus, sess_cstr, callback, userdata)      -> slot|err
#   [+56]  sb_unsubscribe(slot)                                               -> 0
#   [+64]  kind  (NULL=0, LIBSYSTEMD=1, PURE_CYRIUS=2)
#   [+72]  sb_take_control(bus, sess_cstr)                                    -> 0|err
#   [+80]  sb_release_control(bus, sess_cstr)                                 -> 0|err
#   [+88+] reserved for a future minor (properties, introspection, session bus...)
#
# Slots 72/80 were APPENDED in 0.5.1, after `kind`, exactly as ADR-0002
# requires. They exist because logind rejects `TakeDevice` with
# `org.freedesktop.login1.NotInControl` unless the SAME bus connection has
# already called `TakeControl` — so v0.2.0-0.5.0's take_device could never
# succeed in any environment. See docs/audit/2026-09-09-audit.md CRIT-1.
#
# Every C wrapper takes <=6 args so the table is fncall6-safe on
# both x86_64 SysV and aarch64 (cyrius's 6-arg fncall convention,
# see lib/fnptr.cyr docstring). Helpers that need more state pack
# it into a side struct addressed by pointer.

# Slot offsets — keep these as fns rather than globals so a
# downstream module can include this file in any order without
# tripping the global-init-order silent-zero gotcha.
fn samvada_slot_open_system_bus()        { return 0; }
fn samvada_slot_get_session_path()       { return 8; }
fn samvada_slot_take_device()            { return 16; }
fn samvada_slot_release_device()         { return 24; }
fn samvada_slot_pump_signals()           { return 32; }
fn samvada_slot_close_bus()              { return 40; }
fn samvada_slot_subscribe_pause_resume() { return 48; }
fn samvada_slot_unsubscribe()            { return 56; }
fn samvada_slot_kind()                   { return 64; }
# --- appended in 0.5.1 (after kind, per ADR-0002) ---
fn samvada_slot_take_control()           { return 72; }
fn samvada_slot_release_control()        { return 80; }
fn samvada_ffi_size()                    { return 88; }

# Backend kinds. NULL = mock / unbound table (CPU tests). LIBSYSTEMD
# is the v0.x C-shim. PURE_CYRIUS is the v1.0 retirement target.
fn samvada_backend_kind_null()         { return 0; }
fn samvada_backend_kind_libsystemd()   { return 1; }
fn samvada_backend_kind_pure_cyrius()  { return 2; }

# Allocate a zero-filled fn-table on the heap. Used by Cyrius-side
# consumers (e.g. mock backends in tests). The C shim builds its
# table on the C stack and never calls this.
fn samvada_ffi_alloc() {
    var t = alloc(samvada_ffi_size());
    if (t == 0) { return 0; }
    var i = 0;
    var sz = samvada_ffi_size();
    while (i < sz) {
        store64(t + i, 0);
        i = i + 8;
    }
    return t;
}

# Read the fnptr (or kind word) at `off` from table `t`. Returns
# 0 if `t` is null — caller checks before dispatching.
fn samvada_ffi_get_slot(t, off) {
    if (t == 0) { return 0; }
    return load64(t + off);
}

# Install a fnptr at `off`. Used by mock backends + C shim's Cyrius-
# side bindings (when the table is built by Cyrius rather than C).
fn samvada_ffi_set_slot(t, off, fp) {
    if (t == 0) { return 0; }
    store64(t + off, fp);
    return 0;
}

# Convenience: read kind without exposing the offset constant.
fn samvada_ffi_kind(t) {
    return samvada_ffi_get_slot(t, samvada_slot_kind());
}

# --- dbus_sys.cyr ---

# @internal — native-dbus low-level syscall + SCM_RIGHTS layer
# dbus_sys.cyr — the first module of the native Cyrius dbus backend
# (N1, ADR-0003). It does exactly one thing the C shim currently
# does for us: receive a file descriptor over a unix socket via
# `SCM_RIGHTS` ancillary data.
#
# Why this is first: proposal 0001 rates fd passing the only
# Low-confidence module of the pivot, and the fallback is cheap
# ONLY while nothing is built on top of it. So it is proven before
# a single dbus byte exists.
#
# Not derived from the kernel ABI by hand — diffed against working
# in-language implementations:
#   kybernet/src/lib/notify.cyr:182-235  (receive walk, MSG_CTRUNC + bounds)
#   argonaut/src/notify.cyr:176-207      (receive walk, MSG_DONTWAIT)
#   cyrius-doom/src/platform/wayland/client.cyr:206-228 (send side)
# Every layout constant below was then re-confirmed against glibc
# headers on x86_64 (offsetof/sizeof/CMSG_*), and is pinned by
# tests/samvada.tcyr so a silent ABI drift fails at CPU-test time.
#
# NOT REENTRANT, by construction. `var buf[N]` inside a fn is
# STATIC data in Cyrius, not stack — consecutive calls share and
# clobber it. samvada is single-threaded by design (see
# public-api.md §Threading), so the scratch below is file-scope and
# reused deliberately rather than accidentally.

# ---- struct layouts (LP64; identical on x86_64 and aarch64) ----
# struct iovec  { void *iov_base@0; size_t iov_len@8; }            16 bytes
# struct msghdr { name@0 namelen@8 iov@16 iovlen@24
#                 control@32 controllen@40 flags@48 }              56 bytes
# struct cmsghdr{ size_t cmsg_len@0; int level@8; int type@12; }    16 bytes
#                 followed by data at +16
fn dbus_sys_iovec_size()    { return 16; }
fn dbus_sys_msghdr_size()   { return 56; }
fn dbus_sys_cmsghdr_size()  { return 16; }
fn dbus_sys_cmsg_data_off() { return 16; }

# CMSG_LEN(4) = cmsghdr(16) + 4 = 20  — the value that goes in cmsg_len
# CMSG_SPACE(4) = 16 + align8(4) = 24 — the buffer size to reserve
fn dbus_sys_cmsg_len_1fd()   { return 20; }
fn dbus_sys_cmsg_space_1fd() { return 24; }

# ---- constants ----
fn dbus_sys_af_unix()     { return 1; }
fn dbus_sys_sock_stream() { return 1; }
fn dbus_sys_sol_socket()  { return 1; }
fn dbus_sys_scm_rights()  { return 1; }
fn dbus_sys_msg_ctrunc()  { return 8; }
# MSG_CMSG_CLOEXEC — the received fd arrives with FD_CLOEXEC already
# set, so it cannot leak across an execve. This is the receive-side
# counterpart of the F_DUPFD_CLOEXEC fix in the C shim (0.5.1 MED-3);
# doing it here means the native backend never has the window the
# shim had to close by hand.
fn dbus_sys_msg_cmsg_cloexec() { return 1073741824; }

# MSG_DONTWAIT — per-CALL non-blocking. Deliberately not O_NONBLOCK
# on the socket: that is socket state and would make every
# request/reply read non-blocking too, silently turning a normal
# method call into a busy-wait.
fn dbus_sys_msg_dontwait() { return 64; }

# ---- arch-selected syscall numbers ----
# sendmsg/recvmsg are NOT in the same numeric slot across arches, and
# getting this wrong is silent: on aarch64, 46 is `ftruncate`, so a
# hardcoded x86_64 number does not fail — it truncates a file to a
# garbage length. (cyrius-doom hardcodes `WL_SYS_SENDMSG = 46` with no
# aarch64 branch and carries exactly that latent bug.)
#
# `sys_recvmsg` from the stdlib already resolves SYS_RECVMSG per-arch,
# so it is used directly and this fn exists only to PIN the number the
# tests assert against.
fn dbus_sys_recvmsg_nr() {
    #ifdef CYRIUS_ARCH_AARCH64
    return 212;
    #endif
    return 47;
}

# ---- scratch (file-scope; see the non-reentrancy note above) ----
var _dbus_iov  = 0;   # 16 bytes
var _dbus_mh   = 0;   # 56 bytes
var _dbus_ctrl = 0;   # 24 bytes (CMSG_SPACE(1 fd))
var _dbus_sys_ready = 0;

fn _dbus_sys_init() {
    if (_dbus_sys_ready != 0) { return 0; }
    _dbus_iov = alloc(dbus_sys_iovec_size());
    if (_dbus_iov == 0) { return -12; }
    _dbus_mh = alloc(dbus_sys_msghdr_size());
    if (_dbus_mh == 0) { return -12; }
    _dbus_ctrl = alloc(dbus_sys_cmsg_space_1fd());
    if (_dbus_ctrl == 0) { return -12; }
    _dbus_sys_ready = 1;
    return 0;
}

fn _dbus_zero(p, n) {
    var i = 0;
    while (i < n) { store64(p + i, 0); i = i + 8; }
    return 0;
}

# Extract a single SCM_RIGHTS descriptor from a control buffer.
#
# Split out from dbus_sys_recv_fd deliberately: the syscall half
# cannot be driven through its own error paths from a test (the
# kernel validates ancillary data before we ever see it, so a
# forged cmsg never arrives), while the PARSING half is a pure
# byte transform and every guard in it is reachable with a
# hand-built buffer. This is the same "most of it needs no dbus"
# principle the marshaller milestones rest on — applied here so the
# guards are proven rather than merely present.
#
#   ctrl     — the control buffer recvmsg filled
#   ctrllen  — msghdr.msg_controllen AFTER the call
#   fd_out   — receives the fd, or is left untouched if none
#
#   returns >= 0  an fd was extracted and stored; the value is the
#                  number of EXTRA descriptors that arrived in the
#                  same cmsg and were closed here (normally 0)
#           -2     no usable SCM_RIGHTS cmsg present
fn dbus_sys_parse_scm_rights(ctrl, ctrllen, fd_out) {
    if (ctrl == 0)   { return -2; }
    if (fd_out == 0) { return -2; }
    # Subsumed by the `clen > ctrllen` check below (mutation-tested:
    # removing this alone does not fail the suite), but kept as a
    # cheap early-out that does not depend on the header being
    # readable at all.
    if (ctrllen < dbus_sys_cmsg_len_1fd()) { return -2; }

    var clen = load64(ctrl + 0);
    if (clen < dbus_sys_cmsg_len_1fd()) { return -2; }
    # A cmsg_len larger than the buffer the kernel says it filled
    # would read past the end.
    if (clen > ctrllen) { return -2; }
    var level = load64(ctrl + 8) & 0xFFFFFFFF;
    if (level != dbus_sys_sol_socket()) { return -2; }
    var ctype = load64(ctrl + 12) & 0xFFFFFFFF;
    if (ctype != dbus_sys_scm_rights()) { return -2; }

    # The payload is an int32 fd. Read the low 32 bits and sign-extend
    # the same way the C-shim path does, so a kernel-impossible
    # negative cannot read as a huge positive fd.
    var got = load32(ctrl + dbus_sys_cmsg_data_off());
    var neg = got & 0x80000000;
    if (neg != 0) { got = got - 0x100000000; }
    store64(fd_out, got);

    # A cmsg can carry MORE than one descriptor, and the kernel has
    # already installed every one of them in our table — returning
    # only the first leaks the rest for the process lifetime.
    #
    # This is not hypothetical padding-paranoia: CMSG_SPACE(1 fd) and
    # CMSG_SPACE(2 fds) are BOTH 24 bytes (16 + align8(4) == 16 +
    # align8(8)), so a two-fd message fits a one-fd buffer exactly and
    # arrives WITHOUT MSG_CTRUNC. samvada only ever expects one fd
    # (TakeDevice's reply), so close the surplus rather than hand back
    # a descriptor the caller never asked for.
    var extra = 0;
    var off = dbus_sys_cmsg_data_off() + 4;
    while (off + 4 <= clen) {
        # load32, NOT load64: an fd is a 4-byte field, and the last one
        # ends exactly at `clen`. `load64(ctrl + off)` there reads four
        # bytes PAST the buffer — for a legal 2-fd cmsg, clen is 24, off
        # reaches 20, and load64 would touch bytes 24..27 of a 24-byte
        # allocation. The mask hid it, the bump allocator made it
        # harmless, and neither makes it correct.
        var x = load32(ctrl + off);
        var xneg = x & 0x80000000;
        if (xneg != 0) { x = x - 0x100000000; }
        if (x >= 0) { sys_close(x); }
        extra = extra + 1;
        off = off + 4;
    }
    return extra;
}

# Receive up to `buflen` bytes into `buf`, and a single SCM_RIGHTS fd
# if one accompanies the message.
#
#   returns  >= 0  bytes received; the fd (or -1 if none came) is
#                  stored at `fd_out` as a full 64-bit word
#            <  0  negative errno from recvmsg, or:
#                  -71 (-EPROTO)  ancillary data was TRUNCATED, so a
#                                 descriptor may have been dropped by
#                                 the kernel and silently lost
#
# The caller owns the fd and must close it.
fn dbus_sys_recv_fd(fd, buf, buflen, fd_out) {
    return dbus_sys_recv_fd_flags(fd, buf, buflen, fd_out, 0);
}

# As above, plus caller-supplied flags (MSG_DONTWAIT for the pump
# path). Split out rather than adding a parameter to
# dbus_sys_recv_fd, whose signature is pinned by tests.
fn dbus_sys_recv_fd_flags(fd, buf, buflen, fd_out, extra) {
    if (buf == 0)      { return -22; }
    if (buflen <= 0)   { return -22; }
    if (fd_out == 0)   { return -22; }
    var rc = _dbus_sys_init();
    if (rc < 0) { return rc; }
    store64(fd_out, (0 - 1));

    store64(_dbus_iov + 0, buf);
    store64(_dbus_iov + 8, buflen);

    # Zero the control buffer every call. Belt-and-braces: the
    # ctrllen/cmsg_len/level/type guards below all run BEFORE
    # CMSG_DATA is read, so a stale fd cannot actually surface
    # through them — mutation-tested, removing this zeroing alone
    # does not fail the suite. Kept because it costs two
    # instructions and makes the buffer's state independent of the
    # guard ordering the native marshaller will be extending.
    _dbus_zero(_dbus_ctrl, dbus_sys_cmsg_space_1fd());
    _dbus_zero(_dbus_mh, dbus_sys_msghdr_size());
    store64(_dbus_mh + 16, _dbus_iov);
    store64(_dbus_mh + 24, 1);
    store64(_dbus_mh + 32, _dbus_ctrl);
    store64(_dbus_mh + 40, dbus_sys_cmsg_space_1fd());

    var n = sys_recvmsg(fd, _dbus_mh, dbus_sys_msg_cmsg_cloexec() | extra);
    if (n < 0) { return n; }

    var ctrllen = load64(_dbus_mh + 40);

    # MSG_CTRUNC means the kernel had more ancillary data than our buffer
    # held and dropped the excess. Refuse the message — but CLOSE WHAT
    # ARRIVED FIRST.
    #
    # The descriptors that fit are already installed in our table by the
    # time recvmsg returns, and they are ours whether we wanted them or
    # not. Measured against this exact 24-byte control buffer: sending 3
    # fds sets MSG_CTRUNC *and* installs 2 descriptors. Returning -71
    # without closing them leaked one fd pair per truncated message,
    # unbounded, inside a compositor. (0.8.0; the 0.7.0 version returned
    # before parsing and leaked both.)
    var flags = load32(_dbus_mh + 48);
    var trunc = flags & dbus_sys_msg_ctrunc();
    if (trunc != 0) {
        var scratch = alloc(8);
        store64(scratch, (0 - 1));
        dbus_sys_parse_scm_rights(_dbus_ctrl, ctrllen, scratch);
        var first = load64(scratch);
        if (first >= 0) { sys_close(first); }
        return -71;
    }

    dbus_sys_parse_scm_rights(_dbus_ctrl, ctrllen, fd_out);
    return n;
}

# --- dbus_frame.cyr ---

# @internal — native-dbus message framing
# dbus_frame.cyr — splits a byte stream into whole dbus messages.
#
# A read from the bus is not a message. The N2 corpus shows the very
# first exchange delivering TWO complete messages in one 282-byte
# read (101 + 181, zero residual), so a reader that handles one
# message per read silently drops the second — which in that
# exchange is `NameAcquired`. Conversely a stream socket may split
# anywhere, so a partial tail must survive into the next read.
#
# This module owns THE receive buffer. dbus_auth.cyr borrows it
# through tail/space/commit rather than keeping its own: alloc()
# never frees, and a separate auth buffer would either copy or lose
# the residual left when the server pipelines its SASL reply.
#
# NOT REENTRANT. State is file-scope, matching dbus_sys.cyr and for
# the same reason: `var buf[N]` inside a fn is STATIC in Cyrius, so
# per-call scratch is a fiction. samvada is single-threaded by
# design (public-api.md §Threading).

# ---- header layout, message-relative ----
#   +0  endian byte ('l' = 108 little, 'B' = 66 big)
#   +1  message type (u8)
#   +2  flags (u8)
#   +3  protocol major version (u8)
#   +4  body_len   (u32, in the endianness named at +0)
#   +8  serial     (u32)
#   +12 fields_len (u32)
#   +16 header fields array, `fields_len` bytes
#       body starts at align8(16 + fields_len)
fn dbus_frame_hdr_size()  { return 16; }
fn dbus_frame_off_body()  { return 4; }
fn dbus_frame_off_serial(){ return 8; }
fn dbus_frame_off_flds()  { return 12; }
fn dbus_frame_endian_le() { return 108; }
fn dbus_frame_endian_be() { return 66; }

# The buffer. 8192 is 34x the largest delivery the corpus contains
# (282 bytes) and a page multiple. It is NOT a protocol limit — the
# spec allows 128 MiB — so an over-cap message is DRAINED, not
# treated as fatal (see dbus_frame_next). D-Bus can do that because
# the full length is in the fixed header; a bare length-prefix
# protocol could not.
fn dbus_frame_cap() { return 8192; }

# Pending-fd queue depth. Fixed, because alloc() never frees and a
# growable queue leaks per push. On overflow the arriving fd is
# CLOSED, not dropped — an unbounded fd leak inside a compositor is
# worse than a refused message.
fn dbus_frame_fdq_cap() { return 8; }

# ---- status codes ----
# Deliberately OUTSIDE the errno band. samvada's convention is that
# negatives are sd-bus errnos, and dbus_sys.cyr already spends -22
# and -71. If a protocol fault shared that range, "the bus sent a
# malformed header" would be indistinguishable from "recvmsg
# failed", which is exactly the ambiguity the 0.5.1 audit found
# around -22.
fn dbus_frame_ok()        { return 0; }
fn dbus_frame_need_more() { return -1000; }
fn dbus_frame_eof()       { return -1001; }   # orderly close, nothing pending
fn dbus_frame_truncated() { return -1002; }   # EOF mid-message
fn dbus_frame_badendian() { return -1003; }
fn dbus_frame_badproto()  { return -1004; }
fn dbus_frame_overflow()  { return -1005; }   # fd queue full

# ---- arithmetic ----
fn dbus_frame_align8(n) {
    return (n + 7) & (0 - 8);
}

# Read a u32 header field. load32 ZERO-extends, which is the whole
# reason this fn exists and is the only place load32 appears on the
# header path.
#
# `load64(p + 4)` on the bus's very FIRST reply returns -4294967283,
# because the 0xFFFFFFFF serial occupies the high half of that
# 8-byte load. `total` then goes negative, `avail < total` is false,
# the cursor advances by a negative amount and the framer walks
# backwards forever. Verified on the real fixture.
#
# Note also that dbus_sys.cyr DOES sign-extend, correctly — an
# SCM_RIGHTS payload is a signed int32 fd. Copying that idiom here
# is the trap: a valid serial would read as an error.
fn dbus_frame_u32(p, off) {
    return load32(p + off);
}

# Big-endian reader. No mask needed: load8 zero-extends and
# 255 << 24 = 4278190080 is a positive i64.
fn dbus_frame_u32_be(p, off) {
    var b0 = load8(p + off + 0);
    var b1 = load8(p + off + 1);
    var b2 = load8(p + off + 2);
    var b3 = load8(p + off + 3);
    return (b0 << 24) | (b1 << 16) | (b2 << 8) | b3;
}

# Total on-wire length of the message starting at `p`, given `avail`
# readable bytes there. Returns need_more if fewer than 16 bytes are
# present — the length is genuinely unknowable below that, because
# byte +0 selects how to read the u32 at +12.
#
# Every quantity here is MESSAGE-relative. Evaluating align8 against
# an absolute buffer offset is the bug that made the N2 corpus look
# truncated: for message 2 of the hello reply (off 101, fields 151,
# body 13) it yields 184 instead of 181.
fn dbus_frame_total(p, avail) {
    if (avail < dbus_frame_hdr_size()) { return dbus_frame_need_more(); }
    var e = load8(p + 0);
    var body = 0;
    var flds = 0;
    if (e == dbus_frame_endian_le()) {
        body = dbus_frame_u32(p, dbus_frame_off_body());
        flds = dbus_frame_u32(p, dbus_frame_off_flds());
    }
    if (e == dbus_frame_endian_be()) {
        body = dbus_frame_u32_be(p, dbus_frame_off_body());
        flds = dbus_frame_u32_be(p, dbus_frame_off_flds());
    }
    var known = 0;
    if (e == dbus_frame_endian_le()) { known = 1; }
    if (e == dbus_frame_endian_be()) { known = 1; }
    if (known == 0) { return dbus_frame_badendian(); }
    if (load8(p + 3) != 1) { return dbus_frame_badproto(); }
    return dbus_frame_align8(dbus_frame_hdr_size() + flds) + body;
}

fn dbus_frame_msg_type(p)   { return load8(p + 1); }
fn dbus_frame_msg_flags(p)  { return load8(p + 2); }
fn dbus_frame_msg_serial(p) {
    var e = load8(p + 0);
    if (e == dbus_frame_endian_be()) {
        return dbus_frame_u32_be(p, dbus_frame_off_serial());
    }
    return dbus_frame_u32(p, dbus_frame_off_serial());
}

# ---- state ----
var _dbf_buf   = 0;   # the single receive buffer
var _dbf_off   = 0;   # cursor: first unconsumed byte
var _dbf_have  = 0;   # cursor: one past the last valid byte
var _dbf_skip  = 0;   # bytes still to discard for an over-cap message
var _dbf_eof   = 0;   # peer closed
var _dbf_fdq   = 0;   # pending-fd ring
var _dbf_fdn   = 0;   # fds queued
var _dbf_ready = 0;

fn dbus_frame_init() {
    if (_dbf_ready != 0) {
        _dbf_off = 0; _dbf_have = 0; _dbf_skip = 0; _dbf_eof = 0; _dbf_fdn = 0;
        return 0;
    }
    _dbf_buf = alloc(dbus_frame_cap());
    if (_dbf_buf == 0) { return -12; }
    _dbf_fdq = alloc(dbus_frame_fdq_cap() * 8);
    if (_dbf_fdq == 0) { return -12; }
    _dbf_off = 0; _dbf_have = 0; _dbf_skip = 0; _dbf_eof = 0; _dbf_fdn = 0;
    _dbf_ready = 1;
    return 0;
}

# ---- buffer access, for dbus_auth.cyr and the socket reader ----
fn dbus_frame_tail()  { return _dbf_buf + _dbf_have; }
fn dbus_frame_space() { return dbus_frame_cap() - _dbf_have; }
fn dbus_frame_have()  { return _dbf_have - _dbf_off; }
fn dbus_frame_base()  { return _dbf_buf + _dbf_off; }

fn dbus_frame_commit(n) {
    if (n <= 0) { return 0; }
    _dbf_have = _dbf_have + n;
    return 0;
}

# Consume `n` bytes from the front — used by the SASL reader, which
# leaves the cursor exactly where the binary stream begins.
fn dbus_frame_consume(n) {
    if (n <= 0) { return 0; }
    _dbf_off = _dbf_off + n;
    if (_dbf_off > _dbf_have) { _dbf_off = _dbf_have; }
    return 0;
}

fn dbus_frame_set_eof() { _dbf_eof = 1; return 0; }

# Slide unconsumed bytes to the front. Run only when a header can no
# longer be appended, so compaction is rare rather than per-read.
#
# memcpy with dst < src and a forward loop is what makes this safe;
# lib/string.cyr's memcpy is a forward byte loop today and there is
# no memmove. Stated at the call site because the guarantee is
# undocumented upstream.
fn dbus_frame_compact() {
    if (_dbf_off == 0) { return 0; }
    var live = _dbf_have - _dbf_off;
    if (live > 0) { memcpy(_dbf_buf, _dbf_buf + _dbf_off, live); }
    _dbf_off = 0;
    _dbf_have = live;
    return 0;
}

fn dbus_frame_maybe_compact() {
    var room = dbus_frame_cap() - _dbf_have;
    if (room < dbus_frame_hdr_size()) { return dbus_frame_compact(); }
    return 0;
}

# ---- pending fds ----
fn dbus_frame_push_fd(fd) {
    if (fd < 0) { return 0; }
    if (_dbf_fdn >= dbus_frame_fdq_cap()) {
        sys_close(fd);
        return dbus_frame_overflow();
    }
    store64(_dbf_fdq + _dbf_fdn * 8, fd);
    _dbf_fdn = _dbf_fdn + 1;
    return 0;
}

fn dbus_frame_fd_count() { return _dbf_fdn; }

fn dbus_frame_take_fd() {
    if (_dbf_fdn <= 0) { return (0 - 1); }
    var fd = load64(_dbf_fdq + 0);
    var i = 1;
    while (i < _dbf_fdn) {
        store64(_dbf_fdq + (i - 1) * 8, load64(_dbf_fdq + i * 8));
        i = i + 1;
    }
    _dbf_fdn = _dbf_fdn - 1;
    return fd;
}

# Close every queued descriptor. Must run on any terminal fault, on
# the over-cap drain, and at connection close — a queued fd nobody
# takes is a leak for the process lifetime.
fn dbus_frame_close_fds() {
    var i = 0;
    while (i < _dbf_fdn) {
        var fd = load64(_dbf_fdq + i * 8);
        if (fd >= 0) { sys_close(fd); }
        i = i + 1;
    }
    _dbf_fdn = 0;
    return 0;
}

# ---- the framer ----
# Yield the next complete message.
#
#   returns > 0   its total length; the message starts at
#                 dbus_frame_base() and the caller must call
#                 dbus_frame_advance(len) when done with it
#           need_more   buffer holds a partial message; read again
#           eof         peer closed cleanly with nothing pending
#           truncated   peer closed mid-message
#           badendian / badproto   unrecoverable, stream is lost
fn dbus_frame_next() {
    # Finish discarding an over-cap message first.
    if (_dbf_skip > 0) {
        var avail0 = _dbf_have - _dbf_off;
        var take = _dbf_skip;
        if (take > avail0) { take = avail0; }
        _dbf_off = _dbf_off + take;
        _dbf_skip = _dbf_skip - take;
        if (_dbf_skip > 0) {
            if (_dbf_eof != 0) { return dbus_frame_truncated(); }
            return dbus_frame_need_more();
        }
    }

    var avail = _dbf_have - _dbf_off;
    if (avail == 0) {
        if (_dbf_eof != 0) { return dbus_frame_eof(); }
        return dbus_frame_need_more();
    }
    if (avail < dbus_frame_hdr_size()) {
        if (_dbf_eof != 0) { return dbus_frame_truncated(); }
        return dbus_frame_need_more();
    }

    var p = _dbf_buf + _dbf_off;
    var total = dbus_frame_total(p, avail);
    if (total == dbus_frame_badendian()) { return dbus_frame_badendian(); }
    if (total == dbus_frame_badproto())  { return dbus_frame_badproto(); }

    # Over-cap: the message can never fit, so discard exactly `total`
    # bytes and resynchronise. Every queued fd goes with it — the
    # field array may not even be buffered, so UNIX_FDS is unreadable
    # and conservatism is the only safe rule.
    if (total > dbus_frame_cap()) {
        dbus_frame_close_fds();
        _dbf_skip = total;
        return dbus_frame_next();
    }

    if (avail < total) {
        if (_dbf_eof != 0) { return dbus_frame_truncated(); }
        return dbus_frame_need_more();
    }
    return total;
}

fn dbus_frame_advance(n) {
    if (n <= 0) { return 0; }
    _dbf_off = _dbf_off + n;
    if (_dbf_off > _dbf_have) { _dbf_off = _dbf_have; }
    return 0;
}

# --- dbus_socket.cyr ---

# @internal — native-dbus transport
# dbus_socket.cyr — connect to the bus, and read/write reliably.
#
# Two things here are not obvious and both were measured rather
# than assumed:
#
# 1. THE SEND PATH MUST NOT BE sys_write. Writing to a socket whose
#    peer has gone raises SIGPIPE, whose default disposition kills
#    the process. samvada is a library inside a compositor; killing
#    mabda because logind restarted is not an acceptable failure
#    mode. `sendto(..., MSG_NOSIGNAL, 0, 0)` suppresses it at the
#    call, which is the only mechanism that is neither
#    process-global nor inherited across execve (SIG_IGN is both,
#    and samvada does not own the process's signal policy).
#
# 2. THE STDLIB HAS NO SEND-SIDE SOCKET CALL AT ALL. `sys_recvmsg`
#    and `sys_recvfrom` exist; there is no `sys_sendto`,
#    `sys_sendmsg` or `sys_send`, and no SYS_SENDTO constant on
#    either arch. So the number is pinned here, WITH both arches.
#    Filed upstream — the asymmetry is the defect, not the absence.

# ---- arch-selected syscall numbers ----
# Hardcoding ONE number with no arch branch is the bug class that
# bit four sibling repos (they pin SYS_SENDMSG = 46, which is
# `ftruncate` on aarch64). An #ifdef pin supplying BOTH numbers is
# the house exception, already used in src/dbus_sys.cyr.
fn dbus_socket_sendto_nr() {
    #ifdef CYRIUS_ARCH_AARCH64
    return 206;
    #endif
    return 44;
}

fn dbus_socket_msg_nosignal() { return 16384; }

# ---- sockaddr_un ----
# struct sockaddr_un { u16 sun_family@0; char sun_path[108]@2; }
# sizeof == 110. AF_UNIX == 1.
#
# The two address forms need DIFFERENT addrlen rules, and conflating
# them is the mistake this file exists to prevent:
#
#   filesystem: sun_path holds a NUL-terminated path
#               addrlen = 2 + strlen(path) + 1
#   abstract:   sun_path[0] is a LITERAL NUL, then the name, and
#               there is NO trailing NUL
#               addrlen = 2 + 1 + namelen
#
# Applying the filesystem rule to an abstract name is wrong twice:
# it omits the leading NUL and adds a trailing one, so the kernel
# looks up a filesystem path that does not exist.
fn dbus_socket_sockaddr_un_size() { return 110; }
fn dbus_socket_af_unix()          { return 1; }
fn dbus_socket_sock_stream()      { return 1; }

fn _dbus_sock_zero(p, n) {
    var i = 0;
    while (i < n) { store8(p + i, 0); i = i + 1; }
    return 0;
}

# Build a filesystem-path sockaddr_un at `sa`. Returns addrlen, or
# -22 if the path does not fit (it is REFUSED, never clamped —
# a truncated socket path silently connects somewhere else).
fn dbus_socket_addr_path(sa, path, pathlen) {
    if (sa == 0)      { return -22; }
    if (path == 0)    { return -22; }
    if (pathlen <= 0) { return -22; }
    if (pathlen > 107) { return -22; }        # 108 minus the NUL
    _dbus_sock_zero(sa, dbus_socket_sockaddr_un_size());
    store8(sa + 0, dbus_socket_af_unix());
    store8(sa + 1, 0);
    var i = 0;
    while (i < pathlen) {
        store8(sa + 2 + i, load8(path + i));
        i = i + 1;
    }
    store8(sa + 2 + pathlen, 0);
    return 2 + pathlen + 1;
}

# Build an ABSTRACT-namespace sockaddr_un at `sa`. Returns addrlen.
fn dbus_socket_addr_abstract(sa, name, namelen) {
    if (sa == 0)      { return -22; }
    if (name == 0)    { return -22; }
    if (namelen <= 0) { return -22; }
    if (namelen > 107) { return -22; }
    _dbus_sock_zero(sa, dbus_socket_sockaddr_un_size());
    store8(sa + 0, dbus_socket_af_unix());
    store8(sa + 1, 0);
    store8(sa + 2, 0);                        # the leading NUL
    var i = 0;
    while (i < namelen) {
        store8(sa + 3 + i, load8(name + i));
        i = i + 1;
    }
    return 2 + 1 + namelen;                   # NO trailing NUL
}

# ---- connect ----
# Returns the connected fd, or a negative errno. The socket is
# CLOEXEC: samvada hands DRM master fds to a compositor that spawns
# clients, and the bus connection has no business surviving into
# them.
fn dbus_socket_sock_cloexec() { return 524288; }   # SOCK_CLOEXEC

fn dbus_socket_connect(sa, addrlen) {
    if (sa == 0)      { return -22; }
    if (addrlen <= 0) { return -22; }
    var t = dbus_socket_sock_stream() | dbus_socket_sock_cloexec();
    var fd = sys_socket(dbus_socket_af_unix(), t, 0);
    if (fd < 0) { return fd; }
    var rc = sys_connect(fd, sa, addrlen);
    if (rc < 0) {
        sys_close(fd);
        return rc;
    }
    return fd;
}

# ---- reliable write ----
# A unix STREAM socket may accept fewer bytes than offered, so the
# loop is required: a torn request desynchronises the connection and
# the bus drops it.
#
# Honest caveat, so a future closeout does not "prove" this with a
# test that cannot fail: at samvada's message sizes (48-238 bytes,
# against a default SO_SNDBUF of hundreds of KB) a short write does
# not occur. The loop is correct and permanently unexercised unless
# a test forces SO_SNDBUF small.
#
# EINTR (-4) is retried. It has never been observed here, because
# installing a non-SA_RESTART handler needs an SA_RESTORER trampoline
# the stdlib does not provide — so this branch is handled but not
# claimed to be tested.
fn dbus_socket_write_all(fd, buf, len) {
    if (buf == 0)  { return -22; }
    if (len < 0)   { return -22; }
    var sent = 0;
    while (sent < len) {
        var n = syscall(dbus_socket_sendto_nr(), fd, buf + sent, len - sent,
          dbus_socket_msg_nosignal(), 0, 0);
        if (n < 0) {
            if (n == -4) { continue; }        # EINTR
            return n;
        }
        if (n == 0) { return -32; }           # -EPIPE: no progress possible
        sent = sent + n;
    }
    return sent;
}

# --- dbus_auth.cyr ---

# @internal — native-dbus SASL handshake
# dbus_auth.cyr — the connect-time authentication exchange.
#
# What the reference client actually sends, captured in
# tests/fixtures/dbus/01-sasl-client.bin — ONE pipelined 48-byte
# write, with an EMPTY-CREDENTIAL `DATA` step:
#
#   \0 AUTH EXTERNAL\r\n DATA\r\n NEGOTIATE_UNIX_FD\r\n BEGIN\r\n
#
# This is NOT the `AUTH EXTERNAL <hex(ascii(uid))>` ping-pong that
# docs/architecture/dbus-marshalling.md described until 0.7.1. Both
# forms are legal; only one is what libsystemd emits, and a reader
# built for the other blocks forever on a line that already arrived.
#
# The server answers with THREE lines in ONE read
# (01-sasl-server.bin, 58 bytes here):
#
#   DATA\r\n OK <guid>\r\n AGREE_UNIX_FD\r\n
#
# 58 is DERIVED (6 + 3 + 32 + 2 + 15), not a protocol constant: the
# same handshake yields 43 bytes without NEGOTIATE_UNIX_FD and 52
# via the hex-uid form. Never size a read or a state machine off it.
#
# This module borrows dbus_frame.cyr's buffer through
# tail/space/commit rather than owning one. alloc() never frees, and
# a private buffer would either copy or lose the residual — the
# server is free to pipeline, so binary message bytes can arrive in
# the same read as AGREE_UNIX_FD.

fn dbus_auth_ok()        { return 0; }
fn dbus_auth_need_more() { return -1100; }
fn dbus_auth_rejected()  { return -1101; }
fn dbus_auth_error()     { return -1102; }
fn dbus_auth_no_fds()    { return -1103; }   # server refused NEGOTIATE_UNIX_FD

# The exact 48 bytes, byte for byte from the fixture.
fn dbus_auth_blob_len() { return 48; }

fn dbus_auth_write_blob(p) {
    var s = "\x00AUTH EXTERNAL\r\nDATA\r\nNEGOTIATE_UNIX_FD\r\nBEGIN\r\n";
    # The leading NUL means strlen cannot measure this; the length is
    # pinned and asserted against the fixture instead.
    store8(p + 0, 0);
    var lit = "AUTH EXTERNAL\r\nDATA\r\nNEGOTIATE_UNIX_FD\r\nBEGIN\r\n";
    var n = strlen(lit);
    var i = 0;
    while (i < n) {
        store8(p + 1 + i, load8(lit + i));
        i = i + 1;
    }
    return 1 + n;
}

# Find a CRLF in [p, p+len). Returns the index of the '\r', or -1.
# Line-oriented over a buffer: the three server lines can arrive in
# one read, in three, or split mid-line.
fn dbus_auth_find_crlf(p, len) {
    var i = 0;
    while (i + 1 < len) {
        var c = load8(p + i);
        if (c == 13) {
            if (load8(p + i + 1) == 10) { return i; }
        }
        i = i + 1;
    }
    return (0 - 1);
}

fn _dbus_auth_starts(p, len, lit) {
    var n = strlen(lit);
    if (len < n) { return 0; }
    var i = 0;
    while (i < n) {
        if (load8(p + i) != load8(lit + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Classify one server line (without its CRLF).
#   1 = DATA, 2 = OK, 3 = AGREE_UNIX_FD,
#   4 = REJECTED, 5 = ERROR, 0 = anything else
fn dbus_auth_line_kind(p, len) {
    if (_dbus_auth_starts(p, len, "DATA") != 0)          { return 1; }
    if (_dbus_auth_starts(p, len, "OK ") != 0)           { return 2; }
    if (_dbus_auth_starts(p, len, "AGREE_UNIX_FD") != 0) { return 3; }
    if (_dbus_auth_starts(p, len, "REJECTED") != 0)      { return 4; }
    if (_dbus_auth_starts(p, len, "ERROR") != 0)         { return 5; }
    return 0;
}

# Consume as many complete server lines as the buffer holds, and say
# whether the handshake is done.
#
# Returns ok once AGREE_UNIX_FD has been seen; need_more while lines
# are still outstanding; rejected / error / no_fds on refusal. The
# buffer cursor is left exactly where the BINARY stream begins, so
# the framer can take over with no copy.
var _dbus_auth_saw_ok    = 0;
var _dbus_auth_saw_agree = 0;

fn dbus_auth_reset() {
    _dbus_auth_saw_ok = 0;
    _dbus_auth_saw_agree = 0;
    return 0;
}

fn dbus_auth_drain_lines() {
    while (1 == 1) {
        var p = dbus_frame_base();
        var have = dbus_frame_have();
        if (have <= 0) { return dbus_auth_need_more(); }
        var at = dbus_auth_find_crlf(p, have);
        if (at < 0) { return dbus_auth_need_more(); }

        var kind = dbus_auth_line_kind(p, at);
        dbus_frame_consume(at + 2);

        if (kind == 4) { return dbus_auth_rejected(); }
        if (kind == 5) { return dbus_auth_error(); }
        if (kind == 2) { _dbus_auth_saw_ok = 1; }
        if (kind == 3) {
            _dbus_auth_saw_agree = 1;
            return dbus_auth_ok();
        }
        # kind 1 (DATA) and 0 (unknown-but-not-fatal) simply advance.
    }
    return dbus_auth_need_more();
}

# --- dbus_marshal.cyr ---

# @internal — native-dbus message encoder
# dbus_marshal.cyr — builds a dbus message into a buffer.
#
# Scope is the fence in ADR-0003: the types samvada's frozen API
# actually exercises — `u`, `s`, `o`, `g`, `b`, and `h` as a body
# index. Not `y n q i x t d a (...) v`.
#
# ALIGNMENT IS RELATIVE TO THE START OF THE MESSAGE. Every message
# here begins at offset 0 of its own buffer, so buffer offset and
# message offset coincide — which is a convenience, not a licence.
# The moment that stops being true (a second message appended into
# the same buffer) every align call must take the message base. The
# N2 decoder shipped that bug and it cost a false "truncated" claim.
#
# Layout, from tests/fixtures/dbus/02-hello-call.bin:
#   +0  endian 'l'      +1 type      +2 flags     +3 proto=1
#   +4  body_len(u32)   +8 serial    +12 fields_len(u32)
#   +16 header fields — each a (yv) struct, 8-ALIGNED:
#          code(u8) siglen(u8) sig NUL   then the value at ITS
#          own natural alignment (4 for u/s/o, 1 for g)
#   fields_len EXCLUDES the trailing pad; the body starts at
#   align8(16 + fields_len).

fn dbus_marshal_cap() { return 4096; }

fn dbus_marshal_type_call()   { return 1; }
fn dbus_marshal_type_return() { return 2; }
fn dbus_marshal_type_error()  { return 3; }
fn dbus_marshal_type_signal() { return 4; }

# Header field codes.
fn dbus_marshal_f_path()      { return 1; }
fn dbus_marshal_f_interface() { return 2; }
fn dbus_marshal_f_member()    { return 3; }
fn dbus_marshal_f_errname()   { return 4; }
fn dbus_marshal_f_replyser()  { return 5; }
fn dbus_marshal_f_dest()      { return 6; }
fn dbus_marshal_f_sender()    { return 7; }
fn dbus_marshal_f_signature() { return 8; }
fn dbus_marshal_f_unixfds()   { return 9; }

var _dbm_buf   = 0;
var _dbm_at    = 0;   # write cursor
var _dbm_fend  = 0;   # where the header-fields array ended
var _dbm_ready = 0;

fn dbus_marshal_align(n, a) {
    return (n + a - 1) & (0 - a);
}

fn _dbm_pad_to(a) {
    var want = dbus_marshal_align(_dbm_at, a);
    while (_dbm_at < want) {
        store8(_dbm_buf + _dbm_at, 0);
        _dbm_at = _dbm_at + 1;
    }
    return 0;
}

fn _dbm_u8(v) {
    store8(_dbm_buf + _dbm_at, v & 0xFF);
    _dbm_at = _dbm_at + 1;
    return 0;
}

# Little-endian u32. samvada always emits 'l': both target arches
# are little-endian, and emitting native order is what every dbus
# implementation does.
fn _dbm_u32(v) {
    store8(_dbm_buf + _dbm_at + 0, v & 0xFF);
    store8(_dbm_buf + _dbm_at + 1, (v >> 8) & 0xFF);
    store8(_dbm_buf + _dbm_at + 2, (v >> 16) & 0xFF);
    store8(_dbm_buf + _dbm_at + 3, (v >> 24) & 0xFF);
    _dbm_at = _dbm_at + 4;
    return 0;
}

fn _dbm_bytes(p, n) {
    var i = 0;
    while (i < n) {
        store8(_dbm_buf + _dbm_at + i, load8(p + i));
        i = i + 1;
    }
    _dbm_at = _dbm_at + n;
    return 0;
}

# Start a message. `flags` is 0 for a normal call — the captured
# Hello uses 0x00, and replies use 0x01 (NO_REPLY_EXPECTED).
fn dbus_marshal_begin(mtype, flags, serial) {
    if (_dbm_ready == 0) {
        _dbm_buf = alloc(dbus_marshal_cap());
        if (_dbm_buf == 0) { return -12; }
        _dbm_ready = 1;
    }
    _dbm_at = 0;
    _dbm_u8(108);              # 'l'
    _dbm_u8(mtype);
    _dbm_u8(flags);
    _dbm_u8(1);                # protocol version
    _dbm_u32(0);               # body_len, backfilled
    _dbm_u32(serial);
    _dbm_u32(0);               # fields_len, backfilled
    _dbm_fend = 0;
    return 0;
}

# A (yv) header field carrying a string-shaped value: `s` or `o`.
fn dbus_marshal_field_str(code, sigch, str, len) {
    _dbm_pad_to(8);
    _dbm_u8(code);
    _dbm_u8(1);                # signature length
    _dbm_u8(sigch);
    _dbm_u8(0);                # signature NUL
    _dbm_pad_to(4);
    _dbm_u32(len);
    _dbm_bytes(str, len);
    _dbm_u8(0);                # string NUL, not counted in len
    return 0;
}

fn dbus_marshal_field_u32(code, val) {
    _dbm_pad_to(8);
    _dbm_u8(code);
    _dbm_u8(1);
    _dbm_u8(117);              # 'u'
    _dbm_u8(0);
    _dbm_pad_to(4);
    _dbm_u32(val);
    return 0;
}

# A signature-valued field (code 8). `g` is length-prefixed by ONE
# byte and needs no alignment — the trap is treating it like `s`.
fn dbus_marshal_field_sig(code, sig, len) {
    _dbm_pad_to(8);
    _dbm_u8(code);
    _dbm_u8(1);
    _dbm_u8(103);              # 'g'
    _dbm_u8(0);
    _dbm_u8(len);
    _dbm_bytes(sig, len);
    _dbm_u8(0);
    return 0;
}

# Close the fields array. fields_len EXCLUDES the pad that follows,
# so it is recorded before padding to the body's 8-alignment.
fn dbus_marshal_end_fields() {
    _dbm_fend = _dbm_at;
    var flen = _dbm_at - 16;
    store8(_dbm_buf + 12, flen & 0xFF);
    store8(_dbm_buf + 13, (flen >> 8) & 0xFF);
    store8(_dbm_buf + 14, (flen >> 16) & 0xFF);
    store8(_dbm_buf + 15, (flen >> 24) & 0xFF);
    _dbm_pad_to(8);
    return 0;
}

# ---- body ----
fn dbus_marshal_body_u32(v) {
    _dbm_pad_to(4);
    _dbm_u32(v);
    return 0;
}

# `b` is a uint32 on the wire, strictly 0 or 1 — one byte
# semantically, four bytes physically.
fn dbus_marshal_body_bool(v) {
    var b = 0;
    if (v != 0) { b = 1; }
    _dbm_pad_to(4);
    _dbm_u32(b);
    return 0;
}

fn dbus_marshal_body_str(str, len) {
    _dbm_pad_to(4);
    _dbm_u32(len);
    _dbm_bytes(str, len);
    _dbm_u8(0);
    return 0;
}

# Finish: backfill body_len and return the total on-wire length.
fn dbus_marshal_finish() {
    var body_start = dbus_marshal_align(_dbm_fend, 8);
    var blen = _dbm_at - body_start;
    if (blen < 0) { blen = 0; }
    store8(_dbm_buf + 4, blen & 0xFF);
    store8(_dbm_buf + 5, (blen >> 8) & 0xFF);
    store8(_dbm_buf + 6, (blen >> 16) & 0xFF);
    store8(_dbm_buf + 7, (blen >> 24) & 0xFF);
    return _dbm_at;
}

fn dbus_marshal_buf() { return _dbm_buf; }
fn dbus_marshal_len() { return _dbm_at; }

# --- dbus_unmarshal.cyr ---

# @internal — native-dbus message decoder
# dbus_unmarshal.cyr — reads header fields and body values out of a
# framed message.
#
# Operates on a message the framer has already declared COMPLETE, so
# it never has to deal with a partial tail — that separation is why
# neither module needs the other's edge cases.
#
# Two rules govern everything here, and both were paid for:
#
# 1. **Alignment is relative to the START OF THE MESSAGE.** Every
#    offset below is message-relative and `p` is the message base.
#    The N2 decoder aligned against the buffer origin, which works
#    for the first message in a read and silently mis-reads the
#    second.
#
# 2. **Header u32s are read with load32, which zero-extends.**
#    `load64` swallows the neighbouring field: on the bus's very
#    first reply, `load64(p + 4)` returns -4294967283 because the
#    0xFFFFFFFF serial sits in the high half. Note this is the
#    OPPOSITE of dbus_sys.cyr, which sign-extends correctly because
#    an SCM_RIGHTS payload really is a signed int32 fd.
#
# Field ORDER is never assumed. The corpus shows [1,3,2,6] on a
# call, [5,7,6,8] on its reply and [5,6,8,9,7] on an fd-bearing
# reply — it is an implementation choice, so fields are always
# located by scanning for their code.

# ---- message bounds ----
# The 2026-09-09 pre-1.0 audit found this module trusting three
# separate wire-supplied lengths without checking any of them
# against the bytes actually present:
#
#   * a string field claiming length 0xFFFFFFF0 had that length
#     handed straight back to the caller;
#   * `find_field` walked to `16 + fields_len` even when fields_len
#     exceeded the whole message;
#   * the body cursor set its end from `body_len` alone.
#
# None was reachable through samvada's own call paths, because the
# framer only ever yields a message once `avail >= total` — so the
# header lengths are already consistent with the bytes present. But
# "unreachable because the caller happens to validate first" is the
# exact shape of CRIT-1 and CRIT-2, and this module is exported in
# the consumer bundle. So the limit is now explicit and enforced
# here rather than assumed of the caller.
var _dbu_limit = 0;      # total on-wire length of the current message

# Declare the message's true extent. Every caller that has a framed
# message knows it: dbus_frame_next() returns exactly this number.
fn dbus_unmarshal_set_limit(total) {
    _dbu_limit = total;
    return 0;
}

fn dbus_unmarshal_limit() { return _dbu_limit; }

fn dbus_unmarshal_ok()       { return 0; }
fn dbus_unmarshal_notfound() { return -1200; }
fn dbus_unmarshal_malformed(){ return -1201; }

fn dbus_unmarshal_align(n, a) {
    return (n + a - 1) & (0 - a);
}

fn dbus_unmarshal_u32(p, off) {
    return load32(p + off);
}

fn dbus_unmarshal_body_len(p)   { return dbus_unmarshal_u32(p, 4); }
fn dbus_unmarshal_serial(p)     { return dbus_unmarshal_u32(p, 8); }
fn dbus_unmarshal_fields_len(p) { return dbus_unmarshal_u32(p, 12); }
fn dbus_unmarshal_type(p)       { return load8(p + 1); }
fn dbus_unmarshal_flags(p)      { return load8(p + 2); }

fn dbus_unmarshal_body_off(p) {
    return dbus_unmarshal_align(16 + dbus_unmarshal_fields_len(p), 8);
}

# Locate a header field by code. Returns the message-relative offset
# of its VALUE, or notfound. `sig_out` receives the signature's
# first byte so the caller can tell `s` from `o` from `u` from `g`.
#
# Each field is a (yv) struct: 8-aligned, then code(u8) siglen(u8)
# sig NUL, then the value at its own natural alignment.
fn dbus_unmarshal_find_field(p, code, sig_out) {
    var flen = dbus_unmarshal_fields_len(p);
    var end = 16 + flen;
    # Refuse a field array that claims to extend past the message.
    if (_dbu_limit > 0) {
        if (end > _dbu_limit) { return dbus_unmarshal_malformed(); }
    }
    var at = 16;
    while (at < end) {
        at = dbus_unmarshal_align(at, 8);
        if (at >= end) { return dbus_unmarshal_notfound(); }
        var c = load8(p + at);
        var siglen = load8(p + at + 1);
        if (siglen == 0) { return dbus_unmarshal_malformed(); }
        var sig0 = load8(p + at + 2);
        var vo = at + 2 + siglen + 1;

        var nxt = 0;
        if (sig0 == 115) { nxt = 1; }        # 's'
        if (sig0 == 111) { nxt = 1; }        # 'o'
        if (nxt == 1) {
            vo = dbus_unmarshal_align(vo, 4);
            if (vo + 4 > end) { return dbus_unmarshal_malformed(); }
            var n = dbus_unmarshal_u32(p, vo);
            nxt = vo + 4 + n + 1;
            # A length that runs past the field array is malformed,
            # not a value to hand back.
            if (nxt > end) { return dbus_unmarshal_malformed(); }
        }
        if (sig0 == 117) {                   # 'u'
            vo = dbus_unmarshal_align(vo, 4);
            nxt = vo + 4;
            if (nxt > end) { return dbus_unmarshal_malformed(); }
        }
        if (sig0 == 103) {                   # 'g'
            if (vo + 1 > end) { return dbus_unmarshal_malformed(); }
            var gn = load8(p + vo);
            nxt = vo + 1 + gn + 1;
            if (nxt > end) { return dbus_unmarshal_malformed(); }
        }
        if (nxt <= at) { return dbus_unmarshal_malformed(); }

        if (c == code) {
            if (sig_out != 0) { store64(sig_out, sig0); }
            return vo;
        }
        at = nxt;
    }
    return dbus_unmarshal_notfound();
}

# Read a string-shaped value (`s` or `o`) at a message-relative
# offset. Returns its length and stores a pointer to the first byte.
# The bytes are NOT copied — they live in the framer's buffer and
# stay valid until dbus_frame_advance moves past this message.
fn dbus_unmarshal_str_at(p, off, ptr_out) {
    if (off < 0) { return dbus_unmarshal_malformed(); }
    if (_dbu_limit > 0) {
        if (off + 4 > _dbu_limit) { return dbus_unmarshal_malformed(); }
    }
    var n = dbus_unmarshal_u32(p, off);
    # The length must fit inside the message. Returning it unchecked
    # invites the caller to copy gigabytes out of bounds.
    if (_dbu_limit > 0) {
        if (off + 4 + n + 1 > _dbu_limit) { return dbus_unmarshal_malformed(); }
    }
    if (ptr_out != 0) { store64(ptr_out, p + off + 4); }
    return n;
}

# Read a signature value (`g`) — ONE length byte, not four. Treating
# it like `s` reads the signature text as a length.
fn dbus_unmarshal_sig_at(p, off, ptr_out) {
    if (off < 0) { return dbus_unmarshal_malformed(); }
    if (_dbu_limit > 0) {
        if (off + 1 > _dbu_limit) { return dbus_unmarshal_malformed(); }
    }
    var n = load8(p + off);
    if (_dbu_limit > 0) {
        if (off + 1 + n + 1 > _dbu_limit) { return dbus_unmarshal_malformed(); }
    }
    if (ptr_out != 0) { store64(ptr_out, p + off + 1); }
    return n;
}

# ---- body ----
# A cursor, because body values are positional and each is aligned
# relative to the message start.
var _dbu_p   = 0;
var _dbu_at  = 0;
var _dbu_end = 0;

fn dbus_unmarshal_body_begin(p) {
    _dbu_p = p;
    _dbu_at = dbus_unmarshal_body_off(p);
    _dbu_end = _dbu_at + dbus_unmarshal_body_len(p);
    # Clamp to the message's real extent. A header claiming a body
    # far larger than the bytes present would otherwise let the
    # cursor read past the end, one aligned value at a time.
    if (_dbu_limit > 0) {
        if (_dbu_end > _dbu_limit) { _dbu_end = _dbu_limit; }
        if (_dbu_at > _dbu_limit)  { _dbu_at = _dbu_limit; }
    }
    return 0;
}

fn dbus_unmarshal_body_remaining() { return _dbu_end - _dbu_at; }

fn dbus_unmarshal_next_u32() {
    _dbu_at = dbus_unmarshal_align(_dbu_at, 4);
    if (_dbu_at + 4 > _dbu_end) { return dbus_unmarshal_malformed(); }
    var v = dbus_unmarshal_u32(_dbu_p, _dbu_at);
    _dbu_at = _dbu_at + 4;
    return v;
}

# `b` is a u32 on the wire; anything but 0 or 1 is malformed.
fn dbus_unmarshal_next_bool() {
    var v = dbus_unmarshal_next_u32();
    if (v == dbus_unmarshal_malformed()) { return v; }
    if (v > 1) { return dbus_unmarshal_malformed(); }
    return v;
}

fn dbus_unmarshal_next_str(ptr_out) {
    _dbu_at = dbus_unmarshal_align(_dbu_at, 4);
    if (_dbu_at + 4 > _dbu_end) { return dbus_unmarshal_malformed(); }
    var n = dbus_unmarshal_u32(_dbu_p, _dbu_at);
    if (_dbu_at + 4 + n + 1 > _dbu_end) { return dbus_unmarshal_malformed(); }
    if (ptr_out != 0) { store64(ptr_out, _dbu_p + _dbu_at + 4); }
    _dbu_at = _dbu_at + 4 + n + 1;
    return n;
}

# `h` is a 4-byte INDEX into the SCM_RIGHTS array, not an fd. The
# descriptor itself arrives out of band and is queued by
# dbus_frame; this returns the index to look up there.
fn dbus_unmarshal_next_fd_index() {
    return dbus_unmarshal_next_u32();
}

# --- dbus_session.cyr ---

# @internal — native-dbus logind session layer
# dbus_session.cyr — the six logind calls, natively.
#
# This is the module that has to match the FROZEN FFI SHAPES, and
# that constraint is not cosmetic. src/samvada.cyr dispatches with
# exactly:
#
#   fncall1(bus_slot, bus_out)
#   fncall4(sp_slot,  bus, pid, buf, len)
#   fncall2(tc_slot,  bus, sess)
#   fncall6(td_slot,  bus, sess, major, minor, fd_out, active_out)
#   fncall4(rd_slot,  bus, sess, major, minor)
#   fncall1(pump_slot, bus)
#   fncall1(close_slot, bus)
#
# So every native fn below is written to the C shim's ABI, INCLUDING
# the vestigial leading `bus` argument and the C-style out-pointer
# pairs — shapes that would never be chosen for a Cyrius-native
# design. Getting one wrong is a silent crash through fncallN, not a
# compile error, which is why the arities are pinned by tests.
#
# In native mode the "bus handle" is simply the connected socket fd.
#
# SESSION SELECTION — the open question this milestone had to
# settle, and the answer is DOCUMENT, not validate. GetSessionByPID
# returns the CALLER's session, which is not necessarily seated: on
# the development host it returns a `Seat=""` session while seat0
# belongs to the display manager, so TakeDevice cannot get DRM
# master there no matter what. Validating the session's `Seat`
# property would require org.freedesktop.DBus.Properties, which
# ADR-0003's scope fence defers past 1.0 — and widening the fence to
# produce a better error message is a bad trade. samvada therefore
# takes the caller's own session and surfaces logind's error
# verbatim. See public-api.md.
#
# SESSION PATH ESCAPING — logind returns paths like
# `/org/freedesktop/login1/session/_32`, where `_32` is the
# hex-escaped ASCII of '2'. samvada passes the path through
# OPAQUELY: it is only ever echoed back as a method target, never
# parsed or compared, so no unescaping is needed. Anything that
# starts comparing session ids must implement it first.

fn dbus_session_max_serial() { return 4294967295; }

var _dbs_serial = 0;
var _dbs_last_err = 0;      # last ERROR_NAME mapped errno

# Pure, so the wrap is reachable from a test. Driving
# next_serial() to the u32 ceiling would take four billion calls;
# this makes the one branch that matters a one-line assertion.
fn dbus_session_wrap_serial(n) {
    if (n > dbus_session_max_serial()) { return 1; }
    if (n == 0) { return 1; }
    return n;
}

fn dbus_session_next_serial() {
    # Wrap within u32 and never yield 0, which the spec reserves.
    _dbs_serial = dbus_session_wrap_serial(_dbs_serial + 1);
    return _dbs_serial;
}

fn dbus_session_reset() {
    _dbs_serial = 0;
    _dbs_last_err = 0;
    return 0;
}

fn dbus_session_last_error() { return _dbs_last_err; }

# ---- error mapping ----
# The frozen API promises "sd-bus errno pass-through", so the native
# backend has to reproduce libsystemd's dbus-name -> errno mapping
# or consumers branching on magnitudes break. This is the
# error-parity contract N6 verifies; the names here are the ones
# samvada's own calls can actually produce.
fn _dbs_name_is(p, n, lit) {
    if (n != strlen(lit)) { return 0; }
    var i = 0;
    while (i < n) {
        if (load8(p + i) != load8(lit + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn dbus_session_map_error(p, n) {
    if (_dbs_name_is(p, n, "org.freedesktop.DBus.Error.AccessDenied") != 0) { return -13; }
    if (_dbs_name_is(p, n, "org.freedesktop.login1.NotInControl") != 0) { return -22; }
    if (_dbs_name_is(p, n, "org.freedesktop.login1.DeviceNotTaken") != 0) { return -22; }
    if (_dbs_name_is(p, n, "org.freedesktop.DBus.Error.InvalidArgs") != 0) { return -22; }
    if (_dbs_name_is(p, n, "org.freedesktop.DBus.Error.NoSuchDevice") != 0) { return -19; }
    if (_dbs_name_is(p, n, "org.freedesktop.DBus.Error.UnixProcessIdUnknown") != 0) { return -3; }
    if (_dbs_name_is(p, n, "org.freedesktop.DBus.Error.ServiceUnknown") != 0) { return -2; }
    if (_dbs_name_is(p, n, "System.Error.EBUSY") != 0) { return -16; }
    return -5;                                   # -EIO for anything unmapped
}

# ---- the call/reply cycle ----
# Send whatever the marshaller has built, then read until the reply
# whose REPLY_SERIAL matches. Unsolicited traffic is DISCARDED, not
# treated as an error: the bus emits NameAcquired on the connect
# path before any match rule exists, and a reader that treats the
# first message as its answer gets the signal instead.
#
# Returns 0 on a METHOD_RETURN (whose message is left addressable
# via dbus_frame_base()), or a negative errno on an ERROR reply or
# transport failure.
fn dbus_session_call(fd, serial) {
    var total = dbus_marshal_len();
    var w = dbus_socket_write_all(fd, dbus_marshal_buf(), total);
    if (w < 0) { return w; }

    var spins = 0;
    while (spins < 64) {
        var r = dbus_frame_next();
        while (r > 0) {
            var p = dbus_frame_base();
            # dbus_frame_next() returned the message's exact on-wire
            # length; handing it to the unmarshaller is what makes its
            # bounds checks real (pre-1.0 audit, AUDIT-1..3).
            dbus_unmarshal_set_limit(r);
            var ty = dbus_unmarshal_type(p);
            var sig = alloc(8);
            var rs_off = dbus_unmarshal_find_field(p, dbus_marshal_f_replyser(), sig);
            var mine = 0;
            if (rs_off > 0) {
                if (dbus_unmarshal_u32(p, rs_off) == serial) { mine = 1; }
            }
            if (mine == 1) {
                if (ty == dbus_marshal_type_return()) { return 0; }
                if (ty == dbus_marshal_type_error()) {
                    var eo = dbus_unmarshal_find_field(p, dbus_marshal_f_errname(), sig);
                    var rc = -5;
                    if (eo > 0) {
                        var ptr = alloc(8);
                        var n = dbus_unmarshal_str_at(p, eo, ptr);
                        rc = dbus_session_map_error(load64(ptr), n);
                    }
                    _dbs_last_err = rc;
                    dbus_frame_advance(r);
                    return rc;
                }
            }
            # Not ours — a signal, or a reply to something else.
            dbus_frame_advance(r);
            r = dbus_frame_next();
        }
        if (r == dbus_frame_eof())       { return -107; }
        if (r == dbus_frame_truncated()) { return -71; }
        if (r == dbus_frame_badendian()) { return -71; }
        if (r == dbus_frame_badproto())  { return -71; }

        dbus_frame_maybe_compact();
        var got = sys_read(fd, dbus_frame_tail(), dbus_frame_space());
        if (got == 0) { dbus_frame_set_eof(); }
        if (got < 0)  { return got; }
        if (got > 0)  { dbus_frame_commit(got); }
        spins = spins + 1;
    }
    return -110;                                  # -ETIMEDOUT
}

fn _dbs_put(p, s) {
    var n = strlen(s);
    var i = 0;
    while (i < n) { store8(p + i, load8(s + i)); i = i + 1; }
    return n;
}

# Build a logind method call. `path`/`plen` name the object; the
# interface is chosen by `on_mgr`.
fn dbus_session_begin_call(path, plen, member, mlen, on_mgr, serial) {
    var t = alloc(128);
    dbus_marshal_begin(dbus_marshal_type_call(), 0, serial);
    dbus_marshal_field_str(dbus_marshal_f_path(), 111, path, plen);
    dbus_marshal_field_str(dbus_marshal_f_member(), 115, member, mlen);
    var n = 0;
    if (on_mgr != 0) { n = _dbs_put(t, "org.freedesktop.login1.Manager"); }
    if (on_mgr == 0) { n = _dbs_put(t, "org.freedesktop.login1.Session"); }
    dbus_marshal_field_str(dbus_marshal_f_interface(), 115, t, n);
    n = _dbs_put(t, "org.freedesktop.login1");
    dbus_marshal_field_str(dbus_marshal_f_dest(), 115, t, n);
    return 0;
}

# ================= FFI-shaped native backend =================
# Every fn below matches a frozen fncallN shape exactly. The
# `bus` argument is the connected socket fd.

# fncall1(slot, bus_out) -> 0 | -err
fn dbus_native_open_system_bus(bus_out) {
    dbus_frame_init();
    dbus_auth_reset();
    dbus_session_reset();

    var sa = alloc(dbus_socket_sockaddr_un_size());
    var t = alloc(64);
    var n = _dbs_put(t, "/run/dbus/system_bus_socket");
    var alen = dbus_socket_addr_path(sa, t, n);
    if (alen < 0) { return alen; }
    var fd = dbus_socket_connect(sa, alen);
    if (fd < 0) { return fd; }

    var blob = alloc(64);
    var bn = dbus_auth_write_blob(blob);
    var w = dbus_socket_write_all(fd, blob, bn);
    if (w < 0) { sys_close(fd); return w; }

    var st = dbus_auth_need_more();
    var spins = 0;
    while (spins < 32) {
        var got = sys_read(fd, dbus_frame_tail(), dbus_frame_space());
        if (got <= 0) { spins = 99; }
        if (got > 0) {
            dbus_frame_commit(got);
            st = dbus_auth_drain_lines();
            if (st == dbus_auth_ok()) { spins = 99; }
            if (st < 0) {
                if (st != dbus_auth_need_more()) { spins = 99; }
            }
        }
        spins = spins + 1;
    }
    if (st != dbus_auth_ok()) { sys_close(fd); return -13; }

    # Hello, so the bus assigns a unique name. Without it every
    # subsequent call is refused.
    var serial = dbus_session_next_serial();
    var pn = _dbs_put(t, "/org/freedesktop/DBus");
    dbus_marshal_begin(dbus_marshal_type_call(), 0, serial);
    dbus_marshal_field_str(dbus_marshal_f_path(), 111, t, pn);
    var mn = _dbs_put(t, "Hello");
    dbus_marshal_field_str(dbus_marshal_f_member(), 115, t, mn);
    var inn = _dbs_put(t, "org.freedesktop.DBus");
    dbus_marshal_field_str(dbus_marshal_f_interface(), 115, t, inn);
    var dn = _dbs_put(t, "org.freedesktop.DBus");
    dbus_marshal_field_str(dbus_marshal_f_dest(), 115, t, dn);
    dbus_marshal_end_fields();
    dbus_marshal_finish();
    var rc = dbus_session_call(fd, serial);
    if (rc < 0) { sys_close(fd); return rc; }
    dbus_frame_advance(dbus_frame_next());

    store64(bus_out, fd);
    return 0;
}

# fncall4(slot, bus, pid, out_buf, out_buf_len) -> 0 | -err
fn dbus_native_get_session_path(bus, pid, out_buf, out_len) {
    if (out_buf == 0)  { return -22; }
    if (out_len <= 0)  { return -22; }
    var t = alloc(128);
    var serial = dbus_session_next_serial();
    var pn = _dbs_put(t, "/org/freedesktop/login1");
    var m = alloc(64);
    var mn = _dbs_put(m, "GetSessionByPID");
    dbus_session_begin_call(t, pn, m, mn, 1, serial);
    var sg = alloc(8);
    var sn = _dbs_put(sg, "u");
    dbus_marshal_field_sig(dbus_marshal_f_signature(), sg, sn);
    dbus_marshal_end_fields();
    dbus_marshal_body_u32(pid);
    dbus_marshal_finish();

    var rc = dbus_session_call(bus, serial);
    if (rc < 0) { return rc; }
    var p = dbus_frame_base();
    dbus_unmarshal_set_limit(dbus_frame_next());
    dbus_unmarshal_body_begin(p);
    var ptr = alloc(8);
    var n = dbus_unmarshal_next_str(ptr);
    if (n < 0) { dbus_frame_advance(dbus_frame_next()); return -71; }
    if (n + 1 > out_len) {
        dbus_frame_advance(dbus_frame_next());
        return -105;                              # -ENOBUFS
    }
    var src = load64(ptr);
    var i = 0;
    while (i < n) { store8(out_buf + i, load8(src + i)); i = i + 1; }
    store8(out_buf + n, 0);
    dbus_frame_advance(dbus_frame_next());
    return 0;
}

# fncall2(slot, bus, sess_cstr) -> 0 | -err
fn dbus_native_take_control(bus, sess) {
    var t = alloc(64);
    var mn = _dbs_put(t, "TakeControl");
    var serial = dbus_session_next_serial();
    dbus_session_begin_call(sess, strlen(sess), t, mn, 0, serial);
    var sg = alloc(8);
    var sn = _dbs_put(sg, "b");
    dbus_marshal_field_sig(dbus_marshal_f_signature(), sg, sn);
    dbus_marshal_end_fields();
    dbus_marshal_body_bool(0);                    # force = false
    dbus_marshal_finish();
    var rc = dbus_session_call(bus, serial);
    if (rc == 0) { dbus_frame_advance(dbus_frame_next()); }
    return rc;
}

# fncall2(slot, bus, sess_cstr) -> 0 | -err
fn dbus_native_release_control(bus, sess) {
    var t = alloc(64);
    var mn = _dbs_put(t, "ReleaseControl");
    var serial = dbus_session_next_serial();
    dbus_session_begin_call(sess, strlen(sess), t, mn, 0, serial);
    dbus_marshal_end_fields();                    # empty body: NO signature field
    dbus_marshal_finish();
    var rc = dbus_session_call(bus, serial);
    if (rc == 0) { dbus_frame_advance(dbus_frame_next()); }
    return rc;
}

# fncall6(slot, bus, sess_cstr, major, minor, fd_out, active_out) -> 0 | -err
fn dbus_native_take_device(bus, sess, major, minor, fd_out, active_out) {
    if (major < 0) { return -22; }
    if (minor < 0) { return -22; }
    var t = alloc(64);
    var mn = _dbs_put(t, "TakeDevice");
    var serial = dbus_session_next_serial();
    dbus_session_begin_call(sess, strlen(sess), t, mn, 0, serial);
    var sg = alloc(8);
    var sn = _dbs_put(sg, "uu");
    dbus_marshal_field_sig(dbus_marshal_f_signature(), sg, sn);
    dbus_marshal_end_fields();
    dbus_marshal_body_u32(major);
    dbus_marshal_body_u32(minor);
    dbus_marshal_finish();

    var rc = dbus_session_call(bus, serial);
    if (rc < 0) { return rc; }
    var p = dbus_frame_base();
    dbus_unmarshal_set_limit(dbus_frame_next());
    dbus_unmarshal_body_begin(p);
    var idx = dbus_unmarshal_next_fd_index();
    var inactive = dbus_unmarshal_next_bool();
    # The descriptor itself came via SCM_RIGHTS and was queued by
    # the framer; the body carries only an index into that queue.
    var fd = dbus_frame_take_fd();
    store64(fd_out, fd);
    store64(active_out, inactive);
    dbus_frame_advance(dbus_frame_next());
    if (fd < 0) { return -9; }                    # -EBADF: no fd arrived
    return 0;
}

# fncall4(slot, bus, sess_cstr, major, minor) -> 0 | -err
fn dbus_native_release_device(bus, sess, major, minor) {
    if (major < 0) { return -22; }
    if (minor < 0) { return -22; }
    var t = alloc(64);
    var mn = _dbs_put(t, "ReleaseDevice");
    var serial = dbus_session_next_serial();
    dbus_session_begin_call(sess, strlen(sess), t, mn, 0, serial);
    var sg = alloc(8);
    var sn = _dbs_put(sg, "uu");
    dbus_marshal_field_sig(dbus_marshal_f_signature(), sg, sn);
    dbus_marshal_end_fields();
    dbus_marshal_body_u32(major);
    dbus_marshal_body_u32(minor);
    dbus_marshal_finish();
    var rc = dbus_session_call(bus, serial);
    if (rc == 0) { dbus_frame_advance(dbus_frame_next()); }
    return rc;
}

# fncall1(slot, bus) -> events | -err
# Drains whatever is readable without blocking, and reports how many
# whole messages went past. Bounded like the C shim's, and for the
# same reason: the frozen signature takes no cap argument.
#
# The read is NOT optional, and leaving it out is how the 0.11.0
# differential caught this module diverging from the C shim: the C
# side's sd_bus_process pulls from the socket, so it reported 1
# event where this reported 0 having only looked at an already-empty
# buffer. Same call, same session, two different answers — precisely
# the silent error-parity breach N6 exists to find.
#
# MSG_DONTWAIT is per-call. Setting O_NONBLOCK on the socket instead
# would make the request/reply path non-blocking too and turn every
# method call into a busy-wait.
fn dbus_native_pump_signals(bus) {
    var drained = 0;
    if (bus > 0) {
        dbus_frame_maybe_compact();
        var space = dbus_frame_space();
        if (space > 0) {
            var scratch = alloc(8);
            store64(scratch, (0 - 1));
            var got = dbus_sys_recv_fd_flags(bus, dbus_frame_tail(), space,
              scratch, dbus_sys_msg_dontwait());
            if (got > 0) { dbus_frame_commit(got); }
            if (got == 0) { dbus_frame_set_eof(); }
            var qfd = load64(scratch);
            if (qfd >= 0) { dbus_frame_push_fd(qfd); }
        }
    }
    var r = dbus_frame_next();
    while (r > 0) {
        drained = drained + 1;
        dbus_frame_advance(r);
        if (drained >= 256) { return drained; }
        r = dbus_frame_next();
    }
    return drained;
}

# fncall1(slot, bus) -> 0
fn dbus_native_close_bus(bus) {
    dbus_frame_close_fds();
    if (bus > 0) { sys_close(bus); }
    return 0;
}

# ---- the public native entry point (0.11.0, N6 cutover) ----
# @public
#
# The ONLY way a consumer should reach the native backend. It exists
# because CLAUDE.md forbids exposing FFI types in public signatures:
# without it a native consumer would have to write
#
#     var t = samvada_ffi_alloc();
#     dbus_native_populate(t);
#     samvada_init(t);
#
# which hands them a fn-table pointer — the exact thing the rule
# exists to prevent, and the thing that would make the eventual
# removal of the FFI layer a breaking change for them.
#
# Additive, so nothing that exists today changes: `samvada_init` and
# its frozen signature are untouched, and a consumer still linking
# the C shim keeps working unchanged.
#
#   returns 0, or a negative sd-bus errno
fn samvada_native_init() {
    var t = samvada_ffi_alloc();
    if (t == 0) { return -12; }
    var rc = dbus_native_populate(t);
    if (rc < 0) { return rc; }
    return samvada_init(t);
}

# Populate an FFI table with the native backend. kind = PURE_CYRIUS.
fn dbus_native_populate(t) {
    if (t == 0) { return -22; }
    samvada_ffi_set_slot(t, samvada_slot_open_system_bus(),  &dbus_native_open_system_bus);
    samvada_ffi_set_slot(t, samvada_slot_get_session_path(), &dbus_native_get_session_path);
    samvada_ffi_set_slot(t, samvada_slot_take_device(),      &dbus_native_take_device);
    samvada_ffi_set_slot(t, samvada_slot_release_device(),   &dbus_native_release_device);
    samvada_ffi_set_slot(t, samvada_slot_pump_signals(),     &dbus_native_pump_signals);
    samvada_ffi_set_slot(t, samvada_slot_close_bus(),        &dbus_native_close_bus);
    samvada_ffi_set_slot(t, samvada_slot_take_control(),     &dbus_native_take_control);
    samvada_ffi_set_slot(t, samvada_slot_release_control(),  &dbus_native_release_control);
    samvada_ffi_set_slot(t, samvada_slot_kind(), samvada_backend_kind_pure_cyrius());
    return 0;
}

# --- samvada.cyr ---

# @public — samvada API surface (stable across v0.x)
# samvada.cyr — entry point for the dbus / logind subset.
#
# Consumer-facing surface:
#   samvada_init(fn_table_ptr)                 -> 0|err
#   samvada_session_take_device(major, minor)  -> fd | -err
#   samvada_session_release_device(major, minor) -> 0|err
#   samvada_pump_signals()                     -> events_drained|negative_err
#   samvada_release()                          -> 0
#   samvada_version()                          -> packed u32
#
# `samvada_main(table)` is the C-shim entry point. It calls
# `samvada_init(table)` and then returns immediately — consumers
# (mabda's _backend_native_surface_configure_logind) drive the
# rest from their own code paths. The "consume samvada" half of
# the contract is invoked synchronously below the public API.
#
# Implementation: every public fn dispatches through the fn-table
# stashed by samvada_init() via fncallN from lib/fnptr.cyr.
#
# LIFETIME CONTRACT: we BORROW the table, we never copy it —
# `_samvada_slot()` re-reads `load64(_samvada_table + off)` on every
# call. The caller must keep the table valid and unmodified from
# samvada_init() until samvada_release(). The C shim satisfies this
# with a file-scope `static int64_t samvada_fn_table[]`.

# ---- module-scope state ----
# Set by samvada_init; read by the rest of the API. Declared with
# explicit zero to dodge the global-init-order silent-zero gotcha
# AND the uninitialized-var rejection.
var _samvada_table = 0;
var _samvada_bus   = 0;
var _samvada_sess  = 0;     # heap ptr to NUL-terminated session path
var _samvada_outs  = 0;     # heap ptr to 16-byte (fd_out, active_out) scratch
# Session control is acquired LAZILY, on the first successful device take —
# never at init. logind's TakeControl runs session_prepare_vt(), which on any
# session with vtnr >= 1 does KDSKBMODE=K_OFF (keyboard off) and
# KDSETMODE=KD_GRAPHICS (console blanks). Taking control at init therefore
# muted the user's console before any device was requested, and left it muted
# if the take then failed. See ADR-0004.
var _samvada_control = 0;   # 1 once TakeControl has succeeded
var _samvada_devices = 0;   # count of devices currently held

# Sized to fit any logind session path (`/org/freedesktop/login1/session/_NN`
# is ~46 chars; 512 leaves headroom for any future scheme).
var _SAMVADA_SESS_BUFLEN = 512;
var _SAMVADA_OUTS_BUFLEN = 16;

# Version triple packed into a u32 (major << 16 | minor << 8 | patch).
# Bumps lock-step with VERSION; consumers can do
# `if (samvada_version() < ((1<<16)|(0<<8)|0)) { ... }` for gates.
fn samvada_version() {
    return (1 << 16) | (0 << 8) | 0;
}

# ---- private helpers ----

fn _samvada_have_table() {
    if (_samvada_table == 0) { return 0; }
    return 1;
}

fn _samvada_slot(off) {
    return samvada_ffi_get_slot(_samvada_table, off);
}

# ---- public API ----

# Stash the fn-table, open the system bus, look up the session
# object path for our own pid. Returns 0 on success or a negative
# sd-bus errno on failure (-EINVAL if table is null or its kind
# doesn't match a known backend).
fn samvada_init(table) {
    if (table == 0) { return -22; }   # -EINVAL
    # Reject re-init without an intervening release (HIGH-1 in
    # 2026-05-01 hardening review). _samvada_table != 0 catches
    # both successful prior init and partial-init-fail states;
    # samvada_release() clears it back to 0.
    if (_samvada_table != 0) { return -16; }   # -EBUSY
    # Whitelist known backends. Accepting "any non-zero" meant an
    # uninitialised or wrongly-shaped table whose +64 word happened to be
    # non-zero got dispatched as function pointers instead of rejected
    # (0.5.1, audit MED-6).
    var k = samvada_ffi_kind(table);
    var k_ok = 0;
    if (k == samvada_backend_kind_libsystemd())  { k_ok = 1; }
    if (k == samvada_backend_kind_pure_cyrius()) { k_ok = 1; }
    if (k_ok == 0) { return -22; }
    _samvada_table = table;

    # Allocate scratch buffers on first init only; subsequent
    # init-after-release reuses them (the bump allocator never
    # frees, so re-allocating would leak the previous bytes).
    if (_samvada_sess == 0) {
        _samvada_sess = alloc(_SAMVADA_SESS_BUFLEN);
        if (_samvada_sess == 0) { samvada_release(); return -12; }   # -ENOMEM
    }
    if (_samvada_outs == 0) {
        _samvada_outs = alloc(_SAMVADA_OUTS_BUFLEN);
        if (_samvada_outs == 0) { samvada_release(); return -12; }
    }
    # Zero the scratch on every init so stale data from a previous
    # cycle never leaks into a successful read.
    var i = 0;
    while (i < _SAMVADA_SESS_BUFLEN) { store64(_samvada_sess + i, 0); i = i + 8; }
    store64(_samvada_outs + 0, 0);
    store64(_samvada_outs + 8, 0);

    # Open the system bus. The C wrapper writes the bus pointer
    # into the address we hand it.
    var bus_slot = _samvada_slot(samvada_slot_open_system_bus());
    if (bus_slot == 0) { samvada_release(); return -38; }   # -ENOSYS
    var bus_out = _samvada_outs;          # reuse 8 bytes of scratch
    store64(bus_out, 0);
    var rc = fncall1(bus_slot, bus_out);
    if (rc < 0) { samvada_release(); return rc; }
    _samvada_bus = load64(bus_out);
    if (_samvada_bus == 0) { samvada_release(); return -107; }   # -ENOTCONN

    # Look up the session path for our PID. logind speaks
    # GetSessionByPID(uint32) -> object_path; the C wrapper writes
    # the cstr into _samvada_sess.
    var sp_slot = _samvada_slot(samvada_slot_get_session_path());
    # This path LEAKED THE BUS until 0.5.1 (see CHANGELOG 0.5.1, audit
    # MED-8): _samvada_bus is live by this point, so returning without
    # releasing left an open sd_bus AND an armed public API.
    if (sp_slot == 0) { samvada_release(); return -38; }
    var pid = sys_getpid();
    rc = fncall4(sp_slot, _samvada_bus, pid, _samvada_sess,
      _SAMVADA_SESS_BUFLEN);
    if (rc < 0) { samvada_release(); return rc; }

    # NOTE: session control is NOT taken here. 0.5.1 did take it here, to fix
    # CRIT-1 (TakeDevice fails with NotInControl without it) — but logind's
    # TakeControl also runs session_prepare_vt(), muting the keyboard and
    # blanking the console on any seated VT session, before any device was
    # asked for. samvada_session_take_device() now acquires control lazily
    # instead, so a consumer that inits and never takes a device never
    # touches the user's VT. ADR-0004.
    #
    # The slot is still validated at init so a pre-0.5.1 backend table fails
    # loudly here rather than at the first device take.
    var tc_slot = _samvada_slot(samvada_slot_take_control());
    if (tc_slot == 0) { samvada_release(); return -38; }
    return 0;
}

# Acquire session control if we do not already hold it. Returns 0 if control
# is held on return (whether or not we acquired it just now), 1 if we
# acquired it on THIS call, or a negative errno.
fn _samvada_take_control() {
    if (_samvada_control != 0) { return 0; }
    var tc_slot = _samvada_slot(samvada_slot_take_control());
    if (tc_slot == 0) { return -38; }
    var rc = fncall2(tc_slot, _samvada_bus, _samvada_sess);
    if (rc < 0) { return rc; }
    _samvada_control = 1;
    return 1;
}

# Drop session control if held. logind restores the VT (session_restore_vt)
# when the controller is released, so this is what un-mutes the console.
fn _samvada_drop_control() {
    if (_samvada_control == 0) { return 0; }
    var rc_slot = _samvada_slot(samvada_slot_release_control());
    if (rc_slot != 0) { fncall2(rc_slot, _samvada_bus, _samvada_sess); }
    _samvada_control = 0;
    return 0;
}

# Ask logind for DRM-master delegation on /dev/dri/card<N>. Returns
# the dup'd unix_fd on success, or a negative sd-bus errno on
# failure. The fd's lifetime is the caller's; close() it (or pass
# it to ReleaseDevice + close) on teardown.
fn samvada_session_take_device(major, minor) {
    if (_samvada_have_table() == 0) { return -22; }
    if (_samvada_bus == 0)          { return -107; }
    var slot = _samvada_slot(samvada_slot_take_device());
    if (slot == 0) { return -38; }

    # logind answers NotInControl unless this connection holds control, so
    # acquire it here rather than at init (ADR-0004). `acquired` records
    # whether THIS call took it, so a failed take can hand it straight back
    # and leave the user's VT untouched.
    var acquired = _samvada_take_control();
    if (acquired < 0) { return acquired; }

    # 16-byte scratch: [+0] fd_out (i32), [+8] active_out (i32).
    # store64 the whole word; the C side writes only the low 32
    # bits, so high half stays zero.
    store64(_samvada_outs + 0, 0);
    store64(_samvada_outs + 8, 0);

    var rc = fncall6(slot, _samvada_bus, _samvada_sess,
      major, minor,
      _samvada_outs + 0, _samvada_outs + 8);
    if (rc < 0) {
        # Give control back if we took it purely for this failed attempt —
        # otherwise a failed take leaves the console muted for a device we
        # never got. `acquired == 1` means control was NOT held on entry,
        # which means no device was held either (holding a device implies
        # holding control), so this can never revoke a live fd.
        if (acquired == 1) { _samvada_drop_control(); }
        return rc;
    }
    var fd = load64(_samvada_outs + 0) & 0xFFFFFFFF;
    # Sign-extend the i32 fd back to a Cyrius-native int. Any
    # negative-fd path was already handled by the rc < 0 branch
    # in C, so the high bit shouldn't be set here, but be defensive.
    if ((fd & 0x80000000) != 0) { fd = fd - 0x100000000; }
    if (fd < 0) {
        if (acquired == 1) { _samvada_drop_control(); }
        return fd;
    }
    _samvada_devices = _samvada_devices + 1;
    return fd;
}

# Tell logind we're done with the device. Pairs with TakeDevice
# at teardown (and on PauseDevice if the consumer chooses to drop).
fn samvada_session_release_device(major, minor) {
    if (_samvada_have_table() == 0) { return -22; }
    if (_samvada_bus == 0)          { return -107; }
    var slot = _samvada_slot(samvada_slot_release_device());
    if (slot == 0) { return -38; }
    # sd_bus_call_method returns 1 on success; the documented contract here
    # is `0 | -err`. The C wrapper normalises too — this is the belt to its
    # braces, and it also covers a PURE_CYRIUS backend (0.5.1, audit MED-4).
    var rc = fncall4(slot, _samvada_bus, _samvada_sess, major, minor);
    if (rc < 0) { return rc; }
    if (_samvada_devices > 0) { _samvada_devices = _samvada_devices - 1; }
    # Once the consumer has given every device back, give session control
    # back too — logind runs session_restore_vt(), so the console and
    # keyboard return immediately rather than staying muted until the
    # process exits. This is the path mabda takes when the logind attempt
    # fails and it falls back to kiosk while leaving samvada initialized
    # (ADR-0004).
    if (_samvada_devices == 0) { _samvada_drop_control(); }
    return 0;
}

# Drain any pending bus messages. Returns the number of events
# processed (>=0) or a negative sd-bus errno on failure. Consumers
# typically call this once per frame / event-loop tick.
fn samvada_pump_signals() {
    if (_samvada_have_table() == 0) { return -22; }
    if (_samvada_bus == 0)          { return -107; }
    var slot = _samvada_slot(samvada_slot_pump_signals());
    if (slot == 0) { return -38; }
    return fncall1(slot, _samvada_bus);
}

# Close the bus and clear module state. Idempotent — safe to call
# on a partially-initialized samvada (e.g. after samvada_init returned
# an error). Buffers are not freed (bump allocator).
fn samvada_release() {
    if (_samvada_bus != 0) {
        # Drop session control before closing, so logind restores the VT
        # (session_restore_vt) rather than leaving it in graphics mode until
        # the connection drops. Failure is not fatal and is ignored.
        _samvada_drop_control();
        var slot = _samvada_slot(samvada_slot_close_bus());
        if (slot != 0) { fncall1(slot, _samvada_bus); }
        _samvada_bus = 0;
    }
    # Zero the scratch. Closes LOW-2 from the 2026-05-01 review: _samvada_outs
    # held a raw sd_bus* that is DANGLING once close_bus has run, and
    # _samvada_sess held the session path. Neither should survive release
    # (0.5.1, audit LOW-5).
    if (_samvada_outs != 0) {
        store64(_samvada_outs + 0, 0);
        store64(_samvada_outs + 8, 0);
    }
    if (_samvada_sess != 0) {
        var i = 0;
        while (i < _SAMVADA_SESS_BUFLEN) { store64(_samvada_sess + i, 0); i = i + 8; }
    }
    _samvada_control = 0;
    _samvada_devices = 0;
    _samvada_table = 0;
    return 0;
}

# C-shim entry point. The libsystemd shim's `main()` calls into
# this with the fn-table pointer. We init samvada and return —
# the consumer drives all subsequent calls. Smoke build (no shim)
# never reaches this; `src/main.cyr` keeps its own pure-Cyrius
# entry for `cyrius build`.
fn samvada_main(table) {
    var r = samvada_init(table);
    return r;
}
