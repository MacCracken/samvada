# --- visibility.cyr ---

# @internal — the consumer bundle's visibility boundary (1.1.1, A-6)
# visibility.cyr — makes dist/samvada.cyr private-by-default.
#
# Until 1.1.1 every fn in the bundle was consumer-reachable — 204 of
# them, against a documented public surface of eight — because Cyrius
# had no visibility mechanism when samvada was written. It has one now:
# a bare top-level `private` makes the file it sits in private, so
# that only items marked `public` can be named from another file (the
# cyrius guide, "Visibility"). A call to anything else is a hard
# compile error: `'dbus_session_set_timeout_ms' is private to its file`.
#
# This module is listed FIRST in cyrius.cyml `[lib] modules` and in
# nothing else. `cyrius distlib` concatenates the modules into ONE file,
# so to a consumer this marker covers the whole bundle, and the
# `public fn` marks on the eight frozen fns (src/samvada.cyr,
# src/dbus_session.cyr) are the only way in. It leads the bundle, which
# is valid on every toolchain a consumer may pin (the floor is 6.6.5).
# Measured on 6.6.5, 6.7.5 and 6.7.18: a marker after top-level
# DECLARATIONS is fine, but after a top-level statement 6.6.5 and 6.7.5
# refuse it ("unexpected private") and 6.7.18 refuses every later
# `public`. tools/surface_check.py keeps it first.
#
# It is deliberately NOT included from src/lib.cyr. samvada's own build
# and tests compile src/ as separate files, where a `private` here would
# cover only this (empty) file; the tests keep reaching the internals
# they pin.
#
# What it does NOT do: an `object;` build still exports every fn as a
# GLOBAL DEFAULT symbol (measured on 6.7.18), so C code linked against
# that object can still declare an internal `extern`. The boundary is
# Cyrius-level. tools/surface_check.py and ci.yml enforce it.
private

# --- samvada_ffi.cyr ---

# @internal — samvada FFI fn-table layout
# samvada_ffi.cyr — slot offsets and helpers for the C-shim
# function table.
#
# The C side (`deps/samvada_main.c`) builds an 88-byte fn-table in
# FILE-SCOPE STATIC storage, populates each slot with an
# `sd_bus_*`-backed wrapper, then calls `samvada_main(fn_table_ptr)`.
# The Cyrius side reaches into the table via `samvada_ffi_get_slot`
# and dispatches with `fncallN` from `lib/fnptr.cyr`.
#
# Static storage is REQUIRED, not incidental: samvada borrows this
# pointer and re-reads it on every dispatch for the life of the
# process. Before 0.5.1 the table was a stack local in the shim's
# `main()`, justified by a comment claiming `samvada_main()` never
# returns — it does (audit CRIT-2).
#
# Layout (v1) — same shape pattern as mabda's Backend struct.
# Append-after-kind invariant: every future v(N+1) slot lands at
# offset 72 + 8*K. `kind` stays at 64 forever so a v0 caller
# scanning a v(N+1) table never misreads a fnptr as the kind word.
#
# Wire-level:
#   [+0]   sb_open_system_bus(bus_out_ptr)                                    -> 0|err
#   [+8]   sb_get_session_path(bus, pid, out_buf, out_buf_len)                -> 0|err
#   [+16]  sb_take_device(bus, sess_cstr, major, minor, fd_out, active_out)   -> 0|err
#   [+24]  sb_release_device(bus, sess_cstr, major, minor)                    -> 0|err
#   [+32]  sb_pump_signals(bus)                                               -> events|negative_err
#   [+40]  sb_close_bus(bus)                                                  -> 0
#   [+48]  sb_subscribe_pause_resume(bus, sess_cstr, callback, userdata)      -> slot|err
#   [+56]  sb_unsubscribe(slot)                                               -> 0
#   [+64]  kind  (NULL=0, LIBSYSTEMD=1, PURE_CYRIUS=2)
#   [+72]  sb_take_control(bus, sess_cstr)                                    -> 0|err
#   [+80]  sb_release_control(bus, sess_cstr)                                 -> 0|err
#   [+88+] reserved for a future minor (properties, introspection, session bus...)
#
# Slots 72/80 were APPENDED in 0.5.1, after `kind`, exactly as ADR-0002
# requires. They exist because logind rejects `TakeDevice` with
# `org.freedesktop.login1.NotInControl` unless the SAME bus connection has
# already called `TakeControl` — so v0.2.0-0.5.0's take_device could never
# succeed in any environment. See docs/audit/2026-09-09-audit.md CRIT-1.
#
# Every C wrapper takes <=6 args so the table is fncall6-safe on
# both x86_64 SysV and aarch64 (cyrius's 6-arg fncall convention,
# see lib/fnptr.cyr docstring). Helpers that need more state pack
# it into a side struct addressed by pointer.

# Slot offsets — keep these as fns rather than globals so a
# downstream module can include this file in any order without
# tripping the global-init-order silent-zero gotcha.
fn samvada_slot_open_system_bus()        { return 0; }
fn samvada_slot_get_session_path()       { return 8; }
fn samvada_slot_take_device()            { return 16; }
fn samvada_slot_release_device()         { return 24; }
fn samvada_slot_pump_signals()           { return 32; }
fn samvada_slot_close_bus()              { return 40; }
fn samvada_slot_subscribe_pause_resume() { return 48; }
fn samvada_slot_unsubscribe()            { return 56; }
fn samvada_slot_kind()                   { return 64; }
# --- appended in 0.5.1 (after kind, per ADR-0002) ---
fn samvada_slot_take_control()           { return 72; }
fn samvada_slot_release_control()        { return 80; }
fn samvada_ffi_size()                    { return 88; }

# Backend kinds. NULL = mock / unbound table (CPU tests). LIBSYSTEMD
# is the v0.x C-shim. PURE_CYRIUS is the v1.0 retirement target.
fn samvada_backend_kind_null()         { return 0; }
fn samvada_backend_kind_libsystemd()   { return 1; }
fn samvada_backend_kind_pure_cyrius()  { return 2; }

# Allocate a zero-filled fn-table on the heap. Used by Cyrius-side
# consumers (e.g. mock backends in tests). The C shim builds its
# table on the C stack and never calls this.
fn samvada_ffi_alloc() {
    var t = alloc(samvada_ffi_size());
    if (t == 0) { return 0; }
    var i = 0;
    var sz = samvada_ffi_size();
    while (i < sz) {
        store64(t + i, 0);
        i = i + 8;
    }
    return t;
}

# Read the fnptr (or kind word) at `off` from table `t`. Returns
# 0 if `t` is null — caller checks before dispatching.
fn samvada_ffi_get_slot(t, off) {
    if (t == 0) { return 0; }
    return load64(t + off);
}

# Install a fnptr at `off`. Used by mock backends + C shim's Cyrius-
# side bindings (when the table is built by Cyrius rather than C).
fn samvada_ffi_set_slot(t, off, fp) {
    if (t == 0) { return 0; }
    store64(t + off, fp);
    return 0;
}

# Convenience: read kind without exposing the offset constant.
fn samvada_ffi_kind(t) {
    return samvada_ffi_get_slot(t, samvada_slot_kind());
}

# --- dbus_sys.cyr ---

# @internal — native-dbus low-level syscall + SCM_RIGHTS layer
# dbus_sys.cyr — the first module of the native Cyrius dbus backend
# (N1, ADR-0003). It does exactly one thing the C shim currently
# does for us: receive a file descriptor over a unix socket via
# `SCM_RIGHTS` ancillary data.
#
# Why this is first: proposal 0001 rates fd passing the only
# Low-confidence module of the pivot, and the fallback is cheap
# ONLY while nothing is built on top of it. So it is proven before
# a single dbus byte exists.
#
# Not derived from the kernel ABI by hand — diffed against working
# in-language implementations:
#   kybernet/src/lib/notify.cyr:182-235  (receive walk, MSG_CTRUNC + bounds)
#   argonaut/src/notify.cyr:176-207      (receive walk, MSG_DONTWAIT)
#   cyrius-doom/src/platform/wayland/client.cyr:206-228 (send side)
# Every layout constant below was then re-confirmed against glibc
# headers on x86_64 (offsetof/sizeof/CMSG_*), and is pinned by
# tests/samvada.tcyr so a silent ABI drift fails at CPU-test time.
#
# NOT REENTRANT, by construction. `var buf[N]` inside a fn is
# STATIC data in Cyrius, not stack — consecutive calls share and
# clobber it. samvada is single-threaded by design (see
# public-api.md §Threading), so the scratch below is file-scope and
# reused deliberately rather than accidentally.

# ---- struct layouts (LP64; identical on x86_64 and aarch64) ----
# struct iovec  { void *iov_base@0; size_t iov_len@8; }            16 bytes
# struct msghdr { name@0 namelen@8 iov@16 iovlen@24
#                 control@32 controllen@40 flags@48 }              56 bytes
# struct cmsghdr{ size_t cmsg_len@0; int level@8; int type@12; }    16 bytes
#                 followed by data at +16
fn dbus_sys_iovec_size()    { return 16; }
fn dbus_sys_msghdr_size()   { return 56; }
fn dbus_sys_cmsghdr_size()  { return 16; }
fn dbus_sys_cmsg_data_off() { return 16; }

# CMSG_LEN(4) = cmsghdr(16) + 4 = 20, CMSG_SPACE(4) = 16 + align8(4) = 24:
# the one-descriptor layout. The receive reserves room for 253 (below);
# these two are the ABI the tests' senders are built on, and pinned.
fn dbus_sys_cmsg_len_1fd()   { return 20; }
fn dbus_sys_cmsg_space_1fd() { return 24; }

# ---- constants ----
fn dbus_sys_af_unix()     { return 1; }
fn dbus_sys_sock_stream() { return 1; }
fn dbus_sys_sol_socket()  { return 1; }
fn dbus_sys_scm_rights()  { return 1; }
# SCM_PIDFD (Linux 6.5): with SO_PASSPIDFD set on the socket, every
# receive carries a pidfd for the sender. samvada never sets it; if
# anything ever does, the descriptor is still ours to close (1.1.2).
fn dbus_sys_scm_pidfd()   { return 4; }
fn dbus_sys_msg_ctrunc()  { return 8; }
# MSG_CMSG_CLOEXEC — the received fd arrives with FD_CLOEXEC already
# set, so it cannot leak across an execve. This is the receive-side
# counterpart of the F_DUPFD_CLOEXEC fix in the C shim (0.5.1 MED-3);
# doing it here means the native backend never has the window the
# shim had to close by hand.
fn dbus_sys_msg_cmsg_cloexec() { return 1073741824; }

# MSG_DONTWAIT — per-CALL non-blocking. Deliberately not O_NONBLOCK
# on the socket: that is socket state and would make every
# request/reply read non-blocking too, silently turning a normal
# method call into a busy-wait.
fn dbus_sys_msg_dontwait() { return 64; }

# ---- syscall numbers: the stdlib's, never our own ----
# sendmsg/recvmsg are NOT in the same numeric slot across arches, and
# getting this wrong is silent: on aarch64, 46 is `ftruncate`, so a
# hardcoded x86_64 number does not fail — it truncates a file to a
# garbage length. (cyrius-doom hardcodes `WL_SYS_SENDMSG = 46` with no
# aarch64 branch and carries exactly that latent bug.)
#
# So the receive goes through the stdlib's `sys_recvmsg`, which
# resolves SYS_RECVMSG per arch. Until 1.1.0 this file also kept a
# native aarch64 212 under `#ifdef CYRIUS_ARCH_AARCH64` for the tests
# to assert against. It is gone: cyrius 6.7.12+ rewrites x86 numbers
# on ELF-aarch64 through a compat chain, so which number the stdlib
# spells is the compiler's business, and only behaviour says the
# right call ran — tests/dbus_sys.tcyr's SCM_RIGHTS round trip.

# ---- how many descriptors one receive can deliver (1.1.2) ----
# SCM_MAX_FD (include/net/scm.h): the most descriptors one sendmsg can
# carry. A unix stream receive stops after the first segment that
# carried descriptors (net/unix/af_unix.c, unix_stream_read_generic:
# `if (scm.fp) break;`), so 253 is also the most one recvmsg can
# deliver, and a control buffer of CMSG_SPACE(253 fds) never truncates
# an SCM_RIGHTS payload.
#
# Until 1.1.2 the buffer held ONE descriptor (24 bytes). A message with
# three or more truncated, and the truncation branch threw the message's
# BYTES away and answered -EPROTO, which the session layer correctly
# reads as a disconnect — so any bus peer that could send samvada a
# signal with three descriptors on it closed samvada's connection.
fn dbus_sys_fd_max()    { return 253; }
fn dbus_sys_ctrl_size() { return 1032; }      # 16 + align8(253 * 4)

# ---- scratch (file-scope; see the non-reentrancy note above) ----
var _dbus_iov  = 0;   # 16 bytes
var _dbus_mh   = 0;   # 56 bytes
var _dbus_ctrl = 0;   # dbus_sys_ctrl_size() bytes
# The last receive's descriptors, in arrival order: every one is OURS
# (the kernel installed it) and the caller must queue or close each.
var _dbus_rx      = 0;   # dbus_sys_fd_max() * 8 bytes
var _dbus_rxn     = 0;
var _dbus_rxtrunc = 0;   # the kernel dropped ancillary data (MSG_CTRUNC)
var _dbus_sys_ready = 0;

fn _dbus_sys_init() {
    if (_dbus_sys_ready != 0) { return 0; }
    _dbus_iov = alloc(dbus_sys_iovec_size());
    if (_dbus_iov == 0) { return -12; }
    _dbus_mh = alloc(dbus_sys_msghdr_size());
    if (_dbus_mh == 0) { return -12; }
    _dbus_ctrl = alloc(dbus_sys_ctrl_size());
    if (_dbus_ctrl == 0) { return -12; }
    _dbus_rx = alloc(dbus_sys_fd_max() * 8);
    if (_dbus_rx == 0) { return -12; }
    _dbus_sys_ready = 1;
    return 0;
}

fn _dbus_zero(p, n) {
    var i = 0;
    while (i < n) { store64(p + i, 0); i = i + 8; }
    return 0;
}

fn dbus_sys_rx_count()     { return _dbus_rxn; }
fn dbus_sys_rx_truncated() { return _dbus_rxtrunc; }

fn dbus_sys_rx_fd(i) {
    if (i < 0) { return (0 - 1); }
    if (i >= _dbus_rxn) { return (0 - 1); }
    return load64(_dbus_rx + i * 8);
}

fn _dbus_rx_add(fd) {
    if (_dbus_rxn >= dbus_sys_fd_max()) {
        sys_close(fd);                        # cannot be held: never leak it
        return 0;
    }
    store64(_dbus_rx + _dbus_rxn * 8, fd);
    _dbus_rxn = _dbus_rxn + 1;
    return 0;
}

# Collect every SCM_RIGHTS descriptor from a control buffer into the rx
# array, in order, and return how many there are.
#
# Split out from dbus_sys_recv deliberately: the syscall half cannot be
# driven through its own error paths from a test (the kernel validates
# ancillary data before we ever see it, so a forged cmsg never arrives),
# while the PARSING half is a pure byte transform and every guard in it
# is reachable with a hand-built buffer.
#
# It walks every cmsg (CMSG_NXTHDR), not just the first: with SO_PASSCRED
# or SO_PASSSEC set on the socket, SCM_CREDENTIALS or SCM_SECURITY comes
# FIRST and the descriptors second; with SO_PASSPIDFD an SCM_PIDFD
# carries a descriptor of its own, which is closed here. A header that claims less than
# itself, or more than the kernel filled, ends the walk — nothing after
# it can be located.
#
#   ctrl     — the control buffer recvmsg filled
#   ctrllen  — msghdr.msg_controllen AFTER the call
#
#   returns  >= 0  descriptors collected (dbus_sys_rx_fd(0..n-1))
#            -22   null buffer
fn dbus_sys_parse_rights(ctrl, ctrllen) {
    var rc = _dbus_sys_init();
    if (rc < 0) { return rc; }
    _dbus_rxn = 0;
    if (ctrl == 0) { return -22; }
    var hdr = dbus_sys_cmsghdr_size();
    var at = 0;
    var more = 1;
    while (more == 1) {
        more = 0;
        var room = ctrllen - at;
        if (room >= hdr) {
            var clen = load64(ctrl + at);
            var ok = 1;
            if (clen < hdr)  { ok = 0; }
            if (clen > room) { ok = 0; }
            if (ok == 1) {
                var level = load32(ctrl + at + 8);
                var ctype = load32(ctrl + at + 12);
                var rights = 0;
                if (level == dbus_sys_sol_socket()) {
                    if (ctype == dbus_sys_scm_rights()) { rights = 1; }
                    if (ctype == dbus_sys_scm_pidfd()) { rights = 2; }
                }
                if (rights != 0) {
                    # Each fd is an int32: read the low 32 bits and
                    # sign-extend, so a kernel-impossible negative cannot
                    # read as a huge positive fd. load32, NOT load64: the
                    # last fd ends exactly at clen. A pidfd is closed at
                    # once — no message owns it.
                    var off = at + dbus_sys_cmsg_data_off();
                    while (off + 4 <= at + clen) {
                        var x = load32(ctrl + off);
                        var neg = x & 0x80000000;
                        if (neg != 0) { x = x - 0x100000000; }
                        if (x >= 0) {
                            if (rights == 1) { _dbus_rx_add(x); }
                            if (rights == 2) { sys_close(x); }
                        }
                        off = off + 4;
                    }
                }
                at = at + ((clen + 7) & (0 - 8));
                more = 1;
            }
        }
    }
    return _dbus_rxn;
}

# Receive up to `buflen` bytes into `buf`, with every descriptor that
# accompanies them.
#
#   returns  >= 0  bytes received; the descriptors are dbus_sys_rx_fd(0
#                  .. dbus_sys_rx_count() - 1), and the caller owns them
#            <  0  negative errno from recvmsg (no descriptors)
#
# MSG_CTRUNC no longer discards the bytes (1.1.2). The bytes are real
# and already consumed from the socket: dropping them desynchronised the
# stream. The descriptors that fit are delivered like any others, and
# dbus_sys_rx_truncated() says the set is INCOMPLETE, so the caller can
# refuse to treat it as a message's descriptors. With CMSG_SPACE(253)
# reserved it is reachable only when another cmsg shares the buffer.
#
# MSG_CMSG_CLOEXEC rides on every call: a received descriptor never
# leaks across an execve, even between this call and the caller's.
fn dbus_sys_recv(fd, buf, buflen, flags) {
    if (buf == 0)      { return -22; }
    if (buflen <= 0)   { return -22; }
    var rc = _dbus_sys_init();
    if (rc < 0) { return rc; }
    _dbus_rxn = 0;
    _dbus_rxtrunc = 0;

    store64(_dbus_iov + 0, buf);
    store64(_dbus_iov + 8, buflen);
    # Only the first cmsghdr is cleared: the walk reads no further than
    # the msg_controllen the kernel reports, and every byte inside it the
    # kernel wrote. Clearing all 1032 bytes cost ~150 ns on every receive,
    # an idle 60 Hz pump included (measured, 1.1.2).
    _dbus_zero(_dbus_ctrl, dbus_sys_cmsghdr_size());
    _dbus_zero(_dbus_mh, dbus_sys_msghdr_size());
    store64(_dbus_mh + 16, _dbus_iov);
    store64(_dbus_mh + 24, 1);
    store64(_dbus_mh + 32, _dbus_ctrl);
    store64(_dbus_mh + 40, dbus_sys_ctrl_size());

    var n = sys_recvmsg(fd, _dbus_mh, dbus_sys_msg_cmsg_cloexec() | flags);
    if (n < 0) { return n; }

    # The kernel reports how much of the buffer it filled; never walk
    # past what we reserved, whatever it says.
    var ctrllen = load64(_dbus_mh + 40);
    if (ctrllen > dbus_sys_ctrl_size()) { ctrllen = dbus_sys_ctrl_size(); }
    if (ctrllen < 0) { ctrllen = 0; }
    dbus_sys_parse_rights(_dbus_ctrl, ctrllen);

    var mflags = load32(_dbus_mh + 48);
    var trunc = mflags & dbus_sys_msg_ctrunc();
    if (trunc != 0) { _dbus_rxtrunc = 1; }
    return n;
}

# --- dbus_frame.cyr ---

# @internal — native-dbus message framing
# dbus_frame.cyr — splits a byte stream into whole dbus messages.
#
# A read from the bus is not a message. The N2 corpus shows the very
# first exchange delivering TWO complete messages in one 282-byte
# read (101 + 181, zero residual), so a reader that handles one
# message per read silently drops the second — which in that
# exchange is `NameAcquired`. Conversely a stream socket may split
# anywhere, so a partial tail must survive into the next read.
#
# This module owns THE receive buffer. dbus_auth.cyr borrows it
# through tail/space/commit rather than keeping its own: alloc()
# never frees, and a separate auth buffer would either copy or lose
# the residual left when the server pipelines its SASL reply.
#
# NOT REENTRANT. State is file-scope, matching dbus_sys.cyr and for
# the same reason: `var buf[N]` inside a fn is STATIC in Cyrius, so
# per-call scratch is a fiction. samvada is single-threaded by
# design (public-api.md §Threading).

# ---- header layout, message-relative ----
#   +0  endian byte ('l' = 108 little, 'B' = 66 big)
#   +1  message type (u8)
#   +2  flags (u8)
#   +3  protocol major version (u8)
#   +4  body_len   (u32, in the endianness named at +0)
#   +8  serial     (u32)
#   +12 fields_len (u32)
#   +16 header fields array, `fields_len` bytes
#       body starts at align8(16 + fields_len)
fn dbus_frame_hdr_size()  { return 16; }
fn dbus_frame_off_body()  { return 4; }
fn dbus_frame_off_serial(){ return 8; }
fn dbus_frame_off_flds()  { return 12; }
fn dbus_frame_endian_le() { return 108; }
fn dbus_frame_endian_be() { return 66; }

# The buffer. 8192 is 34x the largest delivery the corpus contains
# (282 bytes) and a page multiple. It is NOT a protocol limit — the
# spec allows 128 MiB — so an over-cap message is DRAINED, not
# treated as fatal (see dbus_frame_next). D-Bus can do that because
# the full length is in the fixed header; a bare length-prefix
# protocol could not.
fn dbus_frame_cap() { return 8192; }

# The protocol's own ceiling: "The maximum length of a message,
# including header, header alignment padding, and body is 2 to the 27th
# power or 134217728 (128 MiB)" (D-Bus specification, Message Format).
# A header declaring that much or more is not a large message, it is an
# invalid one, and sd-bus refuses it with -ENOBUFS (bus-socket.c,
# BUS_MESSAGE_SIZE_MAX). Until 1.1.1 the framer drained ANY declared
# length: one forged 16-byte header (body and fields both 0xFFFFFFFF)
# committed it to discarding ~8 GiB of stream before it would frame
# another message (A-1). Now that header is refused on sight.
fn dbus_frame_msg_max() { return 134217728; }

# Pending-fd queue depth. Fixed, because alloc() never frees and a
# growable queue leaks per push. On overflow the arriving fd is
# CLOSED, not dropped — an unbounded fd leak inside a compositor is
# worse than a refused message.
#
# THE QUEUE HOLDS ONE MESSAGE'S DESCRIPTORS (1.1.2). Every read is
# bounded to the message at the head of the buffer (dbus_frame_want), so
# whatever descriptors a read delivers arrived with THAT message's bytes,
# and advancing past the message closes every one it did not hand out.
# This is sd-bus's own rule — bus_socket_read_message reads no further
# than the current message, and the descriptors that arrive meanwhile
# are that message's — and it needs nothing from the message itself.
#
# Until 1.1.2 a message's descriptors were counted from its own UNIX_FDS
# field, and a message whose field array samvada could not walk (any
# big-endian message; an unknown field type ahead of UNIX_FDS) counted
# as carrying none. Any bus peer could send samvada such a signal with a
# descriptor of its choosing attached; the descriptor stayed at the head
# of the queue, and the next TakeDevice handed it to the compositor as
# the device. Attribution by position cannot be argued with by the
# message it attributes.
#
# What it does assume, as sd-bus does: a sender attaches a message's
# descriptors to the write that carries the message's FIRST byte.
# dbus-broker and dbus-daemon both do. A sender that glued one message's
# tail and the next message onto a write carrying the next one's
# descriptors would have them attributed to the first — which closes
# them, so the genuine reply gets -EBADF; it never hands out a stranger's
# descriptor (P(-1) re-verification, demonstrated both ways).
#
# Only the first 8 of a message's descriptors are kept; the rest are
# closed on arrival but still counted (fd_total). A reply whose `h`
# index is 8 or more is therefore refused, where sd-bus would honour it
# — logind's TakeDevice reply carries exactly one.
fn dbus_frame_fdq_cap() { return 8; }

# ---- status codes ----
# Deliberately OUTSIDE the errno band. samvada's convention is that
# negatives are sd-bus errnos, and dbus_sys.cyr already spends -22
# and -71. If a protocol fault shared that range, "the bus sent a
# malformed header" would be indistinguishable from "recvmsg
# failed", which is exactly the ambiguity the 0.5.1 audit found
# around -22.
fn dbus_frame_need_more() { return -1000; }
fn dbus_frame_eof()       { return -1001; }   # orderly close, nothing pending
fn dbus_frame_truncated() { return -1002; }   # EOF mid-message
fn dbus_frame_badendian() { return -1003; }
fn dbus_frame_badproto()  { return -1004; }
fn dbus_frame_overflow()  { return -1005; }   # fd queue full
fn dbus_frame_toolong()   { return -1006; }   # declares >= msg_max: invalid

# ---- arithmetic ----
fn dbus_frame_align8(n) {
    return (n + 7) & (0 - 8);
}

# Read a u32 header field. load32 ZERO-extends, which is the whole
# reason this fn exists and is the only place load32 appears on the
# header path.
#
# `load64(p + 4)` on the bus's very FIRST reply returns -4294967283,
# because the 0xFFFFFFFF serial occupies the high half of that
# 8-byte load. `total` then goes negative, `avail < total` is false,
# the cursor advances by a negative amount and the framer walks
# backwards forever. Verified on the real fixture.
#
# Note also that dbus_sys.cyr DOES sign-extend, correctly — an
# SCM_RIGHTS payload is a signed int32 fd. Copying that idiom here
# is the trap: a valid serial would read as an error.
fn dbus_frame_u32(p, off) {
    return load32(p + off);
}

# Big-endian reader. No mask needed: load8 zero-extends and
# 255 << 24 = 4278190080 is a positive i64.
fn dbus_frame_u32_be(p, off) {
    var b0 = load8(p + off + 0);
    var b1 = load8(p + off + 1);
    var b2 = load8(p + off + 2);
    var b3 = load8(p + off + 3);
    return (b0 << 24) | (b1 << 16) | (b2 << 8) | b3;
}

# Total on-wire length of the message starting at `p`, given `avail`
# readable bytes there. Returns need_more if fewer than 16 bytes are
# present — the length is genuinely unknowable below that, because
# byte +0 selects how to read the u32 at +12.
#
# Every quantity here is MESSAGE-relative. Evaluating align8 against
# an absolute buffer offset is the bug that made the N2 corpus look
# truncated: for message 2 of the hello reply (off 101, fields 151,
# body 13) it yields 184 instead of 181.
fn dbus_frame_total(p, avail) {
    if (avail < dbus_frame_hdr_size()) { return dbus_frame_need_more(); }
    var e = load8(p + 0);
    var body = 0;
    var flds = 0;
    if (e == dbus_frame_endian_le()) {
        body = dbus_frame_u32(p, dbus_frame_off_body());
        flds = dbus_frame_u32(p, dbus_frame_off_flds());
    }
    if (e == dbus_frame_endian_be()) {
        body = dbus_frame_u32_be(p, dbus_frame_off_body());
        flds = dbus_frame_u32_be(p, dbus_frame_off_flds());
    }
    var known = 0;
    if (e == dbus_frame_endian_le()) { known = 1; }
    if (e == dbus_frame_endian_be()) { known = 1; }
    if (known == 0) { return dbus_frame_badendian(); }
    if (load8(p + 3) != 1) { return dbus_frame_badproto(); }
    return dbus_frame_align8(dbus_frame_hdr_size() + flds) + body;
}

fn dbus_frame_msg_type(p)   { return load8(p + 1); }
fn dbus_frame_msg_serial(p) {
    var e = load8(p + 0);
    if (e == dbus_frame_endian_be()) {
        return dbus_frame_u32_be(p, dbus_frame_off_serial());
    }
    return dbus_frame_u32(p, dbus_frame_off_serial());
}

# ---- state ----
var _dbf_buf   = 0;   # the single receive buffer
var _dbf_off   = 0;   # cursor: first unconsumed byte
var _dbf_have  = 0;   # cursor: one past the last valid byte
var _dbf_skip  = 0;   # bytes still to discard for an over-cap message
var _dbf_eof   = 0;   # peer closed
var _dbf_fdq   = 0;   # the head message's descriptors, in arrival order
var _dbf_fdn   = 0;   # fds queued
var _dbf_fdtot = 0;   # fds that arrived with the head message, queued or not
var _dbf_fdbad = 0;   # 1: the head message's descriptor set is incomplete
# Stream position of _dbf_buf[0]: bytes the buffer has slid past since
# init. With it, a byte's position survives compaction, so "did this
# message arrive before the request went out" is a comparison of two
# positions rather than a count that has to be kept in step (1.1.2).
var _dbf_abs0  = 0;
var _dbf_ready = 0;
# Bytes compaction has moved since init. Kept only so A-1's bound is a
# test, not an argument: each message is moved at most once — compaction
# runs only when the tail hits the cap, and it leaves the one partial
# message at offset 0, where it stays until consumed — so this can never
# exceed the bytes received, however a peer sizes its messages.
var _dbf_moved = 0;

# Re-init CLOSES whatever is still queued (1.1.2). It used to zero the
# count, which forgot the descriptors without closing them — a leak per
# reconnect whenever the old connection died holding one.
fn dbus_frame_init() {
    if (_dbf_ready != 0) {
        dbus_frame_close_fds();
        _dbf_off = 0; _dbf_have = 0; _dbf_skip = 0; _dbf_eof = 0;
        _dbf_moved = 0; _dbf_abs0 = 0;
        return 0;
    }
    _dbf_buf = alloc(dbus_frame_cap());
    if (_dbf_buf == 0) { return -12; }
    _dbf_fdq = alloc(dbus_frame_fdq_cap() * 8);
    if (_dbf_fdq == 0) { return -12; }
    _dbf_off = 0; _dbf_have = 0; _dbf_skip = 0; _dbf_eof = 0; _dbf_fdn = 0;
    _dbf_fdtot = 0; _dbf_fdbad = 0;
    _dbf_moved = 0; _dbf_abs0 = 0;
    _dbf_ready = 1;
    return 0;
}

# ---- buffer access, for dbus_auth.cyr and the socket reader ----
fn dbus_frame_tail()  { return _dbf_buf + _dbf_have; }
fn dbus_frame_space() { return dbus_frame_cap() - _dbf_have; }
fn dbus_frame_have()  { return _dbf_have - _dbf_off; }
fn dbus_frame_base()  { return _dbf_buf + _dbf_off; }

fn dbus_frame_commit(n) {
    if (n <= 0) { return 0; }
    _dbf_have = _dbf_have + n;
    return 0;
}

# Consume `n` bytes from the front — used by the SASL reader, which
# leaves the cursor exactly where the binary stream begins.
fn dbus_frame_consume(n) {
    if (n <= 0) { return 0; }
    _dbf_off = _dbf_off + n;
    if (_dbf_off > _dbf_have) { _dbf_off = _dbf_have; }
    return 0;
}

fn dbus_frame_set_eof() { _dbf_eof = 1; return 0; }
fn dbus_frame_moved()   { return _dbf_moved; }

# Stream positions, in bytes since init: of the first unconsumed byte
# (the head message's first byte, once dbus_frame_next has yielded it),
# and one past the last byte received.
fn dbus_frame_pos()      { return _dbf_abs0 + _dbf_off; }
fn dbus_frame_received() { return _dbf_abs0 + _dbf_have; }

# Slide unconsumed bytes to the front. Run only when the next read does
# not fit (dbus_frame_prepare), so compaction is rare rather than
# per-read.
#
# memcpy with dst < src and a forward loop is what makes this safe;
# lib/string.cyr's memcpy is a forward byte loop today and there is
# no memmove. Stated at the call site because the guarantee is
# undocumented upstream.
fn dbus_frame_compact() {
    if (_dbf_off == 0) { return 0; }
    var live = _dbf_have - _dbf_off;
    if (live > 0) { memcpy(_dbf_buf, _dbf_buf + _dbf_off, live); }
    _dbf_moved = _dbf_moved + live;
    _dbf_abs0 = _dbf_abs0 + _dbf_off;
    _dbf_off = 0;
    _dbf_have = live;
    return 0;
}

# ---- the head message's descriptors ----
# A descriptor that arrives while an over-cap message is being drained
# is that message's, and closed on arrival: nobody can claim it.
fn dbus_frame_push_fd(fd) {
    if (fd < 0) { return 0; }
    if (_dbf_skip > 0) {
        sys_close(fd);
        return 0;
    }
    _dbf_fdtot = _dbf_fdtot + 1;
    if (_dbf_fdn >= dbus_frame_fdq_cap()) {
        sys_close(fd);
        return dbus_frame_overflow();
    }
    store64(_dbf_fdq + _dbf_fdn * 8, fd);
    _dbf_fdn = _dbf_fdn + 1;
    return 0;
}

# The kernel truncated the ancillary data of a read (MSG_CTRUNC): some
# of the head message's descriptors were dropped before we saw them, so
# its count can never be trusted.
fn dbus_frame_fds_incomplete() {
    if (_dbf_skip > 0) { return 0; }
    _dbf_fdbad = 1;
    return 0;
}

fn dbus_frame_fd_count() { return _dbf_fdn; }
fn dbus_frame_fd_total() { return _dbf_fdtot; }
fn dbus_frame_fd_bad()   { return _dbf_fdbad; }

# Hand the head message's descriptor number `i` to the caller, who then
# owns it: it leaves the queue, so advancing past the message no longer
# closes it. -1 if there is no such descriptor (it never arrived, or was
# closed on queue overflow). Claiming does not change fd_total, which
# counts what ARRIVED.
fn dbus_frame_claim_fd(i) {
    if (i < 0) { return (0 - 1); }
    if (i >= _dbf_fdn) { return (0 - 1); }
    var fd = load64(_dbf_fdq + i * 8);
    var j = i + 1;
    while (j < _dbf_fdn) {
        store64(_dbf_fdq + (j - 1) * 8, load64(_dbf_fdq + j * 8));
        j = j + 1;
    }
    _dbf_fdn = _dbf_fdn - 1;
    return fd;
}

# The first queued descriptor, claimed (FIFO). Tests read a reply's
# descriptor through this after dbus_session_call.
fn dbus_frame_take_fd() { return dbus_frame_claim_fd(0); }

# Close every queued descriptor and forget the head message's count.
# Runs whenever a message is consumed (dbus_frame_advance), on the
# over-cap drain, at re-init and at connection close — a queued fd
# nobody claims is a leak for the process lifetime.
fn dbus_frame_close_fds() {
    var i = 0;
    while (i < _dbf_fdn) {
        var fd = load64(_dbf_fdq + i * 8);
        if (fd >= 0) { sys_close(fd); }
        i = i + 1;
    }
    _dbf_fdn = 0;
    _dbf_fdtot = 0;
    _dbf_fdbad = 0;
    return 0;
}

# ---- bounding a read to the head message (1.1.2) ----
# How many bytes the next read may take without reading past the end of
# the message at the head of the buffer: the rest of its 16-byte header,
# or the rest of the message once the header says how long it is, or the
# rest of an over-cap message being drained. 0 when a read is not what
# is needed — a whole message is already buffered, or the stream is lost
# (dbus_frame_next says which).
#
# Bounding the read is what makes the descriptor queue one message's:
# see dbus_frame_fdq_cap. It costs a second receive per message, which
# at logind's traffic is nothing.
fn dbus_frame_want() {
    var avail = _dbf_have - _dbf_off;
    if (_dbf_skip > 0) {
        var rest = _dbf_skip - avail;
        if (rest < 0) { rest = 0; }
        return rest;
    }
    if (avail < dbus_frame_hdr_size()) { return dbus_frame_hdr_size() - avail; }
    var total = dbus_frame_total(_dbf_buf + _dbf_off, avail);
    if (total < 0) { return 0; }
    if (total > dbus_frame_cap()) { return 0; }   # dbus_frame_next drains it
    if (total <= avail) { return 0; }
    return total - avail;
}

# Make room for a read of `want` bytes and return how many it may take
# (fewer only while draining an over-cap message). Compaction here moves
# at most the head message's partial bytes, once: it stays at offset 0
# until consumed, and reads never run past it.
fn dbus_frame_prepare(want) {
    if (want <= 0) { return 0; }
    if (dbus_frame_space() < want) { dbus_frame_compact(); }
    var space = dbus_frame_space();
    if (want > space) { return space; }
    return want;
}

# ---- the framer ----
# Yield the next complete message.
#
#   returns > 0   its total length; the message starts at
#                 dbus_frame_base() and the caller must call
#                 dbus_frame_advance(len) when done with it
#           need_more   buffer holds a partial message; read again
#           eof         peer closed cleanly with nothing pending
#           truncated   peer closed mid-message
#           badendian / badproto   unrecoverable, stream is lost
#           toolong     declares >= 128 MiB: invalid, stream is lost
fn dbus_frame_next() {
    # Finish discarding an over-cap message first.
    if (_dbf_skip > 0) {
        var avail0 = _dbf_have - _dbf_off;
        var take = _dbf_skip;
        if (take > avail0) { take = avail0; }
        _dbf_off = _dbf_off + take;
        _dbf_skip = _dbf_skip - take;
        if (_dbf_skip > 0) {
            if (_dbf_eof != 0) { return dbus_frame_truncated(); }
            return dbus_frame_need_more();
        }
        dbus_frame_close_fds();               # the drained message's, if any
    }

    var avail = _dbf_have - _dbf_off;
    if (avail == 0) {
        if (_dbf_eof != 0) { return dbus_frame_eof(); }
        return dbus_frame_need_more();
    }
    if (avail < dbus_frame_hdr_size()) {
        if (_dbf_eof != 0) { return dbus_frame_truncated(); }
        return dbus_frame_need_more();
    }

    var p = _dbf_buf + _dbf_off;
    var total = dbus_frame_total(p, avail);
    if (total == dbus_frame_badendian()) { return dbus_frame_badendian(); }
    if (total == dbus_frame_badproto())  { return dbus_frame_badproto(); }
    # Refused, not drained, and not consumed: the stream cannot be
    # resynchronised past a header the protocol says cannot exist, so
    # every later call sees the same answer — as with a bad endian byte.
    if (total >= dbus_frame_msg_max())   { return dbus_frame_toolong(); }

    # Over-cap: the message can never fit, so discard exactly `total`
    # bytes and resynchronise. Every queued fd goes with it — the
    # field array may not even be buffered, so UNIX_FDS is unreadable
    # and conservatism is the only safe rule.
    if (total > dbus_frame_cap()) {
        dbus_frame_close_fds();
        _dbf_skip = total;
        return dbus_frame_next();
    }

    if (avail < total) {
        if (_dbf_eof != 0) { return dbus_frame_truncated(); }
        return dbus_frame_need_more();
    }
    return total;
}

# Consume the head message. Its descriptors go with it: every one the
# caller did not claim is closed here, so no message — however it was
# parsed, or not — can leave a descriptor for the next one (1.1.2).
fn dbus_frame_advance(n) {
    if (n <= 0) { return 0; }
    _dbf_off = _dbf_off + n;
    if (_dbf_off > _dbf_have) { _dbf_off = _dbf_have; }
    dbus_frame_close_fds();
    return 0;
}

# --- dbus_socket.cyr ---

# @internal — native-dbus transport
# dbus_socket.cyr — connect to the bus, and read/write reliably.
#
# Two things here are not obvious and both were measured rather
# than assumed:
#
# 1. THE SEND PATH MUST NOT BE sys_write. Writing to a socket whose
#    peer has gone raises SIGPIPE, whose default disposition kills
#    the process. samvada is a library inside a compositor; killing
#    mabda because logind restarted is not an acceptable failure
#    mode. `sendto(..., MSG_NOSIGNAL, 0, 0)` suppresses it at the
#    call, which is the only mechanism that is neither
#    process-global nor inherited across execve (SIG_IGN is both,
#    and samvada does not own the process's signal policy).
#
# 2. THE SEND GOES THROUGH THE STDLIB'S `sys_sendto`, NOT A NUMBER
#    OF OUR OWN. Until 1.1.0 this file pinned sendto per arch (206
#    on aarch64, 44 on x86_64), because the stdlib had no send side;
#    cyrius 6.6.5 added `sys_sendto` / `SYS_SENDTO`. A native aarch64
#    number in our own `#ifdef CYRIUS_ARCH_AARCH64` was also the
#    shape cyrius 6.7.12+ calls fragile: ELF-aarch64 builds rewrite
#    x86 syscall numbers through a compat chain that matches a
#    NUMBER, so a future row sourced at 206 would silently change
#    the call, and nothing judges a number returned from a fn. The
#    stdlib's spelling is gated in cyrius's own CI against exactly
#    that; ours was not. The proof that the call is sendto on either
#    arch is behavioural — tests/dbus_auth.tcyr's departed-peer
#    group gets -EPIPE and survives, which a write(2) would not.

fn dbus_socket_msg_nosignal() { return 16384; }

# ---- sockaddr_un ----
# struct sockaddr_un { u16 sun_family@0; char sun_path[108]@2; }
# sizeof == 110. AF_UNIX == 1.
#
# The two address forms need DIFFERENT addrlen rules, and conflating
# them is the mistake this file exists to prevent:
#
#   filesystem: sun_path holds a NUL-terminated path
#               addrlen = 2 + strlen(path) + 1
#   abstract:   sun_path[0] is a LITERAL NUL, then the name, and
#               there is NO trailing NUL
#               addrlen = 2 + 1 + namelen
#
# Applying the filesystem rule to an abstract name is wrong twice:
# it omits the leading NUL and adds a trailing one, so the kernel
# looks up a filesystem path that does not exist.
fn dbus_socket_sockaddr_un_size() { return 110; }
fn dbus_socket_af_unix()          { return 1; }
fn dbus_socket_sock_stream()      { return 1; }

fn _dbus_sock_zero(p, n) {
    var i = 0;
    while (i < n) { store8(p + i, 0); i = i + 1; }
    return 0;
}

# Build a filesystem-path sockaddr_un at `sa`. Returns addrlen, or
# -22 if the path does not fit (it is REFUSED, never clamped —
# a truncated socket path silently connects somewhere else).
fn dbus_socket_addr_path(sa, path, pathlen) {
    if (sa == 0)      { return -22; }
    if (path == 0)    { return -22; }
    if (pathlen <= 0) { return -22; }
    if (pathlen > 107) { return -22; }        # 108 minus the NUL
    _dbus_sock_zero(sa, dbus_socket_sockaddr_un_size());
    store8(sa + 0, dbus_socket_af_unix());
    store8(sa + 1, 0);
    var i = 0;
    while (i < pathlen) {
        store8(sa + 2 + i, load8(path + i));
        i = i + 1;
    }
    store8(sa + 2 + pathlen, 0);
    return 2 + pathlen + 1;
}

# Build an ABSTRACT-namespace sockaddr_un at `sa`. Returns addrlen.
fn dbus_socket_addr_abstract(sa, name, namelen) {
    if (sa == 0)      { return -22; }
    if (name == 0)    { return -22; }
    if (namelen <= 0) { return -22; }
    if (namelen > 107) { return -22; }
    _dbus_sock_zero(sa, dbus_socket_sockaddr_un_size());
    store8(sa + 0, dbus_socket_af_unix());
    store8(sa + 1, 0);
    store8(sa + 2, 0);                        # the leading NUL
    var i = 0;
    while (i < namelen) {
        store8(sa + 3 + i, load8(name + i));
        i = i + 1;
    }
    return 2 + 1 + namelen;                   # NO trailing NUL
}

# ---- connect ----
# Returns the connected fd, or a negative errno. The socket is
# CLOEXEC: samvada hands DRM master fds to a compositor that spawns
# clients, and the bus connection has no business surviving into
# them.
fn dbus_socket_sock_cloexec() { return 524288; }   # SOCK_CLOEXEC

# ---- bounding a blocking receive ----
# Values verified on the host rather than copied from a header:
# SOL_SOCKET=1, SO_RCVTIMEO=20, struct timeval is 16 bytes with
# tv_sec at +0 and tv_usec at +8. A 1-second timeout on an idle
# socketpair was measured returning -1/EAGAIN after 1.02s.
#
# sys_setsockopt is used rather than a raw syscall on purpose: the
# aarch64 backend remaps setsockopt (54 -> 208) through an
# x86-compat socket shim, so the stdlib wrapper is the only form
# that is correct on both arches.
fn dbus_socket_sol_socket()  { return 1; }
fn dbus_socket_so_rcvtimeo() { return 20; }
fn dbus_socket_so_sndtimeo() { return 21; }

# One timeval, allocated on first use: this runs on every connect, and
# alloc() never frees (1.1.1, A-1).
var _dbsk_tv = 0;

fn dbus_socket_set_recv_timeout(fd, secs, usecs) {
    if (fd < 0)    { return -22; }
    if (secs < 0)  { return -22; }
    if (usecs < 0) { return -22; }
    if (_dbsk_tv == 0) { _dbsk_tv = alloc(16); }
    if (_dbsk_tv == 0) { return -12; }
    var tv = _dbsk_tv;
    store64(tv + 0, secs);
    store64(tv + 8, usecs);
    return sys_setsockopt(fd, dbus_socket_sol_socket(),
      dbus_socket_so_rcvtimeo(), tv, 16);
}

# The send's counterpart (1.1.2). The call path bounds every send by its
# deadline; this is the backstop for when the clock has failed, so a
# blocking send to a broker that stopped reading cannot block for ever.
fn dbus_socket_set_send_timeout(fd, secs, usecs) {
    if (fd < 0)    { return -22; }
    if (secs < 0)  { return -22; }
    if (usecs < 0) { return -22; }
    if (_dbsk_tv == 0) { _dbsk_tv = alloc(16); }
    if (_dbsk_tv == 0) { return -12; }
    var tv = _dbsk_tv;
    store64(tv + 0, secs);
    store64(tv + 8, usecs);
    return sys_setsockopt(fd, dbus_socket_sol_socket(),
      dbus_socket_so_sndtimeo(), tv, 16);
}

# The receive timeout is armed HERE, at connect, not at first call —
# so it covers the SASL handshake too. Before this, a peer that
# accepted the connection and then said nothing hung samvada
# forever: the socket is blocking, nothing else called setsockopt,
# and the reply loop's "64 spins" is a MESSAGE budget, not a clock.
# Inside a compositor that is an indefinite freeze.
#
# 25 seconds matches DBUS_DEFAULT_TIMEOUT and sd-bus's
# BUS_DEFAULT_TIMEOUT, so samvada gives up on the same schedule as
# every other client on the bus.
fn dbus_socket_default_timeout_secs() { return 25; }

# F_DUPFD_CLOEXEC (Linux 1030; the stdlib's FcntlCmd stops at F_SETFL).
fn dbus_socket_f_dupfd_cloexec() { return 1030; }

# Never leave the bus on a stdio number (1.1.2). A process that closed
# stdin gets its socket at 0, which the public layer read as "no bus"
# and refused, leaking the connection; at 1 or 2, any later print would
# write into the dbus stream. So a socket on 0..2 is moved to the lowest
# number >= 3, close-on-exec, and the original closed.
fn dbus_socket_above_stdio(fd) {
    if (fd > 2) { return fd; }
    var nfd = sys_fcntl(fd, dbus_socket_f_dupfd_cloexec(), 3);
    sys_close(fd);
    return nfd;
}

fn dbus_socket_connect(sa, addrlen) {
    if (sa == 0)      { return -22; }
    if (addrlen <= 0) { return -22; }
    var t = dbus_socket_sock_stream() | dbus_socket_sock_cloexec();
    var fd0 = sys_socket(dbus_socket_af_unix(), t, 0);
    if (fd0 < 0) { return fd0; }
    var fd = dbus_socket_above_stdio(fd0);
    if (fd < 0) { return fd; }
    var rc = sys_connect(fd, sa, addrlen);
    if (rc < 0) {
        sys_close(fd);
        return rc;
    }
    # Best-effort: a kernel that refuses the option must not stop us
    # connecting. The call-level deadline is the real bound.
    dbus_socket_set_recv_timeout(fd, dbus_socket_default_timeout_secs(), 0);
    dbus_socket_set_send_timeout(fd, dbus_socket_default_timeout_secs(), 0);
    return fd;
}

# ---- reliable write ----
# Lives in dbus_session.cyr as _dbs_write since 1.1.2, where the call's
# deadline bounds it: a unix STREAM socket may accept fewer bytes than
# offered, so it loops — a torn request desynchronises the connection —
# and every send carries MSG_NOSIGNAL (above). The blocking write_all
# that lived here bounded nothing.

# --- dbus_auth.cyr ---

# @internal — native-dbus SASL handshake
# dbus_auth.cyr — the connect-time authentication exchange.
#
# What the reference client actually sends, captured in
# tests/fixtures/dbus/01-sasl-client.bin — ONE pipelined 48-byte
# write, with an EMPTY-CREDENTIAL `DATA` step:
#
#   \0 AUTH EXTERNAL\r\n DATA\r\n NEGOTIATE_UNIX_FD\r\n BEGIN\r\n
#
# This is NOT the `AUTH EXTERNAL <hex(ascii(uid))>` ping-pong that
# docs/architecture/dbus-marshalling.md described until 0.7.1. Both
# forms are legal; only one is what libsystemd emits, and a reader
# built for the other blocks forever on a line that already arrived.
#
# The server answers with THREE lines in ONE read
# (01-sasl-server.bin, 58 bytes here):
#
#   DATA\r\n OK <guid>\r\n AGREE_UNIX_FD\r\n
#
# 58 is DERIVED (6 + 3 + 32 + 2 + 15), not a protocol constant: the
# same handshake yields 43 bytes without NEGOTIATE_UNIX_FD and 52
# via the hex-uid form. Never size a read or a state machine off it.
#
# This module borrows dbus_frame.cyr's buffer through
# tail/space/commit rather than owning one. alloc() never frees, and
# a private buffer would either copy or lose the residual — the
# server is free to pipeline, so binary message bytes can arrive in
# the same read as AGREE_UNIX_FD.

fn dbus_auth_ok()        { return 0; }
fn dbus_auth_need_more() { return -1100; }
fn dbus_auth_rejected()  { return -1101; }
fn dbus_auth_error()     { return -1102; }

# The exact 48 bytes, byte for byte from the fixture.
fn dbus_auth_blob_len() { return 48; }

fn dbus_auth_write_blob(p) {
    var s = "\x00AUTH EXTERNAL\r\nDATA\r\nNEGOTIATE_UNIX_FD\r\nBEGIN\r\n";
    # The leading NUL means strlen cannot measure this; the length is
    # pinned and asserted against the fixture instead.
    store8(p + 0, 0);
    var lit = "AUTH EXTERNAL\r\nDATA\r\nNEGOTIATE_UNIX_FD\r\nBEGIN\r\n";
    var n = strlen(lit);
    var i = 0;
    while (i < n) {
        store8(p + 1 + i, load8(lit + i));
        i = i + 1;
    }
    return 1 + n;
}

# Find a CRLF in [p, p+len). Returns the index of the '\r', or -1.
# Line-oriented over a buffer: the three server lines can arrive in
# one read, in three, or split mid-line.
fn dbus_auth_find_crlf(p, len) {
    var i = 0;
    while (i + 1 < len) {
        var c = load8(p + i);
        if (c == 13) {
            if (load8(p + i + 1) == 10) { return i; }
        }
        i = i + 1;
    }
    return (0 - 1);
}

fn _dbus_auth_starts(p, len, lit) {
    var n = strlen(lit);
    if (len < n) { return 0; }
    var i = 0;
    while (i < n) {
        if (load8(p + i) != load8(lit + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# `OK <guid>`: the server's GUID is exactly 32 hex digits (the D-Bus
# specification's "OK <server_guid>"; sd-bus's client refuses anything
# else). Until 1.1.2 any line starting `OK ` counted — `OK ` alone
# included (P(-1) re-verification).
fn _dbus_auth_is_ok(p, len) {
    if (len != 35) { return 0; }
    if (_dbus_auth_starts(p, len, "OK ") == 0) { return 0; }
    var i = 3;
    while (i < 35) {
        var c = load8(p + i);
        var hex = 0;
        if (c >= 48) { if (c <= 57)  { hex = 1; } }     # 0-9
        if (c >= 97) { if (c <= 102) { hex = 1; } }     # a-f
        if (c >= 65) { if (c <= 70)  { hex = 1; } }     # A-F
        if (hex == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Classify one server line (without its CRLF).
#   1 = DATA, 2 = OK, 3 = AGREE_UNIX_FD,
#   4 = REJECTED, 5 = ERROR, 0 = anything else
# An `OK ` line without a valid GUID is an ERROR (5), not "anything
# else": it is the server saying OK, wrongly.
fn dbus_auth_line_kind(p, len) {
    if (_dbus_auth_starts(p, len, "DATA") != 0)          { return 1; }
    if (_dbus_auth_starts(p, len, "OK ") != 0) {
        if (_dbus_auth_is_ok(p, len) != 0) { return 2; }
        return 5;
    }
    if (_dbus_auth_starts(p, len, "AGREE_UNIX_FD") != 0) { return 3; }
    if (_dbus_auth_starts(p, len, "REJECTED") != 0)      { return 4; }
    if (_dbus_auth_starts(p, len, "ERROR") != 0)         { return 5; }
    return 0;
}

# Consume as many complete server lines as the buffer holds, and say
# whether the handshake is done.
#
# Returns ok once AGREE_UNIX_FD has been seen; need_more while lines
# are still outstanding; rejected or error on refusal. The buffer
# cursor is left exactly where the BINARY stream begins, so the
# framer can take over with no copy.
#
# A server that refuses fd passing answers ERROR and is reported as
# `error`; there is no separate "no fds" status (1.1.2 removed the
# never-produced dbus_auth_no_fds, -1103).
#
# The property that actually matters, and it holds: this can only
# return `ok` by having SEEN AGREE_UNIX_FD. samvada cannot do
# TakeDevice without SCM_RIGHTS, so an `ok` that skipped fd
# negotiation would be a silent downgrade to a bus it cannot use.
# Pinned by test_sasl_reader_survives_hostile_input case (8).
#
# And AGREE_UNIX_FD counts only AFTER `OK` (1.1.2). It answers
# NEGOTIATE_UNIX_FD, which the spec allows only once the server has
# accepted the authentication; until 1.1.2 an AGREE alone was success,
# so a server that never authenticated samvada could still be treated
# as an authenticated bus. Case (9).
var _dbus_auth_saw_ok    = 0;
var _dbus_auth_saw_agree = 0;

fn dbus_auth_reset() {
    _dbus_auth_saw_ok = 0;
    _dbus_auth_saw_agree = 0;
    return 0;
}

fn dbus_auth_drain_lines() {
    while (1 == 1) {
        var p = dbus_frame_base();
        var have = dbus_frame_have();
        if (have <= 0) { return dbus_auth_need_more(); }
        var at = dbus_auth_find_crlf(p, have);
        if (at < 0) { return dbus_auth_need_more(); }

        var kind = dbus_auth_line_kind(p, at);
        dbus_frame_consume(at + 2);

        if (kind == 4) { return dbus_auth_rejected(); }
        if (kind == 5) { return dbus_auth_error(); }
        if (kind == 2) { _dbus_auth_saw_ok = 1; }
        if (kind == 3) {
            if (_dbus_auth_saw_ok == 0) { return dbus_auth_error(); }
            _dbus_auth_saw_agree = 1;
            return dbus_auth_ok();
        }
        # kind 1 (DATA) and 0 (unknown-but-not-fatal) simply advance.
    }
    return dbus_auth_need_more();
}

# --- dbus_marshal.cyr ---

# @internal — native-dbus message encoder
# dbus_marshal.cyr — builds a dbus message into a buffer.
#
# Scope is the fence in ADR-0003: the types samvada's frozen API
# actually exercises — `u`, `s`, `o`, `g`, `b`, and `h` as a body
# index. Not `y n q i x t d a (...) v`.
#
# ALIGNMENT IS RELATIVE TO THE START OF THE MESSAGE. Every message
# here begins at offset 0 of its own buffer, so buffer offset and
# message offset coincide — which is a convenience, not a licence.
# The moment that stops being true (a second message appended into
# the same buffer) every align call must take the message base. The
# N2 decoder shipped that bug and it cost a false "truncated" claim.
#
# Layout, from tests/fixtures/dbus/02-hello-call.bin:
#   +0  endian 'l'      +1 type      +2 flags     +3 proto=1
#   +4  body_len(u32)   +8 serial    +12 fields_len(u32)
#   +16 header fields — each a (yv) struct, 8-ALIGNED:
#          code(u8) siglen(u8) sig NUL   then the value at ITS
#          own natural alignment (4 for u/s/o, 1 for g)
#   fields_len EXCLUDES the trailing pad; the body starts at
#   align8(16 + fields_len).

fn dbus_marshal_cap() { return 4096; }

fn dbus_marshal_type_call()   { return 1; }
fn dbus_marshal_type_return() { return 2; }
fn dbus_marshal_type_error()  { return 3; }
fn dbus_marshal_type_signal() { return 4; }

# Header field codes.
fn dbus_marshal_f_path()      { return 1; }
fn dbus_marshal_f_interface() { return 2; }
fn dbus_marshal_f_member()    { return 3; }
fn dbus_marshal_f_errname()   { return 4; }
fn dbus_marshal_f_replyser()  { return 5; }
fn dbus_marshal_f_dest()      { return 6; }
fn dbus_marshal_f_sender()    { return 7; }
fn dbus_marshal_f_signature() { return 8; }
fn dbus_marshal_f_unixfds()   { return 9; }

var _dbm_buf   = 0;
var _dbm_at    = 0;   # write cursor
var _dbm_fend  = 0;   # where the header-fields array ended
var _dbm_ready = 0;

# ---- overflow guard ----
# Every writer below advanced _dbm_at with NO check against
# dbus_marshal_cap(). A caller-supplied length reached _dbm_bytes
# unvalidated, so a negative length walked the cursor BACKWARDS out
# of the buffer's start, and an oversized one wrote past its end —
# after which dbus_marshal_finish() returned the oversized total and
# dbus_session_call would have handed that straight to write_all,
# putting adjacent heap on the wire.
#
# dbus_marshal_field_str and dbus_marshal_body_str are exported in
# dist/samvada.cyr, so the length is not necessarily samvada's own.
#
# It POISONS rather than truncating, deliberately: a message that did
# not fit must never go out as a shorter, still-parseable one.
var _dbm_bad = 0;

fn dbus_marshal_bad() { return _dbm_bad; }

fn _dbm_room(n) {
    if (_dbm_bad != 0) { return 0; }
    if (n < 0)         { _dbm_bad = 1; return 0; }
    if (_dbm_at < 0)   { _dbm_bad = 1; return 0; }
    var end = _dbm_at + n;
    if (end > dbus_marshal_cap()) { _dbm_bad = 1; return 0; }
    return 1;
}

fn dbus_marshal_align(n, a) {
    return (n + a - 1) & (0 - a);
}

fn _dbm_pad_to(a) {
    var want = dbus_marshal_align(_dbm_at, a);
    if (_dbm_room(want - _dbm_at) == 0) { return -22; }
    while (_dbm_at < want) {
        store8(_dbm_buf + _dbm_at, 0);
        _dbm_at = _dbm_at + 1;
    }
    return 0;
}

fn _dbm_u8(v) {
    if (_dbm_room(1) == 0) { return -22; }
    store8(_dbm_buf + _dbm_at, v & 0xFF);
    _dbm_at = _dbm_at + 1;
    return 0;
}

# Little-endian u32. samvada always emits 'l': both target arches
# are little-endian, and emitting native order is what every dbus
# implementation does.
fn _dbm_u32(v) {
    if (_dbm_room(4) == 0) { return -22; }
    store8(_dbm_buf + _dbm_at + 0, v & 0xFF);
    store8(_dbm_buf + _dbm_at + 1, (v >> 8) & 0xFF);
    store8(_dbm_buf + _dbm_at + 2, (v >> 16) & 0xFF);
    store8(_dbm_buf + _dbm_at + 3, (v >> 24) & 0xFF);
    _dbm_at = _dbm_at + 4;
    return 0;
}

fn _dbm_bytes(p, n) {
    if (_dbm_room(n) == 0) { return -22; }
    var i = 0;
    while (i < n) {
        store8(_dbm_buf + _dbm_at + i, load8(p + i));
        i = i + 1;
    }
    _dbm_at = _dbm_at + n;
    return 0;
}

# Start a message. `flags` is 0 for a normal call — the captured
# Hello uses 0x00, and replies use 0x01 (NO_REPLY_EXPECTED).
fn dbus_marshal_begin(mtype, flags, serial) {
    _dbm_bad = 0;                   # a new message starts unpoisoned
    if (_dbm_ready == 0) {
        _dbm_buf = alloc(dbus_marshal_cap());
        if (_dbm_buf == 0) { return -12; }
        _dbm_ready = 1;
    }
    _dbm_at = 0;
    _dbm_u8(108);              # 'l'
    _dbm_u8(mtype);
    _dbm_u8(flags);
    _dbm_u8(1);                # protocol version
    _dbm_u32(0);               # body_len, backfilled
    _dbm_u32(serial);
    _dbm_u32(0);               # fields_len, backfilled
    _dbm_fend = 0;
    return 0;
}

# A (yv) header field carrying a string-shaped value: `s` or `o`.
fn dbus_marshal_field_str(code, sigch, str, len) {
    _dbm_pad_to(8);
    _dbm_u8(code);
    _dbm_u8(1);                # signature length
    _dbm_u8(sigch);
    _dbm_u8(0);                # signature NUL
    _dbm_pad_to(4);
    _dbm_u32(len);
    _dbm_bytes(str, len);
    _dbm_u8(0);                # string NUL, not counted in len
    return 0;
}

fn dbus_marshal_field_u32(code, val) {
    _dbm_pad_to(8);
    _dbm_u8(code);
    _dbm_u8(1);
    _dbm_u8(117);              # 'u'
    _dbm_u8(0);
    _dbm_pad_to(4);
    _dbm_u32(val);
    return 0;
}

# A signature-valued field (code 8). `g` is length-prefixed by ONE
# byte and needs no alignment — the trap is treating it like `s`.
fn dbus_marshal_field_sig(code, sig, len) {
    # A signature is at most 255 bytes, and its length is ONE byte. A
    # longer one was written as len & 0xFF followed by all `len` bytes —
    # a message whose length byte disagrees with its contents. It
    # poisons the message now, like any other write that cannot fit
    # (1.1.2).
    if (len > 255) { _dbm_bad = 1; return -22; }
    _dbm_pad_to(8);
    _dbm_u8(code);
    _dbm_u8(1);
    _dbm_u8(103);              # 'g'
    _dbm_u8(0);
    _dbm_u8(len);
    _dbm_bytes(sig, len);
    _dbm_u8(0);
    return 0;
}

# Close the fields array. fields_len EXCLUDES the pad that follows,
# so it is recorded before padding to the body's 8-alignment.
fn dbus_marshal_end_fields() {
    _dbm_fend = _dbm_at;
    var flen = _dbm_at - 16;
    store8(_dbm_buf + 12, flen & 0xFF);
    store8(_dbm_buf + 13, (flen >> 8) & 0xFF);
    store8(_dbm_buf + 14, (flen >> 16) & 0xFF);
    store8(_dbm_buf + 15, (flen >> 24) & 0xFF);
    _dbm_pad_to(8);
    return 0;
}

# ---- body ----
fn dbus_marshal_body_u32(v) {
    _dbm_pad_to(4);
    _dbm_u32(v);
    return 0;
}

# `b` is a uint32 on the wire, strictly 0 or 1 — one byte
# semantically, four bytes physically.
fn dbus_marshal_body_bool(v) {
    var b = 0;
    if (v != 0) { b = 1; }
    _dbm_pad_to(4);
    _dbm_u32(b);
    return 0;
}

fn dbus_marshal_body_str(str, len) {
    _dbm_pad_to(4);
    _dbm_u32(len);
    _dbm_bytes(str, len);
    _dbm_u8(0);
    return 0;
}

# Finish: backfill body_len and return the total on-wire length.
fn dbus_marshal_finish() {
    var body_start = dbus_marshal_align(_dbm_fend, 8);
    var blen = _dbm_at - body_start;
    if (blen < 0) { blen = 0; }
    store8(_dbm_buf + 4, blen & 0xFF);
    store8(_dbm_buf + 5, (blen >> 8) & 0xFF);
    store8(_dbm_buf + 6, (blen >> 16) & 0xFF);
    store8(_dbm_buf + 7, (blen >> 24) & 0xFF);
    return _dbm_at;
}

fn dbus_marshal_buf() { return _dbm_buf; }
fn dbus_marshal_len() { return _dbm_at; }

# --- dbus_unmarshal.cyr ---

# @internal — native-dbus message decoder
# dbus_unmarshal.cyr — reads header fields and body values out of a
# framed message.
#
# Operates on a message the framer has already declared COMPLETE, so
# it never has to deal with a partial tail — that separation is why
# neither module needs the other's edge cases.
#
# Two rules govern everything here, and both were paid for:
#
# 1. **Alignment is relative to the START OF THE MESSAGE.** Every
#    offset below is message-relative and `p` is the message base.
#    The N2 decoder aligned against the buffer origin, which works
#    for the first message in a read and silently mis-reads the
#    second.
#
# 2. **Header u32s are read with load32, which zero-extends.**
#    `load64` swallows the neighbouring field: on the bus's very
#    first reply, `load64(p + 4)` returns -4294967283 because the
#    0xFFFFFFFF serial sits in the high half. Note this is the
#    OPPOSITE of dbus_sys.cyr, which sign-extends correctly because
#    an SCM_RIGHTS payload really is a signed int32 fd.
#
# Field ORDER is never assumed. The corpus shows [1,3,2,6] on a
# call, [5,7,6,8] on its reply and [5,6,8,9,7] on an fd-bearing
# reply — it is an implementation choice, so fields are always
# located by scanning for their code.

# ---- message bounds ----
# The 2026-09-09 pre-1.0 audit found this module trusting three
# separate wire-supplied lengths without checking any of them
# against the bytes actually present:
#
#   * a string field claiming length 0xFFFFFFF0 had that length
#     handed straight back to the caller;
#   * `find_field` walked to `16 + fields_len` even when fields_len
#     exceeded the whole message;
#   * the body cursor set its end from `body_len` alone.
#
# None was reachable through samvada's own call paths, because the
# framer only ever yields a message once `avail >= total` — so the
# header lengths are already consistent with the bytes present. But
# "unreachable because the caller happens to validate first" is the
# exact shape of CRIT-1 and CRIT-2, and this module is exported in
# the consumer bundle. So the limit is now explicit and enforced
# here rather than assumed of the caller.
var _dbu_limit = 0;      # total on-wire length of the current message

# Declare the message's true extent. Every caller that has a framed
# message knows it: dbus_frame_next() returns exactly this number.
# FAIL-CLOSED. The 1.0.0 guards were all written `if (_dbu_limit > 0)`
# and _dbu_limit defaults to 0 — so the decoder's DEFAULT state had NO
# bounds at all, and a wire-supplied 0xFFFFFFF0 length was handed back
# to the caller verbatim. That is AUDIT-1 again, re-openable by any
# path that forgets to set a limit, and this module is exported in the
# consumer bundle where callers we do not control reach it.
#
# An unset or nonsensical limit now means EVERYTHING is malformed,
# rather than everything being permitted. A bounds check whose default
# is "no bounds" is not a bounds check.
fn dbus_unmarshal_set_limit(total) {
    if (total <= 0) { _dbu_limit = 0; return -22; }
    _dbu_limit = total;
    return 0;
}

fn dbus_unmarshal_limit() { return _dbu_limit; }

fn dbus_unmarshal_notfound() { return -1200; }
fn dbus_unmarshal_malformed(){ return -1201; }

fn dbus_unmarshal_align(n, a) {
    return (n + a - 1) & (0 - a);
}

fn dbus_unmarshal_u32(p, off) {
    return load32(p + off);
}

fn dbus_unmarshal_body_len(p)   { return dbus_unmarshal_u32(p, 4); }
fn dbus_unmarshal_serial(p)     { return dbus_unmarshal_u32(p, 8); }
fn dbus_unmarshal_fields_len(p) { return dbus_unmarshal_u32(p, 12); }
fn dbus_unmarshal_type(p)       { return load8(p + 1); }

fn dbus_unmarshal_body_off(p) {
    return dbus_unmarshal_align(16 + dbus_unmarshal_fields_len(p), 8);
}

# The wire size (= alignment) of a fixed-size basic type, 0 if `t` is
# not one. What lets the walk below step over a header field samvada
# does not use, whatever basic type it carries (1.1.2).
fn _dbu_basic_size(t) {
    if (t == 121) { return 1; }               # 'y'
    if (t == 110) { return 2; }               # 'n'
    if (t == 113) { return 2; }               # 'q'
    if (t == 98)  { return 4; }               # 'b'
    if (t == 105) { return 4; }               # 'i'
    if (t == 117) { return 4; }               # 'u'
    if (t == 104) { return 4; }               # 'h'
    if (t == 120) { return 8; }               # 'x'
    if (t == 116) { return 8; }               # 't'
    if (t == 100) { return 8; }               # 'd'
    return 0;
}

# The type the spec's header-field table REQUIRES of each defined code,
# or 0 for a code it does not define (which may carry anything).
fn _dbu_field_type(code) {
    if (code == 1) { return 111; }            # PATH          'o'
    if (code == 2) { return 115; }            # INTERFACE     's'
    if (code == 3) { return 115; }            # MEMBER        's'
    if (code == 4) { return 115; }            # ERROR_NAME    's'
    if (code == 5) { return 117; }            # REPLY_SERIAL  'u'
    if (code == 6) { return 115; }            # DESTINATION   's'
    if (code == 7) { return 115; }            # SENDER        's'
    if (code == 8) { return 103; }            # SIGNATURE     'g'
    if (code == 9) { return 117; }            # UNIX_FDS      'u'
    return 0;
}

# Locate a header field by code. Returns the message-relative offset
# of its VALUE, or notfound. `sig_out` receives the signature's
# first byte so the caller can tell `s` from `o` from `u` from `g`.
#
# Each field is a (yv) struct: 8-aligned, then code(u8) siglen(u8)
# sig NUL, then the value at its own natural alignment.
#
# 1.1.2, three changes, each from the P(-1) audit:
#   * A field of any BASIC type is stepped over. The walk knew only
#     s/o/u/g, so a legal unknown field of another type ahead of the one
#     wanted made the whole array "malformed" — which is how a message
#     could hide its UNIX_FDS (H1; descriptors no longer depend on it).
#     A container-typed field is still refused: no bus emits one, and
#     refusing is the fail-closed answer.
#   * A defined field with the wrong type makes the message malformed,
#     as in sd-bus (bus_message_parse_fields: -EBADMSG). Until then a
#     REPLY_SERIAL typed `s` was read as a u32 — its string's length.
#   * The limit is checked BEFORE fields_len is read, so an unset limit
#     reads nothing at all.
fn dbus_unmarshal_find_field(p, code, sig_out) {
    if (_dbu_limit < 16) { return dbus_unmarshal_malformed(); }
    var flen = dbus_unmarshal_fields_len(p);
    var end = 16 + flen;
    # Refuse a field array that claims to extend past the message.
    if (end > _dbu_limit) { return dbus_unmarshal_malformed(); }
    var at = 16;
    while (at < end) {
        at = dbus_unmarshal_align(at, 8);
        if (at >= end) { return dbus_unmarshal_notfound(); }
        # code, a one-byte signature and its NUL must all be inside.
        if (at + 4 > end) { return dbus_unmarshal_malformed(); }
        var c = load8(p + at);
        var siglen = load8(p + at + 1);
        if (siglen != 1) { return dbus_unmarshal_malformed(); }
        var sig0 = load8(p + at + 2);
        if (load8(p + at + 3) != 0) { return dbus_unmarshal_malformed(); }
        var want = _dbu_field_type(c);
        if (want != 0) {
            if (sig0 != want) { return dbus_unmarshal_malformed(); }
        }
        var vo = at + 4;

        var nxt = 0;
        var strish = 0;
        if (sig0 == 115) { strish = 1; }     # 's'
        if (sig0 == 111) { strish = 1; }     # 'o'
        if (strish == 1) {
            vo = dbus_unmarshal_align(vo, 4);
            if (vo + 4 > end) { return dbus_unmarshal_malformed(); }
            var n = dbus_unmarshal_u32(p, vo);
            nxt = vo + 4 + n + 1;
            # A length that runs past the field array is malformed,
            # not a value to hand back.
            if (nxt > end) { return dbus_unmarshal_malformed(); }
        }
        if (sig0 == 103) {                   # 'g'
            if (vo + 1 > end) { return dbus_unmarshal_malformed(); }
            var gn = load8(p + vo);
            nxt = vo + 1 + gn + 1;
            if (nxt > end) { return dbus_unmarshal_malformed(); }
        }
        if (nxt == 0) {
            var sz = _dbu_basic_size(sig0);
            if (sz == 0) { return dbus_unmarshal_malformed(); }
            vo = dbus_unmarshal_align(vo, sz);
            nxt = vo + sz;
            if (nxt > end) { return dbus_unmarshal_malformed(); }
        }
        if (nxt <= at) { return dbus_unmarshal_malformed(); }

        if (c == code) {
            if (sig_out != 0) { store64(sig_out, sig0); }
            return vo;
        }
        at = nxt;
    }
    return dbus_unmarshal_notfound();
}

# ---- validating the field array, once (1.1.2) ----
# Is [p, p+n) a valid object path? "/", or "/" followed by one or more
# segments of [A-Za-z0-9_], separated by single "/", with no trailing
# "/" (D-Bus specification, Valid Object Paths). No NUL can pass.
fn dbus_unmarshal_path_ok(p, n) {
    if (n <= 0) { return 0; }
    if (load8(p) != 47) { return 0; }         # '/'
    if (n == 1) { return 1; }
    if (load8(p + n - 1) == 47) { return 0; }  # trailing '/'
    var prev_slash = 1;
    var i = 1;
    while (i < n) {
        var c = load8(p + i);
        var ok = 0;
        if (c == 47) {
            if (prev_slash == 1) { return 0; } # empty segment
            prev_slash = 1;
            ok = 1;
        }
        if (ok == 0) {
            var word = 0;
            if (c >= 65) { if (c <= 90)  { word = 1; } }    # A-Z
            if (c >= 97) { if (c <= 122) { word = 1; } }    # a-z
            if (c >= 48) { if (c <= 57)  { word = 1; } }    # 0-9
            if (c == 95) { word = 1; }                       # _
            if (word == 0) { return 0; }
            prev_slash = 0;
        }
        i = i + 1;
    }
    return 1;
}

# 1 if none of [p, p+n) is NUL.
fn _dbu_no_nul(p, n) {
    var i = 0;
    while (i < n) {
        if (load8(p + i) == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Validate the whole header-field array, as sd-bus's
# bus_message_parse_fields does before anything is read from it: no
# INVALID (0) code; no defined field twice; every defined field of its
# defined type; every string, object path and signature NUL-terminated,
# with no NUL inside; every object path valid. Returns 0, or malformed.
#
# Until 1.1.2 nothing looked past the field a caller asked for, so
# whether a malformed message was accepted depended on field ORDER: a
# reply with DESTINATION ahead of a garbage field was accepted and
# handed out its descriptor, the same reply without DESTINATION was
# walked to the end and dropped (P(-1) re-verification). Every message
# the call path considers is validated first, whatever it carries.
fn dbus_unmarshal_validate(p) {
    if (_dbu_limit < 16) { return dbus_unmarshal_malformed(); }
    var flen = dbus_unmarshal_fields_len(p);
    var end = 16 + flen;
    if (end > _dbu_limit) { return dbus_unmarshal_malformed(); }
    var seen = 0;
    var at = 16;
    while (at < end) {
        at = dbus_unmarshal_align(at, 8);
        if (at >= end) { return 0; }
        if (at + 4 > end) { return dbus_unmarshal_malformed(); }
        var c = load8(p + at);
        if (c == 0) { return dbus_unmarshal_malformed(); }          # INVALID
        if (load8(p + at + 1) != 1) { return dbus_unmarshal_malformed(); }
        var sig0 = load8(p + at + 2);
        if (load8(p + at + 3) != 0) { return dbus_unmarshal_malformed(); }
        var want = _dbu_field_type(c);
        if (want != 0) {
            if (sig0 != want) { return dbus_unmarshal_malformed(); }
            var bit = 1 << c;
            if ((seen & bit) != 0) { return dbus_unmarshal_malformed(); }
            seen = seen | bit;
        }
        var vo = at + 4;
        var nxt = 0;
        var strish = 0;
        if (sig0 == 115) { strish = 1; }     # 's'
        if (sig0 == 111) { strish = 1; }     # 'o'
        if (strish == 1) {
            vo = dbus_unmarshal_align(vo, 4);
            if (vo + 4 > end) { return dbus_unmarshal_malformed(); }
            var n = dbus_unmarshal_u32(p, vo);
            nxt = vo + 4 + n + 1;
            if (nxt > end) { return dbus_unmarshal_malformed(); }
            if (load8(p + vo + 4 + n) != 0) { return dbus_unmarshal_malformed(); }
            if (_dbu_no_nul(p + vo + 4, n) == 0) { return dbus_unmarshal_malformed(); }
            if (sig0 == 111) {
                if (dbus_unmarshal_path_ok(p + vo + 4, n) == 0) { return dbus_unmarshal_malformed(); }
            }
        }
        if (sig0 == 103) {                   # 'g'
            if (vo + 1 > end) { return dbus_unmarshal_malformed(); }
            var gn = load8(p + vo);
            nxt = vo + 1 + gn + 1;
            if (nxt > end) { return dbus_unmarshal_malformed(); }
            if (load8(p + vo + 1 + gn) != 0) { return dbus_unmarshal_malformed(); }
            if (_dbu_no_nul(p + vo + 1, gn) == 0) { return dbus_unmarshal_malformed(); }
        }
        if (nxt == 0) {
            var sz = _dbu_basic_size(sig0);
            if (sz == 0) { return dbus_unmarshal_malformed(); }
            vo = dbus_unmarshal_align(vo, sz);
            nxt = vo + sz;
            if (nxt > end) { return dbus_unmarshal_malformed(); }
        }
        at = nxt;
    }
    return 0;
}

# Read a string-shaped value (`s` or `o`) at a message-relative
# offset. Returns its length and stores a pointer to the first byte.
# The bytes are NOT copied — they live in the framer's buffer and
# stay valid until dbus_frame_advance moves past this message.
fn dbus_unmarshal_str_at(p, off, ptr_out) {
    if (off < 0) { return dbus_unmarshal_malformed(); }
    if (_dbu_limit <= 0) { return dbus_unmarshal_malformed(); }
    if (off + 4 > _dbu_limit) { return dbus_unmarshal_malformed(); }
    var n = dbus_unmarshal_u32(p, off);
    # The length must fit inside the message. Returning it unchecked
    # invites the caller to copy gigabytes out of bounds.
    if (off + 4 + n + 1 > _dbu_limit) { return dbus_unmarshal_malformed(); }
    if (ptr_out != 0) { store64(ptr_out, p + off + 4); }
    return n;
}

# Read a signature value (`g`) — ONE length byte, not four. Treating
# it like `s` reads the signature text as a length.
fn dbus_unmarshal_sig_at(p, off, ptr_out) {
    if (off < 0) { return dbus_unmarshal_malformed(); }
    if (_dbu_limit <= 0) { return dbus_unmarshal_malformed(); }
    if (off + 1 > _dbu_limit) { return dbus_unmarshal_malformed(); }
    var n = load8(p + off);
    if (off + 1 + n + 1 > _dbu_limit) { return dbus_unmarshal_malformed(); }
    if (ptr_out != 0) { store64(ptr_out, p + off + 1); }
    return n;
}

# ---- body ----
# A cursor, because body values are positional and each is aligned
# relative to the message start.
var _dbu_p   = 0;
var _dbu_at  = 0;
var _dbu_end = 0;

fn dbus_unmarshal_body_begin(p) {
    _dbu_p = p;
    _dbu_at = dbus_unmarshal_body_off(p);
    _dbu_end = _dbu_at + dbus_unmarshal_body_len(p);
    # Clamp to the message's real extent. A header claiming a body
    # far larger than the bytes present would otherwise let the
    # cursor read past the end, one aligned value at a time.
    # An unset limit yields an EMPTY cursor rather than an unbounded
    # one: remaining() is 0 and every next_*() refuses.
    if (_dbu_limit <= 0) { _dbu_at = 0; _dbu_end = 0; return 0; }
    if (_dbu_end > _dbu_limit) { _dbu_end = _dbu_limit; }
    if (_dbu_at > _dbu_limit)  { _dbu_at = _dbu_limit; }
    return 0;
}

fn dbus_unmarshal_body_remaining() { return _dbu_end - _dbu_at; }

fn dbus_unmarshal_next_u32() {
    _dbu_at = dbus_unmarshal_align(_dbu_at, 4);
    if (_dbu_at + 4 > _dbu_end) { return dbus_unmarshal_malformed(); }
    var v = dbus_unmarshal_u32(_dbu_p, _dbu_at);
    _dbu_at = _dbu_at + 4;
    return v;
}

# `b` is a u32 on the wire; anything but 0 or 1 is malformed.
fn dbus_unmarshal_next_bool() {
    var v = dbus_unmarshal_next_u32();
    if (v == dbus_unmarshal_malformed()) { return v; }
    if (v > 1) { return dbus_unmarshal_malformed(); }
    return v;
}

fn dbus_unmarshal_next_str(ptr_out) {
    _dbu_at = dbus_unmarshal_align(_dbu_at, 4);
    if (_dbu_at + 4 > _dbu_end) { return dbus_unmarshal_malformed(); }
    var n = dbus_unmarshal_u32(_dbu_p, _dbu_at);
    if (_dbu_at + 4 + n + 1 > _dbu_end) { return dbus_unmarshal_malformed(); }
    if (ptr_out != 0) { store64(ptr_out, _dbu_p + _dbu_at + 4); }
    _dbu_at = _dbu_at + 4 + n + 1;
    return n;
}

# `h` is a 4-byte INDEX into the SCM_RIGHTS array, not an fd. The
# descriptor itself arrives out of band and is queued by
# dbus_frame; this returns the index to look up there.
fn dbus_unmarshal_next_fd_index() {
    return dbus_unmarshal_next_u32();
}

# --- dbus_session.cyr ---

# @internal — native-dbus logind session layer
# dbus_session.cyr — the logind calls (and Hello), natively.
#
# This is the module that has to match the FROZEN FFI SHAPES, and
# that constraint is not cosmetic. src/samvada.cyr dispatches with
# exactly:
#
#   fncall1(bus_slot, bus_out)
#   fncall4(sp_slot,  bus, pid, buf, len)
#   fncall2(tc_slot,  bus, sess)
#   fncall6(td_slot,  bus, sess, major, minor, fd_out, active_out)
#   fncall4(rd_slot,  bus, sess, major, minor)
#   fncall1(pump_slot, bus)
#   fncall1(close_slot, bus)
#
# So every native fn below is written to the C shim's ABI, INCLUDING
# the vestigial leading `bus` argument and the C-style out-pointer
# pairs — shapes that would never be chosen for a Cyrius-native
# design. Getting one wrong is a silent crash through fncallN, not a
# compile error, which is why the arities are pinned by tests.
#
# In native mode the "bus handle" is simply the connected socket fd.
#
# SESSION SELECTION — the open question this milestone had to
# settle, and the answer is DOCUMENT, not validate. GetSessionByPID
# returns the CALLER's session, which is not necessarily seated: on
# the development host it returns a `Seat=""` session while seat0
# belongs to the display manager, so TakeDevice cannot get DRM
# master there no matter what. Validating the session's `Seat`
# property would require org.freedesktop.DBus.Properties, which
# ADR-0003's scope fence defers past 1.0 — and widening the fence to
# produce a better error message is a bad trade. samvada therefore
# takes the caller's own session and surfaces logind's error
# verbatim. See public-api.md.
#
# SESSION PATH ESCAPING — logind returns paths like
# `/org/freedesktop/login1/session/_32`, where `_32` is the
# hex-escaped ASCII of '2'. samvada passes the path through
# OPAQUELY: it is only ever echoed back as a method target, never
# parsed or compared, so no unescaping is needed. Anything that
# starts comparing session ids must implement it first.

fn dbus_session_max_serial() { return 4294967295; }

var _dbs_serial = 0;

# ---- a dead connection is a state, not an event (1.1.1, A-4) ----
# Set the first time the connection is seen to have gone: an orderly
# close (EOF), a stream cut mid-message, or a disconnect errno from a
# send or a receive. sd-bus moves to CLOSING at that moment and answers
# from then on without touching the socket; samvada does the same, so
# the two backends return the same errno on the same disconnect:
#
#   the call that sees the drop           -ECONNRESET  (sd-bus: bus_enter_closing)
#   every later call                      -ENOTCONN    (sd-bus: !BUS_IS_OPEN)
#   pump_signals once the drop is seen    -ECONNRESET  (sd-bus: BUS_CLOSED)
#
# Until 1.1.1 there was no such state: a call after the drop wrote to
# the dead socket and got -EPIPE, EOF mid-call came back -ENOTCONN, a
# cut stream -EPROTO, and pump_signals returned 0 events forever.
# Cleared only by dbus_session_reset(), i.e. by a fresh connect.
var _dbs_closed = 0;

# ---- our own unique name, and why it is worth storing ----
# The bus assigns it in the Hello reply, which samvada used to read
# and throw away. Keeping it is what makes a provenance check
# possible at all: without it there is nothing to compare a reply's
# DESTINATION against.
#
# A word on what canNOT be checked. The obvious guard — "require
# SENDER to be org.freedesktop.login1" — is WRONG and would reject
# every genuine reply. The broker rewrites SENDER to the sender's
# UNIQUE id on every message it forwards (message_stitch_sender), so
# a real logind reply arrives with SENDER=":1.5". Verified against
# all four captured logind replies in tests/fixtures/dbus/: every
# one carries a unique name, never the well-known one. Only the bus
# driver is special-cased, sending as "org.freedesktop.DBus".
#
# Pinning logind's unique name on first use was considered and
# REJECTED: logind can restart and come back with a different id,
# which would strand a long-lived consumer with a stale pin and fail
# every subsequent call. That is a self-inflicted availability bug
# traded for very little — the DESTINATION check below already
# refuses anything not addressed to us.
var _dbs_uniq  = 0;         # copied out of the frame buffer, which moves
var _dbs_uniqn = 0;

# Copy, never alias: the name arrives inside the framer's buffer and
# dbus_frame_advance / compaction will move or overwrite it.
fn dbus_session_set_unique(p, n) {
    if (p == 0)  { return -22; }
    if (n <= 0)  { return -22; }
    if (n > 255) { return -22; }          # dbus caps any bus name at 255
    if (_dbs_uniq == 0) { _dbs_uniq = alloc(256); }
    if (_dbs_uniq == 0) { return -12; }
    var i = 0;
    while (i < n) { store8(_dbs_uniq + i, load8(p + i)); i = i + 1; }
    _dbs_uniqn = n;
    return 0;
}

fn _dbs_bytes_eq(a, an, b, bn) {
    if (an != bn) { return 0; }
    var i = 0;
    while (i < an) {
        var x = load8(a + i);
        var y = load8(b + i);
        if (x != y) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Pure, so the wrap is reachable from a test. Driving
# next_serial() to the u32 ceiling would take four billion calls;
# this makes the one branch that matters a one-line assertion.
fn dbus_session_wrap_serial(n) {
    if (n > dbus_session_max_serial()) { return 1; }
    if (n == 0) { return 1; }
    return n;
}

fn dbus_session_next_serial() {
    # Wrap within u32 and never yield 0, which the spec reserves.
    _dbs_serial = dbus_session_wrap_serial(_dbs_serial + 1);
    return _dbs_serial;
}

fn dbus_session_reset() {
    _dbs_serial = 0;
    _dbs_closed = 0;
    _dbs_uniqn = 0;
    _dbs_timeout_ms = 25000;
    _dbs_clock_fail = 0;
    return 0;
}

fn dbus_session_closed() { return _dbs_closed; }

# sd-bus's ERRNO_IS_NEG_DISCONNECT (systemd v262 src/basic/errno-util.h),
# for errnos a send or receive syscall returns. Only raw syscall results
# are classified: samvada's own deadline -ETIMEDOUT is not a disconnect,
# exactly as sd-bus's call timeout does not close the bus.
fn dbus_session_is_disconnect(e) {
    if (e == -103) { return 1; }                # ECONNABORTED
    if (e == -111) { return 1; }                # ECONNREFUSED
    if (e == -104) { return 1; }                # ECONNRESET
    if (e == -112) { return 1; }                # EHOSTDOWN
    if (e == -113) { return 1; }                # EHOSTUNREACH
    if (e == -100) { return 1; }                # ENETDOWN
    if (e == -102) { return 1; }                # ENETRESET
    if (e == -101) { return 1; }                # ENETUNREACH
    if (e == -64)  { return 1; }                # ENONET
    if (e == -92)  { return 1; }                # ENOPROTOOPT
    if (e == -107) { return 1; }                # ENOTCONN
    if (e == -32)  { return 1; }                # EPIPE
    if (e == -71)  { return 1; }                # EPROTO
    if (e == -108) { return 1; }                # ESHUTDOWN
    if (e == -110) { return 1; }                # ETIMEDOUT
    return 0;
}

# The connection just went: remember it, and answer as sd-bus does.
fn _dbs_lost() {
    _dbs_closed = 1;
    return -104;                                # -ECONNRESET
}

# A failed send or receive: a disconnect errno ends the connection,
# anything else is passed through unchanged.
fn _dbs_io_fail(e) {
    if (dbus_session_is_disconnect(e) != 0) { return _dbs_lost(); }
    return e;
}

# The errno for a framer fault, or 0 if `r` is not one. ONE mapping
# shared by the call path and pump_signals (1.1.2): until then each
# carried its own copy, and two copies of a parity table are how the
# backends drift apart. EOF, with or without a partial message, is the
# connection going — sd-bus reads it as -ECONNRESET either way
# (bus-socket.c) — so it latches _dbs_closed. An unreadable stream is
# -EPROTO (sd-bus says -EBADMSG for a bad endian byte: a documented
# divergence), and a message declaring >= 128 MiB is -ENOBUFS, as in
# sd-bus.
fn _dbs_frame_fault(r) {
    if (r == dbus_frame_eof())       { return _dbs_lost(); }
    if (r == dbus_frame_truncated()) { return _dbs_lost(); }
    if (r == dbus_frame_badendian()) { return -71; }
    if (r == dbus_frame_badproto())  { return -71; }
    if (r == dbus_frame_toolong())   { return -105; }
    return 0;
}

# ---- error mapping ----
# The frozen API promises "sd-bus errno pass-through", so the native
# backend has to reproduce libsystemd's dbus-name -> errno mapping
# or consumers branching on magnitudes break. This is the
# error-parity contract N6 verifies.
#
# 1.1.1 (A-4): the table is sd-bus's own, not a hand-picked subset.
# Through 1.1.0 it held eight names, and against libsystemd 262 it
# disagreed on the very errors a logind restart or a bus disconnect
# produce: ServiceUnknown came back -2 (sd-bus: -113), NoReply,
# Disconnected, NameHasNoOwner and NoSessionForPID all -5, and logind's
# DeviceIsTaken -5 instead of -22. A logind method that fails with a
# plain errno reaches the wire as `System.Error.<ERRNO>`, and only EBUSY
# was recognised. The ground truth is tests/fixtures/sdbus_errno_map.tsv,
# produced by tools/sdbus_errno_probe.c from libsystemd itself; the
# test asserts every row, and CI re-runs the probe against the runner's
# libsystemd. Scope: org.freedesktop.DBus.Error.* (sd-bus's own map),
# org.freedesktop.login1.* and System.Error.* — the only peers samvada
# calls. Anything else is -EIO, as it is in sd-bus.
fn _dbs_has_prefix(p, n, lit) {
    var ln = strlen(lit);
    if (n < ln) { return 0; }
    var i = 0;
    while (i < ln) {
        if (load8(p + i) != load8(lit + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn _dbs_name_is(p, n, lit) {
    if (n != strlen(lit)) { return 0; }
    return _dbs_has_prefix(p, n, lit);
}

# System.Error.<NAME> -> errno, as sd-bus's errno_from_name() reads it:
# every name glibc's strerrorname_np() knows, plus the aliases
# EWOULDBLOCK, EDEADLOCK and ENOTSUP. 0 when the name is not an errno.
fn _dbs_errno_named(p, n) {
    if (_dbs_name_is(p, n, "EPERM") != 0) { return 1; }
    if (_dbs_name_is(p, n, "ENOENT") != 0) { return 2; }
    if (_dbs_name_is(p, n, "ESRCH") != 0) { return 3; }
    if (_dbs_name_is(p, n, "EINTR") != 0) { return 4; }
    if (_dbs_name_is(p, n, "EIO") != 0) { return 5; }
    if (_dbs_name_is(p, n, "ENXIO") != 0) { return 6; }
    if (_dbs_name_is(p, n, "E2BIG") != 0) { return 7; }
    if (_dbs_name_is(p, n, "ENOEXEC") != 0) { return 8; }
    if (_dbs_name_is(p, n, "EBADF") != 0) { return 9; }
    if (_dbs_name_is(p, n, "ECHILD") != 0) { return 10; }
    if (_dbs_name_is(p, n, "EAGAIN") != 0) { return 11; }
    if (_dbs_name_is(p, n, "ENOMEM") != 0) { return 12; }
    if (_dbs_name_is(p, n, "EACCES") != 0) { return 13; }
    if (_dbs_name_is(p, n, "EFAULT") != 0) { return 14; }
    if (_dbs_name_is(p, n, "ENOTBLK") != 0) { return 15; }
    if (_dbs_name_is(p, n, "EBUSY") != 0) { return 16; }
    if (_dbs_name_is(p, n, "EEXIST") != 0) { return 17; }
    if (_dbs_name_is(p, n, "EXDEV") != 0) { return 18; }
    if (_dbs_name_is(p, n, "ENODEV") != 0) { return 19; }
    if (_dbs_name_is(p, n, "ENOTDIR") != 0) { return 20; }
    if (_dbs_name_is(p, n, "EISDIR") != 0) { return 21; }
    if (_dbs_name_is(p, n, "EINVAL") != 0) { return 22; }
    if (_dbs_name_is(p, n, "ENFILE") != 0) { return 23; }
    if (_dbs_name_is(p, n, "EMFILE") != 0) { return 24; }
    if (_dbs_name_is(p, n, "ENOTTY") != 0) { return 25; }
    if (_dbs_name_is(p, n, "ETXTBSY") != 0) { return 26; }
    if (_dbs_name_is(p, n, "EFBIG") != 0) { return 27; }
    if (_dbs_name_is(p, n, "ENOSPC") != 0) { return 28; }
    if (_dbs_name_is(p, n, "ESPIPE") != 0) { return 29; }
    if (_dbs_name_is(p, n, "EROFS") != 0) { return 30; }
    if (_dbs_name_is(p, n, "EMLINK") != 0) { return 31; }
