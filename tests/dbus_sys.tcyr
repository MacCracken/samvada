# N1 — SCM_RIGHTS fd passing, proven over a socketpair.
#
# No dbus, no logind, no hardware. The whole point of doing fd
# passing FIRST (ADR-0003 / roadmap N1) is that it is the one
# Low-confidence module of the native pivot and it can be proven
# in isolation, before anything is built on top of it.
#
# NOTE this file includes src/dbus_sys.cyr DIRECTLY rather than via
# src/lib.cyr. dbus_sys is deliberately NOT in `[lib] modules` yet:
# the roadmap's standing exit criterion for every pre-cutover
# milestone is that dist/samvada.cyr's exported symbol set does not
# change, so the native modules stay out of the consumer bundle
# until the N6 cutover.

include "src/dbus_sys.cyr"

# ---- test-only sendmsg ----
# samvada NEVER sends an fd in production — the only `h` it handles
# is on the TakeDevice *reply*, received. So the send side is a
# harness dependency and lives here, not in src/, and the exported
# surface does not grow to satisfy a test.
#
# It goes through the stdlib's `sys_sendmsg`, never a number of our
# own. cyrius-doom hardcodes 46, which is sendmsg on x86_64 but
# **ftruncate** on aarch64 (asm-generic/unistd.h: __NR3264_ftruncate
# = 46) — it does not fail loudly there, it truncates a file. Until
# 1.1.0 this file avoided that with a native 211 under `#ifdef
# CYRIUS_ARCH_AARCH64`, the shape cyrius 6.7.12+ calls fragile (see
# src/dbus_sys.cyr). The round trips below are what prove the call.

var _t_iov  = 0;
var _t_mh   = 0;
var _t_ctrl = 0;
var _t_byte = 0;
var _t_ctrl2 = 0;
var _t_ctrl3 = 0;

fn t_send_init() {
    if (_t_iov != 0) { return 0; }
    _t_iov  = alloc(16);
    _t_mh   = alloc(56);
    _t_ctrl = alloc(24);
    _t_byte = alloc(8);
    return 0;
}

# Send one byte plus one fd over `sock`.
fn t_send_fd(sock, payload_fd) {
    t_send_init();
    store64(_t_byte, 0x42);
    store64(_t_iov + 0, _t_byte);
    store64(_t_iov + 8, 1);

    var i = 0;
    while (i < 24) { store64(_t_ctrl + i, 0); i = i + 8; }
    store64(_t_ctrl + 0, dbus_sys_cmsg_len_1fd());   # cmsg_len = 20
    store64(_t_ctrl + 8, dbus_sys_sol_socket());     # level (low 32 bits)
    store64(_t_ctrl + 12, dbus_sys_scm_rights());    # type  (low 32 bits)
    store64(_t_ctrl + 16, payload_fd);               # the fd itself

    i = 0;
    while (i < 56) { store64(_t_mh + i, 0); i = i + 8; }
    store64(_t_mh + 16, _t_iov);
    store64(_t_mh + 24, 1);
    store64(_t_mh + 32, _t_ctrl);
    store64(_t_mh + 40, dbus_sys_cmsg_space_1fd());

    return sys_sendmsg(sock, _t_mh, 0);
}

# Send one byte plus a cmsg of the WRONG type. Used to prove the
# receive path rejects on cmsg_type rather than blindly reading
# whatever sits at CMSG_DATA.
fn t_send_wrong_cmsg(sock) {
    t_send_init();
    store64(_t_byte, 0x42);
    store64(_t_iov + 0, _t_byte);
    store64(_t_iov + 8, 1);
    var i = 0;
    while (i < 24) { store64(_t_ctrl + i, 0); i = i + 8; }
    store64(_t_ctrl + 0, dbus_sys_cmsg_len_1fd());
    store64(_t_ctrl + 8, dbus_sys_sol_socket());
    store64(_t_ctrl + 12, 2);              # SCM_CREDENTIALS, not SCM_RIGHTS
    store64(_t_ctrl + 16, 0x7FFFFFFF);     # a plausible-looking fd number
    i = 0;
    while (i < 56) { store64(_t_mh + i, 0); i = i + 8; }
    store64(_t_mh + 16, _t_iov);
    store64(_t_mh + 24, 1);
    store64(_t_mh + 32, _t_ctrl);
    store64(_t_mh + 40, dbus_sys_cmsg_space_1fd());
    return sys_sendmsg(sock, _t_mh, 0);
}

# ---- layout pins ----
# These freeze the ABI the whole native fd path is built on. Every
# number was confirmed against glibc's own offsetof/sizeof/CMSG_*
# on x86_64; struct msghdr/iovec/cmsghdr are LP64-identical on
# aarch64, so one set covers both.
fn test_dbus_sys_layout() {
    test_group("dbus_sys: ABI layout pins");
    assert_eq(dbus_sys_iovec_size(),      16, "sizeof(struct iovec)");
    assert_eq(dbus_sys_msghdr_size(),     56, "sizeof(struct msghdr)");
    assert_eq(dbus_sys_cmsghdr_size(),    16, "sizeof(struct cmsghdr)");
    assert_eq(dbus_sys_cmsg_data_off(),   16, "CMSG_DATA - cmsghdr");
    assert_eq(dbus_sys_cmsg_len_1fd(),    20, "CMSG_LEN(sizeof int)");
    assert_eq(dbus_sys_cmsg_space_1fd(),  24, "CMSG_SPACE(sizeof int)");
    assert_eq(dbus_sys_fd_max(),         253, "SCM_MAX_FD");
    assert_eq(dbus_sys_ctrl_size(),     1032, "CMSG_SPACE(253 * sizeof int)");
    assert_eq(dbus_sys_sol_socket(),       1, "SOL_SOCKET");
    assert_eq(dbus_sys_scm_rights(),       1, "SCM_RIGHTS");
    assert_eq(dbus_sys_msg_ctrunc(),       8, "MSG_CTRUNC");
    assert_eq(dbus_sys_msg_cmsg_cloexec(), 1073741824, "MSG_CMSG_CLOEXEC");
    assert_eq(dbus_sys_af_unix(),          1, "AF_UNIX");
    assert_eq(dbus_sys_sock_stream(),      1, "SOCK_STREAM");
    return 0;
}

# The syscall numbers are the one thing that is NOT arch-uniform,
# and getting them wrong is silent rather than loud. samvada spells
# none of its own (1.1.0): every socket call is the stdlib's.
#
# On x86_64 the stdlib's constants ARE the kernel ABI, so they are
# pinned — a stdlib typo would fail here. On aarch64 they are not
# pinned at all: the compiler rewrites x86 numbers through a compat
# chain, so the stdlib may legitimately spell either the native or the
# x86 number, and asserting one would pin cyrius's choice, not the
# call. What proves the aarch64 call is the round trips below, and the
# `-strace` run recorded in CHANGELOG 1.1.0.
fn test_dbus_sys_syscall_numbers() {
    test_group("dbus_sys: the socket calls are the stdlib's");
    #ifdef CYRIUS_ARCH_X86
    assert_eq(SYS_RECVMSG, 47, "x86_64 recvmsg");
    assert_eq(SYS_SENDMSG, 46, "x86_64 sendmsg");
    assert_eq(SYS_SENDTO,  44, "x86_64 sendto");
    #endif
    return 0;
}

# ---- the real thing: an fd crosses a socketpair ----
fn test_scm_rights_round_trip() {
    test_group("SCM_RIGHTS: an fd crosses a socketpair intact");
    var fds = alloc(8);
    store64(fds, 0);
    var rc = sys_socketpair(dbus_sys_af_unix(), dbus_sys_sock_stream(), 0, fds);
    assert_eq(rc, 0, "socketpair created");
    var a = load64(fds) & 0xFFFFFFFF;
    var b = (load64(fds) >> 32) & 0xFFFFFFFF;
    assert(a > 2, "sock a is a real fd");
    assert(b > 2, "sock b is a real fd");

    # Send one END OF THE PAIR through the other — a real, open,
    # statable fd with no filesystem dependency.
    var pair2 = alloc(8);
    store64(pair2, 0);
    assert_eq(sys_socketpair(dbus_sys_af_unix(), dbus_sys_sock_stream(), 0, pair2), 0,
      "payload pair created");
    var payload = load64(pair2) & 0xFFFFFFFF;
    var payload_peer = (load64(pair2) >> 32) & 0xFFFFFFFF;

    var sent = t_send_fd(a, payload);
    assert_eq(sent, 1, "sendmsg wrote 1 byte");

    var buf = alloc(64);
    var got = dbus_sys_recv(b, buf, 64, 0);
    assert_eq(got, 1, "recvmsg read 1 byte");
    assert_eq(dbus_sys_rx_count(), 1, "one descriptor delivered");
    assert_eq(dbus_sys_rx_truncated(), 0, "and nothing truncated");
    var rfd = dbus_sys_rx_fd(0);
    assert(rfd > 2, "an fd was received");
    assert(rfd != payload, "and it is a NEW descriptor number");

    # Prove it is the SAME open file: fstat dev/ino must match.
    # st_dev@0 and st_ino@8 are at these offsets on x86_64 AND
    # aarch64 (only st_mode differs between them), so no arch split.
    var s1 = alloc(160);
    var s2 = alloc(160);
    assert_eq(sys_fstat(payload, s1), 0, "fstat original");
    assert_eq(sys_fstat(rfd, s2), 0, "fstat received");
    assert_eq(load64(s1 + 0), load64(s2 + 0), "st_dev matches");
    assert_eq(load64(s1 + 8), load64(s2 + 8), "st_ino matches — same open file");

    # MSG_CMSG_CLOEXEC must have taken effect. Assert it rather than
    # trusting the flag: this is the receive-side counterpart of the
    # 0.5.1 F_DUPFD_CLOEXEC fix, and a silently-ignored flag would
    # leak a DRM master fd across execve.
    var fl = syscall(SYS_FCNTL, rfd, 1, 0);      # F_GETFD
    assert(fl >= 0, "F_GETFD succeeded");
    assert_eq(fl & 1, 1, "FD_CLOEXEC is set on the received fd");

    sys_close(rfd); sys_close(payload); sys_close(payload_peer);
    sys_close(a); sys_close(b);
    return 0;
}

# ---- guards ----
fn test_dbus_sys_rejects_bad_args() {
    test_group("dbus_sys: argument guards");
    assert_eq(dbus_sys_recv(0, 0, 64, 0),   -22, "null buf rejected");
    assert_eq(dbus_sys_recv(0, 1024, 0, 0), -22, "zero buflen rejected");
    assert_eq(dbus_sys_recv(0, 1024, (0 - 1), 0), -22, "negative buflen rejected");
    assert_eq(dbus_sys_rx_fd((0 - 1)), (0 - 1), "rx_fd below range is -1");
    assert_eq(dbus_sys_rx_fd(dbus_sys_fd_max()), (0 - 1), "rx_fd past the count is -1");
    return 0;
}

# A message with NO ancillary data must report no descriptors — not a
# previous receive's — and must still return the byte count.
fn test_recv_without_fd_reports_none() {
    test_group("recv with no SCM_RIGHTS reports no fd");
    var fds = alloc(8);
    store64(fds, 0);
    assert_eq(sys_socketpair(dbus_sys_af_unix(), dbus_sys_sock_stream(), 0, fds), 0, "pair");
    var a = load64(fds) & 0xFFFFFFFF;
    var b = (load64(fds) >> 32) & 0xFFFFFFFF;

    var msg = alloc(8);
    store64(msg, 0x41);
    assert_eq(sys_write(a, msg, 1), 1, "plain write");

    var buf = alloc(64);
    var n = dbus_sys_recv(b, buf, 64, 0);
    assert_eq(n, 1, "one byte read");
    assert_eq(dbus_sys_rx_count(), 0, "no descriptor reported");
    assert_eq(dbus_sys_rx_fd(0), (0 - 1), "and rx_fd(0) is -1");

    sys_close(a); sys_close(b);
    return 0;
}

# The receive path must reject ancillary data that is not
# SCM_RIGHTS rather than reading CMSG_DATA regardless of type. A
# missing type check would hand the caller 0x7FFFFFFF as an "fd".
fn test_rejects_wrong_cmsg_type() {
    test_group("recv rejects a non-SCM_RIGHTS cmsg");
    var fds = alloc(8);
    store64(fds, 0);
    assert_eq(sys_socketpair(dbus_sys_af_unix(), dbus_sys_sock_stream(), 0, fds), 0, "pair");
    var a = load64(fds) & 0xFFFFFFFF;
    var b = (load64(fds) >> 32) & 0xFFFFFFFF;

    var sent = t_send_wrong_cmsg(a);
    var buf = alloc(64);

    # The kernel validates SCM_CREDENTIALS and refuses a forged one, so
    # sendmsg may fail outright. Only read if something was actually
    # queued — a blocking recvmsg on an empty queue hangs the suite,
    # which is exactly what the first draft of this test did.
    if (sent == 1) {
        var n = dbus_sys_recv(b, buf, 64, 0);
        assert_eq(n, 1, "byte still delivered");
        assert_eq(dbus_sys_rx_count(), 0,
          "no descriptor — the wrong-type payload was NOT read as an fd");
        assert(dbus_sys_rx_fd(0) != 0x7FFFFFFF, "the bogus payload never became an fd");
    }
    if (sent != 1) {
        assert(sent < 0, "kernel refused the forged cmsg (also acceptable)");
    }
    sys_close(a); sys_close(b);
    return 0;
}

# Send one byte plus TWO fds.
fn t_send_two_fds(sock, fd_a, fd_b) {
    t_send_init();
    if (_t_ctrl2 == 0) { _t_ctrl2 = alloc(32); }
    store64(_t_byte, 0x42);
    store64(_t_iov + 0, _t_byte);
    store64(_t_iov + 8, 1);
    var i = 0;
    while (i < 32) { store64(_t_ctrl2 + i, 0); i = i + 8; }
    store64(_t_ctrl2 + 0, 24);                     # CMSG_LEN(2 * int) = 16 + 8
    store64(_t_ctrl2 + 8, dbus_sys_sol_socket());
    store64(_t_ctrl2 + 12, dbus_sys_scm_rights());
    store64(_t_ctrl2 + 16, fd_a);                  # two int32 fds, packed
    store64(_t_ctrl2 + 20, fd_b);
    i = 0;
    while (i < 56) { store64(_t_mh + i, 0); i = i + 8; }
    store64(_t_mh + 16, _t_iov);
    store64(_t_mh + 24, 1);
    store64(_t_mh + 32, _t_ctrl2);
    store64(_t_mh + 40, 32);                       # CMSG_SPACE(2 * int)
    return sys_sendmsg(sock, _t_mh, 0);
}

# Until 1.1.2 the receive kept ONE descriptor and closed the rest, so a
# message that legitimately carried two lost one. Every descriptor is now
# delivered, in order, and the caller decides which message owns it.
fn test_two_fds_are_both_delivered() {
    test_group("SCM_RIGHTS: both descriptors of a two-fd message are delivered");
    var fds = alloc(8);
    store64(fds, 0);
    assert_eq(sys_socketpair(dbus_sys_af_unix(), dbus_sys_sock_stream(), 0, fds), 0, "pair");
    var a = load64(fds) & 0xFFFFFFFF;
    var b = (load64(fds) >> 32) & 0xFFFFFFFF;
    var p2 = alloc(8);
    store64(p2, 0);
    assert_eq(sys_socketpair(dbus_sys_af_unix(), dbus_sys_sock_stream(), 0, p2), 0, "payload pair");
    var f1 = load64(p2) & 0xFFFFFFFF;
    var f2 = (load64(p2) >> 32) & 0xFFFFFFFF;

    var sent = t_send_two_fds(a, f1, f2);
    var buf = alloc(64);
    if (sent == 1) {
        var n = dbus_sys_recv(b, buf, 64, 0);
        assert_eq(n, 1, "the byte was delivered");
        assert_eq(dbus_sys_rx_count(), 2, "THE PIN: both descriptors delivered");
        assert_eq(dbus_sys_rx_truncated(), 0, "nothing truncated");
        var r1 = dbus_sys_rx_fd(0);
        var r2 = dbus_sys_rx_fd(1);
        assert(r1 > 2, "first is a real descriptor");
        assert(r2 > 2, "second is a real descriptor");
        var st1 = alloc(160);
        var st2 = alloc(160);
        sys_fstat(r1, st1);
        sys_fstat(f1, st2);
        assert_eq(load64(st1 + 8), load64(st2 + 8), "in order: the first is f1's file");
        sys_close(r1);
        sys_close(r2);
    }
    if (sent != 1) { assert(sent < 0, "kernel refused the two-fd send"); }
    sys_close(f1); sys_close(f2); sys_close(a); sys_close(b);
    return 0;
}

# Count currently-open descriptors by probing F_GETFD across the low fd
# range. Crude, but it is the only leak probe in this suite that actually
# works: the lowest-free-fd probe passed against a version that leaked two
# descriptors per call.
fn t_count_open_fds() {
    var n = 0;
    var i = 0;
    while (i < 256) {
        var r = syscall(SYS_FCNTL, i, 1, 0);      # F_GETFD
        if (r >= 0) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

# Send one byte plus THREE fds. Through 1.1.1 the receive reserved room
# for one, so this truncated (MSG_CTRUNC), and the truncation branch threw
# the message's bytes away and answered -EPROTO.
fn t_send_three_fds(sock, f1, f2, f3) {
    t_send_init();
    if (_t_ctrl3 == 0) { _t_ctrl3 = alloc(40); }
    store64(_t_byte, 0x42);
    store64(_t_iov + 0, _t_byte);
    store64(_t_iov + 8, 1);
    var i = 0;
    while (i < 40) { store64(_t_ctrl3 + i, 0); i = i + 8; }
    store64(_t_ctrl3 + 0, 28);                     # CMSG_LEN(3 * int) = 16 + 12
    store64(_t_ctrl3 + 8, dbus_sys_sol_socket());
    store64(_t_ctrl3 + 12, dbus_sys_scm_rights());
    store64(_t_ctrl3 + 16, f1);
    store64(_t_ctrl3 + 20, f2);
    store64(_t_ctrl3 + 24, f3);
    i = 0;
    while (i < 56) { store64(_t_mh + i, 0); i = i + 8; }
    store64(_t_mh + 16, _t_iov);
    store64(_t_mh + 24, 1);
    store64(_t_mh + 32, _t_ctrl3);
    store64(_t_mh + 40, 32);                       # CMSG_SPACE(3 * int)
    return sys_sendmsg(sock, _t_mh, 0);
}

# THE M1 PIN (1.1.2). A three-descriptor message truncated the old 24-byte
# control buffer; the receive returned -EPROTO and discarded the bytes,
# and the session layer — rightly — read -EPROTO as a disconnect. So any
# bus peer that could send samvada a three-fd signal closed its
# connection. With room for SCM_MAX_FD reserved, nothing truncates.
fn test_three_fds_do_not_truncate() {
    test_group("SCM_RIGHTS: a three-fd message is delivered whole, not refused");
    var fds = alloc(8);
    store64(fds, 0);
    assert_eq(sys_socketpair(dbus_sys_af_unix(), dbus_sys_sock_stream(), 0, fds), 0, "pair");
    var a = load64(fds) & 0xFFFFFFFF;
    var b = (load64(fds) >> 32) & 0xFFFFFFFF;
    var pa = alloc(8);
    store64(pa, 0);
    sys_socketpair(dbus_sys_af_unix(), dbus_sys_sock_stream(), 0, pa);
    var f1 = load64(pa) & 0xFFFFFFFF;
    var f2 = (load64(pa) >> 32) & 0xFFFFFFFF;
    var pb = alloc(8);
    store64(pb, 0);
    sys_socketpair(dbus_sys_af_unix(), dbus_sys_sock_stream(), 0, pb);
    var f3 = load64(pb) & 0xFFFFFFFF;
    var f4 = (load64(pb) >> 32) & 0xFFFFFFFF;

    var before = t_count_open_fds();
    var sent = t_send_three_fds(a, f1, f2, f3);
    var buf = alloc(64);
    if (sent == 1) {
        var n = dbus_sys_recv(b, buf, 64, 0);
        assert_eq(n, 1, "THE PIN: the byte is delivered, not refused with -EPROTO");
        assert_eq(dbus_sys_rx_count(), 3, "all three descriptors delivered");
        assert_eq(dbus_sys_rx_truncated(), 0, "and nothing truncated");
        var i = 0;
        while (i < dbus_sys_rx_count()) { sys_close(dbus_sys_rx_fd(i)); i = i + 1; }
        assert_eq(t_count_open_fds(), before, "every delivered descriptor was real and is closed");
    }
    if (sent != 1) { assert(sent < 0, "kernel refused the three-fd send"); }
    sys_close(f1); sys_close(f2); sys_close(f3); sys_close(f4);
    sys_close(a); sys_close(b);
    return 0;
}

# Send one byte plus `count` copies of one descriptor — the kernel
# installs a fresh descriptor for each, so this is `count` real fds.
var _t_ctrln = 0;
fn t_send_n_fds(sock, fd, count) {
    t_send_init();
    if (_t_ctrln == 0) { _t_ctrln = alloc(16 + 253 * 4 + 8); }
    store64(_t_byte, 0x42);
    store64(_t_iov + 0, _t_byte);
    store64(_t_iov + 8, 1);
    var clen = 16 + count * 4;
    var space = (clen + 7) & (0 - 8);
    var i = 0;
    while (i < space) { store64(_t_ctrln + i, 0); i = i + 8; }
    store64(_t_ctrln + 0, clen);
    store32(_t_ctrln + 8, dbus_sys_sol_socket());
    store32(_t_ctrln + 12, dbus_sys_scm_rights());
    i = 0;
    while (i < count) { store32(_t_ctrln + 16 + i * 4, fd); i = i + 1; }
    i = 0;
    while (i < 56) { store64(_t_mh + i, 0); i = i + 8; }
    store64(_t_mh + 16, _t_iov);
    store64(_t_mh + 24, 1);
    store64(_t_mh + 32, _t_ctrln);
    store64(_t_mh + 40, space);
    return sys_sendmsg(sock, _t_mh, 0);
}

# SO_PASSCRED makes the kernel put SCM_CREDENTIALS (32 bytes) ahead of the
# descriptors, so 250 of them no longer fit the 1032-byte buffer: the one
# way left to reach MSG_CTRUNC.
fn t_passcred(sock) {
    var one = alloc(8);
    store64(one, 1);
    return sys_setsockopt(sock, dbus_sys_sol_socket(), 16, one, 4);   # SO_PASSCRED
}

# MSG_CTRUNC keeps the BYTES, delivers the descriptors that fit, and says
# the set is incomplete — it no longer refuses the message (1.1.2). It
# also shows the receive walks past a non-SCM_RIGHTS cmsg: the
# credentials come first.
fn test_ctrunc_keeps_the_bytes() {
    test_group("MSG_CTRUNC: bytes kept, descriptors that fit delivered, set flagged");
    var fds = alloc(8);
    store64(fds, 0);
    assert_eq(sys_socketpair(dbus_sys_af_unix(), dbus_sys_sock_stream(), 0, fds), 0, "pair");
    var a = load64(fds) & 0xFFFFFFFF;
    var b = (load64(fds) >> 32) & 0xFFFFFFFF;
    var pa = alloc(8);
    store64(pa, 0);
    sys_socketpair(dbus_sys_af_unix(), dbus_sys_sock_stream(), 0, pa);
    var f1 = load64(pa) & 0xFFFFFFFF;
    var f2 = (load64(pa) >> 32) & 0xFFFFFFFF;
    assert_eq(t_passcred(b), 0, "SO_PASSCRED set on the receiver");

    var before = t_count_open_fds();
    var sent = t_send_n_fds(a, f1, 250);
    assert_eq(sent, 1, "250 descriptors sent");
    var buf = alloc(64);
    var n = dbus_sys_recv(b, buf, 64, 0);
    assert_eq(n, 1, "THE PIN: the byte is delivered");
    assert_eq(dbus_sys_rx_truncated(), 1, "and the truncation is reported");
    var k = dbus_sys_rx_count();
    assert(k > 200, "the descriptors that fit after the credentials were delivered");
    assert(k < 250, "and not more than fit");
    var i = 0;
    while (i < k) { sys_close(dbus_sys_rx_fd(i)); i = i + 1; }
    assert_eq(t_count_open_fds(), before, "closing them leaves nothing behind");
    sys_close(f1); sys_close(f2); sys_close(a); sys_close(b);
    return 0;
}

# ---- the parser guards, driven directly ----
# The kernel validates ancillary data before recvmsg returns, so a
# forged cmsg can never arrive through a socket — which means these
# guards are unreachable from a round-trip test and would ship
# unproven. Driving the parser directly is what makes them real.
fn t_ctrl_build(ctrl, clen, level, ctype, payload) {
    var i = 0;
    while (i < 32) { store64(ctrl + i, 0); i = i + 8; }
    store64(ctrl + 0, clen);
    store64(ctrl + 8, level);
    store64(ctrl + 12, ctype);
    store64(ctrl + 16, payload);
    return 0;
}

fn test_parser_guards() {
    test_group("cmsg parser: every guard is reachable and rejects");
    var ctrl = alloc(64);
    var GOOD = dbus_sys_cmsg_len_1fd();

    # the accepting case first, so the rejections mean something
    t_ctrl_build(ctrl, GOOD, dbus_sys_sol_socket(), dbus_sys_scm_rights(), 9);
    assert_eq(dbus_sys_parse_rights(ctrl, 24), 1, "well-formed cmsg accepted");
    assert_eq(dbus_sys_rx_fd(0), 9, "fd extracted");

    # wrong cmsg_type (SCM_CREDENTIALS shape)
    t_ctrl_build(ctrl, GOOD, dbus_sys_sol_socket(), 2, 0x7FFFFFFF);
    assert_eq(dbus_sys_parse_rights(ctrl, 24), 0, "wrong cmsg_type rejected");
    assert_eq(dbus_sys_rx_fd(0), (0 - 1), "and no stale fd survives the reset");

    # wrong level
    t_ctrl_build(ctrl, GOOD, 41, dbus_sys_scm_rights(), 0x7FFFFFFF);
    assert_eq(dbus_sys_parse_rights(ctrl, 24), 0, "wrong cmsg_level rejected");

    # cmsg_len below the floor — a truncated header
    t_ctrl_build(ctrl, 12, dbus_sys_sol_socket(), dbus_sys_scm_rights(), 7);
    assert_eq(dbus_sys_parse_rights(ctrl, 24), 0, "short cmsg_len rejected");

    # cmsg_len claiming MORE than the kernel says it filled — an
    # over-read if believed
    t_ctrl_build(ctrl, 4096, dbus_sys_sol_socket(), dbus_sys_scm_rights(), 7);
    assert_eq(dbus_sys_parse_rights(ctrl, 24), 0, "cmsg_len > controllen rejected");

    # controllen below the floor
    t_ctrl_build(ctrl, GOOD, dbus_sys_sol_socket(), dbus_sys_scm_rights(), 7);
    assert_eq(dbus_sys_parse_rights(ctrl, 8), 0, "short controllen rejected");
    assert_eq(dbus_sys_parse_rights(ctrl, 0), 0, "zero controllen rejected");

    # a SECOND cmsg is found by CMSG_NXTHDR: credentials first (24 bytes,
    # aligned), the descriptor after — what SO_PASSCRED produces
    var i = 0;
    while (i < 64) { store64(ctrl + i, 0); i = i + 8; }
    store64(ctrl + 0, 28);                         # CMSG_LEN(12): struct ucred
    store32(ctrl + 8, dbus_sys_sol_socket());
    store32(ctrl + 12, 2);                         # SCM_CREDENTIALS
    store64(ctrl + 32, GOOD);                      # next header at align8(28)
    store32(ctrl + 40, dbus_sys_sol_socket());
    store32(ctrl + 44, dbus_sys_scm_rights());
    store32(ctrl + 48, 11);
    assert_eq(dbus_sys_parse_rights(ctrl, 56), 1, "the descriptor after a credentials cmsg is found");
    assert_eq(dbus_sys_rx_fd(0), 11, "and it is the right one");

    # null argument
    assert_eq(dbus_sys_parse_rights(0, 24), -22, "null ctrl rejected");
    return 0;
}

# The fd is an int32 on the wire. Sign-extension has to be explicit
# because Cyrius `>>` is logical and there is no unsigned type, so a
# kernel-impossible negative must not read back as a huge positive fd —
# it is not collected at all.
fn test_parser_sign_extension() {
    test_group("cmsg parser: int32 fd sign-extension");
    var ctrl = alloc(32);
    var L = dbus_sys_cmsg_len_1fd();
    t_ctrl_build(ctrl, L, dbus_sys_sol_socket(), dbus_sys_scm_rights(), 0);
    assert_eq(dbus_sys_parse_rights(ctrl, 24), 1, "fd 0 parsed");
    assert_eq(dbus_sys_rx_fd(0), 0, "fd 0");
    t_ctrl_build(ctrl, L, dbus_sys_sol_socket(), dbus_sys_scm_rights(), 0x7FFFFFFF);
    dbus_sys_parse_rights(ctrl, 24);
    assert_eq(dbus_sys_rx_fd(0), 2147483647, "INT32_MAX");
    t_ctrl_build(ctrl, L, dbus_sys_sol_socket(), dbus_sys_scm_rights(), 0xFFFFFFFF);
    assert_eq(dbus_sys_parse_rights(ctrl, 24), 0, "0xFFFFFFFF is -1: not a descriptor");
    assert(dbus_sys_rx_fd(0) != 4294967295, "and never read as 4294967295");
    t_ctrl_build(ctrl, L, dbus_sys_sol_socket(), dbus_sys_scm_rights(), 0x80000000);
    assert_eq(dbus_sys_parse_rights(ctrl, 24), 0, "INT32_MIN: not a descriptor");
    return 0;
}

# fd-leak regression pin. The cmsg path is exactly where descriptors
# go missing: a dropped fd is invisible until the process hits
# RLIMIT_NOFILE. Run the round trip many times and assert the
# allocator hands back the SAME fd numbers at the end as at the
# start — which it cannot do if any were leaked.
fn test_scm_rights_no_fd_leak() {
    test_group("SCM_RIGHTS: 200 round trips leak no descriptors");
    var probe = alloc(8);
    store64(probe, 0);
    assert_eq(sys_socketpair(dbus_sys_af_unix(), dbus_sys_sock_stream(), 0, probe), 0, "probe");
    var base = load64(probe) & 0xFFFFFFFF;
    sys_close(base);
    sys_close((load64(probe) >> 32) & 0xFFFFFFFF);

    var buf = alloc(64);
    var fds = alloc(8);
    var pair2 = alloc(8);
    var i = 0;
    var failures = 0;
    while (i < 200) {
        store64(fds, 0);
        var r1 = sys_socketpair(dbus_sys_af_unix(), dbus_sys_sock_stream(), 0, fds);
        if (r1 != 0) { failures = failures + 1; }
        var a = load64(fds) & 0xFFFFFFFF;
        var b = (load64(fds) >> 32) & 0xFFFFFFFF;
        store64(pair2, 0);
        sys_socketpair(dbus_sys_af_unix(), dbus_sys_sock_stream(), 0, pair2);
        var p = load64(pair2) & 0xFFFFFFFF;
        var pp = (load64(pair2) >> 32) & 0xFFFFFFFF;
        t_send_fd(a, p);
        dbus_sys_recv(b, buf, 64, 0);
        var rfd = dbus_sys_rx_fd(0);
        if (rfd > 2) { sys_close(rfd); }
        sys_close(p); sys_close(pp); sys_close(a); sys_close(b);
        i = i + 1;
    }
    assert_eq(failures, 0, "every socketpair in the loop succeeded");

    store64(probe, 0);
    assert_eq(sys_socketpair(dbus_sys_af_unix(), dbus_sys_sock_stream(), 0, probe), 0,
      "probe pair after the loop");
    var after = load64(probe) & 0xFFFFFFFF;
    assert_eq(after, base, "fd numbers unchanged after 200 round trips — nothing leaked");
    sys_close(after);
    sys_close((load64(probe) >> 32) & 0xFFFFFFFF);
    return 0;
}

# ---- A-1 (1.1.1): a peer that truncates every message ----
# Truncation is peer-driven. Until 1.1.1 the truncation branch did an
# alloc(8) each time, so such a peer grew the never-freeing heap by 8
# bytes per message, forever. 1.1.2 reaches the branch the one way left
# (SO_PASSCRED + 250 descriptors) and holds it to the same bound: no heap,
# and no descriptor the caller did not get to close.
fn test_sustained_ctrunc_is_bounded() {
    test_group("SCM_RIGHTS: 100 truncated receives leak no descriptor and no heap");
    var fds = alloc(8);
    sys_socketpair(dbus_sys_af_unix(), dbus_sys_sock_stream(), 0, fds);
    var a = load64(fds) & 0xFFFFFFFF;
    var b = (load64(fds) >> 32) & 0xFFFFFFFF;
    var pa = alloc(8);
    sys_socketpair(dbus_sys_af_unix(), dbus_sys_sock_stream(), 0, pa);
    var f1 = load64(pa) & 0xFFFFFFFF;
    var f2 = (load64(pa) >> 32) & 0xFFFFFFFF;
    t_passcred(b);
    var buf = alloc(64);
    # Warm the path once.
    t_send_n_fds(a, f1, 250);
    dbus_sys_recv(b, buf, 64, 0);
    var j = 0;
    while (j < dbus_sys_rx_count()) { sys_close(dbus_sys_rx_fd(j)); j = j + 1; }
    var open0 = t_count_open_fds();
    var heap0 = alloc_used();
    var trunc = 0;
    var i = 0;
    while (i < 100) {
        if (t_send_n_fds(a, f1, 250) == 1) {
            if (dbus_sys_recv(b, buf, 64, 0) == 1) {
                if (dbus_sys_rx_truncated() != 0) { trunc = trunc + 1; }
            }
            j = 0;
            while (j < dbus_sys_rx_count()) { sys_close(dbus_sys_rx_fd(j)); j = j + 1; }
        }
        i = i + 1;
    }
    assert_eq(trunc, 100, "every receive was truncated, and kept its byte");
    assert_eq(t_count_open_fds(), open0, "no descriptor leaked across 100 truncations");
    assert_eq(alloc_used() - heap0, 0, "THE PIN: and the heap did not grow (was 8 bytes per truncation)");
    sys_close(f1); sys_close(f2);
    sys_close(a); sys_close(b);
    return 0;
}

fn main() {
    alloc_init();
    test_dbus_sys_layout();
    test_dbus_sys_syscall_numbers();
    test_dbus_sys_rejects_bad_args();
    test_scm_rights_round_trip();
    test_recv_without_fd_reports_none();
    test_rejects_wrong_cmsg_type();
    test_two_fds_are_both_delivered();
    test_three_fds_do_not_truncate();
    test_ctrunc_keeps_the_bytes();
    test_parser_guards();
    test_parser_sign_extension();
    test_scm_rights_no_fd_leak();
    test_sustained_ctrunc_is_bounded();
    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
