    assert_eq(t_err(p, "org.freedesktop.login1.DeviceNotTaken"), -22, "org.freedesktop.login1.DeviceNotTaken");
    assert_eq(t_err(p, "org.freedesktop.login1.NoSessionForPID"), -6, "org.freedesktop.login1.NoSessionForPID");
    assert_eq(t_err(p, "org.freedesktop.login1.NoSuchSeat"), -6, "org.freedesktop.login1.NoSuchSeat");
    assert_eq(t_err(p, "org.freedesktop.login1.NoSuchSession"), -6, "org.freedesktop.login1.NoSuchSession");
    assert_eq(t_err(p, "org.freedesktop.login1.NoSuchUser"), -6, "org.freedesktop.login1.NoSuchUser");
    assert_eq(t_err(p, "org.freedesktop.login1.NoUserForPID"), -6, "org.freedesktop.login1.NoUserForPID");
    assert_eq(t_err(p, "org.freedesktop.login1.NotInControl"), -22, "org.freedesktop.login1.NotInControl");
