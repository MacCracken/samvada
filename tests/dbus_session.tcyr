    assert_eq(t_err(p, "org.freedesktop.DBus.Error.TimedOut"), -110, "org.freedesktop.DBus.Error.TimedOut");
    assert_eq(t_err(p, "org.freedesktop.DBus.Error.MatchRuleNotFound"), -2,
