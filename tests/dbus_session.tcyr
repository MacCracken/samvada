# N5 — the logind session layer.
#
# The live half of this milestone is verified by driving samvada's
# FROZEN PUBLIC API through the native backend against the real bus
# (see the 0.10.0 release notes). What is pinned here is everything
# that can be checked with no bus — and in particular the FFI
# ARITIES, because a mismatch there is a silent crash through
# fncallN rather than a compile error.

include "src/lib.cyr"
include "src/dbus_sys.cyr"
include "src/dbus_frame.cyr"
include "src/dbus_auth.cyr"
include "src/dbus_socket.cyr"
include "src/dbus_marshal.cyr"
include "src/dbus_unmarshal.cyr"
include "src/dbus_session.cyr"

fn t_put(p, s) {
    var n = strlen(s);
    var i = 0;
    while (i < n) { store8(p + i, load8(s + i)); i = i + 1; }
    return n;
}

# ---- the FFI contract ----
# The native backend must populate the SAME slots the C shim does,
# with kind = PURE_CYRIUS. ADR-0002's append-after-kind invariant
# means this table is byte-compatible with the libsystemd one.
fn test_native_populates_the_same_table() {
    test_group("native: populates every slot the C shim does");
    var t = samvada_ffi_alloc();
    assert(t != 0, "table allocated");
    assert_eq(dbus_native_populate(t), 0, "populate succeeds");
    assert_eq(samvada_ffi_kind(t), samvada_backend_kind_pure_cyrius(),
      "kind is PURE_CYRIUS, not LIBSYSTEMD");
    assert(samvada_ffi_get_slot(t, samvada_slot_open_system_bus()) != 0, "open_system_bus wired");
    assert(samvada_ffi_get_slot(t, samvada_slot_get_session_path()) != 0, "get_session_path wired");
    assert(samvada_ffi_get_slot(t, samvada_slot_take_device()) != 0, "take_device wired");
    assert(samvada_ffi_get_slot(t, samvada_slot_release_device()) != 0, "release_device wired");
    assert(samvada_ffi_get_slot(t, samvada_slot_pump_signals()) != 0, "pump_signals wired");
    assert(samvada_ffi_get_slot(t, samvada_slot_close_bus()) != 0, "close_bus wired");
    assert(samvada_ffi_get_slot(t, samvada_slot_take_control()) != 0, "take_control wired");
    assert(samvada_ffi_get_slot(t, samvada_slot_release_control()) != 0, "release_control wired");
    assert_eq(dbus_native_populate(0), -22, "null table rejected");
    return 0;
}

# THE arity pin. src/samvada.cyr dispatches these with fixed
# fncallN arities; a native fn with the wrong parameter count reads
# garbage from an unset register and crashes somewhere else
# entirely. Calling each through the SAME fncallN the public API
# uses is the only way to catch it at CPU-test time.
fn test_ffi_arities_match_the_frozen_dispatch() {
    test_group("native: fn arities match the frozen fncallN shapes");
    var t = samvada_ffi_alloc();
    dbus_native_populate(t);

    # fncall1(slot, bus) — pump_signals and close_bus.
    # pump on an empty framer must report 0 events, not fault.
    dbus_frame_init();
    var pump = samvada_ffi_get_slot(t, samvada_slot_pump_signals());
    assert_eq(fncall1(pump, 0), 0, "pump_signals is fncall1-shaped");

    # fncall1(slot, bus) — close_bus with fd 0 must not close stdin.
    var close = samvada_ffi_get_slot(t, samvada_slot_close_bus());
    assert_eq(fncall1(close, 0), 0, "close_bus is fncall1-shaped");
    var st = alloc(160);
    assert(sys_fstat(0, st) >= 0, "and did NOT close fd 0");

    # fncall4(slot, bus, sess, major, minor) — release_device.
    # A negative devnum is refused before any I/O, which makes this
    # callable with no bus.
    var rel = samvada_ffi_get_slot(t, samvada_slot_release_device());
    assert_eq(fncall4(rel, 0, 0, (0 - 1), 0), -22,
      "release_device is fncall4-shaped and validates");

    # fncall6(slot, bus, sess, major, minor, fd_out, active_out).
    var take = samvada_ffi_get_slot(t, samvada_slot_take_device());
    var fo = alloc(8);
    var ao = alloc(8);
    assert_eq(fncall6(take, 0, 0, (0 - 1), 0, fo, ao), -22,
      "take_device is fncall6-shaped and validates");

    # fncall4(slot, bus, pid, buf, len) — get_session_path.
    var gsp = samvada_ffi_get_slot(t, samvada_slot_get_session_path());
    assert_eq(fncall4(gsp, 0, 1, 0, 64), -22, "get_session_path is fncall4-shaped");
    var buf = alloc(64);
    assert_eq(fncall4(gsp, 0, 1, buf, 0), -22, "and validates its length");

    # DIRECT calls at the exact declared arity. These are the real
    # guard: Cyrius rejects a wrong-arity direct call at COMPILE
    # time, so a native fn that loses or gains a parameter stops the
    # build instead of crashing somewhere else through fncallN.
    assert_eq(dbus_native_take_device(0, 0, (0 - 1), 0, fo, ao), -22, "take_device/6");
    assert_eq(dbus_native_release_device(0, 0, (0 - 1), 0), -22, "release_device/4");
    assert_eq(dbus_native_get_session_path(0, 1, 0, 64), -22, "get_session_path/4");
    assert_eq(dbus_native_pump_signals(0), 0, "pump_signals/1");
    assert_eq(dbus_native_close_bus(0), 0, "close_bus/1");
    return 0;
}

# ---- serial counter ----
fn test_serial_counter() {
    test_group("native: serials increment and never yield 0");
    dbus_session_reset();
    assert_eq(dbus_session_next_serial(), 1, "first serial is 1");
    assert_eq(dbus_session_next_serial(), 2, "then 2");
    assert_eq(dbus_session_next_serial(), 3, "then 3");
    # The spec reserves serial 0. Driving next_serial() to the u32
    # ceiling would take four billion calls, so the wrap is a pure
    # fn and the branch that matters is asserted directly.
    assert_eq(dbus_session_wrap_serial(1), 1, "1 passes through");
    assert_eq(dbus_session_wrap_serial(4294967295), 4294967295, "u32 max passes through");
    assert_eq(dbus_session_wrap_serial(4294967296), 1, "one past the ceiling wraps to 1");
    assert_eq(dbus_session_wrap_serial(0), 1, "0 is never returned — the spec reserves it");
    return 0;
}

# ---- error mapping ----
# The frozen API promises sd-bus errno pass-through, so the native
# backend must reproduce libsystemd's name -> errno map or consumers
# branching on magnitudes break. These are the names samvada's own
# calls can actually produce; AccessDenied is the one captured live
# in tests/fixtures/dbus/05-takedevice-error-reply.bin.
fn test_error_name_mapping() {
    test_group("native: dbus error names map to sd-bus errnos");
    var p = alloc(128);
    var n = t_put(p, "org.freedesktop.DBus.Error.AccessDenied");
    assert_eq(dbus_session_map_error(p, n), -13, "AccessDenied -> -EACCES");
    n = t_put(p, "org.freedesktop.login1.NotInControl");
    assert_eq(dbus_session_map_error(p, n), -22, "NotInControl -> -EINVAL");
    n = t_put(p, "org.freedesktop.DBus.Error.NoSuchDevice");
    assert_eq(dbus_session_map_error(p, n), -19, "NoSuchDevice -> -ENODEV");
    n = t_put(p, "System.Error.EBUSY");
    assert_eq(dbus_session_map_error(p, n), -16, "EBUSY -> -EBUSY");
    n = t_put(p, "org.freedesktop.DBus.Error.ServiceUnknown");
    assert_eq(dbus_session_map_error(p, n), -2, "ServiceUnknown -> -ENOENT");
    n = t_put(p, "com.example.SomethingElse");
    assert_eq(dbus_session_map_error(p, n), -5, "anything unmapped -> -EIO");
    # A prefix must not match a longer name.
    n = t_put(p, "org.freedesktop.login1.NotInControlXX");
    assert(dbus_session_map_error(p, n) != -22, "prefix does NOT match");
    return 0;
}

# ---- decoding a REAL captured error reply ----
# The AccessDenied reply captured in N2, reconstructed field for
# field, must map to exactly what the live run produced: -13.
fn test_captured_error_reply_maps_to_eacces() {
    test_group("native: the captured AccessDenied reply maps to -13");
    var t = alloc(128);
    dbus_marshal_begin(dbus_marshal_type_error(), 1, 20486);
    dbus_marshal_field_u32(dbus_marshal_f_replyser(), 4);
    var n = t_put(t, "org.freedesktop.DBus.Error.AccessDenied");
    dbus_marshal_field_str(dbus_marshal_f_errname(), 115, t, n);
    var sg = alloc(8);
    var sn = t_put(sg, "s");
    dbus_marshal_field_sig(dbus_marshal_f_signature(), sg, sn);
    dbus_marshal_end_fields();
    n = t_put(t, "Operation not permitted");
    dbus_marshal_body_str(t, n);
    dbus_marshal_finish();
    dbus_unmarshal_set_limit(dbus_marshal_len());

    var b = dbus_marshal_buf();
    assert_eq(dbus_unmarshal_type(b), dbus_marshal_type_error(), "it is an ERROR");
    var sig = alloc(8);
    var eo = dbus_unmarshal_find_field(b, dbus_marshal_f_errname(), sig);
    assert(eo > 0, "ERROR_NAME located");
    var ptr = alloc(8);
    var en = dbus_unmarshal_str_at(b, eo, ptr);
    assert_eq(dbus_session_map_error(load64(ptr), en), -13,
      "maps to -13, matching the live run");
    # the human-readable body survives too
    dbus_unmarshal_body_begin(b);
    var m = dbus_unmarshal_next_str(ptr);
    assert_eq(m, 23, "body message is 23 bytes");
    return 0;
}

# ---- the empty-body call ----
# ReleaseControl takes no arguments. A message with an empty body
# carries NO signature field at all — emitting SIGNATURE="" is a
# different encoding, and logind's reader tolerates the omission,
# which is what libsystemd does.
fn test_release_control_has_no_signature_field() {
    test_group("native: an empty-body call omits SIGNATURE entirely");
    var t = alloc(128);
    var pn = t_put(t, "/org/freedesktop/login1/session/_32");
    var m = alloc(64);
    var mn = t_put(m, "ReleaseControl");
    dbus_session_begin_call(t, pn, m, mn, 0, 5);
    dbus_marshal_end_fields();
    dbus_marshal_finish();
    dbus_unmarshal_set_limit(dbus_marshal_len());
    var b = dbus_marshal_buf();
    assert_eq(dbus_unmarshal_body_len(b), 0, "empty body");
    var sig = alloc(8);
    assert_eq(dbus_unmarshal_find_field(b, dbus_marshal_f_signature(), sig),
      dbus_unmarshal_notfound(), "and NO SIGNATURE field");
    # the interface must be Session, not Manager
    var off = dbus_unmarshal_find_field(b, dbus_marshal_f_interface(), sig);
    var ptr = alloc(8);
    var n = dbus_unmarshal_str_at(b, off, ptr);
    assert_eq(n, strlen("org.freedesktop.login1.Session"), "interface is Session");
    return 0;
}

# ---- socketpair plumbing for the reply-path pins ----
# sendmsg is 46 on x86_64 but **ftruncate** on aarch64; hardcoding it
# would not fail loudly there, it would truncate a file.
fn s_sendmsg_nr() {
    #ifdef CYRIUS_ARCH_AARCH64
    return 211;
    #endif
    return 46;
}

var _s_iov  = 0;
var _s_mh   = 0;
var _s_ctrl = 0;

fn s_send_init() {
    if (_s_iov != 0) { return 0; }
    _s_iov  = alloc(16);
    _s_mh   = alloc(56);
    _s_ctrl = alloc(24);
    return 0;
}

# Send `len` bytes plus one SCM_RIGHTS fd. Planting a whole framed
# reply this way is the only way to exercise the call path's read
# with a descriptor actually riding on it.
fn s_send_with_fd(sock, buf, len, payload_fd) {
    s_send_init();
    store64(_s_iov + 0, buf);
    store64(_s_iov + 8, len);
    var i = 0;
    while (i < 24) { store64(_s_ctrl + i, 0); i = i + 8; }
    store64(_s_ctrl + 0, dbus_sys_cmsg_len_1fd());
    store64(_s_ctrl + 8, dbus_sys_sol_socket());
    store64(_s_ctrl + 12, dbus_sys_scm_rights());
    store64(_s_ctrl + 16, payload_fd);
    i = 0;
    while (i < 56) { store64(_s_mh + i, 0); i = i + 8; }
    store64(_s_mh + 16, _s_iov);
    store64(_s_mh + 24, 1);
    store64(_s_mh + 32, _s_ctrl);
    store64(_s_mh + 40, dbus_sys_cmsg_space_1fd());
    return syscall(s_sendmsg_nr(), sock, _s_mh, 0);
}

fn s_copy(dst, src, n) {
    var i = 0;
    while (i < n) { store8(dst + i, load8(src + i)); i = i + 1; }
    return n;
}

# ---- THE FD PIN ----
# dbus_session_call must read with recvmsg, not read(). A plain
# read() delivers the reply's BYTES and lets the kernel discard the
# SCM_RIGHTS payload: the message parses perfectly, its UNIX_FDS
# field still says 1, the body still carries a valid index, and the
# descriptor is gone. Nothing downstream can tell.
#
# That was true of every release through 0.11.0 and no test caught
# it, because an unseated host answers TakeDevice with AccessDenied
# and an ERROR reply carries no fd — so the fd path never ran. This
# plants a real fd on a real reply over a socketpair, which needs no
# bus and no seat.
fn test_reply_fd_survives_the_call_path() {
    test_group("native: an fd riding on a METHOD_RETURN survives the call path");
    var pair = alloc(8);
    store64(pair, 0);
    assert_eq(sys_socketpair(dbus_sys_af_unix(), dbus_sys_sock_stream(), 0, pair), 0,
      "socketpair created");
    var a = load64(pair) & 0xFFFFFFFF;
    var b = (load64(pair) >> 32) & 0xFFFFFFFF;

    # A TakeDevice-shaped reply: UNIX_FDS=1, signature 'h', body index 0.
    dbus_marshal_begin(dbus_marshal_type_return(), 1, 4242);
    dbus_marshal_field_u32(dbus_marshal_f_replyser(), 7);
    var sg = alloc(8);
    var sn = t_put(sg, "h");
    dbus_marshal_field_sig(dbus_marshal_f_signature(), sg, sn);
    dbus_marshal_field_u32(dbus_marshal_f_unixfds(), 1);
    dbus_marshal_end_fields();
    dbus_marshal_body_u32(0);
    dbus_marshal_finish();
    dbus_unmarshal_set_limit(dbus_marshal_len());
    var mlen = dbus_marshal_len();
    var wire = alloc(512);
    s_copy(wire, dbus_marshal_buf(), mlen);

    # The payload fd is one end of a second socketpair — a real open
    # descriptor with no filesystem dependency.
    var pair2 = alloc(8);
    store64(pair2, 0);
    assert_eq(sys_socketpair(dbus_sys_af_unix(), dbus_sys_sock_stream(), 0, pair2), 0,
      "payload pair created");
    var payload = load64(pair2) & 0xFFFFFFFF;
    var payload_peer = (load64(pair2) >> 32) & 0xFFFFFFFF;

    assert_eq(s_send_with_fd(a, wire, mlen, payload), mlen, "reply + fd planted");

    dbus_frame_init();
    assert_eq(dbus_frame_fd_count(), 0, "fd queue starts empty");
    var rc = dbus_session_call(b, 7);
    assert_eq(rc, 0, "the reply matched and was accepted");
    assert_eq(dbus_frame_fd_count(), 1,
      "THE PIN: the descriptor arrived — a plain read() would leave this 0");
    var got = dbus_frame_take_fd();
    assert(got > 2, "and it is a usable descriptor");
    assert(got != payload, "a NEW descriptor number, not the sender's");

    sys_close(got);
    sys_close(payload);
    sys_close(payload_peer);
    sys_close(a);
    sys_close(b);
    return 0;
}

# ---- THE TYPE-GATE PIN ----
# The 2026-09-09 reply-forgery audit found that the ONE frame type a
# hostile bus peer can actually push to samvada is a directed SIGNAL
# — the broker delivers those to any destination, and a peer can
# bolt a matching REPLY_SERIAL onto one. samvada discards it only
# because dbus_session_call returns for message type 2/3 and nothing
# else. That guard reads as spec-correctness (ignore NameAcquired),
# so its anti-forgery value is incidental and undocumented. Pinned
# here so it is never "simplified" away.
fn test_forged_signal_cannot_impersonate_a_reply() {
    test_group("native: a SIGNAL carrying a matching REPLY_SERIAL is NOT the reply");
    var pair = alloc(8);
    store64(pair, 0);
    assert_eq(sys_socketpair(dbus_sys_af_unix(), dbus_sys_sock_stream(), 0, pair), 0,
      "socketpair created");
    var a = load64(pair) & 0xFFFFFFFF;
    var b = (load64(pair) >> 32) & 0xFFFFFFFF;

    var sg = alloc(8);
    var txt = alloc(64);
    var wire = alloc(1024);
    var at = 0;

    # (1) the forgery: a SIGNAL whose REPLY_SERIAL matches ours.
    dbus_marshal_begin(dbus_marshal_type_signal(), 1, 9001);
    dbus_marshal_field_u32(dbus_marshal_f_replyser(), 9);
    var sn = t_put(sg, "o");
    dbus_marshal_field_sig(dbus_marshal_f_signature(), sg, sn);
    dbus_marshal_end_fields();
    var tn = t_put(txt, "/org/freedesktop/PWNED/session/_99");
    dbus_marshal_body_str(txt, tn);
    dbus_marshal_finish();
    dbus_unmarshal_set_limit(dbus_marshal_len());
    at = at + s_copy(wire + at, dbus_marshal_buf(), dbus_marshal_len());

    # (2) the genuine reply, same serial, arriving second.
    dbus_marshal_begin(dbus_marshal_type_return(), 1, 9002);
    dbus_marshal_field_u32(dbus_marshal_f_replyser(), 9);
    sn = t_put(sg, "o");
    dbus_marshal_field_sig(dbus_marshal_f_signature(), sg, sn);
    dbus_marshal_end_fields();
    tn = t_put(txt, "/org/freedesktop/login1/session/_32");
    dbus_marshal_body_str(txt, tn);
    dbus_marshal_finish();
    dbus_unmarshal_set_limit(dbus_marshal_len());
    at = at + s_copy(wire + at, dbus_marshal_buf(), dbus_marshal_len());

    assert_eq(sys_write(a, wire, at), at, "forged signal + real reply planted");

    dbus_frame_init();
    var rc = dbus_session_call(b, 9);
    assert_eq(rc, 0, "the call completed");
    var p = dbus_frame_base();
    assert_eq(dbus_unmarshal_type(p), dbus_marshal_type_return(),
      "THE PIN: what it accepted is the METHOD_RETURN, not the SIGNAL");
    dbus_unmarshal_set_limit(dbus_frame_next());
    dbus_unmarshal_body_begin(p);
    var ptr = alloc(8);
    var n = dbus_unmarshal_next_str(ptr);
    assert_eq(n, strlen("/org/freedesktop/login1/session/_32"),
      "and it carries the REAL session path, not the forged one");

    sys_close(a);
    sys_close(b);
    return 0;
}

# Build a METHOD_RETURN addressed to `dest`, answering `rser`,
# carrying `path` as its body. Returns its length; bytes are in the
# marshal buffer.
fn s_build_reply(rser, dest, destn, path, pathn) {
    dbus_marshal_begin(dbus_marshal_type_return(), 1, 5000);
    dbus_marshal_field_u32(dbus_marshal_f_replyser(), rser);
    dbus_marshal_field_str(dbus_marshal_f_dest(), 115, dest, destn);
    var sg = alloc(8);
    var sn = t_put(sg, "o");
    dbus_marshal_field_sig(dbus_marshal_f_signature(), sg, sn);
    dbus_marshal_end_fields();
    dbus_marshal_body_str(path, pathn);
    dbus_marshal_finish();
    dbus_unmarshal_set_limit(dbus_marshal_len());
    return dbus_marshal_len();
}

# ---- THE DESTINATION PIN ----
# sd-bus's async guard (sd-bus.c:2790) and the one provenance check
# samvada makes. A reply whose REPLY_SERIAL matches but which is
# addressed to a DIFFERENT unique name is not ours, and must be
# skipped rather than accepted.
fn test_reply_addressed_elsewhere_is_refused() {
    test_group("native: a reply addressed to someone else is NOT ours");
    var pair = alloc(8);
    store64(pair, 0);
    assert_eq(sys_socketpair(dbus_sys_af_unix(), dbus_sys_sock_stream(), 0, pair), 0,
      "socketpair created");
    var a = load64(pair) & 0xFFFFFFFF;
    var b = (load64(pair) >> 32) & 0xFFFFFFFF;

    dbus_session_reset();
    var me = alloc(32);
    var men = t_put(me, ":1.99");
    assert_eq(dbus_session_set_unique(me, men), 0, "our unique name is known");

    var them = alloc(32);
    var wire = alloc(1024);
    var txt = alloc(64);
    var at = 0;

    # (1) same serial, addressed to a DIFFERENT peer.
    var thn = t_put(them, ":1.500");
    var tn = t_put(txt, "/org/freedesktop/PWNED/session/_99");
    at = at + s_copy(wire + at, dbus_marshal_buf(),
      s_build_reply(11, them, thn, txt, tn));
    # (2) same serial, addressed to US.
    thn = t_put(them, ":1.99");
    tn = t_put(txt, "/org/freedesktop/login1/session/_32");
    at = at + s_copy(wire + at, dbus_marshal_buf(),
      s_build_reply(11, them, thn, txt, tn));

    assert_eq(sys_write(a, wire, at), at, "both replies planted");

    dbus_frame_init();
    var rc = dbus_session_call(b, 11);
    assert_eq(rc, 0, "the call completed");
    var p = dbus_frame_base();
    dbus_unmarshal_set_limit(dbus_frame_next());
    dbus_unmarshal_body_begin(p);
    var ptr = alloc(8);
    var n = dbus_unmarshal_next_str(ptr);
    assert_eq(n, strlen("/org/freedesktop/login1/session/_32"),
      "THE PIN: it skipped the misaddressed reply and took the one meant for us");

    dbus_session_reset();
    sys_close(a);
    sys_close(b);
    return 0;
}

# The same guard must not fire when the field is ABSENT, or the
# Hello reply — matched before the bus has told us our own name —
# would be rejected and no connection could ever be established.
fn test_absent_destination_is_permitted() {
    test_group("native: a reply with NO destination field is still accepted");
    var pair = alloc(8);
    store64(pair, 0);
    assert_eq(sys_socketpair(dbus_sys_af_unix(), dbus_sys_sock_stream(), 0, pair), 0,
      "socketpair created");
    var a = load64(pair) & 0xFFFFFFFF;
    var b = (load64(pair) >> 32) & 0xFFFFFFFF;

    dbus_session_reset();
    var me = alloc(32);
    var men = t_put(me, ":1.99");
    dbus_session_set_unique(me, men);

    dbus_marshal_begin(dbus_marshal_type_return(), 1, 5001);
    dbus_marshal_field_u32(dbus_marshal_f_replyser(), 13);
    dbus_marshal_end_fields();
    dbus_marshal_finish();
    dbus_unmarshal_set_limit(dbus_marshal_len());
    var mlen = dbus_marshal_len();
    var wire = alloc(256);
    s_copy(wire, dbus_marshal_buf(), mlen);
    assert_eq(sys_write(a, wire, mlen), mlen, "destination-less reply planted");

    dbus_frame_init();
    assert_eq(dbus_session_call(b, 13), 0,
      "THE PIN: absent DESTINATION is permitted, as in sd-bus — the Hello reply depends on it");

    dbus_session_reset();
    sys_close(a);
    sys_close(b);
    return 0;
}

# ---- THE WATERMARK PIN ----
# Bytes already in the buffer when the request goes out cannot be a
# reply to it. Without this, an attacker who can get a well-formed
# reply into the buffer EARLY answers a call that has not been made
# yet — and samvada's serials are sequential, so the serial to use
# is not a secret.
fn test_preplanted_reply_cannot_answer_a_later_call() {
    test_group("native: a reply buffered BEFORE the request cannot answer it");
    var pair = alloc(8);
    store64(pair, 0);
    assert_eq(sys_socketpair(dbus_sys_af_unix(), dbus_sys_sock_stream(), 0, pair), 0,
      "socketpair created");
    var a = load64(pair) & 0xFFFFFFFF;
    var b = (load64(pair) >> 32) & 0xFFFFFFFF;

    dbus_session_reset();
    dbus_frame_init();

    # Pre-plant a perfectly valid reply DIRECTLY into the framer's
    # buffer, as an earlier pump_signals would have left it there.
    var me = alloc(32);
    var men = t_put(me, ":1.99");
    var txt = alloc(64);
    var tn = t_put(txt, "/org/freedesktop/PWNED/session/_99");
    var flen = s_build_reply(12, me, men, txt, tn);
    s_copy(dbus_frame_tail(), dbus_marshal_buf(), flen);
    dbus_frame_commit(flen);
    assert_eq(dbus_frame_have(), flen, "the forged reply is buffered before the call");

    # The genuine reply, same serial, arrives on the wire afterwards.
    tn = t_put(txt, "/org/freedesktop/login1/session/_32");
    var rlen = s_build_reply(12, me, men, txt, tn);
    var wire = alloc(512);
    s_copy(wire, dbus_marshal_buf(), rlen);
    assert_eq(sys_write(a, wire, rlen), rlen, "genuine reply planted on the wire");

    var rc = dbus_session_call(b, 12);
    assert_eq(rc, 0, "the call completed");
    var p = dbus_frame_base();
    dbus_unmarshal_set_limit(dbus_frame_next());
    dbus_unmarshal_body_begin(p);
    var ptr = alloc(8);
    var n = dbus_unmarshal_next_str(ptr);
    assert_eq(n, strlen("/org/freedesktop/login1/session/_32"),
      "THE PIN: the pre-planted reply was skipped; the one that arrived after the send won");

    dbus_session_reset();
    sys_close(a);
    sys_close(b);
    return 0;
}

# ---- THE TIMEOUT PINS ----
# Before 1.0.0 samvada had no time-based bound of ANY kind: the
# socket is blocking, nothing called setsockopt, and the reply
# loop's "64 spins" counts MESSAGES, not seconds. A peer that
# accepted the connection and then said nothing hung the caller
# forever — inside a compositor, an indefinite freeze.
#
# This is not hypothetical: while mutation-testing the DESTINATION
# guard, the over-strict variant did not fail the suite, it HUNG it.
fn test_silent_peer_times_out_instead_of_hanging() {
    test_group("native: a peer that never answers times out, it does not hang");
    var pair = alloc(8);
    store64(pair, 0);
    assert_eq(sys_socketpair(dbus_sys_af_unix(), dbus_sys_sock_stream(), 0, pair), 0,
      "socketpair created");
    var a = load64(pair) & 0xFFFFFFFF;
    var b = (load64(pair) >> 32) & 0xFFFFFFFF;

    # 200 ms rather than the 25 s default, so the pin runs fast. This
    # is the same setsockopt dbus_socket_connect arms in production.
    assert_eq(dbus_socket_set_recv_timeout(b, 0, 200000), 0,
      "SO_RCVTIMEO accepted by the kernel");

    dbus_session_reset();
    dbus_frame_init();

    # Nothing is EVER planted on `a`. The peer is simply silent.
    var t0 = dbus_session_now_ms();
    assert(t0 > 0, "the monotonic clock works — arch syscall number is right");
    var rc = dbus_session_call(b, 99);
    var elapsed = dbus_session_now_ms() - t0;

    assert_eq(rc, -110,
      "THE PIN: -ETIMEDOUT from an expired SO_RCVTIMEO, not a hang and not raw -EAGAIN");
    var prompt = 0;
    if (elapsed < 5000) { prompt = 1; }
    assert_eq(prompt, 1, "and it gave up promptly rather than spinning out 64 reads");

    dbus_session_reset();
    sys_close(a);
    sys_close(b);
    return 0;
}

# The per-receive timeout above cannot bound the CALL: a peer that
# dribbles one byte per read satisfies every individual SO_RCVTIMEO
# while the call runs unbounded. The wall-clock deadline is what
# closes that. Driving it with a zero budget reaches the branch
# deterministically, with no slow peer to orchestrate.
fn test_expired_deadline_refuses_to_block() {
    test_group("native: an expired wall-clock deadline returns before blocking");
    var pair = alloc(8);
    store64(pair, 0);
    assert_eq(sys_socketpair(dbus_sys_af_unix(), dbus_sys_sock_stream(), 0, pair), 0,
      "socketpair created");
    var a = load64(pair) & 0xFFFFFFFF;
    var b = (load64(pair) >> 32) & 0xFFFFFFFF;

    dbus_session_reset();
    dbus_frame_init();
    assert_eq(dbus_session_set_timeout_ms(0), 0, "budget set to zero");

    # No SO_RCVTIMEO is armed on `b`, so if the deadline check did
    # NOT fire this call would block on a silent peer forever. That
    # is precisely what makes this a real pin.
    var rc = dbus_session_call(b, 77);
    assert_eq(rc, -110, "THE PIN: the deadline fired before committing to a blocking receive");

    # A budget large enough to overflow `t0 + timeout` must be
    # REFUSED, not accepted: the deadline is gated on `deadline > 0`,
    # so a wrapped-negative sum silently DISARMS the guard. A bound
    # that its own argument can switch off is not a bound.
    assert_eq(dbus_session_set_timeout_ms(9223372036854775807), -22,
      "THE PIN: an overflowing budget is refused, not silently disarming");
    assert_eq(dbus_session_set_timeout_ms(dbus_session_timeout_max_ms() + 1), -22,
      "one past the cap is refused");
    assert_eq(dbus_session_set_timeout_ms(dbus_session_timeout_max_ms()), 0,
      "the cap itself is accepted");
    assert_eq(dbus_session_set_timeout_ms((0 - 1)), -22, "negative is refused");

    # And reset must restore the default, or a short budget leaks
    # into every later test in this file.
    dbus_session_reset();
    assert_eq(dbus_session_timeout_ms(), 25000,
      "reset restored the 25 s default (the global resolves correctly)");

    sys_close(a);
    sys_close(b);
    return 0;
}

fn s_ino(fd) {
    var st = alloc(160);
    var rc = sys_fstat(fd, st);
    if (rc < 0) { return (0 - 1); }
    return load64(st + 8);              # st_ino sits at +8 on x86_64
}

# Count open descriptors by fstat'ing each number. Stronger than a
# lowest-free-fd probe, which the 0.8.0 work found could pass against
# a version that was leaking two descriptors.
fn s_count_open() {
    var st = alloc(160);
    var n = 0;
    var i = 0;
    while (i < 64) {
        var rc = sys_fstat(i, st);
        if (rc >= 0) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

fn s_pair() {
    var p = alloc(8);
    store64(p, 0);
    sys_socketpair(dbus_sys_af_unix(), dbus_sys_sock_stream(), 0, p);
    return load64(p);
}

# ---- THE FD-OWNERSHIP PIN ----
# There is ONE fd queue with TWO fill sites (the reply loop and
# pump_signals) and ONE drain site (take_device), which pops FIFO.
# logind's ResumeDevice SIGNAL carries a descriptor, and signals are
# never surfaced (ADR-0004) — so that descriptor used to sit at the
# head of the queue until the next take_device collected it BY
# MISTAKE. A compositor asking for an input device would have been
# handed the DRM descriptor from an earlier resume.
#
# Measured before the fix: signal fd inode 3201875, reply fd inode
# 3201877, take_fd() returned 3201875.
#
# Same shape as AUDIT-4 — an index into a queue whose fill path was
# never exercised.
fn test_take_device_gets_its_own_descriptor() {
    test_group("native: a signal's descriptor is not collected by the next call");
    var before = s_count_open();

    var bus = s_pair();
    var a = bus & 0xFFFFFFFF;
    var b = (bus >> 32) & 0xFFFFFFFF;
    var px = s_pair();
    var x = px & 0xFFFFFFFF;
    var xp = (px >> 32) & 0xFFFFFFFF;
    var py = s_pair();
    var y = py & 0xFFFFFFFF;
    var yp = (py >> 32) & 0xFFFFFFFF;

    var inox = s_ino(x);
    var inoy = s_ino(y);
    var distinct = 0;
    if (inox != inoy) { distinct = 1; }
    assert_eq(distinct, 1, "the two descriptors are distinguishable by inode");

    dbus_session_reset();
    dbus_frame_init();

    # (1) a ResumeDevice-shaped SIGNAL carrying descriptor X.
    var sg = alloc(8);
    store8(sg, 104);                    # 'h'
    dbus_marshal_begin(dbus_marshal_type_signal(), 1, 9001);
    dbus_marshal_field_sig(dbus_marshal_f_signature(), sg, 1);
    dbus_marshal_field_u32(dbus_marshal_f_unixfds(), 1);
    dbus_marshal_end_fields();
    dbus_marshal_body_u32(0);
    dbus_marshal_finish();
    dbus_unmarshal_set_limit(dbus_marshal_len());
    var slen = dbus_marshal_len();
    var swire = alloc(512);
    s_copy(swire, dbus_marshal_buf(), slen);
    assert_eq(s_send_with_fd(a, swire, slen, x), slen, "signal + its fd planted");

    # (2) the TakeDevice reply carrying descriptor Y.
    dbus_marshal_begin(dbus_marshal_type_return(), 1, 4242);
    dbus_marshal_field_u32(dbus_marshal_f_replyser(), 7);
    dbus_marshal_field_sig(dbus_marshal_f_signature(), sg, 1);
    dbus_marshal_field_u32(dbus_marshal_f_unixfds(), 1);
    dbus_marshal_end_fields();
    dbus_marshal_body_u32(0);
    dbus_marshal_finish();
    dbus_unmarshal_set_limit(dbus_marshal_len());
    var rlen = dbus_marshal_len();
    var rwire = alloc(512);
    s_copy(rwire, dbus_marshal_buf(), rlen);
    assert_eq(s_send_with_fd(a, rwire, rlen, y), rlen, "reply + its fd planted");

    assert_eq(dbus_session_call(b, 7), 0, "the reply matched");
    assert_eq(dbus_frame_fd_count(), 1,
      "exactly one descriptor is queued — the signal's was closed, not left behind");

    var got = dbus_frame_take_fd();
    assert(got > 2, "a descriptor came back");
    assert_eq(s_ino(got), inoy,
      "THE PIN: it is the REPLY's descriptor, not the signal's");

    sys_close(got);
    sys_close(x);  sys_close(xp);
    sys_close(y);  sys_close(yp);
    sys_close(a);  sys_close(b);
    dbus_session_reset();

    assert_eq(s_count_open(), before,
      "and the signal's descriptor was closed, not leaked");
    return 0;
}

# The same hazard by the OTHER route, and the more realistic one: a
# compositor pumps its event loop, logind's ResumeDevice arrives with
# a descriptor, and only later does the consumer take a device.
# pump_signals fills the shared queue and never drains it.
fn test_pumped_signal_descriptor_is_not_left_for_take_device() {
    test_group("native: pump_signals does not leave a descriptor for the next take");
    var before = s_count_open();

    var bus = s_pair();
    var a = bus & 0xFFFFFFFF;
    var b = (bus >> 32) & 0xFFFFFFFF;
    var px = s_pair();
    var x = px & 0xFFFFFFFF;
    var xp = (px >> 32) & 0xFFFFFFFF;
    var py = s_pair();
    var y = py & 0xFFFFFFFF;
    var yp = (py >> 32) & 0xFFFFFFFF;
    var inoy = s_ino(y);

    dbus_session_reset();
    dbus_frame_init();

    var sg = alloc(8);
    store8(sg, 104);                    # 'h'
    dbus_marshal_begin(dbus_marshal_type_signal(), 1, 9001);
    dbus_marshal_field_sig(dbus_marshal_f_signature(), sg, 1);
    dbus_marshal_field_u32(dbus_marshal_f_unixfds(), 1);
    dbus_marshal_end_fields();
    dbus_marshal_body_u32(0);
    dbus_marshal_finish();
    dbus_unmarshal_set_limit(dbus_marshal_len());
    var slen = dbus_marshal_len();
    var swire = alloc(512);
    s_copy(swire, dbus_marshal_buf(), slen);
    assert_eq(s_send_with_fd(a, swire, slen, x), slen, "ResumeDevice-shaped signal planted");

    # The consumer pumps its event loop first.
    assert_eq(dbus_native_pump_signals(b), 1, "pump drained exactly one message");
    assert_eq(dbus_frame_fd_count(), 0,
      "THE PIN: pump left NO descriptor behind for a later take_device");

    # Only now does it take a device.
    dbus_marshal_begin(dbus_marshal_type_return(), 1, 4242);
    dbus_marshal_field_u32(dbus_marshal_f_replyser(), 7);
    dbus_marshal_field_sig(dbus_marshal_f_signature(), sg, 1);
    dbus_marshal_field_u32(dbus_marshal_f_unixfds(), 1);
    dbus_marshal_end_fields();
    dbus_marshal_body_u32(0);
    dbus_marshal_finish();
    dbus_unmarshal_set_limit(dbus_marshal_len());
    var rlen = dbus_marshal_len();
    var rwire = alloc(512);
    s_copy(rwire, dbus_marshal_buf(), rlen);
    assert_eq(s_send_with_fd(a, rwire, rlen, y), rlen, "reply + its fd planted");

    assert_eq(dbus_session_call(b, 7), 0, "the reply matched");
    var got = dbus_frame_take_fd();
    assert_eq(s_ino(got), inoy, "and take got the REPLY's descriptor");

    sys_close(got);
    sys_close(x);  sys_close(xp);
    sys_close(y);  sys_close(yp);
    sys_close(a);  sys_close(b);
    dbus_session_reset();
    assert_eq(s_count_open(), before, "no descriptor leaked");
    return 0;
}

# ---- THE DEVNUM PIN ----
# The C shim gates both device calls on devnum_ok(v) == (v >= 0 &&
# v <= UINT32_MAX) BEFORE the 64->32 narrowing — audit MED-2, 0.5.1,
# added because the cast truncated silently. CLAUDE.md says a
# PURE_CYRIUS backend must RE-SUPPLY that check; at the N6 cutover
# it did not, checking only `v < 0`.
#
# _dbm_u32 writes the low four bytes and nothing else, so a major of
# 2^32 + 1 marshalled as major 1: samvada would have opened a
# DIFFERENT DEVICE than asked for, silently, and returned success.
# The differential harness compares error codes for in-range values
# only, which is why it never noticed.
fn test_out_of_range_devnum_is_refused_not_truncated() {
    test_group("native: an out-of-range device number is refused, not silently truncated");
    var fo = alloc(8);
    var ao = alloc(8);

    # The predicate itself, exercised directly. Everything past the
    # guard does real I/O, so the bound is tested here rather than
    # through a call that would block on a 25 s deadline.
    assert_eq(dbus_session_devnum_ok(0), 1, "0 is a valid device number");
    assert_eq(dbus_session_devnum_ok(226), 1, "226 (DRM major) is valid");
    assert_eq(dbus_session_devnum_ok(4294967295), 1,
      "UINT32_MAX is valid — matches the shim's `v <= UINT32_MAX`");
    assert_eq(dbus_session_devnum_ok(4294967296), 0,
      "THE PIN: 2^32 is refused, not truncated to 0");
    assert_eq(dbus_session_devnum_ok(4294967522), 0,
      "2^32+226 refused, not truncated to 226 — the silent-wrong-device case");
    assert_eq(dbus_session_devnum_ok((0 - 1)), 0, "negative refused");

    # And the guard is actually WIRED into both device calls. These
    # return before any I/O, so they are safe with a null bus.
    assert_eq(dbus_native_take_device(0, 0, 4294967296, 0, fo, ao), -22,
      "take_device rejects an out-of-range major");
    assert_eq(dbus_native_take_device(0, 0, 0, 4294967296, fo, ao), -22,
      "take_device rejects an out-of-range minor");
    assert_eq(dbus_native_release_device(0, 0, 4294967296, 0), -22,
      "release_device rejects an out-of-range major");
    assert_eq(dbus_native_release_device(0, 0, 0, 4294967296), -22,
      "release_device rejects an out-of-range minor");
    assert_eq(dbus_native_take_device(0, 0, (0 - 1), 0, fo, ao), -22,
      "and the negative bound the native path always had");

    # A null session is refused rather than dereferenced, on ALL FOUR
    # fns that take one. These ship in dist/samvada.cyr, so a caller
    # we do not control reaches them; strlen(0) is a segfault, not an
    # error code. The public path survives only because samvada_init
    # allocates a zeroed buffer — luck, not design, which is AUDIT-1's
    # exact shape.
    #
    # The guard was first applied to the two device fns only, and
    # dbus_native_take_control(0, 0) went on exiting 139. All four are
    # asserted here so it cannot be half-applied a second time.
    assert_eq(dbus_session_sess_ok(0), 0, "the predicate rejects null");
    assert_eq(dbus_session_sess_ok(1), 1, "and accepts a pointer");
    assert_eq(dbus_native_take_device(0, 0, 226, 0, fo, ao), -22,
      "take_device refuses a null session");
    assert_eq(dbus_native_release_device(0, 0, 226, 0), -22,
      "release_device refuses a null session");
    assert_eq(dbus_native_take_control(0, 0), -22,
      "THE PIN: take_control refuses it too — this one used to SIGSEGV");
    assert_eq(dbus_native_release_control(0, 0), -22,
      "release_control refuses it too");
    return 0;
}

# ---- THE ALLOCATION PIN ----
# alloc() is a bump allocator that NEVER frees, and the consumer is a
# compositor that pumps at 60 Hz for days. Every alloc() on a
# repeating path is therefore a permanent leak, and no test process
# lives long enough to notice.
#
# Measured before the fix, on the IDLE path where nothing is read:
# 8 bytes per pump = ~41 MB/day at 60 Hz, unbounded.
fn test_repeating_paths_do_not_grow_the_heap() {
    test_group("native: the 60 Hz pump path allocates nothing per call");
    var p = alloc(8);
    store64(p, 0);
    assert_eq(sys_socketpair(dbus_sys_af_unix(), dbus_sys_sock_stream(), 0, p), 0,
      "socketpair created");
    var a = load64(p) & 0xFFFFFFFF;
    var b = (load64(p) >> 32) & 0xFFFFFFFF;

    dbus_session_reset();
    dbus_frame_init();

    # Warm up, so one-time lazy allocations are not counted as growth.
    dbus_native_pump_signals(b);
    dbus_native_pump_signals(b);

    var before = alloc_used();
    var i = 0;
    while (i < 20000) { dbus_native_pump_signals(b); i = i + 1; }
    var grew = alloc_used() - before;
    assert_eq(grew, 0,
      "THE PIN: 20000 idle pumps allocate ZERO bytes (was 8 each = ~41 MB/day at 60 Hz)");

    # The reply path too — and it must actually PARSE messages, or
    # the per-message allocation is never reached. A call that only
    # times out exercises nothing: that mistake is what let the
    # per-message alloc survive the first version of this test.
    assert_eq(dbus_socket_set_recv_timeout(b, 0, 20000), 0, "short recv timeout");
    var sgz = alloc(8);
    store8(sgz, 111);                   # 'o'
    var txt = alloc(64);
    var tn = t_put(txt, "/org/freedesktop/login1/session/_32");
    dbus_marshal_begin(dbus_marshal_type_return(), 1, 5000);
    dbus_marshal_field_u32(dbus_marshal_f_replyser(), 999);   # never matches
    dbus_marshal_field_sig(dbus_marshal_f_signature(), sgz, 1);
    dbus_marshal_end_fields();
    dbus_marshal_body_str(txt, tn);
    dbus_marshal_finish();
    dbus_unmarshal_set_limit(dbus_marshal_len());
    var one = dbus_marshal_len();
    var wire = alloc(2048);
    var w = 0;
    var c = 0;
    while (c < 8) { w = w + s_copy(wire + w, dbus_marshal_buf(), one); c = c + 1; }

    # Warm the path once so lazy one-time state is already allocated.
    sys_write(a, wire, w);
    dbus_session_call(b, 4242);

    var before2 = alloc_used();
    var j = 0;
    var parsed = 0;
    while (j < 10) {
        sys_write(a, wire, w);
        dbus_session_call(b, 4242);     # 8 messages examined and discarded
        parsed = parsed + 8;
        j = j + 1;
    }
    assert_eq(parsed, 80, "80 messages were actually examined, not zero");
    assert_eq(alloc_used() - before2, 0,
      "THE PIN: examining 80 messages allocates nothing (was 8 bytes EACH)");

    sys_close(a);
    sys_close(b);
    dbus_session_reset();
    return 0;
}

# ---- A-4: THE SASL READER UNDER HOSTILE INPUT ----
# dbus_auth is a line-oriented reader over the framer's SHARED 8192
# buffer, fed by a 48-byte pipelined blob. It runs BEFORE any dbus
# framing exists, against a peer that has not authenticated — so it
# is the first thing a hostile or broken server touches.
fn s_plant(p, n) {
    s_copy(dbus_frame_tail(), p, n);
    dbus_frame_commit(n);
    return n;
}

fn test_sasl_reader_survives_hostile_input() {
    test_group("native: the SASL reader survives hostile server output");
    var buf = alloc(9000);

    # (1) A line with no terminator, ever. Must ask for more rather
    # than scanning off the end.
    dbus_frame_init();
    dbus_auth_reset();
    var n = t_put(buf, "OK 1234");
    s_plant(buf, n);
    assert_eq(dbus_auth_drain_lines(), dbus_auth_need_more(),
      "an unterminated line asks for more, it does not guess");

    # (2) A line that FILLS the buffer with no terminator. The framer
    # has 8192 bytes; find_crlf must stay inside them.
    dbus_frame_init();
    dbus_auth_reset();
    var i = 0;
    while (i < 8000) { store8(buf + i, 65); i = i + 1; }   # 'A' x8000
    s_plant(buf, 8000);
    assert_eq(dbus_auth_drain_lines(), dbus_auth_need_more(),
      "8000 bytes with no CRLF stays in-bounds and asks for more");
    assert_eq(dbus_frame_space(), dbus_frame_cap() - 8000,
      "and consumed nothing, so the caller can see the buffer is nearly full");

    # (3) Binary garbage including NULs and high bytes.
    dbus_frame_init();
    dbus_auth_reset();
    i = 0;
    while (i < 64) { store8(buf + i, i * 3); i = i + 1; }
    store8(buf + 64, 13); store8(buf + 65, 10);            # CRLF
    s_plant(buf, 66);
    var g = dbus_auth_drain_lines();
    var garbage_ok = 0;
    if (g == dbus_auth_error()) { garbage_ok = 1; }
    if (g == dbus_auth_need_more()) { garbage_ok = 1; }
    assert_eq(garbage_ok, 1, "binary garbage is an error or ignored, never OK");

    # (4) An explicit REJECTED must not read as success.
    dbus_frame_init();
    dbus_auth_reset();
    n = t_put(buf, "REJECTED EXTERNAL\r\n");
    s_plant(buf, n);
    assert_eq(dbus_auth_drain_lines(), dbus_auth_rejected(), "REJECTED is reported as such");

    # (5) An ERROR line likewise.
    dbus_frame_init();
    dbus_auth_reset();
    n = t_put(buf, "ERROR not welcome\r\n");
    s_plant(buf, n);
    assert(dbus_auth_drain_lines() != dbus_auth_ok(), "ERROR is never OK");

    # (6) A line split across two reads must reassemble, not be lost.
    dbus_frame_init();
    dbus_auth_reset();
    n = t_put(buf, "OK 0123456789abcdef");
    s_plant(buf, n);
    assert_eq(dbus_auth_drain_lines(), dbus_auth_need_more(), "first half: incomplete");
    n = t_put(buf, "\r\nAGREE_UNIX_FD\r\n");
    s_plant(buf, n);
    assert_eq(dbus_auth_drain_lines(), dbus_auth_ok(),
      "the split line reassembles and completes with fd support");

    # (7) A server that OKs but refuses fd passing must be refused —
    # samvada cannot do TakeDevice without SCM_RIGHTS.
    dbus_frame_init();
    dbus_auth_reset();
    n = t_put(buf, "OK 0123456789abcdef\r\nERROR\r\n");
    s_plant(buf, n);
    # It reports plain `error`, not the more specific `no_fds` — see
    # the note there; what matters is that it is NEVER ok.
    assert(dbus_auth_drain_lines() != dbus_auth_ok(),
      "OK without AGREE_UNIX_FD is refused, not treated as usable");

    # (8) THE property the whole handshake rests on: the reader can
    # only report success by actually seeing AGREE_UNIX_FD. samvada
    # cannot do TakeDevice without SCM_RIGHTS, so an `ok` that did not
    # observe fd negotiation would be a silent downgrade.
    dbus_frame_init();
    dbus_auth_reset();
    n = t_put(buf, "OK 0123456789abcdef\r\nDATA\r\nWHATEVER\r\n");
    s_plant(buf, n);
    assert_eq(dbus_auth_drain_lines(), dbus_auth_need_more(),
      "THE PIN: OK plus unknown lines is never ok — only AGREE_UNIX_FD ends it");
    return 0;
}

fn main() {
    alloc_init();
    test_native_populates_the_same_table();
    test_ffi_arities_match_the_frozen_dispatch();
    test_serial_counter();
    test_error_name_mapping();
    test_captured_error_reply_maps_to_eacces();
    test_release_control_has_no_signature_field();
    test_reply_fd_survives_the_call_path();
    test_forged_signal_cannot_impersonate_a_reply();
    test_reply_addressed_elsewhere_is_refused();
    test_absent_destination_is_permitted();
    test_preplanted_reply_cannot_answer_a_later_call();
    test_silent_peer_times_out_instead_of_hanging();
    test_expired_deadline_refuses_to_block();
    test_take_device_gets_its_own_descriptor();
    test_pumped_signal_descriptor_is_not_left_for_take_device();
    test_out_of_range_devnum_is_refused_not_truncated();
    test_repeating_paths_do_not_grow_the_heap();
    test_sasl_reader_survives_hostile_input();
    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
