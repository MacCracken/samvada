    assert_eq(t_err(p, "System.Error.EADDRNOTAVAIL"), -99, "System.Error.EADDRNOTAVAIL");
    assert_eq(t_err(p, "System.Error.ENETDOWN"), -100, "System.Error.ENETDOWN");
    assert_eq(t_err(p, "System.Error.ENETUNREACH"), -101, "System.Error.ENETUNREACH");
    assert_eq(t_err(p, "System.Error.ENETRESET"), -102, "System.Error.ENETRESET");
    assert_eq(t_err(p, "System.Error.ECONNABORTED"), -103, "System.Error.ECONNABORTED");
    assert_eq(t_err(p, "System.Error.ECONNRESET"), -104, "System.Error.ECONNRESET");
    assert_eq(t_err(p, "System.Error.ENOBUFS"), -105, "System.Error.ENOBUFS");
    assert_eq(t_err(p, "System.Error.EISCONN"), -106, "System.Error.EISCONN");
    assert_eq(t_err(p, "System.Error.ENOTCONN"), -107, "System.Error.ENOTCONN");
    assert_eq(t_err(p, "System.Error.ESHUTDOWN"), -108, "System.Error.ESHUTDOWN");
    assert_eq(t_err(p, "System.Error.ETOOMANYREFS"), -109, "System.Error.ETOOMANYREFS");
    assert_eq(t_err(p, "System.Error.ETIMEDOUT"), -110, "System.Error.ETIMEDOUT");
    assert_eq(t_err(p, "System.Error.ECONNREFUSED"), -111, "System.Error.ECONNREFUSED");
    assert_eq(t_err(p, "System.Error.EHOSTDOWN"), -112, "System.Error.EHOSTDOWN");
    assert_eq(t_err(p, "System.Error.EHOSTUNREACH"), -113, "System.Error.EHOSTUNREACH");
    assert_eq(t_err(p, "System.Error.EALREADY"), -114, "System.Error.EALREADY");
    assert_eq(t_err(p, "System.Error.EINPROGRESS"), -115, "System.Error.EINPROGRESS");
    assert_eq(t_err(p, "System.Error.ESTALE"), -116, "System.Error.ESTALE");
    assert_eq(t_err(p, "System.Error.EUCLEAN"), -117, "System.Error.EUCLEAN");
    assert_eq(t_err(p, "System.Error.ENOTNAM"), -118, "System.Error.ENOTNAM");
    assert_eq(t_err(p, "System.Error.ENAVAIL"), -119, "System.Error.ENAVAIL");
    assert_eq(t_err(p, "System.Error.EISNAM"), -120, "System.Error.EISNAM");
    assert_eq(t_err(p, "System.Error.EREMOTEIO"), -121, "System.Error.EREMOTEIO");
    assert_eq(t_err(p, "System.Error.EDQUOT"), -122, "System.Error.EDQUOT");
    assert_eq(t_err(p, "System.Error.ENOMEDIUM"), -123, "System.Error.ENOMEDIUM");
    assert_eq(t_err(p, "System.Error.EMEDIUMTYPE"), -124, "System.Error.EMEDIUMTYPE");
    assert_eq(t_err(p, "System.Error.ECANCELED"), -125, "System.Error.ECANCELED");
    assert_eq(t_err(p, "System.Error.ENOKEY"), -126, "System.Error.ENOKEY");
    assert_eq(t_err(p, "System.Error.EKEYEXPIRED"), -127, "System.Error.EKEYEXPIRED");
    assert_eq(t_err(p, "System.Error.EKEYREVOKED"), -128, "System.Error.EKEYREVOKED");
    assert_eq(t_err(p, "System.Error.EKEYREJECTED"), -129, "System.Error.EKEYREJECTED");
    assert_eq(t_err(p, "System.Error.EOWNERDEAD"), -130, "System.Error.EOWNERDEAD");
    assert_eq(t_err(p, "System.Error.ENOTRECOVERABLE"), -131, "System.Error.ENOTRECOVERABLE");
    assert_eq(t_err(p, "System.Error.ERFKILL"), -132, "System.Error.ERFKILL");
    assert_eq(t_err(p, "System.Error.EHWPOISON"), -133, "System.Error.EHWPOISON");
    assert_eq(t_err(p, "System.Error.EWOULDBLOCK"), -11, "System.Error.EWOULDBLOCK");
    assert_eq(t_err(p, "System.Error.EDEADLOCK"), -35, "System.Error.EDEADLOCK");
    assert_eq(t_err(p, "System.Error.ENOTSUP"), -95, "System.Error.ENOTSUP");
    assert_eq(t_err(p, "System.Error.NOTANERRNO"), -5, "System.Error.NOTANERRNO");
    assert_eq(t_err(p, "System.Error."), -5, "System.Error.");
    assert_eq(t_err(p, "org.freedesktop.DBus.Error.NoSuchDevice"), -5, "org.freedesktop.DBus.Error.NoSuchDevice");
    assert_eq(t_err(p, "com.example.SomethingElse"), -5, "com.example.SomethingElse");
    # A prefix must not match a longer name, and an errno name must
    # match whole.
    assert(t_err(p, "org.freedesktop.login1.NotInControlXX") != -22, "prefix does NOT match");
    assert_eq(t_err(p, "System.Error.EBUSYX"), -5, "an errno name matches whole");
    assert_eq(t_err(p, "System.Error"), -5, "no trailing dot is not the System.Error family");
    assert_eq(t_err(p, "System.Error.EFTYPE"), -5, "EFTYPE is left out of the table: -EIO, as libsystemd <= 259");
    return 0;
}

# ---- decoding a REAL captured error reply ----
# The AccessDenied reply captured in N2, reconstructed field for
# field, must map to exactly what the live run produced: -13.
# ---- the errno map, against the fixture FILE (1.1.2) ----
# The asserts above are the table in readable form; this proves it at run
# time. CI used to check the asserted rows were the fixture's by matching
# the test's text, and an assert inside a dead `#ifdef` still matched —
# so a wrong mapping could ship with every gate green (P(-1)
# re-verification). Here the fixture itself is read and every row is
# asserted through dbus_session_map_error, and the one summary line CI
# requires is printed only by a run that got here:
#     errno-map: N rows of tests/fixtures/sdbus_errno_map.tsv checked
fn test_error_map_matches_the_fixture_file() {
    test_group("native: every row of sdbus_errno_map.tsv, read at run time");
    var path = "tests/fixtures/sdbus_errno_map.tsv";
    var fd = sys_open(path, 524288, 0);           # O_RDONLY | O_CLOEXEC
    assert(fd >= 0, "the fixture opens (tests run from the repo root)");
    if (fd < 0) { return 0; }
    var cap = 65536;
    var buf = alloc(cap);
    var have = 0;
    var more = 1;
    while (more == 1) {
        var got = sys_read(fd, buf + have, cap - have);
        more = 0;
        if (got > 0) {
            have = have + got;
            if (have < cap) { more = 1; }
        }
    }
    sys_close(fd);
    assert(have < cap, "the fixture fits the buffer (it is ~6.5 KB)");
    var name = alloc(256);
    var rows = 0;
    var bad = 0;
    var at = 0;
    while (at < have) {
        # [at, eol) is one line: find its LF (or the end of the file)
        var eol = at;
        var found = 0;
        while (found == 0) {
            if (eol >= have) { found = 1; continue; }
            if (load8(buf + eol) == 10) { found = 1; continue; }
            eol = eol + 1;
        }
        var skip = 0;
        if (eol == at) { skip = 1; }
        if (skip == 0) {
            if (load8(buf + at) == 35) { skip = 1; }           # '#'
        }
        if (skip == 0) {
            var tab = at;
            var tfound = 0;
            while (tfound == 0) {
                if (tab >= eol) { tfound = 1; continue; }
                if (load8(buf + tab) == 9) { tfound = 1; continue; }
                tab = tab + 1;
            }
            var nlen = tab - at;
            var ok = 1;
            if (tab >= eol) { ok = 0; }
            if (nlen <= 0) { ok = 0; }
            if (nlen > 255) { ok = 0; }
            var want = 0;
            if (ok == 1) {
                var k = tab + 1;
                var neg = 0;
                if (load8(buf + k) == 45) { neg = 1; k = k + 1; }   # '-'
                while (k < eol) {
                    var d = load8(buf + k);
                    if (d >= 48) { if (d <= 57) { want = want * 10 + (d - 48); } }
                    k = k + 1;
                }
                if (neg == 1) { want = 0 - want; }
                var i = 0;
                while (i < nlen) { store8(name + i, load8(buf + at + i)); i = i + 1; }
                store8(name + nlen, 0);
                var got2 = dbus_session_map_error(name, nlen);
                if (got2 != want) {
                    bad = bad + 1;
                    assert_eq(got2, want, name);
                }
                rows = rows + 1;
            }
            if (ok == 0) { bad = bad + 1; }
        }
        at = eol + 1;
    }
    assert(rows > 0, "rows were read");
    assert_eq(bad, 0, "THE PIN: every row maps as libsystemd maps it");
    if (bad == 0) {
        print("errno-map: ", 11);
        print_num(rows);
        println(" rows of tests/fixtures/sdbus_errno_map.tsv checked");
    }
    return 0;
}

fn test_captured_error_reply_maps_to_eacces() {
    test_group("native: the captured AccessDenied reply maps to -13");
    var t = alloc(128);
    dbus_marshal_begin(dbus_marshal_type_error(), 1, 20486);
    dbus_marshal_field_u32(dbus_marshal_f_replyser(), 4);
    var n = t_put(t, "org.freedesktop.DBus.Error.AccessDenied");
    dbus_marshal_field_str(dbus_marshal_f_errname(), 115, t, n);
    var sg = alloc(8);
    var sn = t_put(sg, "s");
    dbus_marshal_field_sig(dbus_marshal_f_signature(), sg, sn);
    dbus_marshal_end_fields();
    n = t_put(t, "Operation not permitted");
    dbus_marshal_body_str(t, n);
    dbus_marshal_finish();
    dbus_unmarshal_set_limit(dbus_marshal_len());

    var b = dbus_marshal_buf();
    assert_eq(dbus_unmarshal_type(b), dbus_marshal_type_error(), "it is an ERROR");
    var sig = alloc(8);
    var eo = dbus_unmarshal_find_field(b, dbus_marshal_f_errname(), sig);
    assert(eo > 0, "ERROR_NAME located");
    var ptr = alloc(8);
    var en = dbus_unmarshal_str_at(b, eo, ptr);
    assert_eq(dbus_session_map_error(load64(ptr), en), -13,
      "maps to -13, matching the live run");
    # the human-readable body survives too
    dbus_unmarshal_body_begin(b);
    var m = dbus_unmarshal_next_str(ptr);
    assert_eq(m, 23, "body message is 23 bytes");
    return 0;
}

# ---- the empty-body call ----
# ReleaseControl takes no arguments. A message with an empty body
# carries NO signature field at all — emitting SIGNATURE="" is a
# different encoding, and logind's reader tolerates the omission,
# which is what libsystemd does.
fn test_release_control_has_no_signature_field() {
    test_group("native: an empty-body call omits SIGNATURE entirely");
    var t = alloc(128);
    var pn = t_put(t, "/org/freedesktop/login1/session/_32");
    var m = alloc(64);
    var mn = t_put(m, "ReleaseControl");
    dbus_session_begin_call(t, pn, m, mn, 0, 5);
    dbus_marshal_end_fields();
    dbus_marshal_finish();
    dbus_unmarshal_set_limit(dbus_marshal_len());
    var b = dbus_marshal_buf();
    assert_eq(dbus_unmarshal_body_len(b), 0, "empty body");
    var sig = alloc(8);
    assert_eq(dbus_unmarshal_find_field(b, dbus_marshal_f_signature(), sig),
      dbus_unmarshal_notfound(), "and NO SIGNATURE field");
    # the interface must be Session, not Manager
    var off = dbus_unmarshal_find_field(b, dbus_marshal_f_interface(), sig);
    var ptr = alloc(8);
    var n = dbus_unmarshal_str_at(b, off, ptr);
    assert_eq(n, strlen("org.freedesktop.login1.Session"), "interface is Session");
    return 0;
}

# ---- socketpair plumbing for the reply-path pins ----
# sendmsg is 46 on x86_64 but **ftruncate** on aarch64; hardcoding it
# would not fail loudly there, it would truncate a file. So it is the
# stdlib's `sys_sendmsg` — never a number of our own (1.1.0; see
# tests/dbus_sys.tcyr).

var _s_iov  = 0;
var _s_mh   = 0;
var _s_ctrl = 0;

fn s_send_init() {
    if (_s_iov != 0) { return 0; }
    _s_iov  = alloc(16);
    _s_mh   = alloc(56);
    _s_ctrl = alloc(24);
    return 0;
}

# Send `len` bytes plus one SCM_RIGHTS fd. Planting a whole framed
# reply this way is the only way to exercise the call path's read
# with a descriptor actually riding on it.
fn s_send_with_fd(sock, buf, len, payload_fd) {
    s_send_init();
    store64(_s_iov + 0, buf);
    store64(_s_iov + 8, len);
    var i = 0;
    while (i < 24) { store64(_s_ctrl + i, 0); i = i + 8; }
    store64(_s_ctrl + 0, dbus_sys_cmsg_len_1fd());
    store64(_s_ctrl + 8, dbus_sys_sol_socket());
    store64(_s_ctrl + 12, dbus_sys_scm_rights());
    store64(_s_ctrl + 16, payload_fd);
    i = 0;
    while (i < 56) { store64(_s_mh + i, 0); i = i + 8; }
    store64(_s_mh + 16, _s_iov);
    store64(_s_mh + 24, 1);
    store64(_s_mh + 32, _s_ctrl);
    store64(_s_mh + 40, dbus_sys_cmsg_space_1fd());
    return sys_sendmsg(sock, _s_mh, 0);
}

fn s_copy(dst, src, n) {
    var i = 0;
    while (i < n) { store8(dst + i, load8(src + i)); i = i + 1; }
    return n;
}

# ---- THE FD PIN ----
# dbus_session_call must read with recvmsg, not read(). A plain
# read() delivers the reply's BYTES and lets the kernel discard the
# SCM_RIGHTS payload: the message parses perfectly, its UNIX_FDS
# field still says 1, the body still carries a valid index, and the
# descriptor is gone. Nothing downstream can tell.
#
# That was true of every release through 0.11.0 and no test caught
# it, because an unseated host answers TakeDevice with AccessDenied
# and an ERROR reply carries no fd — so the fd path never ran. This
# plants a real fd on a real reply over a socketpair, which needs no
# bus and no seat.
fn test_reply_fd_survives_the_call_path() {
    test_group("native: an fd riding on a METHOD_RETURN survives the call path");
    var pair = alloc(8);
    store64(pair, 0);
    assert_eq(sys_socketpair(dbus_sys_af_unix(), dbus_sys_sock_stream(), 0, pair), 0,
      "socketpair created");
    var a = load64(pair) & 0xFFFFFFFF;
    var b = (load64(pair) >> 32) & 0xFFFFFFFF;

    # A TakeDevice-shaped reply: UNIX_FDS=1, signature 'h', body index 0.
    dbus_marshal_begin(dbus_marshal_type_return(), 1, 4242);
    dbus_marshal_field_u32(dbus_marshal_f_replyser(), 7);
    var sg = alloc(8);
    var sn = t_put(sg, "h");
    dbus_marshal_field_sig(dbus_marshal_f_signature(), sg, sn);
    dbus_marshal_field_u32(dbus_marshal_f_unixfds(), 1);
    dbus_marshal_end_fields();
    dbus_marshal_body_u32(0);
    dbus_marshal_finish();
    dbus_unmarshal_set_limit(dbus_marshal_len());
    var mlen = dbus_marshal_len();
    var wire = alloc(512);
    s_copy(wire, dbus_marshal_buf(), mlen);

    # The payload fd is one end of a second socketpair — a real open
    # descriptor with no filesystem dependency.
    var pair2 = alloc(8);
    store64(pair2, 0);
    assert_eq(sys_socketpair(dbus_sys_af_unix(), dbus_sys_sock_stream(), 0, pair2), 0,
      "payload pair created");
    var payload = load64(pair2) & 0xFFFFFFFF;
    var payload_peer = (load64(pair2) >> 32) & 0xFFFFFFFF;

    assert_eq(s_send_with_fd(a, wire, mlen, payload), mlen, "reply + fd planted");

    dbus_frame_init();
    assert_eq(dbus_frame_fd_count(), 0, "fd queue starts empty");
    var rc = dbus_session_call(b, 7);
    assert_eq(rc, 0, "the reply matched and was accepted");
    assert_eq(dbus_frame_fd_count(), 1,
      "THE PIN: the descriptor arrived — a plain read() would leave this 0");
    var got = dbus_frame_take_fd();
    assert(got > 2, "and it is a usable descriptor");
    assert(got != payload, "a NEW descriptor number, not the sender's");

    sys_close(got);
    sys_close(payload);
    sys_close(payload_peer);
    sys_close(a);
    sys_close(b);
    return 0;
}

# ---- THE TYPE-GATE PIN ----
# The 2026-09-09 reply-forgery audit found that the ONE frame type a
# hostile bus peer can actually push to samvada is a directed SIGNAL
# — the broker delivers those to any destination, and a peer can
# bolt a matching REPLY_SERIAL onto one. samvada discards it only
# because dbus_session_call returns for message type 2/3 and nothing
# else. That guard reads as spec-correctness (ignore NameAcquired),
# so its anti-forgery value is incidental and undocumented. Pinned
# here so it is never "simplified" away.
fn test_forged_signal_cannot_impersonate_a_reply() {
    test_group("native: a SIGNAL carrying a matching REPLY_SERIAL is NOT the reply");
    var pair = alloc(8);
    store64(pair, 0);
    assert_eq(sys_socketpair(dbus_sys_af_unix(), dbus_sys_sock_stream(), 0, pair), 0,
      "socketpair created");
    var a = load64(pair) & 0xFFFFFFFF;
    var b = (load64(pair) >> 32) & 0xFFFFFFFF;

    var sg = alloc(8);
    var txt = alloc(64);
    var wire = alloc(1024);
    var at = 0;

    # (1) the forgery: a SIGNAL whose REPLY_SERIAL matches ours.
    dbus_marshal_begin(dbus_marshal_type_signal(), 1, 9001);
    dbus_marshal_field_u32(dbus_marshal_f_replyser(), 9);
    var sn = t_put(sg, "o");
    dbus_marshal_field_sig(dbus_marshal_f_signature(), sg, sn);
    dbus_marshal_end_fields();
    var tn = t_put(txt, "/org/freedesktop/PWNED/session/_99");
    dbus_marshal_body_str(txt, tn);
    dbus_marshal_finish();
    dbus_unmarshal_set_limit(dbus_marshal_len());
    at = at + s_copy(wire + at, dbus_marshal_buf(), dbus_marshal_len());

    # (2) the genuine reply, same serial, arriving second.
    dbus_marshal_begin(dbus_marshal_type_return(), 1, 9002);
    dbus_marshal_field_u32(dbus_marshal_f_replyser(), 9);
    sn = t_put(sg, "o");
    dbus_marshal_field_sig(dbus_marshal_f_signature(), sg, sn);
    dbus_marshal_end_fields();
    tn = t_put(txt, "/org/freedesktop/login1/session/_32");
    dbus_marshal_body_str(txt, tn);
    dbus_marshal_finish();
    dbus_unmarshal_set_limit(dbus_marshal_len());
    at = at + s_copy(wire + at, dbus_marshal_buf(), dbus_marshal_len());

    assert_eq(sys_write(a, wire, at), at, "forged signal + real reply planted");

    dbus_frame_init();
    var rc = dbus_session_call(b, 9);
    assert_eq(rc, 0, "the call completed");
    var p = dbus_frame_base();
    assert_eq(dbus_unmarshal_type(p), dbus_marshal_type_return(),
      "THE PIN: what it accepted is the METHOD_RETURN, not the SIGNAL");
    dbus_unmarshal_set_limit(dbus_frame_next());
    dbus_unmarshal_body_begin(p);
    var ptr = alloc(8);
    var n = dbus_unmarshal_next_str(ptr);
    assert_eq(n, strlen("/org/freedesktop/login1/session/_32"),
      "and it carries the REAL session path, not the forged one");

    sys_close(a);
    sys_close(b);
    return 0;
}

# Build a METHOD_RETURN addressed to `dest`, answering `rser`,
# carrying `path` as its body. Returns its length; bytes are in the
# marshal buffer.
fn s_build_reply(rser, dest, destn, path, pathn) {
    dbus_marshal_begin(dbus_marshal_type_return(), 1, 5000);
    dbus_marshal_field_u32(dbus_marshal_f_replyser(), rser);
    dbus_marshal_field_str(dbus_marshal_f_dest(), 115, dest, destn);
    var sg = alloc(8);
    var sn = t_put(sg, "o");
    dbus_marshal_field_sig(dbus_marshal_f_signature(), sg, sn);
    dbus_marshal_end_fields();
    dbus_marshal_body_str(path, pathn);
    dbus_marshal_finish();
    dbus_unmarshal_set_limit(dbus_marshal_len());
    return dbus_marshal_len();
}

# ---- THE DESTINATION PIN ----
# sd-bus's async guard (sd-bus.c:2790) and the one provenance check
# samvada makes. A reply whose REPLY_SERIAL matches but which is
# addressed to a DIFFERENT unique name is not ours, and must be
# skipped rather than accepted.
fn test_reply_addressed_elsewhere_is_refused() {
    test_group("native: a reply addressed to someone else is NOT ours");
    var pair = alloc(8);
    store64(pair, 0);
    assert_eq(sys_socketpair(dbus_sys_af_unix(), dbus_sys_sock_stream(), 0, pair), 0,
      "socketpair created");
    var a = load64(pair) & 0xFFFFFFFF;
    var b = (load64(pair) >> 32) & 0xFFFFFFFF;

    dbus_session_reset();
    var me = alloc(32);
    var men = t_put(me, ":1.99");
    assert_eq(dbus_session_set_unique(me, men), 0, "our unique name is known");

    var them = alloc(32);
    var wire = alloc(1024);
    var txt = alloc(64);
    var at = 0;

    # (1) same serial, addressed to a DIFFERENT peer.
    var thn = t_put(them, ":1.500");
    var tn = t_put(txt, "/org/freedesktop/PWNED/session/_99");
    at = at + s_copy(wire + at, dbus_marshal_buf(),
      s_build_reply(11, them, thn, txt, tn));
    # (2) same serial, addressed to US.
    thn = t_put(them, ":1.99");
    tn = t_put(txt, "/org/freedesktop/login1/session/_32");
    at = at + s_copy(wire + at, dbus_marshal_buf(),
      s_build_reply(11, them, thn, txt, tn));

    assert_eq(sys_write(a, wire, at), at, "both replies planted");

    dbus_frame_init();
    var rc = dbus_session_call(b, 11);
    assert_eq(rc, 0, "the call completed");
    var p = dbus_frame_base();
    dbus_unmarshal_set_limit(dbus_frame_next());
    dbus_unmarshal_body_begin(p);
    var ptr = alloc(8);
    var n = dbus_unmarshal_next_str(ptr);
    assert_eq(n, strlen("/org/freedesktop/login1/session/_32"),
      "THE PIN: it skipped the misaddressed reply and took the one meant for us");

    dbus_session_reset();
    sys_close(a);
    sys_close(b);
    return 0;
}

# The same guard must not fire when the field is ABSENT, or the
# Hello reply — matched before the bus has told us our own name —
# would be rejected and no connection could ever be established.
fn test_absent_destination_is_permitted() {
    test_group("native: a reply with NO destination field is still accepted");
    var pair = alloc(8);
    store64(pair, 0);
    assert_eq(sys_socketpair(dbus_sys_af_unix(), dbus_sys_sock_stream(), 0, pair), 0,
      "socketpair created");
    var a = load64(pair) & 0xFFFFFFFF;
    var b = (load64(pair) >> 32) & 0xFFFFFFFF;

    dbus_session_reset();
    var me = alloc(32);
    var men = t_put(me, ":1.99");
    dbus_session_set_unique(me, men);

    dbus_marshal_begin(dbus_marshal_type_return(), 1, 5001);
    dbus_marshal_field_u32(dbus_marshal_f_replyser(), 13);
    dbus_marshal_end_fields();
    dbus_marshal_finish();
    dbus_unmarshal_set_limit(dbus_marshal_len());
    var mlen = dbus_marshal_len();
    var wire = alloc(256);
    s_copy(wire, dbus_marshal_buf(), mlen);
    assert_eq(sys_write(a, wire, mlen), mlen, "destination-less reply planted");

    dbus_frame_init();
    assert_eq(dbus_session_call(b, 13), 0,
      "THE PIN: absent DESTINATION is permitted, as in sd-bus — the Hello reply depends on it");

    dbus_session_reset();
    sys_close(a);
    sys_close(b);
    return 0;
}

# ---- THE WATERMARK PIN ----
# Bytes already in the buffer when the request goes out cannot be a
# reply to it. Without this, an attacker who can get a well-formed
# reply into the buffer EARLY answers a call that has not been made
# yet — and samvada's serials are sequential, so the serial to use
# is not a secret.
fn test_preplanted_reply_cannot_answer_a_later_call() {
    test_group("native: a reply buffered BEFORE the request cannot answer it");
    var pair = alloc(8);
    store64(pair, 0);
    assert_eq(sys_socketpair(dbus_sys_af_unix(), dbus_sys_sock_stream(), 0, pair), 0,
      "socketpair created");
    var a = load64(pair) & 0xFFFFFFFF;
    var b = (load64(pair) >> 32) & 0xFFFFFFFF;

    dbus_session_reset();
    dbus_frame_init();

    # Pre-plant a perfectly valid reply DIRECTLY into the framer's
    # buffer, as an earlier pump_signals would have left it there.
    var me = alloc(32);
    var men = t_put(me, ":1.99");
    var txt = alloc(64);
    var tn = t_put(txt, "/org/freedesktop/PWNED/session/_99");
    var flen = s_build_reply(12, me, men, txt, tn);
    s_copy(dbus_frame_tail(), dbus_marshal_buf(), flen);
    dbus_frame_commit(flen);
    assert_eq(dbus_frame_have(), flen, "the forged reply is buffered before the call");

    # The genuine reply, same serial, arrives on the wire afterwards.
    tn = t_put(txt, "/org/freedesktop/login1/session/_32");
    var rlen = s_build_reply(12, me, men, txt, tn);
    var wire = alloc(512);
    s_copy(wire, dbus_marshal_buf(), rlen);
    assert_eq(sys_write(a, wire, rlen), rlen, "genuine reply planted on the wire");

    var rc = dbus_session_call(b, 12);
    assert_eq(rc, 0, "the call completed");
    var p = dbus_frame_base();
    dbus_unmarshal_set_limit(dbus_frame_next());
    dbus_unmarshal_body_begin(p);
    var ptr = alloc(8);
    var n = dbus_unmarshal_next_str(ptr);
    assert_eq(n, strlen("/org/freedesktop/login1/session/_32"),
      "THE PIN: the pre-planted reply was skipped; the one that arrived after the send won");

    dbus_session_reset();
    sys_close(a);
    sys_close(b);
    return 0;
}

# ---- THE TIMEOUT PINS ----
# Before 1.0.0 samvada had no time-based bound of ANY kind: the
# socket is blocking, nothing called setsockopt, and the reply
# loop's "64 spins" counts MESSAGES, not seconds. A peer that
# accepted the connection and then said nothing hung the caller
# forever — inside a compositor, an indefinite freeze.
#
# This is not hypothetical: while mutation-testing the DESTINATION
# guard, the over-strict variant did not fail the suite, it HUNG it.
fn test_silent_peer_times_out_instead_of_hanging() {
    test_group("native: a peer that never answers times out, it does not hang");
    var pair = alloc(8);
    store64(pair, 0);
    assert_eq(sys_socketpair(dbus_sys_af_unix(), dbus_sys_sock_stream(), 0, pair), 0,
      "socketpair created");
    var a = load64(pair) & 0xFFFFFFFF;
    var b = (load64(pair) >> 32) & 0xFFFFFFFF;

    # 1.1.2: the call's deadline is its only bound — every wait is a
    # poll for the time left — so the pin drives the deadline, at 200 ms
    # rather than the 25 s default so it runs fast. No SO_RCVTIMEO is
    # armed on `b`: if the poll did not bound the wait, this would block
    # on the silent peer forever.
    dbus_session_reset();
    dbus_frame_init();
    assert_eq(dbus_session_set_timeout_ms(200), 0, "a 200 ms budget");

    # Nothing is EVER planted on `a`. The peer is simply silent.
    var t0 = dbus_session_now_ms();
    assert(t0 > 0, "the monotonic clock works — arch syscall number is right");
    var rc = dbus_session_call(b, 99);
    var elapsed = dbus_session_now_ms() - t0;

    assert_eq(rc, -110,
      "THE PIN: -ETIMEDOUT at the deadline, not a hang and not raw -EAGAIN");
    var waited = 0;
    if (elapsed >= 150) { waited = 1; }
    assert_eq(waited, 1, "it waited for the budget, rather than refusing at once");
    var prompt = 0;
    if (elapsed < 2000) { prompt = 1; }
    assert_eq(prompt, 1, "and gave up at the deadline, not one SO_RCVTIMEO past it");

    dbus_session_reset();
    sys_close(a);
    sys_close(b);
    return 0;
}

# The per-receive timeout above cannot bound the CALL: a peer that
# dribbles one byte per read satisfies every individual SO_RCVTIMEO
# while the call runs unbounded. The wall-clock deadline is what
# closes that. Driving it with a zero budget reaches the branch
# deterministically, with no slow peer to orchestrate.
fn test_expired_deadline_refuses_to_block() {
    test_group("native: an expired wall-clock deadline returns before blocking");
    var pair = alloc(8);
    store64(pair, 0);
    assert_eq(sys_socketpair(dbus_sys_af_unix(), dbus_sys_sock_stream(), 0, pair), 0,
      "socketpair created");
    var a = load64(pair) & 0xFFFFFFFF;
    var b = (load64(pair) >> 32) & 0xFFFFFFFF;

    dbus_session_reset();
    dbus_frame_init();
    assert_eq(dbus_session_set_timeout_ms(0), 0, "budget set to zero");

    # No SO_RCVTIMEO is armed on `b`, so if the deadline check did
    # NOT fire this call would block on a silent peer forever. That
    # is precisely what makes this a real pin.
    var rc = dbus_session_call(b, 77);
    assert_eq(rc, -110, "THE PIN: the deadline fired before committing to a blocking receive");

    # A budget large enough to overflow `t0 + timeout` must be
    # REFUSED, not accepted: the deadline is gated on `deadline > 0`,
    # so a wrapped-negative sum silently DISARMS the guard. A bound
    # that its own argument can switch off is not a bound.
    assert_eq(dbus_session_set_timeout_ms(9223372036854775807), -22,
      "THE PIN: an overflowing budget is refused, not silently disarming");
    assert_eq(dbus_session_set_timeout_ms(dbus_session_timeout_max_ms() + 1), -22,
      "one past the cap is refused");
    assert_eq(dbus_session_set_timeout_ms(dbus_session_timeout_max_ms()), 0,
      "the cap itself is accepted");
    assert_eq(dbus_session_set_timeout_ms((0 - 1)), -22, "negative is refused");

    # And reset must restore the default, or a short budget leaks
    # into every later test in this file.
    dbus_session_reset();
    assert_eq(dbus_session_timeout_ms(), 25000,
      "reset restored the 25 s default (the global resolves correctly)");

    sys_close(a);
    sys_close(b);
    return 0;
}

fn s_ino(fd) {
    var st = alloc(160);
    var rc = sys_fstat(fd, st);
    if (rc < 0) { return (0 - 1); }
    return load64(st + 8);              # st_ino sits at +8 on x86_64
}

# Count open descriptors by fstat'ing each number. Stronger than a
# lowest-free-fd probe, which the 0.8.0 work found could pass against
# a version that was leaking two descriptors.
fn s_count_open() {
    var st = alloc(160);
    var n = 0;
    var i = 0;
    while (i < 64) {
        var rc = sys_fstat(i, st);
        if (rc >= 0) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

fn s_pair() {
    var p = alloc(8);
    store64(p, 0);
    sys_socketpair(dbus_sys_af_unix(), dbus_sys_sock_stream(), 0, p);
    return load64(p);
}

# A real character device to stand in for the one logind hands over.
# take_device checks that the descriptor IS the device asked for — a
# char device whose rdev is (major, minor) — since 1.1.2, so a
# socketpair end no longer passes as one. /dev/null is 1:3, /dev/zero
# 1:5, /dev/full 1:7: present on every Linux, containers included.
#
# Read-write, as logind opens a device: take_device refuses anything else
# (an O_PATH or read-only descriptor names the node but is not one logind
# would hand over).
fn s_dev(path) {
    return sys_open(path, 524290, 0);   # O_RDWR | O_CLOEXEC
}

# ---- THE FD-OWNERSHIP PIN ----
# There is ONE fd queue with TWO fill sites (the reply loop and
# pump_signals) and ONE drain site (take_device), which pops FIFO.
# logind's ResumeDevice SIGNAL carries a descriptor, and signals are
# never surfaced (ADR-0004) — so that descriptor used to sit at the
# head of the queue until the next take_device collected it BY
# MISTAKE. A compositor asking for an input device would have been
# handed the DRM descriptor from an earlier resume.
#
# Measured before the fix: signal fd inode 3201875, reply fd inode
# 3201877, take_fd() returned 3201875.
#
# Same shape as AUDIT-4 — an index into a queue whose fill path was
# never exercised.
fn test_take_device_gets_its_own_descriptor() {
    test_group("native: a signal's descriptor is not collected by the next call");
    var before = s_count_open();

    var bus = s_pair();
    var a = bus & 0xFFFFFFFF;
    var b = (bus >> 32) & 0xFFFFFFFF;
    var px = s_pair();
    var x = px & 0xFFFFFFFF;
    var xp = (px >> 32) & 0xFFFFFFFF;
    var py = s_pair();
    var y = py & 0xFFFFFFFF;
    var yp = (py >> 32) & 0xFFFFFFFF;

    var inox = s_ino(x);
    var inoy = s_ino(y);
    var distinct = 0;
    if (inox != inoy) { distinct = 1; }
    assert_eq(distinct, 1, "the two descriptors are distinguishable by inode");

    dbus_session_reset();
    dbus_frame_init();

    # (1) a ResumeDevice-shaped SIGNAL carrying descriptor X.
    var sg = alloc(8);
    store8(sg, 104);                    # 'h'
    dbus_marshal_begin(dbus_marshal_type_signal(), 1, 9001);
    dbus_marshal_field_sig(dbus_marshal_f_signature(), sg, 1);
    dbus_marshal_field_u32(dbus_marshal_f_unixfds(), 1);
    dbus_marshal_end_fields();
    dbus_marshal_body_u32(0);
    dbus_marshal_finish();
    dbus_unmarshal_set_limit(dbus_marshal_len());
    var slen = dbus_marshal_len();
    var swire = alloc(512);
    s_copy(swire, dbus_marshal_buf(), slen);
    assert_eq(s_send_with_fd(a, swire, slen, x), slen, "signal + its fd planted");

    # (2) the TakeDevice reply carrying descriptor Y.
    dbus_marshal_begin(dbus_marshal_type_return(), 1, 4242);
    dbus_marshal_field_u32(dbus_marshal_f_replyser(), 7);
    dbus_marshal_field_sig(dbus_marshal_f_signature(), sg, 1);
    dbus_marshal_field_u32(dbus_marshal_f_unixfds(), 1);
    dbus_marshal_end_fields();
    dbus_marshal_body_u32(0);
    dbus_marshal_finish();
    dbus_unmarshal_set_limit(dbus_marshal_len());
    var rlen = dbus_marshal_len();
    var rwire = alloc(512);
    s_copy(rwire, dbus_marshal_buf(), rlen);
    assert_eq(s_send_with_fd(a, rwire, rlen, y), rlen, "reply + its fd planted");

    assert_eq(dbus_session_call(b, 7), 0, "the reply matched");
    assert_eq(dbus_frame_fd_count(), 1,
      "exactly one descriptor is queued — the signal's was closed, not left behind");

    var got = dbus_frame_take_fd();
    assert(got > 2, "a descriptor came back");
    assert_eq(s_ino(got), inoy,
      "THE PIN: it is the REPLY's descriptor, not the signal's");

    sys_close(got);
    sys_close(x);  sys_close(xp);
    sys_close(y);  sys_close(yp);
    sys_close(a);  sys_close(b);
    dbus_session_reset();

    assert_eq(s_count_open(), before,
      "and the signal's descriptor was closed, not leaked");
    return 0;
}

# The same hazard by the OTHER route, and the more realistic one: a
# compositor pumps its event loop, logind's ResumeDevice arrives with
# a descriptor, and only later does the consumer take a device.
# pump_signals fills the shared queue and never drains it.
fn test_pumped_signal_descriptor_is_not_left_for_take_device() {
    test_group("native: pump_signals does not leave a descriptor for the next take");
    var before = s_count_open();

    var bus = s_pair();
    var a = bus & 0xFFFFFFFF;
    var b = (bus >> 32) & 0xFFFFFFFF;
    var px = s_pair();
    var x = px & 0xFFFFFFFF;
    var xp = (px >> 32) & 0xFFFFFFFF;
    var py = s_pair();
    var y = py & 0xFFFFFFFF;
    var yp = (py >> 32) & 0xFFFFFFFF;
    var inoy = s_ino(y);

    dbus_session_reset();
    dbus_frame_init();

    var sg = alloc(8);
    store8(sg, 104);                    # 'h'
    dbus_marshal_begin(dbus_marshal_type_signal(), 1, 9001);
    dbus_marshal_field_sig(dbus_marshal_f_signature(), sg, 1);
    dbus_marshal_field_u32(dbus_marshal_f_unixfds(), 1);
    dbus_marshal_end_fields();
    dbus_marshal_body_u32(0);
    dbus_marshal_finish();
    dbus_unmarshal_set_limit(dbus_marshal_len());
    var slen = dbus_marshal_len();
    var swire = alloc(512);
    s_copy(swire, dbus_marshal_buf(), slen);
    assert_eq(s_send_with_fd(a, swire, slen, x), slen, "ResumeDevice-shaped signal planted");

    # The consumer pumps its event loop first.
    assert_eq(dbus_native_pump_signals(b), 1, "pump drained exactly one message");
    assert_eq(dbus_frame_fd_count(), 0,
      "THE PIN: pump left NO descriptor behind for a later take_device");

    # Only now does it take a device.
    dbus_marshal_begin(dbus_marshal_type_return(), 1, 4242);
    dbus_marshal_field_u32(dbus_marshal_f_replyser(), 7);
    dbus_marshal_field_sig(dbus_marshal_f_signature(), sg, 1);
    dbus_marshal_field_u32(dbus_marshal_f_unixfds(), 1);
    dbus_marshal_end_fields();
    dbus_marshal_body_u32(0);
    dbus_marshal_finish();
    dbus_unmarshal_set_limit(dbus_marshal_len());
    var rlen = dbus_marshal_len();
    var rwire = alloc(512);
    s_copy(rwire, dbus_marshal_buf(), rlen);
    assert_eq(s_send_with_fd(a, rwire, rlen, y), rlen, "reply + its fd planted");

    assert_eq(dbus_session_call(b, 7), 0, "the reply matched");
    var got = dbus_frame_take_fd();
    assert_eq(s_ino(got), inoy, "and take got the REPLY's descriptor");

    sys_close(got);
    sys_close(x);  sys_close(xp);
    sys_close(y);  sys_close(yp);
    sys_close(a);  sys_close(b);
    dbus_session_reset();
    assert_eq(s_count_open(), before, "no descriptor leaked");
    return 0;
}

# ---- THE DEVNUM PIN ----
# The C shim gates both device calls on devnum_ok(v) == (v >= 0 &&
# v <= UINT32_MAX) BEFORE the 64->32 narrowing — audit MED-2, 0.5.1,
# added because the cast truncated silently. CLAUDE.md says a
# PURE_CYRIUS backend must RE-SUPPLY that check; at the N6 cutover
# it did not, checking only `v < 0`.
#
# _dbm_u32 writes the low four bytes and nothing else, so a major of
# 2^32 + 1 marshalled as major 1: samvada would have opened a
# DIFFERENT DEVICE than asked for, silently, and returned success.
# The differential harness compares error codes for in-range values
# only, which is why it never noticed.
fn test_out_of_range_devnum_is_refused_not_truncated() {
    test_group("native: an out-of-range device number is refused, not silently truncated");
    var fo = alloc(8);
    var ao = alloc(8);

    # The predicate itself, exercised directly. Everything past the
    # guard does real I/O, so the bound is tested here rather than
    # through a call that would block on a 25 s deadline.
    assert_eq(dbus_session_devnum_ok(0), 1, "0 is a valid device number");
    assert_eq(dbus_session_devnum_ok(226), 1, "226 (DRM major) is valid");
    assert_eq(dbus_session_devnum_ok(4294967295), 1,
      "UINT32_MAX is valid — matches the shim's `v <= UINT32_MAX`");
    assert_eq(dbus_session_devnum_ok(4294967296), 0,
      "THE PIN: 2^32 is refused, not truncated to 0");
    assert_eq(dbus_session_devnum_ok(4294967522), 0,
      "2^32+226 refused, not truncated to 226 — the silent-wrong-device case");
    assert_eq(dbus_session_devnum_ok((0 - 1)), 0, "negative refused");

    # And the guard is actually WIRED into both device calls. These
    # return before any I/O, so they are safe with a null bus.
    assert_eq(dbus_native_take_device(0, 0, 4294967296, 0, fo, ao), -22,
      "take_device rejects an out-of-range major");
    assert_eq(dbus_native_take_device(0, 0, 0, 4294967296, fo, ao), -22,
      "take_device rejects an out-of-range minor");
    assert_eq(dbus_native_release_device(0, 0, 4294967296, 0), -22,
      "release_device rejects an out-of-range major");
    assert_eq(dbus_native_release_device(0, 0, 0, 4294967296), -22,
      "release_device rejects an out-of-range minor");
    assert_eq(dbus_native_take_device(0, 0, (0 - 1), 0, fo, ao), -22,
      "and the negative bound the native path always had");

    # A null session is refused rather than dereferenced, on ALL FOUR
    # fns that take one. These ship in dist/samvada.cyr, so a caller
    # we do not control reaches them; strlen(0) is a segfault, not an
    # error code. The public path survives only because samvada_init
    # allocates a zeroed buffer — luck, not design, which is AUDIT-1's
    # exact shape.
    #
    # The guard was first applied to the two device fns only, and
    # dbus_native_take_control(0, 0) went on exiting 139. All four are
    # asserted here so it cannot be half-applied a second time.
    assert_eq(dbus_session_sess_ok(0), 0, "the predicate rejects null");
    var good = s_cstr("/org/freedesktop/login1/session/_31");
    assert_eq(dbus_session_sess_ok(good), 1, "and accepts a session path");
    # 1.1.2: it must be a valid object path, or it goes on the wire as a
    # PATH field sd-bus would refuse to build.
    assert_eq(dbus_session_sess_ok(s_cstr("")), 0, "the empty path is refused");
    assert_eq(dbus_session_sess_ok(s_cstr("relative/path")), 0, "a relative path is refused");
    assert_eq(dbus_session_sess_ok(s_cstr("/org/x/")), 0, "a trailing slash is refused");
    assert_eq(dbus_session_sess_ok(s_cstr("/org//x")), 0, "an empty segment is refused");
    assert_eq(dbus_session_sess_ok(s_cstr("/org/x-y")), 0, "a '-' is refused");
    assert_eq(dbus_session_sess_ok(s_cstr("/")), 1, "the root path is valid");
    assert_eq(dbus_native_take_device(0, 0, 226, 0, fo, ao), -22,
      "take_device refuses a null session");
    assert_eq(dbus_native_release_device(0, 0, 226, 0), -22,
      "release_device refuses a null session");
    assert_eq(dbus_native_take_control(0, 0), -22,
      "THE PIN: take_control refuses it too — this one used to SIGSEGV");
    assert_eq(dbus_native_release_control(0, 0), -22,
      "release_control refuses it too");
    return 0;
}

# ---- THE ALLOCATION PIN ----
# alloc() is a bump allocator that NEVER frees, and the consumer is a
# compositor that pumps at 60 Hz for days. Every alloc() on a
# repeating path is therefore a permanent leak, and no test process
# lives long enough to notice.
#
# Measured before the fix, on the IDLE path where nothing is read:
# 8 bytes per pump = ~41 MB/day at 60 Hz, unbounded.
fn test_repeating_paths_do_not_grow_the_heap() {
    test_group("native: the 60 Hz pump path allocates nothing per call");
    var p = alloc(8);
    store64(p, 0);
    assert_eq(sys_socketpair(dbus_sys_af_unix(), dbus_sys_sock_stream(), 0, p), 0,
      "socketpair created");
    var a = load64(p) & 0xFFFFFFFF;
    var b = (load64(p) >> 32) & 0xFFFFFFFF;

    dbus_session_reset();
    dbus_frame_init();

    # Warm up, so one-time lazy allocations are not counted as growth.
    dbus_native_pump_signals(b);
    dbus_native_pump_signals(b);

    var before = alloc_used();
    var i = 0;
    while (i < 20000) { dbus_native_pump_signals(b); i = i + 1; }
    var grew = alloc_used() - before;
    assert_eq(grew, 0,
      "THE PIN: 20000 idle pumps allocate ZERO bytes (was 8 each = ~41 MB/day at 60 Hz)");

    # The reply path too — and it must actually PARSE messages, or
    # the per-message allocation is never reached. A call that only
    # times out exercises nothing: that mistake is what let the
    # per-message alloc survive the first version of this test.
    # Each call below ends at its deadline once the 8 messages are
    # examined: 20 ms, not the 25 s default.
    assert_eq(dbus_session_set_timeout_ms(20), 0, "short call budget");
    var sgz = alloc(8);
    store8(sgz, 111);                   # 'o'
    var txt = alloc(64);
    var tn = t_put(txt, "/org/freedesktop/login1/session/_32");
    dbus_marshal_begin(dbus_marshal_type_return(), 1, 5000);
    dbus_marshal_field_u32(dbus_marshal_f_replyser(), 999);   # never matches
    dbus_marshal_field_sig(dbus_marshal_f_signature(), sgz, 1);
    dbus_marshal_end_fields();
    dbus_marshal_body_str(txt, tn);
    dbus_marshal_finish();
    dbus_unmarshal_set_limit(dbus_marshal_len());
    var one = dbus_marshal_len();
    var wire = alloc(2048);
    var w = 0;
    var c = 0;
    while (c < 8) { w = w + s_copy(wire + w, dbus_marshal_buf(), one); c = c + 1; }

    # Warm the path once so lazy one-time state is already allocated.
    sys_write(a, wire, w);
    dbus_session_call(b, 4242);

    var before2 = alloc_used();
    var pos0 = dbus_frame_pos();
    var j = 0;
    while (j < 10) {
        sys_write(a, wire, w);
        dbus_session_call(b, 4242);     # 8 messages examined and discarded
        j = j + 1;
    }
    # Measured, not counted by the loop (1.1.2: this used to add 8 per
    # iteration itself and assert the sum, which no defect could fail):
    # the framer's consume cursor moved past every byte of all 80.
    assert_eq(dbus_frame_pos() - pos0, w * 10,
      "80 messages were actually framed and consumed, not zero");
    assert_eq(alloc_used() - before2, 0,
      "THE PIN: examining 80 messages allocates nothing (was 8 bytes EACH)");

    sys_close(a);
    sys_close(b);
    dbus_session_reset();
    return 0;
}

# ---- A-4: THE SASL READER UNDER HOSTILE INPUT ----
# dbus_auth is a line-oriented reader over the framer's SHARED 8192
# buffer, fed by a 48-byte pipelined blob. It runs BEFORE any dbus
# framing exists, against a peer that has not authenticated — so it
# is the first thing a hostile or broken server touches.
fn s_plant(p, n) {
    s_copy(dbus_frame_tail(), p, n);
    dbus_frame_commit(n);
    return n;
}

fn test_sasl_reader_survives_hostile_input() {
    test_group("native: the SASL reader survives hostile server output");
    var buf = alloc(9000);

    # (1) A line with no terminator, ever. Must ask for more rather
    # than scanning off the end.
    dbus_frame_init();
    dbus_auth_reset();
    var n = t_put(buf, "OK 1234");
    s_plant(buf, n);
    assert_eq(dbus_auth_drain_lines(), dbus_auth_need_more(),
      "an unterminated line asks for more, it does not guess");

    # (2) A line that FILLS the buffer with no terminator. The framer
    # has 8192 bytes; find_crlf must stay inside them.
    dbus_frame_init();
    dbus_auth_reset();
    var i = 0;
    while (i < 8000) { store8(buf + i, 65); i = i + 1; }   # 'A' x8000
    s_plant(buf, 8000);
    assert_eq(dbus_auth_drain_lines(), dbus_auth_need_more(),
      "8000 bytes with no CRLF stays in-bounds and asks for more");
    assert_eq(dbus_frame_space(), dbus_frame_cap() - 8000,
      "and consumed nothing, so the caller can see the buffer is nearly full");

    # (3) Binary garbage including NULs and high bytes.
    dbus_frame_init();
    dbus_auth_reset();
    i = 0;
    while (i < 64) { store8(buf + i, i * 3); i = i + 1; }
    store8(buf + 64, 13); store8(buf + 65, 10);            # CRLF
    s_plant(buf, 66);
    var g = dbus_auth_drain_lines();
    var garbage_ok = 0;
    if (g == dbus_auth_error()) { garbage_ok = 1; }
    if (g == dbus_auth_need_more()) { garbage_ok = 1; }
    assert_eq(garbage_ok, 1, "binary garbage is an error or ignored, never OK");

    # (4) An explicit REJECTED must not read as success.
    dbus_frame_init();
    dbus_auth_reset();
    n = t_put(buf, "REJECTED EXTERNAL\r\n");
    s_plant(buf, n);
    assert_eq(dbus_auth_drain_lines(), dbus_auth_rejected(), "REJECTED is reported as such");

    # (5) An ERROR line likewise.
    dbus_frame_init();
    dbus_auth_reset();
    n = t_put(buf, "ERROR not welcome\r\n");
    s_plant(buf, n);
    assert(dbus_auth_drain_lines() != dbus_auth_ok(), "ERROR is never OK");

    # (6) A line split across two reads must reassemble, not be lost.
    dbus_frame_init();
    dbus_auth_reset();
    n = t_put(buf, "OK 0123456789abcdef0123456789abcdef");
    s_plant(buf, n);
    assert_eq(dbus_auth_drain_lines(), dbus_auth_need_more(), "first half: incomplete");
    n = t_put(buf, "\r\nAGREE_UNIX_FD\r\n");
    s_plant(buf, n);
    assert_eq(dbus_auth_drain_lines(), dbus_auth_ok(),
      "the split line reassembles and completes with fd support");

    # (7) A server that OKs but refuses fd passing must be refused —
    # samvada cannot do TakeDevice without SCM_RIGHTS.
    dbus_frame_init();
    dbus_auth_reset();
    n = t_put(buf, "OK 0123456789abcdef0123456789abcdef\r\nERROR\r\n");
    s_plant(buf, n);
    # It reports plain `error`; what matters is that it is NEVER ok.
    assert(dbus_auth_drain_lines() != dbus_auth_ok(),
      "OK without AGREE_UNIX_FD is refused, not treated as usable");

    # (8) THE property the whole handshake rests on: the reader can
    # only report success by actually seeing AGREE_UNIX_FD. samvada
    # cannot do TakeDevice without SCM_RIGHTS, so an `ok` that did not
    # observe fd negotiation would be a silent downgrade.
    dbus_frame_init();
    dbus_auth_reset();
    n = t_put(buf, "OK 0123456789abcdef0123456789abcdef\r\nDATA\r\nWHATEVER\r\n");
    s_plant(buf, n);
    assert_eq(dbus_auth_drain_lines(), dbus_auth_need_more(),
      "THE PIN: OK plus unknown lines is never ok — only AGREE_UNIX_FD ends it");

    # (9) AGREE_UNIX_FD before any OK. It answers NEGOTIATE_UNIX_FD,
    # which is legal only after authentication succeeded, so on its own
    # it says nothing about whether samvada was authenticated (1.1.2).
    dbus_frame_init();
    dbus_auth_reset();
    n = t_put(buf, "DATA\r\nAGREE_UNIX_FD\r\nOK 0123456789abcdef0123456789abcdef\r\n");
    s_plant(buf, n);
    assert_eq(dbus_auth_drain_lines(), dbus_auth_error(),
      "THE PIN: AGREE_UNIX_FD without a prior OK is an error, not ok");
    return 0;
}

# ==== A-4 (1.1.1): the protocol state machine ====
# The roadmap's A-4 named three states no test had driven: a bus that
# goes away mid-session, a logind restart, and PauseDevice /
# ResumeDevice arriving around a TakeDevice. Each is reproduced here
# over a socketpair, with the bytes and descriptors the real peers send.

# shutdown(fd, SHUT_WR). The stdlib has no wrapper, so the x86_64
# number is written at a literal site — cyrius's syscall rule 2, which
# ELF-aarch64 routes 48 -> 210 through its compat chain. A half-closed
# peer is how these tests watch for bytes samvada must NOT send: the
# peer stops writing, but its read side stays open.
fn s_shut_wr(fd) {
    return syscall(48, fd, 1);
}

# Whatever the peer can read right now, without blocking: bytes, or -11.
fn s_peer_reads(fd) {
    var buf = alloc(256);
    var n = dbus_sys_recv(fd, buf, 256, dbus_sys_msg_dontwait());
    var i = 0;
    while (i < dbus_sys_rx_count()) { sys_close(dbus_sys_rx_fd(i)); i = i + 1; }
    return n;
}

fn s_wire() {
    var w = alloc(512);
    s_copy(w, dbus_marshal_buf(), dbus_marshal_len());
    return w;
}

fn s_cstr(lit) {
    var p = alloc(128);
    var n = t_put(p, lit);
    store8(p + n, 0);
    return p;
}

fn s_sig(lit) {
    return s_cstr(lit);
}

# logind's PauseDevice(u major, u minor, s type).
fn s_build_pause(major, minor, kind) {
    dbus_marshal_begin(dbus_marshal_type_signal(), 1, 9100);
    var m = s_cstr("PauseDevice");
    dbus_marshal_field_str(dbus_marshal_f_member(), 115, m, strlen(m));
    var sg = s_sig("uus");
    dbus_marshal_field_sig(dbus_marshal_f_signature(), sg, 3);
    dbus_marshal_end_fields();
    dbus_marshal_body_u32(major);
    dbus_marshal_body_u32(minor);
    var k = s_cstr(kind);
    dbus_marshal_body_str(k, strlen(k));
    dbus_marshal_finish();
    dbus_unmarshal_set_limit(dbus_marshal_len());
    return dbus_marshal_len();
}

# logind's ResumeDevice(u major, u minor, h fd): ONE descriptor rides on it.
fn s_build_resume(major, minor) {
    dbus_marshal_begin(dbus_marshal_type_signal(), 1, 9101);
    var m = s_cstr("ResumeDevice");
    dbus_marshal_field_str(dbus_marshal_f_member(), 115, m, strlen(m));
    var sg = s_sig("uuh");
    dbus_marshal_field_sig(dbus_marshal_f_signature(), sg, 3);
    dbus_marshal_field_u32(dbus_marshal_f_unixfds(), 1);
    dbus_marshal_end_fields();
    dbus_marshal_body_u32(major);
    dbus_marshal_body_u32(minor);
    dbus_marshal_body_u32(0);
    dbus_marshal_finish();
    dbus_unmarshal_set_limit(dbus_marshal_len());
    return dbus_marshal_len();
}

# TakeDevice's METHOD_RETURN: (h fd, b inactive), one descriptor.
fn s_build_take_reply(rser) {
    dbus_marshal_begin(dbus_marshal_type_return(), 1, 5100);
    dbus_marshal_field_u32(dbus_marshal_f_replyser(), rser);
    var sg = s_sig("hb");
    dbus_marshal_field_sig(dbus_marshal_f_signature(), sg, 2);
    dbus_marshal_field_u32(dbus_marshal_f_unixfds(), 1);
    dbus_marshal_end_fields();
    dbus_marshal_body_u32(0);
    dbus_marshal_body_bool(0);
    dbus_marshal_finish();
    dbus_unmarshal_set_limit(dbus_marshal_len());
    return dbus_marshal_len();
}

# An empty METHOD_RETURN, optionally naming its DESTINATION and SENDER
# and optionally declaring `nfds` descriptors it should not carry.
fn s_build_return(rser, dest, sender, nfds) {
    dbus_marshal_begin(dbus_marshal_type_return(), 1, 5200);
    dbus_marshal_field_u32(dbus_marshal_f_replyser(), rser);
    if (dest != 0) {
        dbus_marshal_field_str(dbus_marshal_f_dest(), 115, dest, strlen(dest));
    }
    if (sender != 0) {
        dbus_marshal_field_str(dbus_marshal_f_sender(), 115, sender, strlen(sender));
    }
    if (nfds > 0) { dbus_marshal_field_u32(dbus_marshal_f_unixfds(), nfds); }
    dbus_marshal_end_fields();
    dbus_marshal_finish();
    dbus_unmarshal_set_limit(dbus_marshal_len());
    return dbus_marshal_len();
}

fn s_build_error(rser, name, dest, sender, nfds) {
    dbus_marshal_begin(dbus_marshal_type_error(), 1, 5300);
    dbus_marshal_field_u32(dbus_marshal_f_replyser(), rser);
    dbus_marshal_field_str(dbus_marshal_f_errname(), 115, name, strlen(name));
    if (dest != 0) {
        dbus_marshal_field_str(dbus_marshal_f_dest(), 115, dest, strlen(dest));
    }
    if (sender != 0) {
        dbus_marshal_field_str(dbus_marshal_f_sender(), 115, sender, strlen(sender));
    }
    if (nfds > 0) { dbus_marshal_field_u32(dbus_marshal_f_unixfds(), nfds); }
    dbus_marshal_end_fields();
    dbus_marshal_finish();
    dbus_unmarshal_set_limit(dbus_marshal_len());
    return dbus_marshal_len();
}

# org.freedesktop.DBus.NameOwnerChanged(s name, s old, s new).
fn s_build_owner_changed(name, old, new) {
    dbus_marshal_begin(dbus_marshal_type_signal(), 1, 9200);
    var m = s_cstr("NameOwnerChanged");
    dbus_marshal_field_str(dbus_marshal_f_member(), 115, m, strlen(m));
    var snd = s_cstr("org.freedesktop.DBus");
    dbus_marshal_field_str(dbus_marshal_f_sender(), 115, snd, strlen(snd));
    var sg = s_sig("sss");
    dbus_marshal_field_sig(dbus_marshal_f_signature(), sg, 3);
    dbus_marshal_end_fields();
    dbus_marshal_body_str(name, strlen(name));
    dbus_marshal_body_str(old, strlen(old));
    dbus_marshal_body_str(new, strlen(new));
    dbus_marshal_finish();
    dbus_unmarshal_set_limit(dbus_marshal_len());
    return dbus_marshal_len();
}

# ---- mid-session disconnect ----
# Until 1.1.1 a bus that went away was invisible to pump_signals —
# 0 events, every call, forever — and a call after it wrote to the
# dead socket. sd-bus enters CLOSING at the drop and answers from state
# from then on; so does samvada now (_dbs_closed).
fn test_disconnect_is_a_state() {
    test_group("native: a disconnect is a state — reported once seen, nothing written after it");
    var before = s_count_open();
    var bus = s_pair();
    var a = bus & 0xFFFFFFFF;
    var b = (bus >> 32) & 0xFFFFFFFF;
    dbus_session_reset();
    dbus_frame_init();

    assert_eq(dbus_native_pump_signals(b), 0, "a quiet live bus is 0 events, not an error");
    assert_eq(dbus_session_closed(), 0, "and the connection is open");
    assert_eq(s_shut_wr(a), 0, "the peer half-closes: it stops sending but still reads");
    assert_eq(dbus_native_pump_signals(b), -104,
      "THE PIN: the pump reports the drop as -ECONNRESET, as sd-bus does (until 1.1.1: 0, forever)");
    assert_eq(dbus_session_closed(), 1, "and the connection is now known closed");
    assert_eq(dbus_native_pump_signals(b), -104, "every later pump says so too");

    var n = s_build_return(1, 0, 0, 0);
    assert_eq(dbus_session_call(b, 1), -107,
      "a call after the drop is -ENOTCONN, as sd-bus's !BUS_IS_OPEN");
    assert_eq(s_peer_reads(a), -11, "and it wrote NOTHING: the peer reads EAGAIN");

    sys_close(a);
    dbus_native_close_bus(b);
    dbus_session_reset();
    assert_eq(dbus_session_closed(), 0, "a fresh connection starts open");
    assert_eq(s_count_open(), before, "no descriptor leaked");
    return 0;
}

fn test_drop_mid_call_is_connreset() {
    test_group("native: a connection that drops mid-call ends with -ECONNRESET, and stays ended");
    var before = s_count_open();

    # (1) The peer sends HALF a reply and stops: EOF mid-message.
    var bus = s_pair();
    var a = bus & 0xFFFFFFFF;
    var b = (bus >> 32) & 0xFFFFFFFF;
    dbus_session_reset();
    dbus_frame_init();
    var n = s_build_return(1, 0, 0, 0);
    var w = s_wire();
    assert_eq(sys_write(a, w, 20), 20, "20 bytes of a reply planted");
    assert_eq(s_shut_wr(a), 0, "then the peer stops sending");
    assert_eq(dbus_session_call(b, 1), -104,
      "THE PIN: EOF mid-reply is the connection going: -ECONNRESET (until 1.1.1: -EPROTO)");
    assert_eq(dbus_session_call(b, 2), -107, "and the next call is -ENOTCONN without a send");
    sys_close(a);
    sys_close(b);

    # (2) The peer is gone before the call: the SEND fails.
    var bus2 = s_pair();
    var c = bus2 & 0xFFFFFFFF;
    var d = (bus2 >> 32) & 0xFFFFFFFF;
    dbus_session_reset();
    dbus_frame_init();
    sys_close(c);
    n = s_build_return(1, 0, 0, 0);
    assert_eq(dbus_session_call(d, 1), -104,
      "a send to a departed peer is -ECONNRESET, not -EPIPE — EPIPE is a disconnect errno (and no SIGPIPE)");
    assert_eq(dbus_session_closed(), 1, "and it latches the connection closed");
    sys_close(d);
    dbus_session_reset();
    assert_eq(s_count_open(), before, "no descriptor leaked");
    return 0;
}

# ---- logind restart ----
# systemd v262 session_load() (logind-session.c:705-708) restores a
# session's controller on restart if the controller's bus name still has
# an owner — samvada's connection is to the BROKER, so it does — and its
# devices with it. So samvada keeps control across the restart, and its
# cached `_samvada_control` stays true. What changes on the wire is
# logind's unique name, plus the broker's NameOwnerChanged traffic, plus
# an error for any call that was in flight when the old instance died.
fn test_logind_restart_is_survived() {
    test_group("native: a logind restart — a new sender, NameOwnerChanged, NoReply — is survived");
    var bus = s_pair();
    var a = bus & 0xFFFFFFFF;
    var b = (bus >> 32) & 0xFFFFFFFF;
    dbus_session_reset();
    dbus_frame_init();
    var me = s_cstr(":1.42");
    dbus_session_set_unique(me, strlen(me));

    var n = s_build_return(1, me, s_cstr(":1.5"), 0);
    var w = s_wire();
    assert_eq(sys_write(a, w, n), n, "a reply from logind's first instance, :1.5");
    assert_eq(dbus_session_call(b, 1), 0, "accepted");
    dbus_session_done();

    var l1 = s_cstr("org.freedesktop.login1");
    n = s_build_owner_changed(l1, s_cstr(":1.5"), s_cstr(""));
    w = s_wire();
    assert_eq(sys_write(a, w, n), n, "the broker: login1 lost its owner");
    n = s_build_owner_changed(l1, s_cstr(""), s_cstr(":1.99"));
    w = s_wire();
    assert_eq(sys_write(a, w, n), n, "the broker: login1 has a new owner, :1.99");
    n = s_build_return(2, me, s_cstr(":1.99"), 0);
    w = s_wire();
    assert_eq(sys_write(a, w, n), n, "a reply from the NEW instance");
    assert_eq(dbus_session_call(b, 2), 0,
      "THE PIN: accepted — samvada never pins logind's unique name, which a restart changes");
    dbus_session_done();

    var nr = s_cstr("org.freedesktop.DBus.Error.NoReply");
    n = s_build_error(3, nr, me, s_cstr("org.freedesktop.DBus"), 0);
    w = s_wire();
    assert_eq(sys_write(a, w, n), n, "the broker answers a call logind died holding");
    assert_eq(dbus_session_call(b, 3), -110,
      "-ETIMEDOUT, as sd-bus maps NoReply (until 1.1.1: -EIO)");
    assert_eq(dbus_session_closed(), 0, "and an error reply is not a disconnect");

    sys_close(a);
    sys_close(b);
    dbus_session_reset();
    return 0;
}

# ---- PauseDevice / ResumeDevice around a TakeDevice (ADR-0004) ----
# Signals are not surfaced (ADR-0004 §2), so their descriptors must be
# closed in stream order — never left for the next take_device. The
# two 1.0.1 tests cover a lone signal; these drive the orderings a VT
# switch actually produces.
fn test_pause_resume_around_take_device() {
    test_group("native: Pause and Resume around a TakeDevice keep each descriptor with its own message");
    var before = s_count_open();
    var bus = s_pair();
    var a = bus & 0xFFFFFFFF;
    var b = (bus >> 32) & 0xFFFFFFFF;
    var px = s_pair();
    var x = px & 0xFFFFFFFF;
    var xp = (px >> 32) & 0xFFFFFFFF;
    var y = s_dev("/dev/null");          # 1:3 — the device the reply hands over
    var yp = s_dev("/dev/null");
    var pz = s_pair();
    var z = pz & 0xFFFFFFFF;
    var zp = (pz >> 32) & 0xFFFFFFFF;
    var v = s_dev("/dev/zero");          # 1:5 — the second take's device
    var vp = s_dev("/dev/zero");
    var sess = s_cstr("/org/freedesktop/login1/session/_31");
    var fo = alloc(8);
    var ao = alloc(8);

    # (1) A VT switch lands before the reply: Pause("force"), Resume(X).
    dbus_session_reset();
    dbus_frame_init();
    var n = s_build_pause(226, 0, "force");
    var w = s_wire();
    assert_eq(sys_write(a, w, n), n, "PauseDevice(force) planted");
    n = s_build_resume(226, 0);
    w = s_wire();
    assert_eq(s_send_with_fd(a, w, n, x), n, "ResumeDevice + its descriptor X planted");
    n = s_build_take_reply(1);
    w = s_wire();
    assert_eq(s_send_with_fd(a, w, n, y), n, "the TakeDevice reply + Y planted");
    assert_eq(dbus_native_take_device(b, sess, 1, 3, fo, ao), 0, "take_device succeeded");
    assert_eq(s_ino(load64(fo)), s_ino(y),
      "THE PIN: it got the REPLY's descriptor, past a Pause and a Resume");
    assert_eq(dbus_frame_fd_count(), 0, "and the Resume's was closed, not left queued");
    sys_close(load64(fo));

    # (2) The reply first, a Resume(Z) right behind it — then the
    # consumer takes a SECOND device (say, input) without pumping.
    dbus_session_reset();
    dbus_frame_init();
    n = s_build_take_reply(1);
    w = s_wire();
    assert_eq(s_send_with_fd(a, w, n, y), n, "reply + Y");
    n = s_build_resume(226, 0);
    w = s_wire();
    assert_eq(s_send_with_fd(a, w, n, z), n, "Resume + Z, right behind it");
    assert_eq(dbus_native_take_device(b, sess, 1, 3, fo, ao), 0, "the first take");
    assert_eq(s_ino(load64(fo)), s_ino(y), "got Y");
    sys_close(load64(fo));
    n = s_build_take_reply(2);
    w = s_wire();
    assert_eq(s_send_with_fd(a, w, n, v), n, "the second take's reply + V");
    assert_eq(dbus_native_take_device(b, sess, 1, 5, fo, ao), 0, "the second take");
    assert_eq(s_ino(load64(fo)), s_ino(v),
      "THE PIN: the second take got V, not the Resume's Z queued ahead of it");
    assert_eq(dbus_frame_fd_count(), 0, "and Z was closed on the way past");
    sys_close(load64(fo));

    sys_close(x);  sys_close(xp);
    sys_close(y);  sys_close(yp);
    sys_close(z);  sys_close(zp);
    sys_close(v);  sys_close(vp);
    sys_close(a);  sys_close(b);
    dbus_session_reset();
    assert_eq(s_count_open(), before, "no descriptor leaked");
    return 0;
}

fn test_pause_needing_an_ack_is_drained_not_acked() {
    test_group("native: PauseDevice(\"pause\") is drained and NOT acknowledged (ADR-0004)");
    var bus = s_pair();
    var a = bus & 0xFFFFFFFF;
    var b = (bus >> 32) & 0xFFFFFFFF;
    dbus_session_reset();
    dbus_frame_init();
    var n = s_build_pause(226, 0, "pause");
    var w = s_wire();
    assert_eq(sys_write(a, w, n), n, "PauseDevice(pause) planted — the one type wanting PauseDeviceComplete");
    assert_eq(dbus_native_pump_signals(b), 1, "the pump drained it");
    assert_eq(s_peer_reads(a), -11,
      "and sent nothing back: no PauseDeviceComplete. ADR-0004 finding 3: unreachable on a VT seat, and nothing waits");
    sys_close(a);
    sys_close(b);
    dbus_session_reset();
    return 0;
}

# ---- descriptors on replies that should carry none ----
fn test_stray_reply_descriptors_are_closed() {
    test_group("native: a descriptor on a reply that should carry none is closed, never handed to take_device");
    var before = s_count_open();
    var bus = s_pair();
    var a = bus & 0xFFFFFFFF;
    var b = (bus >> 32) & 0xFFFFFFFF;
    var ps = s_pair();
    var st = ps & 0xFFFFFFFF;
    var stp = (ps >> 32) & 0xFFFFFFFF;
    var pe = s_pair();
    var e = pe & 0xFFFFFFFF;
    var ep = (pe >> 32) & 0xFFFFFFFF;
    var y = s_dev("/dev/null");          # 1:3 — the device the reply hands over
    var yp = s_dev("/dev/null");
    var sess = s_cstr("/org/freedesktop/login1/session/_31");
    var fo = alloc(8);
    var ao = alloc(8);
    dbus_session_reset();
    dbus_frame_init();

    var n = s_build_return(1, 0, 0, 1);
    var w = s_wire();
    assert_eq(s_send_with_fd(a, w, n, st), n, "a TakeControl reply carrying a stray descriptor");
    assert_eq(dbus_native_take_control(b, sess), 0, "take_control succeeded");
    assert_eq(dbus_frame_fd_count(), 0,
      "THE PIN: the stray went with its reply (until 1.1.1 it stayed at the head of the queue)");

    var ad = s_cstr("org.freedesktop.DBus.Error.AccessDenied");
    n = s_build_error(2, ad, 0, 0, 1);
    w = s_wire();
    assert_eq(s_send_with_fd(a, w, n, e), n, "an ERROR reply carrying one");
    assert_eq(dbus_native_release_control(b, sess), -13, "release_control: -EACCES");
    assert_eq(dbus_frame_fd_count(), 0, "and the ERROR reply's descriptor went with it too");

    n = s_build_take_reply(3);
    w = s_wire();
    assert_eq(s_send_with_fd(a, w, n, y), n, "then a real TakeDevice reply + Y");
    assert_eq(dbus_native_take_device(b, sess, 1, 3, fo, ao), 0, "take_device succeeded");
    assert_eq(s_ino(load64(fo)), s_ino(y), "and it got Y, not either stray");
    sys_close(load64(fo));

    sys_close(st); sys_close(stp);
    sys_close(e);  sys_close(ep);
    sys_close(y);  sys_close(yp);
    sys_close(a);  sys_close(b);
    dbus_session_reset();
    assert_eq(s_count_open(), before, "no descriptor leaked");
    return 0;
}

# ==== A-1 (1.1.1): resource exhaustion ====

# ---- every logind call, not only the pump ----
# The 1.0.1 pin covers the 60 Hz pump and the reply loop. A-1's
# question is whether a long-running consumer grows without bound, and
# alloc() never frees — so EVERY repeating path counts, including the
# ones a compositor runs per device per VT switch. Measured before
# 1.1.1: take_control 200 bytes per call, release_control 192,
# release_device 200, take_device 200, GetSessionByPID 336 — a literal
# copied into a fresh alloc() each time. Each call here gets a real mock
# reply, so the whole path runs, parse included; the reply bytes and the
# descriptors are prepared BEFORE the measured loop, so only the call
# itself is inside it.
fn s_heap_per_call(b, a, which, sess) {
    var fo = alloc(8);
    var ao = alloc(8);
    var out = alloc(128);
    var n = 0;
    if (which == 3) { n = s_build_take_reply(1); }
    if (which == 4) {
        var path = s_cstr("/org/freedesktop/login1/session/_31");
        n = s_build_reply(1, 0, 0, path, strlen(path));
    }
    if (which < 3) { n = s_build_return(1, 0, 0, 0); }
    var w = s_wire();
    var fds = alloc(12 * 16);
    var k = 0;
    while (k < 12) {
        store64(fds + k * 16, s_dev("/dev/null"));
        store64(fds + k * 16 + 8, s_dev("/dev/null"));
        k = k + 1;
    }
    var rc = 0;
    var before = 0;
    var i = 0;
    # The first call warms one-time state; the next ten are measured.
    while (i < 11) {
        if (i == 1) { before = alloc_used(); }
        dbus_session_reset();
        dbus_frame_init();
        if (which == 3) {
            s_send_with_fd(a, w, n, load64(fds + i * 16));
        }
        if (which != 3) { sys_write(a, w, n); }
        if (which == 0) { rc = dbus_native_take_control(b, sess); }
        if (which == 1) { rc = dbus_native_release_control(b, sess); }
        if (which == 2) { rc = dbus_native_release_device(b, sess, 226, 0); }
        if (which == 3) {
            rc = dbus_native_take_device(b, sess, 1, 3, fo, ao);
            sys_close(load64(fo));
        }
        if (which == 4) { rc = dbus_native_get_session_path(b, 1000, out, 128); }
        if (rc != 0) { return (0 - 1000000) + rc; }
        i = i + 1;
    }
    var grew = alloc_used() - before;
    k = 0;
    while (k < 12) {
        sys_close(load64(fds + k * 16));
        sys_close(load64(fds + k * 16 + 8));
        k = k + 1;
    }
    return grew;
}

fn test_logind_calls_do_not_grow_the_heap() {
    test_group("native: every logind call allocates nothing per call");
    var before = s_count_open();
    var bus = s_pair();
    var a = bus & 0xFFFFFFFF;
    var b = (bus >> 32) & 0xFFFFFFFF;
    var sess = s_cstr("/org/freedesktop/login1/session/_31");
    assert_eq(s_heap_per_call(b, a, 0, sess), 0, "take_control: ten calls allocate nothing (was 200 B each)");
    assert_eq(s_heap_per_call(b, a, 1, sess), 0, "release_control: ten calls allocate nothing (was 192 B each)");
    assert_eq(s_heap_per_call(b, a, 2, sess), 0, "release_device: ten calls allocate nothing (was 200 B each)");
    assert_eq(s_heap_per_call(b, a, 3, sess), 0, "take_device: ten calls allocate nothing (was 200 B each)");
    assert_eq(s_heap_per_call(b, a, 4, sess), 0, "GetSessionByPID: ten calls allocate nothing (was 336 B each)");
    sys_close(a);
    sys_close(b);
    dbus_session_reset();
    assert_eq(s_count_open(), before, "no descriptor leaked");
    return 0;
}

# ---- sustained fd-bearing traffic ----
# A-1's third item: the fd queue under a peer that never stops sending
# descriptors. logind's ResumeDevice is the realistic one; a hostile
# peer is the worst case. Neither may grow the queue, the descriptor
# table or the heap, and a take afterwards must still get its own.
fn test_sustained_fd_traffic_is_bounded() {
    test_group("native: 1000 fd-bearing signals leave no descriptor, no queue and no heap behind");
    var bus = s_pair();
    var a = bus & 0xFFFFFFFF;
    var b = (bus >> 32) & 0xFFFFFFFF;
    var px = s_pair();
    var x = px & 0xFFFFFFFF;
    var xp = (px >> 32) & 0xFFFFFFFF;
    var y = s_dev("/dev/null");          # 1:3 — the device the reply hands over
    var yp = s_dev("/dev/null");
    var sess = s_cstr("/org/freedesktop/login1/session/_31");
    var fo = alloc(8);
    var ao = alloc(8);
    dbus_session_reset();
    dbus_frame_init();
    var n = s_build_resume(226, 0);
    var w = s_wire();
    # Warm, then measure.
    s_send_with_fd(a, w, n, x);
    dbus_native_pump_signals(b);
    var open0 = s_count_open();
    var heap0 = alloc_used();
    var drained = 0;
    var worst_q = 0;
    var round = 0;
    while (round < 100) {
        var k = 0;
        while (k < 10) { s_send_with_fd(a, w, n, x); k = k + 1; }
        var got = 1;
        while (got > 0) {
            got = dbus_native_pump_signals(b);
            if (got > 0) { drained = drained + got; }
            if (dbus_frame_fd_count() > worst_q) { worst_q = dbus_frame_fd_count(); }
        }
        round = round + 1;
    }
    var grew = alloc_used() - heap0;            # before s_count_open, which allocates
    assert_eq(drained, 1000, "all 1000 ResumeDevice signals were drained");
    # Between pumps the queue may hold ONE descriptor: when the buffer has
    # less room than a message, a receive brings part of it and its fd,
    # and the fd waits for the rest of its own message. Never more.
    var bounded = 0;
    if (worst_q <= 1) { bounded = 1; }
    assert_eq(bounded, 1, "the queue never held more than the one partial message's descriptor");
    assert_eq(dbus_frame_fd_count(), 0, "and holds none once drained");
    assert_eq(s_count_open(), open0, "THE PIN: 1000 received descriptors, every one closed");
    assert_eq(grew, 0, "and the heap did not grow");
    n = s_build_take_reply(1);
    w = s_wire();
    s_send_with_fd(a, w, n, y);
    assert_eq(dbus_native_take_device(b, sess, 1, 3, fo, ao), 0, "a take afterwards succeeds");
    assert_eq(s_ino(load64(fo)), s_ino(y), "and gets its own descriptor");
    sys_close(load64(fo));
    sys_close(x);  sys_close(xp);
    sys_close(y);  sys_close(yp);
    sys_close(a);  sys_close(b);
    dbus_session_reset();
    return 0;
}

fn test_declared_128mib_fails_both_paths() {
    test_group("native: a header declaring >= 128 MiB is -ENOBUFS on the call and the pump");
    var bus = s_pair();
    var a = bus & 0xFFFFFFFF;
    var b = (bus >> 32) & 0xFFFFFFFF;
    dbus_session_reset();
    dbus_frame_init();
    var h = alloc(16);
    var i = 0;
    while (i < 16) { store8(h + i, 0); i = i + 1; }
    store8(h + 0, 108); store8(h + 1, 2); store8(h + 3, 1);
    # store32, not store64: an 8-byte store at +12 ran 4 bytes past this
    # 16-byte buffer (1.1.2; harmless only because alloc() is a bump
    # allocator).
    store32(h + 4, 0xFFFFFFFF);
    store8(h + 8, 9);
    store32(h + 12, 0xFFFFFFFF);
    assert_eq(sys_write(a, h, 16), 16, "a 16-byte header declaring ~8 GiB");
    var n = s_build_return(1, 0, 0, 0);
    assert_eq(dbus_session_call(b, 1), -105,
      "THE PIN: the call is -ENOBUFS, as sd-bus (until 1.1.1 it began an ~8 GiB drain)");
    assert_eq(dbus_native_pump_signals(b), -105, "and so is the pump");
    assert_eq(dbus_session_closed(), 0, "a refused message is not a disconnect");
    sys_close(a);
    sys_close(b);
    dbus_session_reset();
    return 0;
}

# ==== P(-1) (1.1.2): descriptor attribution, and what a bus peer can do ====
# Every test here is a proof of concept from the 1.1.2 audit, kept as a
# pin. The one frame an unprivileged bus peer can push to samvada is a
# directed SIGNAL, and the broker forwards it with whatever descriptors
# the peer attached — so each of these is reachable by any local user.

# Send `len` bytes plus `count` SCM_RIGHTS descriptors: `first`, then
# copies of `rest` (the kernel installs a fresh descriptor for each).
var _s_ctrln = 0;
fn s_send_with_fds(sock, buf, len, first, rest, count) {
    s_send_init();
    if (_s_ctrln == 0) { _s_ctrln = alloc(16 + 253 * 4 + 8); }
    store64(_s_iov + 0, buf);
    store64(_s_iov + 8, len);
    var clen = 16 + count * 4;
    var space = (clen + 7) & (0 - 8);
    var i = 0;
    while (i < space) { store64(_s_ctrln + i, 0); i = i + 8; }
    store64(_s_ctrln + 0, clen);
    store32(_s_ctrln + 8, dbus_sys_sol_socket());
    store32(_s_ctrln + 12, dbus_sys_scm_rights());
    i = 0;
    while (i < count) {
        var e = rest;
        if (i == 0) { e = first; }
        store32(_s_ctrln + 16 + i * 4, e);
        i = i + 1;
    }
    i = 0;
    while (i < 56) { store64(_s_mh + i, 0); i = i + 8; }
    store64(_s_mh + 16, _s_iov);
    store64(_s_mh + 24, 1);
    store64(_s_mh + 32, _s_ctrln);
    store64(_s_mh + 40, space);
    return sys_sendmsg(sock, _s_mh, 0);
}

fn s_be32(p, v) {
    store8(p + 0, (v >> 24) & 255);
    store8(p + 1, (v >> 16) & 255);
    store8(p + 2, (v >> 8) & 255);
    store8(p + 3, v & 255);
    return 0;
}

# A BIG-endian SIGNAL declaring UNIX_FDS=1, built by hand (the
# marshaller writes little-endian only). samvada's header-field walker
# reads little-endian, so through 1.1.1 this message's UNIX_FDS was
# unreadable and it was taken to carry no descriptor.
fn s_build_be_signal(w) {
    var i = 0;
    while (i < 32) { store8(w + i, 0); i = i + 1; }
    store8(w + 0, 66);                  # 'B'
    store8(w + 1, 4);                   # SIGNAL
    store8(w + 3, 1);                   # protocol version
    s_be32(w + 4, 0);                   # body_len
    s_be32(w + 8, 7001);                # serial
    s_be32(w + 12, 8);                  # fields_len
    store8(w + 16, 9);                  # UNIX_FDS
    store8(w + 17, 1);
    store8(w + 18, 117);                # 'u'
    s_be32(w + 20, 1);
    return 24;
}

# A little-endian SIGNAL whose first header field has a code samvada
# does not know (200) and a type its walker had no case for ('y'),
# ahead of UNIX_FDS=1. Legal — the spec says unknown fields are ignored —
# and through 1.1.1 it stopped the walk, so UNIX_FDS was never found.
fn s_build_unknown_field_signal(w) {
    var i = 0;
    while (i < 40) { store8(w + i, 0); i = i + 1; }
    store8(w + 0, 108);                 # 'l'
    store8(w + 1, 4);
    store8(w + 3, 1);
    store32(w + 4, 0);
    store32(w + 8, 7002);
    store32(w + 12, 16);
    store8(w + 16, 200);                # unknown field code
    store8(w + 17, 1);
    store8(w + 18, 121);                # 'y'
    store8(w + 20, 42);                 # its byte value
    store8(w + 24, 9);                  # UNIX_FDS, 8-aligned
    store8(w + 25, 1);
    store8(w + 26, 117);
    store32(w + 28, 1);
    return 32;
}

# THE H1 PIN. A peer plants descriptor X on a message samvada cannot
# parse, then logind's TakeDevice reply arrives with the real device Y.
# Through 1.1.1 X stayed at the head of the queue and take_device
# returned it as the device; Y shifted to the NEXT take. With eight
# planted the queue was full and every genuine descriptor after them
# was closed on arrival.
fn s_h1_case(label, kind, planted) {
    var before = s_count_open();
    var bus = s_pair();
    var a = bus & 0xFFFFFFFF;
    var b = (bus >> 32) & 0xFFFFFFFF;
    var px = s_pair();
    var x = px & 0xFFFFFFFF;
    var xp = (px >> 32) & 0xFFFFFFFF;
    var y = s_dev("/dev/null");          # 1:3 — the device the reply hands over
    var yp = s_dev("/dev/null");
    var sess = s_cstr("/org/freedesktop/login1/session/_31");
    var fo = alloc(8);
    var ao = alloc(8);

    dbus_session_reset();
    dbus_frame_init();
    var w = alloc(64);
    var n = 0;
    if (kind == 0) { n = s_build_be_signal(w); }
    if (kind == 1) { n = s_build_unknown_field_signal(w); }
    var i = 0;
    var sent = 0;
    while (i < planted) {
        if (s_send_with_fd(a, w, n, x) == n) { sent = sent + 1; }
        i = i + 1;
    }
    assert_eq(sent, planted, label);
    n = s_build_take_reply(1);
    var rw = s_wire();
    assert_eq(s_send_with_fd(a, rw, n, y), n, "the TakeDevice reply + Y planted behind them");
    assert_eq(dbus_native_take_device(b, sess, 1, 3, fo, ao), 0, "take_device succeeded");
    assert_eq(s_ino(load64(fo)), s_ino(y),
      "THE PIN: take_device returned the REPLY's descriptor, not the planted one");
    assert_eq(dbus_frame_fd_count(), 0, "nothing is left queued");
    sys_close(load64(fo));
    sys_close(x);  sys_close(xp);
    sys_close(y);  sys_close(yp);
    sys_close(a);  sys_close(b);
    dbus_session_reset();
    assert_eq(s_count_open(), before, "every planted descriptor was closed, none leaked");
    return 0;
}

fn test_unparseable_message_cannot_plant_a_descriptor() {
    test_group("native: a descriptor on a message samvada cannot parse is still that message's (H1)");
    s_h1_case("a big-endian signal + X planted", 0, 1);
    s_h1_case("a signal with an unknown field ahead of UNIX_FDS + X planted", 1, 1);
    s_h1_case("EIGHT big-endian signals, each + X — the queue's whole depth", 0, 8);
    return 0;
}

# A TakeDevice reply carrying `nfds` descriptors (`fd`, then copies of
# `fd2`), declaring `declared` in UNIX_FDS, with body `(h idx, b
# inactive)` under signature `sig`; inactive < 0 omits the `b`.
fn s_send_take_reply(sock, rser, sig, declared, idx, inactive, fd, fd2, nfds) {
    dbus_marshal_begin(dbus_marshal_type_return(), 1, 5300);
    dbus_marshal_field_u32(dbus_marshal_f_replyser(), rser);
    var sg = s_sig(sig);
    dbus_marshal_field_sig(dbus_marshal_f_signature(), sg, strlen(sg));
    if (declared > 0) { dbus_marshal_field_u32(dbus_marshal_f_unixfds(), declared); }
    dbus_marshal_end_fields();
    dbus_marshal_body_u32(idx);
    if (inactive >= 0) { dbus_marshal_body_u32(inactive); }
    dbus_marshal_finish();
    dbus_unmarshal_set_limit(dbus_marshal_len());
    var n = dbus_marshal_len();
    var w = s_wire();
    if (nfds == 0) { return sys_write(sock, w, n); }
    return s_send_with_fds(sock, w, n, fd, fd2, nfds);
}

# take_device used to take the head of the queue whatever the reply
# said. It now holds the reply to sd-bus's rules: the `h` is an INDEX
# into the reply's own descriptors, UNIX_FDS must match what arrived,
# and the body must be `(hb)`. Anything else is -EBADF and nothing is
# handed out.
fn test_take_device_holds_the_reply_to_its_contract() {
    test_group("native: take_device honours the reply's index, count and signature");
    var before = s_count_open();
    var bus = s_pair();
    var a = bus & 0xFFFFFFFF;
    var b = (bus >> 32) & 0xFFFFFFFF;
    var px = s_pair();
    var x = px & 0xFFFFFFFF;
    var xp = (px >> 32) & 0xFFFFFFFF;
    var y = s_dev("/dev/null");          # 1:3 — the device the reply hands over
    var yp = s_dev("/dev/null");
    var sess = s_cstr("/org/freedesktop/login1/session/_31");
    var fo = alloc(8);
    var ao = alloc(8);

    # (0) THE BOUNDED-READ PIN. A descriptor-less signal sits in the
    # socket immediately ahead of the reply. One unbounded read would
    # take both, and the reply's descriptor would arrive while the SIGNAL
    # was the head message — and be closed with it.
    dbus_session_reset();
    dbus_frame_init();
    var pn = s_build_pause(226, 0, "pause");
    var pw = s_wire();
    assert_eq(sys_write(a, pw, pn), pn, "a PauseDevice, no descriptor");
    s_send_take_reply(a, 1, "hb", 1, 0, 0, y, y, 1);
    assert_eq(dbus_native_take_device(b, sess, 1, 3, fo, ao), 0,
      "THE PIN: the reply right behind a descriptor-less signal keeps its descriptor");
    assert_eq(s_ino(load64(fo)), s_ino(y), "and it is the reply's");
    sys_close(load64(fo));

    # (1) Two descriptors, X then Y, and the body names the SECOND.
    dbus_session_reset();
    dbus_frame_init();
    var sent = s_send_take_reply(a, 1, "hb", 2, 1, 0, x, y, 2);
    assert(sent > 0, "a two-fd reply, index 1");
    assert_eq(dbus_native_take_device(b, sess, 1, 3, fo, ao), 0, "accepted");
    var got = load64(fo);
    assert_eq(s_ino(got), s_ino(y), "THE PIN: the index is honoured — the second, Y");
    sys_close(got);
    assert_eq(dbus_frame_fd_count(), 0, "X was closed with the reply");

    # (2) UNIX_FDS says 2, one arrived: the count disagrees.
    dbus_session_reset();
    dbus_frame_init();
    s_send_take_reply(a, 1, "hb", 2, 0, 0, y, y, 1);
    store64(ao, 77);
    assert_eq(dbus_native_take_device(b, sess, 1, 3, fo, ao), -9, "THE PIN: a count mismatch is -EBADF");
    assert_eq(load64(fo), (0 - 1), "and no descriptor is handed out");

    # (3) The index points past the descriptors.
    dbus_session_reset();
    dbus_frame_init();
    s_send_take_reply(a, 1, "hb", 1, 3, 0, y, y, 1);
    assert_eq(dbus_native_take_device(b, sess, 1, 3, fo, ao), -9, "an index past the descriptors is -EBADF");

    # (4) No descriptor at all, as an unseated logind would never send but
    # a broken one might.
    dbus_session_reset();
    dbus_frame_init();
    s_send_take_reply(a, 1, "hb", 0, 0, 0, x, x, 0);
    assert_eq(dbus_native_take_device(b, sess, 1, 3, fo, ao), -9, "no descriptor is -EBADF");

    # (5) The wrong signature, and a body with no `inactive`: the latter
    # used to store the decoder's -1201 into active_out.
    dbus_session_reset();
    dbus_frame_init();
    s_send_take_reply(a, 1, "hu", 1, 0, 0, y, y, 1);
    assert_eq(dbus_native_take_device(b, sess, 1, 3, fo, ao), -9, "signature `hu` is -EBADF");
    dbus_session_reset();
    dbus_frame_init();
    s_send_take_reply(a, 1, "h", 1, 0, (0 - 1), y, y, 1);
    store64(ao, 77);
    assert_eq(dbus_native_take_device(b, sess, 1, 3, fo, ao), -9, "a body without `b` is -EBADF");
    assert_eq(load64(ao), 0, "and active_out is 0, never the decoder's -1201");

    # (6) A truncated descriptor set, with a UNIX_FDS that lies to match
    # what survived: SO_PASSCRED puts credentials ahead of the
    # descriptors, so 246 of 250 fit. The count agrees; the set is still
    # known incomplete, and is refused.
    var one = alloc(8);
    store64(one, 1);
    assert_eq(sys_setsockopt(b, dbus_sys_sol_socket(), 16, one, 4), 0, "SO_PASSCRED on our end");
    dbus_session_reset();
    dbus_frame_init();
    s_send_take_reply(a, 1, "hb", 246, 0, 0, y, y, 250);
    assert_eq(dbus_native_take_device(b, sess, 1, 3, fo, ao), -9,
      "THE PIN: a truncated set is refused even when UNIX_FDS matches it");
    store64(one, 0);
    sys_setsockopt(b, dbus_sys_sol_socket(), 16, one, 4);

    # (7) THE RDEV PIN (1.1.2). A reply that is right in every way but
    # the descriptor itself: take_device asks the kernel what it is. The
    # wrong character device, and a socket, are both refused — had this
    # existed, P1-1 would have been -EBADF, not another user's descriptor.
    var z = s_dev("/dev/zero");
    dbus_session_reset();
    dbus_frame_init();
    s_send_take_reply(a, 1, "hb", 1, 0, 0, z, z, 1);
    assert_eq(dbus_native_take_device(b, sess, 1, 3, fo, ao), -9,
      "THE PIN: /dev/zero (1:5) is not the 1:3 that was asked for");
    dbus_session_reset();
    dbus_frame_init();
    s_send_take_reply(a, 1, "hb", 1, 0, 0, x, x, 1);
    assert_eq(dbus_native_take_device(b, sess, 1, 3, fo, ao), -9, "a socket is not a device");
    dbus_session_reset();
    dbus_frame_init();
    s_send_take_reply(a, 1, "hb", 1, 0, 0, z, z, 1);
    assert_eq(dbus_native_take_device(b, sess, 1, 5, fo, ao), 0, "and 1:5 asked for /dev/zero is accepted");
    assert_eq(s_ino(load64(fo)), s_ino(z), "it is /dev/zero");
    sys_close(load64(fo));
    sys_close(z);
    # The right node, but not opened the way logind opens it: O_PATH
    # (which anyone can open on any node, readable or not) and read-only.
    # The first cut of this check accepted both (P(-1) final pass).
    var op = sys_open("/dev/null", 2097152 | 524288, 0);     # O_PATH | O_CLOEXEC
    assert(op >= 0, "an O_PATH descriptor of /dev/null");
    dbus_session_reset();
    dbus_frame_init();
    s_send_take_reply(a, 1, "hb", 1, 0, 0, op, op, 1);
    assert_eq(dbus_native_take_device(b, sess, 1, 3, fo, ao), -9,
      "THE PIN: an O_PATH descriptor of the right node is refused");
    sys_close(op);
    var ro = sys_open("/dev/null", 524288, 0);                # O_RDONLY | O_CLOEXEC
    dbus_session_reset();
    dbus_frame_init();
    s_send_take_reply(a, 1, "hb", 1, 0, 0, ro, ro, 1);
    assert_eq(dbus_native_take_device(b, sess, 1, 3, fo, ao), -9,
      "and so is a read-only one");
    sys_close(ro);

    sys_close(x);  sys_close(xp);
    sys_close(y);  sys_close(yp);
    sys_close(a);  sys_close(b);
    dbus_session_reset();
    assert_eq(s_count_open(), before, "every refused reply's descriptors were closed");
    return 0;
}

# THE M1 AND M2 PINS. Neither needs the peer to parse as anything odd.
# (1) A signal carrying three descriptors truncated the old one-fd
#     control buffer; the receive answered -EPROTO, which is a
#     disconnect, and samvada closed its own bus.
# (2) The reply loop gave up after 64 reads, and a descriptor ends a
#     read, so 64 one-fd signals ahead of the reply failed the call.
fn test_bus_peer_traffic_cannot_fail_a_call() {
    test_group("native: descriptor-heavy bus traffic cannot fail a call or close the bus (M1, M2)");
    var before = s_count_open();
    var bus = s_pair();
    var a = bus & 0xFFFFFFFF;
    var b = (bus >> 32) & 0xFFFFFFFF;
    var px = s_pair();
    var x = px & 0xFFFFFFFF;
    var xp = (px >> 32) & 0xFFFFFFFF;
    var y = s_dev("/dev/null");          # 1:3 — the device the reply hands over
    var yp = s_dev("/dev/null");
    var sess = s_cstr("/org/freedesktop/login1/session/_31");
    var fo = alloc(8);
    var ao = alloc(8);

    dbus_session_reset();
    dbus_frame_init();
    var n = s_build_resume(226, 0);
    var w = s_wire();
    assert_eq(s_send_with_fds(a, w, n, x, x, 3), n, "a Resume-shaped signal with THREE descriptors");
    n = s_build_take_reply(1);
    var rw = s_wire();
    s_send_with_fd(a, rw, n, y);
    assert_eq(dbus_native_take_device(b, sess, 1, 3, fo, ao), 0,
      "THE M1 PIN: the take succeeds past it");
    assert_eq(dbus_session_closed(), 0, "and the bus is still open");
    assert_eq(s_ino(load64(fo)), s_ino(y), "with the reply's descriptor");
    sys_close(load64(fo));

    dbus_session_reset();
    dbus_frame_init();
    n = s_build_resume(226, 0);
    w = s_wire();
    var i = 0;
    var sent = 0;
    while (i < 100) {
        if (s_send_with_fd(a, w, n, x) == n) { sent = sent + 1; }
        i = i + 1;
    }
    assert_eq(sent, 100, "100 one-fd signals ahead of the reply");
    n = s_build_take_reply(1);
    rw = s_wire();
    s_send_with_fd(a, rw, n, y);
    assert_eq(dbus_native_take_device(b, sess, 1, 3, fo, ao), 0,
      "THE M2 PIN: the take succeeds — the deadline bounds the call, not a read count");
    assert_eq(s_ino(load64(fo)), s_ino(y), "with the reply's descriptor");
    sys_close(load64(fo));

    sys_close(x);  sys_close(xp);
    sys_close(y);  sys_close(yp);
    sys_close(a);  sys_close(b);
    dbus_session_reset();
    assert_eq(s_count_open(), before, "and all 103 planted descriptors were closed");
    return 0;
}

# THE M3 PIN. The send-time watermark was a count of pending bytes,
# decremented by each message consumed but not by the bytes an over-cap
# drain threw away. An over-cap message straddling the send left the
# count above zero for good, and the genuine reply behind it was refused
# as stale. The watermark is now a stream position.
fn test_drain_does_not_strand_the_watermark() {
    test_group("native: an over-cap drain across the send does not make the reply stale (M3)");
    var bus = s_pair();
    var a = bus & 0xFFFFFFFF;
    var b = (bus >> 32) & 0xFFFFFFFF;
    dbus_session_reset();
    dbus_frame_init();
    assert_eq(dbus_session_set_timeout_ms(500), 0, "a short budget, so a regression fails fast");

    # The over-cap message's header is already buffered when the call
    # starts; its body and the reply arrive after the request.
    var big = alloc(9100);
    var i = 0;
    while (i < 9100) { store8(big + i, 0); i = i + 1; }
    store8(big + 0, 108);
    store8(big + 1, 4);
    store8(big + 3, 1);
    store32(big + 4, 9000);             # body: total 16 + 9000 > the 8192 cap
    store32(big + 8, 7100);
    store32(big + 12, 0);
    s_plant(big, 16);
    assert_eq(sys_write(a, big + 16, 9000), 9000, "the rest of the over-cap message");
    var n = s_build_return(7, 0, 0, 0);
    var w = s_wire();
    assert_eq(sys_write(a, w, n), n, "then the reply");
    assert_eq(dbus_session_call(b, 7), 0, "THE PIN: the reply is accepted after the drain");
    dbus_session_done();

    sys_close(a);
    sys_close(b);
    dbus_session_reset();
    return 0;
}

# Re-init used to zero the queue's count without closing what it held.
fn test_frame_init_closes_what_is_queued() {
    test_group("native: re-initialising the framer closes queued descriptors");
    var bus = s_pair();
    var a = bus & 0xFFFFFFFF;
    var b = (bus >> 32) & 0xFFFFFFFF;
    dbus_frame_init();
    assert_eq(dbus_frame_push_fd(b), 0, "a real descriptor queued");
    dbus_frame_init();
    var st = alloc(160);
    assert(sys_fstat(b, st) < 0, "THE PIN: re-init closed it");
    assert_eq(dbus_frame_fd_count(), 0, "and the queue is empty");
    sys_close(a);
    return 0;
}

# The pump swallowed every receive error but a disconnect, so a pump on
# a descriptor that had gone bad reported a quiet bus forever.
fn test_pump_reports_a_bad_descriptor() {
    test_group("native: pump_signals returns a receive error rather than 0 events");
    var bus = s_pair();
    var a = bus & 0xFFFFFFFF;
    var b = (bus >> 32) & 0xFFFFFFFF;
    dbus_session_reset();
    dbus_frame_init();
    assert_eq(dbus_native_pump_signals(b), 0, "an idle bus: 0 events");
    sys_close(b);
    assert_eq(dbus_native_pump_signals(b), -9, "THE PIN: a closed descriptor is -EBADF, not 0");
    assert_eq(dbus_native_pump_signals(2), 0, "a stdio number is never read as a bus");
    sys_close(a);
    dbus_session_reset();
    return 0;
}

# A process that closed stdin got its bus socket at 0, which the public
# layer read as "no bus".
fn test_socket_is_moved_above_stdio() {
    test_group("native: a bus socket never sits on a stdio number");
    var saved = sys_fcntl(0, dbus_socket_f_dupfd_cloexec(), 10);
    assert(saved >= 10, "stdin saved");
    sys_close(0);
    var p = s_pair();
    var lo = p & 0xFFFFFFFF;
    var hi = (p >> 32) & 0xFFFFFFFF;
    assert_eq(lo, 0, "with stdin closed, a new socket lands on 0");
    var moved = dbus_socket_above_stdio(lo);
    var st = alloc(160);
    var zero_open = sys_fstat(0, st);
    sys_dup2(saved, 0);                 # restore stdin before asserting
    sys_close(saved);
    assert(moved > 2, "THE PIN: it is moved above 2");
    assert(zero_open < 0, "and the original number closed");
    assert_eq(sys_fcntl(moved, 1, 0) & 1, 1, "close-on-exec kept");
    assert_eq(dbus_socket_above_stdio(moved), moved, "a socket above 2 is left alone");
    sys_close(moved);
    sys_close(hi);
    return 0;
}

# A stream that can no longer be framed is not written to: the call
# reports the fault without sending a request logind would act on.
fn test_corrupt_stream_is_not_written_to() {
    test_group("native: no request is sent on a stream that cannot be framed");
    var bus = s_pair();
    var a = bus & 0xFFFFFFFF;
    var b = (bus >> 32) & 0xFFFFFFFF;
    dbus_session_reset();
    dbus_frame_init();
    var junk = alloc(16);
    var i = 0;
    while (i < 16) { store8(junk + i, 88); i = i + 1; }       # 'X': no endian byte
    assert_eq(sys_write(a, junk, 16), 16, "16 bytes that are not a header");
    var n = s_build_return(1, 0, 0, 0);
    assert_eq(dbus_session_call(b, 1), -71, "the first call reads them: -EPROTO");
    s_peer_reads(a);                    # drop that call's request
    assert_eq(dbus_session_call(b, 2), -71, "a later call: the same errno");
    assert_eq(s_peer_reads(a), -11, "THE PIN: and it sent nothing");
    assert_eq(dbus_session_closed(), 0, "not a disconnect");
    assert(n > 0, "a well-formed request was ready to send");
    sys_close(a);
    sys_close(b);
    dbus_session_reset();
    return 0;
}

# ==== 1.1.2 re-verification: what the five reviewers found in the repairs ====

# A METHOD_RETURN to `rser` whose body is one string under signature `sig`.
fn s_build_str_reply(rser, sig, str) {
    dbus_marshal_begin(dbus_marshal_type_return(), 1, 5400);
    dbus_marshal_field_u32(dbus_marshal_f_replyser(), rser);
    var sg = s_sig(sig);
    dbus_marshal_field_sig(dbus_marshal_f_signature(), sg, strlen(sg));
    dbus_marshal_end_fields();
    var v = s_cstr(str);
    dbus_marshal_body_str(v, strlen(v));
    dbus_marshal_finish();
    dbus_unmarshal_set_limit(dbus_marshal_len());
    return dbus_marshal_len();
}

# A received device descriptor never lands on 0..2. The bus socket was
# moved above stdio; the descriptors it delivers were not, so in a
# consumer that closed stdin TakeDevice returned fd 0.
fn test_device_fd_is_never_stdio() {
    test_group("native: a received descriptor is moved above stdio");
    var bus = s_pair();
    var a = bus & 0xFFFFFFFF;
    var b = (bus >> 32) & 0xFFFFFFFF;
    var y = s_dev("/dev/null");
    var sess = s_cstr("/org/freedesktop/login1/session/_31");
    var fo = alloc(8);
    var ao = alloc(8);
    dbus_session_reset();
    dbus_frame_init();
    s_send_take_reply(a, 1, "hb", 1, 0, 0, y, y, 1);
    var saved = sys_fcntl(0, dbus_socket_f_dupfd_cloexec(), 10);
    sys_close(0);
    var rc = dbus_native_take_device(b, sess, 1, 3, fo, ao);
    var got = load64(fo);
    var zero_open = sys_fstat(0, alloc(160));
    sys_dup2(saved, 0);                 # restore stdin before asserting
    sys_close(saved);
    assert_eq(rc, 0, "the take succeeded with stdin closed");
    assert(got > 2, "THE PIN: the device is not handed out as fd 0");
    assert(zero_open < 0, "and nothing was left on 0");
    assert_eq(s_ino(got), s_ino(y), "it is the device");
    sys_close(got);
    sys_close(y);
    sys_close(a);  sys_close(b);
    dbus_session_reset();
    return 0;
}

# With SO_PASSPIDFD set, every receive carries an SCM_PIDFD descriptor.
# samvada never sets it; if anything does, the pidfd is still closed.
fn test_pidfd_is_closed() {
    test_group("native: an SCM_PIDFD descriptor is closed, not leaked");
    var bus = s_pair();
    var a = bus & 0xFFFFFFFF;
    var b = (bus >> 32) & 0xFFFFFFFF;
    var one = alloc(8);
    store64(one, 1);
    var on = sys_setsockopt(b, dbus_sys_sol_socket(), 76, one, 4);   # SO_PASSPIDFD
    if (on < 0) {
        assert(on < 0, "SO_PASSPIDFD unsupported by this kernel: nothing to leak");
        sys_close(a);  sys_close(b);
        return 0;
    }
    var y = s_dev("/dev/null");
    var sess = s_cstr("/org/freedesktop/login1/session/_31");
    var fo = alloc(8);
    var ao = alloc(8);
    dbus_session_reset();
    dbus_frame_init();
    var before = s_count_open();
    var n = s_build_pause(1, 3, "pause");
    var w = s_wire();
    sys_write(a, w, n);
    s_send_take_reply(a, 1, "hb", 1, 0, 0, y, y, 1);
    assert_eq(dbus_native_take_device(b, sess, 1, 3, fo, ao), 0, "the take succeeds");
    sys_close(load64(fo));
    assert_eq(s_count_open(), before, "THE PIN: no pidfd was left open");
    sys_close(y);
    sys_close(a);  sys_close(b);
    dbus_session_reset();
    return 0;
}

# A poll can report the socket readable with nothing to read — one
# MSG_OOB byte does it — and a blocking receive there ignored the
# deadline: with no SO_RCVTIMEO, the call hung for ever.
fn test_oob_byte_cannot_block_a_call() {
    test_group("native: a readable-but-empty socket does not block past the deadline");
    var bus = s_pair();
    var a = bus & 0xFFFFFFFF;
    var b = (bus >> 32) & 0xFFFFFFFF;
    dbus_session_reset();
    dbus_frame_init();
    var z = alloc(8);
    store8(z, 90);
    var sent = sys_sendto(a, z, 1, 1, 0, 0);    # MSG_OOB
    if (sent != 1) {
        assert(sent < 0, "MSG_OOB unsupported here (CONFIG_AF_UNIX_OOB): nothing to test");
        sys_close(a);  sys_close(b);
        return 0;
    }
    assert_eq(dbus_session_set_timeout_ms(300), 0, "a 300 ms budget, and no SO_RCVTIMEO");
    var n = s_build_return(1, 0, 0, 0);
    var t0 = dbus_session_now_ms();
    var rc = dbus_session_call(b, 7);
    var dt = dbus_session_now_ms() - t0;
    assert_eq(rc, -110, "THE PIN: the call ends at its deadline");
    var prompt = 0;
    if (dt < 2000) { prompt = 1; }
    assert_eq(prompt, 1, "promptly — it used to hang until killed");
    assert(n > 0, "a request was built");
    sys_close(a);  sys_close(b);
    dbus_session_reset();
    return 0;
}

# A clock that worked at t0 and fails mid-call turned the wait into a
# poll of ~24 days. It ends the call instead. And a clock that fails at
# t0 leaves the read backstop and SO_RCVTIMEO, which do end it.
fn test_clock_failure_cannot_disarm_the_bound() {
    test_group("native: a failing clock cannot switch the call's bound off");
    var bus = s_pair();
    var a = bus & 0xFFFFFFFF;
    var b = (bus >> 32) & 0xFFFFFFFF;
    dbus_session_reset();
    dbus_frame_init();
    var n = s_build_return(1, 0, 0, 0);
    dbus_session_fail_clock_after(1);           # t0 works, the wait's read fails
    assert_eq(dbus_session_call(b, 7), -110, "THE PIN: a mid-call clock failure is -ETIMEDOUT, not a 24-day poll");
    dbus_session_reset();
    dbus_frame_init();
    assert_eq(dbus_socket_set_recv_timeout(b, 0, 200000), 0, "SO_RCVTIMEO 200 ms");
    dbus_session_fail_clock_after(0);           # no clock at all: no deadline
    assert_eq(dbus_session_call(b, 8), -110, "with no clock, SO_RCVTIMEO ends the receive");
    assert(n > 0, "a request was built");
    sys_close(a);  sys_close(b);
    dbus_session_reset();
    return 0;
}

# The handshake, over a socketpair (1.1.2: it ran only against the real
# bus, so none of this had a test). Its reads are bounded by the
# deadline alone, and each failure has its own errno, not -13 for all.
fn s_sasl_case(text, n_extra_junk, budget, want, label) {
    var bus = s_pair();
    var a = bus & 0xFFFFFFFF;
    var b = (bus >> 32) & 0xFFFFFFFF;
    dbus_session_reset();
    dbus_frame_init();
    dbus_auth_reset();
    dbus_session_set_timeout_ms(budget);
    var buf = alloc(9000);
    var n = 0;
    if (text != 0) { n = t_put(buf, text); }
    var i = 0;
    while (i < n_extra_junk) { store8(buf + n + i, 65); i = i + 1; }
    n = n + n_extra_junk;
    if (n > 0) { sys_write(a, buf, n); }
    if (want == -104) { s_shut_wr(a); }
    assert_eq(dbus_session_sasl(b), want, label);
    sys_close(a);  sys_close(b);
    dbus_session_reset();
    return 0;
}

fn test_handshake_failures_are_told_apart() {
    test_group("native: the SASL handshake is deadline-bounded and says why it failed");
    s_sasl_case("DATA\r\nOK 0123456789abcdef0123456789abcdef\r\nAGREE_UNIX_FD\r\n", 0, 1000, 0,
      "a well-formed reply authenticates");
    s_sasl_case("REJECTED EXTERNAL\r\n", 0, 1000, -13, "REJECTED is -EACCES");
    s_sasl_case("DATA\r\nOK 0123456789abcdef0123456789abcdef\r\nERROR\r\n", 0, 1000, -13,
      "an ERROR after OK is -EACCES");
    s_sasl_case(0, 0, 200, -110, "THE PIN: a silent server is -ETIMEDOUT at the deadline, not -13");
    s_sasl_case("DATA\r\n", 0, 1000, -104, "a server that closes is -ECONNRESET, not -13");
    s_sasl_case(0, 8192, 1000, -71, "a buffer of garbage with no line end is -EPROTO, not -13");
    return 0;
}

# The Hello reply is checked: an `s` body naming a unique (':') name.
fn s_hello_case(sig, name, want, label) {
    var bus = s_pair();
    var a = bus & 0xFFFFFFFF;
    var b = (bus >> 32) & 0xFFFFFFFF;
    dbus_session_reset();
    dbus_frame_init();
    dbus_session_set_timeout_ms(500);
    var n = s_build_str_reply(1, sig, name);
    var w = s_wire();
    sys_write(a, w, n);
    assert_eq(dbus_session_hello(b), want, label);
    sys_close(a);  sys_close(b);
    dbus_session_reset();
    return 0;
}

fn test_hello_reply_is_checked() {
    test_group("native: the Hello reply must name a unique name");
    s_hello_case("s", ":1.42", 0, "':1.42' is accepted");
    assert_eq(dbus_session_closed(), 0, "and the connection is up");
    s_hello_case("s", "1.42", -71, "THE PIN: a name without ':' is -EPROTO");
    s_hello_case("o", "/org/x", -71, "an `o` body is -EPROTO");
    s_hello_case("s", ":", -71, "a bare ':' is -EPROTO");
    # A Hello that fails leaves no descriptor behind.
    var bus = s_pair();
    var a = bus & 0xFFFFFFFF;
    var b = (bus >> 32) & 0xFFFFFFFF;
    var x = s_dev("/dev/null");
    dbus_session_reset();
    dbus_frame_init();
    dbus_session_set_timeout_ms(300);
    var n = s_build_str_reply(1, "s", ":1.42");
    var w = s_wire();
    assert_eq(s_send_with_fd(a, w, 20, x), 20, "the first 20 bytes of the reply, with a descriptor");
    assert_eq(dbus_session_hello(b), -110, "the rest never comes");
    assert_eq(dbus_frame_fd_count(), 0, "THE PIN: the failed Hello closed what it had queued");
    assert(n > 20, "the reply was longer than what was sent");
    sys_close(x);
    sys_close(a);  sys_close(b);
    dbus_session_reset();
    return 0;
}

# GetSessionByPID's reply must be an `o` holding a valid object path —
# what the shim's sd_bus_message_read("o") checks.
fn s_gsp_case(sig, path, want, label) {
    var bus = s_pair();
    var a = bus & 0xFFFFFFFF;
    var b = (bus >> 32) & 0xFFFFFFFF;
    dbus_session_reset();
    dbus_frame_init();
    dbus_session_set_timeout_ms(500);
    var n = s_build_str_reply(1, sig, path);
    var w = s_wire();
    sys_write(a, w, n);
    var out = alloc(128);
    assert_eq(dbus_native_get_session_path(b, 1000, out, 128), want, label);
    sys_close(a);  sys_close(b);
    dbus_session_reset();
    return 0;
}

fn test_session_path_reply_is_checked() {
    test_group("native: GetSessionByPID must answer an object path");
    s_gsp_case("o", "/org/freedesktop/login1/session/_31", 0, "a session path is accepted");
    s_gsp_case("s", "/org/freedesktop/login1/session/_31", -71, "THE PIN: an `s` body is -EPROTO");
    s_gsp_case("o", "relative/path", -71, "an invalid path is -EPROTO");
    s_gsp_case("o", "/org/x/", -71, "a trailing slash is -EPROTO");
    return 0;
}

# The whole field array is validated before the reply loop reads it, so
# acceptance cannot depend on field order: the same junk field was
# accepted after DESTINATION and refused without it.
fn s_raw_reply(w, dest, junk) {
    # METHOD_RETURN, REPLY_SERIAL=1 [, DESTINATION][, junk field]
    var i = 0;
    while (i < 128) { store8(w + i, 0); i = i + 1; }
    store8(w + 0, 108); store8(w + 1, 2); store8(w + 2, 1); store8(w + 3, 1);
    store32(w + 8, 6001);
    var at = 16;
    store8(w + at, 5); store8(w + at + 1, 1); store8(w + at + 2, 117); store32(w + at + 4, 1);
    at = 24;
    if (dest != 0) {
        var dn = strlen(dest);
        store8(w + at, 6); store8(w + at + 1, 1); store8(w + at + 2, 115);
        store32(w + at + 4, dn);
        s_copy(w + at + 8, dest, dn);
        at = (at + 8 + dn + 1 + 7) & (0 - 8);
    }
    if (junk == 1) {                    # code 0, INVALID
        store8(w + at, 0); store8(w + at + 1, 1); store8(w + at + 2, 121);
        at = at + 8;
    }
    if (junk == 2) {                    # a second REPLY_SERIAL
        store8(w + at, 5); store8(w + at + 1, 1); store8(w + at + 2, 117); store32(w + at + 4, 99);
        at = at + 8;
    }
    if (junk == 3) {                    # a DESTINATION with no NUL terminator
        store8(w + at, 6); store8(w + at + 1, 1); store8(w + at + 2, 115);
        store32(w + at + 4, 3); store8(w + at + 8, 65); store8(w + at + 9, 65);
        store8(w + at + 10, 65); store8(w + at + 11, 66);
        at = at + 16;
    }
    var flen = at - 16;
    # fields_len excludes the trailing pad; every field here ends 8-aligned
    # or is padded by the next one, so `at` is the end.
    store32(w + 12, flen);
    store32(w + 4, 0);
    return at;
}

fn test_field_order_cannot_change_acceptance() {
    test_group("native: a malformed field array is refused whatever comes first");
    var bus = s_pair();
    var a = bus & 0xFFFFFFFF;
    var b = (bus >> 32) & 0xFFFFFFFF;
    var w = alloc(128);
    var me = s_cstr(":1.9");
    var k = 0;
    while (k < 4) {
        dbus_session_reset();
        dbus_frame_init();
        dbus_session_set_unique(me, 4);
        dbus_session_set_timeout_ms(300);
        var n = s_raw_reply(w, me, k);
        sys_write(a, w, n);
        s_build_return(1, 0, 0, 0);
        var rc = dbus_session_call(b, 1);
        var want = -110;
        if (k == 0) { want = 0; }
        assert_eq(rc, want, "DESTINATION first, then junk case k (0 = none: accepted)");
        if (rc == 0) { dbus_session_done(); }
        s_peer_reads(a);
        k = k + 1;
    }
    sys_close(a);  sys_close(b);
    dbus_session_reset();
    return 0;
}

# The send was outside every bound: a broker that stops reading blocked
# the call for ever once the send buffer filled. Every send now carries
# the call's deadline (1.1.2).
fn test_full_send_buffer_ends_at_the_deadline() {
    test_group("native: a send that cannot complete ends at the deadline");
    var bus = s_pair();
    var a = bus & 0xFFFFFFFF;
    var b = (bus >> 32) & 0xFFFFFFFF;
    dbus_session_reset();
    dbus_frame_init();
    # Fill b's send side: nobody reads a.
    var junk = alloc(4096);
    var i = 0;
    while (i < 4096) { store8(junk + i, 0); i = i + 1; }
    var filled = 0;
    var more = 1;
    while (more == 1) {
        var n = sys_sendto(b, junk, 4096, dbus_sys_msg_dontwait() | 16384, 0, 0);
        more = 0;
        if (n > 0) { filled = filled + n; more = 1; }
    }
    assert(filled > 0, "the send side is full");
    assert_eq(dbus_session_set_timeout_ms(300), 0, "a 300 ms budget");
    var m = s_build_return(1, 0, 0, 0);
    var t0 = dbus_session_now_ms();
    var rc = dbus_session_call(b, 7);
    var dt = dbus_session_now_ms() - t0;
    assert_eq(rc, -110, "THE PIN: -ETIMEDOUT at the deadline, not blocked for ever");
    var prompt = 0;
    if (dt < 2000) { prompt = 1; }
    assert_eq(prompt, 1, "promptly");
    assert_eq(dbus_session_closed(), 0, "nothing was sent, so the stream is intact");
    assert(m > 0, "a request was built");
    sys_close(a);  sys_close(b);
    dbus_session_reset();
    return 0;
}

fn main() {
    alloc_init();
    test_native_populates_the_same_table();
    test_ffi_arities_match_the_frozen_dispatch();
    test_serial_counter();
    test_error_name_mapping();
    test_error_map_matches_the_fixture_file();
    test_captured_error_reply_maps_to_eacces();
    test_release_control_has_no_signature_field();
    test_reply_fd_survives_the_call_path();
    test_forged_signal_cannot_impersonate_a_reply();
    test_reply_addressed_elsewhere_is_refused();
    test_absent_destination_is_permitted();
    test_preplanted_reply_cannot_answer_a_later_call();
    test_silent_peer_times_out_instead_of_hanging();
    test_expired_deadline_refuses_to_block();
    test_take_device_gets_its_own_descriptor();
    test_pumped_signal_descriptor_is_not_left_for_take_device();
    test_out_of_range_devnum_is_refused_not_truncated();
    test_repeating_paths_do_not_grow_the_heap();
    test_sasl_reader_survives_hostile_input();
    test_disconnect_is_a_state();
    test_drop_mid_call_is_connreset();
    test_logind_restart_is_survived();
    test_pause_resume_around_take_device();
    test_pause_needing_an_ack_is_drained_not_acked();
    test_stray_reply_descriptors_are_closed();
    test_logind_calls_do_not_grow_the_heap();
    test_sustained_fd_traffic_is_bounded();
    test_declared_128mib_fails_both_paths();
    test_unparseable_message_cannot_plant_a_descriptor();
    test_take_device_holds_the_reply_to_its_contract();
    test_bus_peer_traffic_cannot_fail_a_call();
    test_drain_does_not_strand_the_watermark();
    test_frame_init_closes_what_is_queued();
    test_pump_reports_a_bad_descriptor();
    test_socket_is_moved_above_stdio();
    test_corrupt_stream_is_not_written_to();
    test_device_fd_is_never_stdio();
    test_pidfd_is_closed();
    test_oob_byte_cannot_block_a_call();
    test_clock_failure_cannot_disarm_the_bound();
    test_handshake_failures_are_told_apart();
    test_hello_reply_is_checked();
    test_session_path_reply_is_checked();
    test_field_order_cannot_change_acceptance();
    test_full_send_buffer_ends_at_the_deadline();
    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
