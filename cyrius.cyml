[package]
name = "samvada"
version = "${file:VERSION}"
description = "samvada — Cyrius dbus client for the AGNOS suite (logind / system-bus / message marshalling)"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/samvada"
language = "cyrius"
cyrius = "6.7.18"

# v0.x ships a smoke entry point only; the API surface (lib.cyr +
# samvada.cyr) gets populated when the C shim lands in v0.2.0.
[build]
entry = "src/main.cyr"
test = "src/test.cyr"
output = "samvada"

# `[lib]` feeds `cyrius distlib` — module order matters when
# samvada grows real modules. v0.1.0 has only a placeholder fn so
# the bundle is intentionally trivial.
# N6 cutover (0.11.0): the native dbus modules ship in the bundle.
# Until 0.10.0 they were built and tested but deliberately excluded,
# so `dist/samvada.cyr`'s exported set stayed frozen at 26 fns while
# the backend was under construction. Shipping them IS the cutover —
# a consumer can now reach a working dbus client with no C shim and
# no libsystemd, via `samvada_native_init()`.
#
# Order matters: each module is included in dependency order, and
# samvada.cyr last because it is what dispatches through the table.
#
# 1.1.1 (A-6): src/visibility.cyr comes FIRST. It holds only a bare
# `private`, which makes the whole bundle private-by-default, so a
# consumer can name only the eight `public fn`s. It is listed here and
# nowhere else — see the file.
[lib]
modules = [
    "src/visibility.cyr",
    "src/samvada_ffi.cyr",
    "src/dbus_sys.cyr",
    "src/dbus_frame.cyr",
    "src/dbus_socket.cyr",
    "src/dbus_auth.cyr",
    "src/dbus_marshal.cyr",
    "src/dbus_unmarshal.cyr",
    "src/dbus_session.cyr",
    "src/samvada.cyr",
]

[deps]
stdlib = ["string", "fmt", "alloc", "io", "vec", "str", "syscalls", "assert", "tagged", "fnptr"]
