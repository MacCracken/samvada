# @internal — native-dbus low-level syscall + SCM_RIGHTS layer
# dbus_sys.cyr — the first module of the native Cyrius dbus backend
# (N1, ADR-0003). It does exactly one thing: receive bytes from a unix
# socket together with every file descriptor riding on them as
# `SCM_RIGHTS` ancillary data — the job libsystemd does for the C
# shim. Every native receive goes through dbus_sys_recv.
#
# Why this is first: proposal 0001 rates fd passing the only
# Low-confidence module of the pivot, and the fallback is cheap
# ONLY while nothing is built on top of it. So it is proven before
# a single dbus byte exists.
#
# Not derived from the kernel ABI by hand — diffed against working
# in-language implementations:
#   kybernet/src/lib/notify.cyr:182-235  (receive walk, MSG_CTRUNC + bounds)
#   argonaut/src/notify.cyr:176-207      (receive walk, MSG_DONTWAIT)
#   cyrius-doom/src/platform/wayland/client.cyr:206-228 (send side)
# Every layout constant below was then re-confirmed against glibc
# headers on x86_64 (offsetof/sizeof/CMSG_*), and is pinned by
# tests/dbus_sys.tcyr (test_dbus_sys_layout) so a silent ABI drift
# fails at CPU-test time.
#
# NOT REENTRANT, by construction. `var buf[N]` inside a fn is
# STATIC data in Cyrius, not stack — consecutive calls share and
# clobber it. samvada is single-threaded by design (see
# public-api.md §Threading), so the scratch below is file-scope and
# reused deliberately rather than accidentally.

# ---- struct layouts (LP64; identical on x86_64 and aarch64) ----
# struct iovec  { void *iov_base@0; size_t iov_len@8; }            16 bytes
# struct msghdr { name@0 namelen@8 iov@16 iovlen@24
#                 control@32 controllen@40 flags@48 }              56 bytes
# struct cmsghdr{ size_t cmsg_len@0; int level@8; int type@12; }    16 bytes
#                 followed by data at +16
fn dbus_sys_iovec_size()    { return 16; }
fn dbus_sys_msghdr_size()   { return 56; }
fn dbus_sys_cmsghdr_size()  { return 16; }
fn dbus_sys_cmsg_data_off() { return 16; }

# CMSG_LEN(4) = cmsghdr(16) + 4 = 20, CMSG_SPACE(4) = 16 + align8(4) = 24:
# the one-descriptor layout. The receive reserves room for 253 (below);
# these two are the ABI the tests' senders are built on, and pinned.
fn dbus_sys_cmsg_len_1fd()   { return 20; }
fn dbus_sys_cmsg_space_1fd() { return 24; }

# ---- constants ----
fn dbus_sys_af_unix()     { return 1; }
fn dbus_sys_sock_stream() { return 1; }
fn dbus_sys_sol_socket()  { return 1; }
fn dbus_sys_scm_rights()  { return 1; }
# SCM_PIDFD (Linux 6.5): with SO_PASSPIDFD set on the socket, every
# receive carries a pidfd for the sender. samvada never sets it; if
# anything ever does, the descriptor is still ours to close (1.1.2).
fn dbus_sys_scm_pidfd()   { return 4; }
fn dbus_sys_msg_ctrunc()  { return 8; }
# MSG_CMSG_CLOEXEC — the received fd arrives with FD_CLOEXEC already
# set, so it cannot leak across an execve. This is the receive-side
# counterpart of the F_DUPFD_CLOEXEC fix in the C shim (0.5.1 MED-3);
# doing it here means the native backend never has the window the
# shim had to close by hand.
fn dbus_sys_msg_cmsg_cloexec() { return 1073741824; }

# MSG_DONTWAIT — per-CALL non-blocking. Deliberately not O_NONBLOCK
# on the socket: that is socket state and would make every
# request/reply read non-blocking too, silently turning a normal
# method call into a busy-wait.
fn dbus_sys_msg_dontwait() { return 64; }

# ---- syscall numbers: the stdlib's, never our own ----
# sendmsg/recvmsg are NOT in the same numeric slot across arches, and
# getting this wrong is silent: on aarch64, 46 is `ftruncate`, so a
# hardcoded x86_64 number does not fail — it truncates a file to a
# garbage length. (cyrius-doom hardcodes `WL_SYS_SENDMSG = 46` with no
# aarch64 branch and carries exactly that latent bug.)
#
# So the receive goes through the stdlib's `sys_recvmsg`, which
# resolves SYS_RECVMSG per arch. Until 1.1.0 this file also kept a
# native aarch64 212 under `#ifdef CYRIUS_ARCH_AARCH64` for the tests
# to assert against. It is gone: cyrius 6.7.12+ rewrites x86 numbers
# on ELF-aarch64 through a compat chain, so which number the stdlib
# spells is the compiler's business, and only behaviour says the
# right call ran — tests/dbus_sys.tcyr's SCM_RIGHTS round trip.

# ---- how many descriptors one receive can deliver (1.1.2) ----
# SCM_MAX_FD (include/net/scm.h): the most descriptors one sendmsg can
# carry. A unix stream receive stops after the first segment that
# carried descriptors (net/unix/af_unix.c, unix_stream_read_generic:
# `if (scm.fp) break;`), so 253 is also the most one recvmsg can
# deliver, and a control buffer of CMSG_SPACE(253 fds) never truncates
# an SCM_RIGHTS payload.
#
# Until 1.1.2 the buffer held ONE descriptor (24 bytes). A message with
# three or more truncated, and the truncation branch threw the message's
# BYTES away and answered -EPROTO, which the session layer correctly
# reads as a disconnect — so any bus peer that could send samvada a
# signal with three descriptors on it closed samvada's connection.
fn dbus_sys_fd_max()    { return 253; }
fn dbus_sys_ctrl_size() { return 1032; }      # 16 + align8(253 * 4)

# ---- scratch (file-scope; see the non-reentrancy note above) ----
var _dbus_iov  = 0;   # 16 bytes
var _dbus_mh   = 0;   # 56 bytes
var _dbus_ctrl = 0;   # dbus_sys_ctrl_size() bytes
# The last receive's descriptors, in arrival order: every one is OURS
# (the kernel installed it) and the caller must queue or close each.
var _dbus_rx      = 0;   # dbus_sys_fd_max() * 8 bytes
var _dbus_rxn     = 0;
var _dbus_rxtrunc = 0;   # the kernel dropped ancillary data (MSG_CTRUNC)
var _dbus_sys_ready = 0;

fn _dbus_sys_init() {
    if (_dbus_sys_ready != 0) { return 0; }
    _dbus_iov = alloc(dbus_sys_iovec_size());
    if (_dbus_iov == 0) { return -12; }
    _dbus_mh = alloc(dbus_sys_msghdr_size());
    if (_dbus_mh == 0) { return -12; }
    _dbus_ctrl = alloc(dbus_sys_ctrl_size());
    if (_dbus_ctrl == 0) { return -12; }
    _dbus_rx = alloc(dbus_sys_fd_max() * 8);
    if (_dbus_rx == 0) { return -12; }
    _dbus_sys_ready = 1;
    return 0;
}

fn _dbus_zero(p, n) {
    var i = 0;
    while (i < n) { store64(p + i, 0); i = i + 8; }
    return 0;
}

fn dbus_sys_rx_count()     { return _dbus_rxn; }
fn dbus_sys_rx_truncated() { return _dbus_rxtrunc; }

fn dbus_sys_rx_fd(i) {
    if (i < 0) { return (0 - 1); }
    if (i >= _dbus_rxn) { return (0 - 1); }
    return load64(_dbus_rx + i * 8);
}

fn _dbus_rx_add(fd) {
    if (_dbus_rxn >= dbus_sys_fd_max()) {
        sys_close(fd);                        # cannot be held: never leak it
        return 0;
    }
    store64(_dbus_rx + _dbus_rxn * 8, fd);
    _dbus_rxn = _dbus_rxn + 1;
    return 0;
}

# Collect every SCM_RIGHTS descriptor from a control buffer into the rx
# array, in order, and return how many there are.
#
# Split out from dbus_sys_recv deliberately: the syscall half cannot be
# driven through its own error paths from a test (the kernel validates
# ancillary data before we ever see it, so a forged cmsg never arrives),
# while the PARSING half is a pure byte transform and every guard in it
# is reachable with a hand-built buffer.
#
# It walks every cmsg (CMSG_NXTHDR), not just the first: with SO_PASSCRED
# or SO_PASSSEC set on the socket, SCM_CREDENTIALS or SCM_SECURITY comes
# FIRST and the descriptors second; with SO_PASSPIDFD an SCM_PIDFD
# carries a descriptor of its own, which is closed here. A header that claims less than
# itself, or more than the kernel filled, ends the walk — nothing after
# it can be located.
#
#   ctrl     — the control buffer recvmsg filled
#   ctrllen  — msghdr.msg_controllen AFTER the call
#
#   returns  >= 0  descriptors collected (dbus_sys_rx_fd(0..n-1))
#            -22   null buffer
#            -12   the receive scratch could not be allocated
fn dbus_sys_parse_rights(ctrl, ctrllen) {
    var rc = _dbus_sys_init();
    if (rc < 0) { return rc; }
    _dbus_rxn = 0;
    if (ctrl == 0) { return -22; }
    var hdr = dbus_sys_cmsghdr_size();
    var at = 0;
    var more = 1;
    while (more == 1) {
        more = 0;
        var room = ctrllen - at;
        if (room >= hdr) {
            var clen = load64(ctrl + at);
            var ok = 1;
            if (clen < hdr)  { ok = 0; }
            if (clen > room) { ok = 0; }
            if (ok == 1) {
                var level = load32(ctrl + at + 8);
                var ctype = load32(ctrl + at + 12);
                var rights = 0;
                if (level == dbus_sys_sol_socket()) {
                    if (ctype == dbus_sys_scm_rights()) { rights = 1; }
                    if (ctype == dbus_sys_scm_pidfd()) { rights = 2; }
                }
                if (rights != 0) {
                    # Each fd is an int32: read the low 32 bits and
                    # sign-extend, so a kernel-impossible negative cannot
                    # read as a huge positive fd. load32, NOT load64: the
                    # last fd ends exactly at clen. A pidfd is closed at
                    # once — no message owns it.
                    var off = at + dbus_sys_cmsg_data_off();
                    while (off + 4 <= at + clen) {
                        var x = load32(ctrl + off);
                        var neg = x & 0x80000000;
                        if (neg != 0) { x = x - 0x100000000; }
                        if (x >= 0) {
                            if (rights == 1) { _dbus_rx_add(x); }
                            if (rights == 2) { sys_close(x); }
                        }
                        off = off + 4;
                    }
                }
                at = at + ((clen + 7) & (0 - 8));
                more = 1;
            }
        }
    }
    return _dbus_rxn;
}

# Receive up to `buflen` bytes into `buf`, with every descriptor that
# accompanies them.
#
#   returns  >= 0  bytes received; the descriptors are dbus_sys_rx_fd(0
#                  .. dbus_sys_rx_count() - 1), and the caller owns them
#            -22   null buffer, or buflen <= 0
#            -12   the receive scratch could not be allocated
#            other < 0  negative errno from recvmsg (no descriptors)
#
# MSG_CTRUNC no longer discards the bytes (1.1.2). The bytes are real
# and already consumed from the socket: dropping them desynchronised the
# stream. The descriptors that fit are delivered like any others, and
# dbus_sys_rx_truncated() says the set is INCOMPLETE, so the caller can
# refuse to treat it as a message's descriptors. With CMSG_SPACE(253)
# reserved it is reachable only when another cmsg shares the buffer.
#
# MSG_CMSG_CLOEXEC rides on every call: a received descriptor never
# leaks across an execve, even between this call and the caller's.
fn dbus_sys_recv(fd, buf, buflen, flags) {
    if (buf == 0)      { return -22; }
    if (buflen <= 0)   { return -22; }
    var rc = _dbus_sys_init();
    if (rc < 0) { return rc; }
    _dbus_rxn = 0;
    _dbus_rxtrunc = 0;

    store64(_dbus_iov + 0, buf);
    store64(_dbus_iov + 8, buflen);
    # Only the first cmsghdr is cleared: the walk reads no further than
    # the msg_controllen the kernel reports, and every byte inside it the
    # kernel wrote. Clearing all 1032 bytes cost ~150 ns on every receive,
    # an idle 60 Hz pump included (measured, 1.1.2).
    _dbus_zero(_dbus_ctrl, dbus_sys_cmsghdr_size());
    _dbus_zero(_dbus_mh, dbus_sys_msghdr_size());
    store64(_dbus_mh + 16, _dbus_iov);
    store64(_dbus_mh + 24, 1);
    store64(_dbus_mh + 32, _dbus_ctrl);
    store64(_dbus_mh + 40, dbus_sys_ctrl_size());

    var n = sys_recvmsg(fd, _dbus_mh, dbus_sys_msg_cmsg_cloexec() | flags);
    if (n < 0) { return n; }

    # The kernel reports how much of the buffer it filled; never walk
    # past what we reserved, whatever it says.
    var ctrllen = load64(_dbus_mh + 40);
    if (ctrllen > dbus_sys_ctrl_size()) { ctrllen = dbus_sys_ctrl_size(); }
    if (ctrllen < 0) { ctrllen = 0; }
    dbus_sys_parse_rights(_dbus_ctrl, ctrllen);

    var mflags = load32(_dbus_mh + 48);
    var trunc = mflags & dbus_sys_msg_ctrunc();
    if (trunc != 0) { _dbus_rxtrunc = 1; }
    return n;
}
