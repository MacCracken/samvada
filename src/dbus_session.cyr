# @internal — native-dbus logind session layer
# dbus_session.cyr — the six logind calls, natively.
#
# This is the module that has to match the FROZEN FFI SHAPES, and
# that constraint is not cosmetic. src/samvada.cyr dispatches with
# exactly:
#
#   fncall1(bus_slot, bus_out)
#   fncall4(sp_slot,  bus, pid, buf, len)
#   fncall2(tc_slot,  bus, sess)
#   fncall6(td_slot,  bus, sess, major, minor, fd_out, active_out)
#   fncall4(rd_slot,  bus, sess, major, minor)
#   fncall1(pump_slot, bus)
#   fncall1(close_slot, bus)
#
# So every native fn below is written to the C shim's ABI, INCLUDING
# the vestigial leading `bus` argument and the C-style out-pointer
# pairs — shapes that would never be chosen for a Cyrius-native
# design. Getting one wrong is a silent crash through fncallN, not a
# compile error, which is why the arities are pinned by tests.
#
# In native mode the "bus handle" is simply the connected socket fd.
#
# SESSION SELECTION — the open question this milestone had to
# settle, and the answer is DOCUMENT, not validate. GetSessionByPID
# returns the CALLER's session, which is not necessarily seated: on
# the development host it returns a `Seat=""` session while seat0
# belongs to the display manager, so TakeDevice cannot get DRM
# master there no matter what. Validating the session's `Seat`
# property would require org.freedesktop.DBus.Properties, which
# ADR-0003's scope fence defers past 1.0 — and widening the fence to
# produce a better error message is a bad trade. samvada therefore
# takes the caller's own session and surfaces logind's error
# verbatim. See public-api.md.
#
# SESSION PATH ESCAPING — logind returns paths like
# `/org/freedesktop/login1/session/_32`, where `_32` is the
# hex-escaped ASCII of '2'. samvada passes the path through
# OPAQUELY: it is only ever echoed back as a method target, never
# parsed or compared, so no unescaping is needed. Anything that
# starts comparing session ids must implement it first.

fn dbus_session_max_serial() { return 4294967295; }

var _dbs_serial = 0;
var _dbs_last_err = 0;      # last ERROR_NAME mapped errno

# ---- our own unique name, and why it is worth storing ----
# The bus assigns it in the Hello reply, which samvada used to read
# and throw away. Keeping it is what makes a provenance check
# possible at all: without it there is nothing to compare a reply's
# DESTINATION against.
#
# A word on what canNOT be checked. The obvious guard — "require
# SENDER to be org.freedesktop.login1" — is WRONG and would reject
# every genuine reply. The broker rewrites SENDER to the sender's
# UNIQUE id on every message it forwards (message_stitch_sender), so
# a real logind reply arrives with SENDER=":1.5". Verified against
# all four captured logind replies in tests/fixtures/dbus/: every
# one carries a unique name, never the well-known one. Only the bus
# driver is special-cased, sending as "org.freedesktop.DBus".
#
# Pinning logind's unique name on first use was considered and
# REJECTED: logind can restart and come back with a different id,
# which would strand a long-lived consumer with a stale pin and fail
# every subsequent call. That is a self-inflicted availability bug
# traded for very little — the DESTINATION check below already
# refuses anything not addressed to us.
var _dbs_uniq  = 0;         # copied out of the frame buffer, which moves
var _dbs_uniqn = 0;

fn dbus_session_unique_len() { return _dbs_uniqn; }
fn dbus_session_unique()     { return _dbs_uniq; }

# Copy, never alias: the name arrives inside the framer's buffer and
# dbus_frame_advance / maybe_compact will move or overwrite it.
fn dbus_session_set_unique(p, n) {
    if (p == 0)  { return -22; }
    if (n <= 0)  { return -22; }
    if (n > 255) { return -22; }          # dbus caps any bus name at 255
    if (_dbs_uniq == 0) { _dbs_uniq = alloc(256); }
    if (_dbs_uniq == 0) { return -12; }
    var i = 0;
    while (i < n) { store8(_dbs_uniq + i, load8(p + i)); i = i + 1; }
    _dbs_uniqn = n;
    return 0;
}

fn _dbs_bytes_eq(a, an, b, bn) {
    if (an != bn) { return 0; }
    var i = 0;
    while (i < an) {
        var x = load8(a + i);
        var y = load8(b + i);
        if (x != y) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Pure, so the wrap is reachable from a test. Driving
# next_serial() to the u32 ceiling would take four billion calls;
# this makes the one branch that matters a one-line assertion.
fn dbus_session_wrap_serial(n) {
    if (n > dbus_session_max_serial()) { return 1; }
    if (n == 0) { return 1; }
    return n;
}

fn dbus_session_next_serial() {
    # Wrap within u32 and never yield 0, which the spec reserves.
    _dbs_serial = dbus_session_wrap_serial(_dbs_serial + 1);
    return _dbs_serial;
}

fn dbus_session_reset() {
    _dbs_serial = 0;
    _dbs_last_err = 0;
    _dbs_uniqn = 0;
    _dbs_timeout_ms = 25000;
    return 0;
}

fn dbus_session_last_error() { return _dbs_last_err; }

# ---- error mapping ----
# The frozen API promises "sd-bus errno pass-through", so the native
# backend has to reproduce libsystemd's dbus-name -> errno mapping
# or consumers branching on magnitudes break. This is the
# error-parity contract N6 verifies; the names here are the ones
# samvada's own calls can actually produce.
fn _dbs_name_is(p, n, lit) {
    if (n != strlen(lit)) { return 0; }
    var i = 0;
    while (i < n) {
        if (load8(p + i) != load8(lit + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn dbus_session_map_error(p, n) {
    if (_dbs_name_is(p, n, "org.freedesktop.DBus.Error.AccessDenied") != 0) { return -13; }
    if (_dbs_name_is(p, n, "org.freedesktop.login1.NotInControl") != 0) { return -22; }
    if (_dbs_name_is(p, n, "org.freedesktop.login1.DeviceNotTaken") != 0) { return -22; }
    if (_dbs_name_is(p, n, "org.freedesktop.DBus.Error.InvalidArgs") != 0) { return -22; }
    if (_dbs_name_is(p, n, "org.freedesktop.DBus.Error.NoSuchDevice") != 0) { return -19; }
    if (_dbs_name_is(p, n, "org.freedesktop.DBus.Error.UnixProcessIdUnknown") != 0) { return -3; }
    if (_dbs_name_is(p, n, "org.freedesktop.DBus.Error.ServiceUnknown") != 0) { return -2; }
    if (_dbs_name_is(p, n, "System.Error.EBUSY") != 0) { return -16; }
    return -5;                                   # -EIO for anything unmapped
}

# ---- the clock ----
# clock_gettime is not in the stdlib, so the arch numbers are pinned
# here under the same house exception as dbus_sys.cyr's recvmsg:
# 228 on x86_64, 113 on aarch64 (asm-generic). Verified on the host,
# not copied from a header — as was struct timespec's shape, which
# is 16 bytes with tv_sec at +0 and tv_nsec at +8.
fn dbus_session_clock_nr() {
    #ifdef CYRIUS_ARCH_AARCH64
    return 113;
    #endif
    return 228;
}

# CLOCK_MONOTONIC, deliberately: a deadline must not be extendable
# (or fired early) by an NTP step or a suspend/resume adjusting the
# wall clock.
fn dbus_session_clock_monotonic() { return 1; }

var _dbs_ts = 0;

# Monotonic milliseconds, or a negative errno if the clock fails.
fn dbus_session_now_ms() {
    if (_dbs_ts == 0) { _dbs_ts = alloc(16); }
    if (_dbs_ts == 0) { return -12; }
    store64(_dbs_ts + 0, 0);
    store64(_dbs_ts + 8, 0);
    var rc = syscall(dbus_session_clock_nr(),
      dbus_session_clock_monotonic(), _dbs_ts);
    if (rc < 0) { return rc; }
    var sec  = load64(_dbs_ts + 0);
    var nsec = load64(_dbs_ts + 8);
    return sec * 1000 + nsec / 1000000;
}

# Matches DBUS_DEFAULT_TIMEOUT / sd-bus's BUS_DEFAULT_TIMEOUT, so
# samvada gives up on the same schedule as every other bus client.
var _dbs_timeout_ms = 25000;

fn dbus_session_timeout_ms() { return _dbs_timeout_ms; }

# @internal, and it exists for a specific reason: without it the
# deadline branch below could only be reached by a test willing to
# wait 25 seconds, and an untestable guard is how AUDIT-4 shipped.
# dbus_session_reset() restores the default so no test can leak a
# short timeout into another.
#
# CORRECTION (A-6): an earlier version of this comment claimed it was
# "not reachable from the public API". That is false and was worth
# fixing rather than leaving. dist/samvada.cyr exports 198 functions
# against a documented public surface of eight — `@internal` is a
# comment with no mechanical meaning — so a consumer CAN call this
# and set every subsequent call's budget to 0. It is in the same
# position as dbus_frame_close_fds and the whole dbus_unmarshal_*
# surface, which is the premise AUDIT-1 already rests on. The real
# contract is now stated in public-api.md instead of denied here.
# One day, well past any bus's patience and far below the point where
# `t0 + timeout` could overflow i64. The cap is not cosmetic: the
# deadline is armed as `deadline = t0 + timeout` and gated on
# `deadline > 0`, so a large enough value wraps the sum NEGATIVE and
# SILENTLY DISARMS the guard — it switches itself off instead of
# firing. A bound that can be turned off by its own argument is not a
# bound.
fn dbus_session_timeout_max_ms() { return 86400000; }

fn dbus_session_set_timeout_ms(ms) {
    if (ms < 0) { return -22; }
    if (ms > dbus_session_timeout_max_ms()) { return -22; }
    _dbs_timeout_ms = ms;
    return 0;
}

# -EAGAIN and -EWOULDBLOCK are the same value on Linux (11), which
# is what SO_RCVTIMEO reports when the receive budget expires.
fn dbus_session_eagain() { return -11; }

# ONE cached scratch block, instead of an alloc() per call and per
# message.
#
# alloc() is a bump allocator that NEVER frees, and pump_signals runs
# at 60 Hz inside a compositor for days. Measured before this change,
# on the IDLE path where nothing is even read:
#
#   pump x100000 heap delta = 800000 bytes
#   per idle pump           = 8 bytes
#   per DAY at 60 Hz        = 41472000 bytes     (~41 MB)
#
# Unbounded, and invisible to every test because a test process exits
# long before it matters.
#
# Offsets are fixed and documented so two users cannot alias. Each is
# a scratch OUT-parameter whose value dies within a few statements;
# none is live across another's use.
#   +0,+8  dest_ok       — find_field out, str_at out
#   +16    drop_fds_of   — find_field out
#   +24    reply loop    — find_field sig out
#   +32    reply loop    — ERROR name ptr
#   +40    reply loop    — received fd
#   +48    pump_signals  — received fd
var _dbs_scr = 0;
fn _dbs_scratch() {
    if (_dbs_scr == 0) { _dbs_scr = alloc(64); }
    return _dbs_scr;
}

# Is this reply addressed to US?
#
# This mirrors sd-bus's async guard (sd-bus.c:2790,
# `m->destination && bus->unique_name && !streq(...)` -> drop) and
# is deliberately the ONLY provenance check samvada makes, because
# it is the only one that is both correct and stateless. See the
# note on SENDER above for the two checks that look attractive and
# are not.
#
# Permissive when the field is ABSENT, exactly as sd-bus is. That is
# not laxity, it is required: the Hello reply is matched BEFORE the
# bus has told us our own name, so there is nothing to compare
# against yet — _dbs_uniqn is still 0 and this returns 1.
fn dbus_session_dest_ok(p) {
    if (_dbs_uniqn <= 0) { return 1; }        # name not learned yet
    var sc = _dbs_scratch();
    var off = dbus_unmarshal_find_field(p, dbus_marshal_f_dest(), sc);
    if (off == dbus_unmarshal_notfound()) { return 1; }
    if (off < 0) { return 0; }                # malformed field array
    var n = dbus_unmarshal_str_at(p, off, sc + 8);
    if (n < 0) { return 0; }
    return _dbs_bytes_eq(load64(sc + 8), n, _dbs_uniq, _dbs_uniqn);
}

# ---- session-path validation ----
# EVERY native fn that accepts a session path must call this, and the
# reason is a lesson learned twice in one release.
#
# These fns ship in dist/samvada.cyr — 198 exported functions against
# a documented public surface of seven — so a consumer we do not
# control reaches them directly. strlen(sess) on a null pointer is a
# segfault, not an error code. The PUBLIC path survives only because
# samvada_init happens to allocate _samvada_sess as a zeroed buffer,
# so it is never null there: luck, not design, which is the exact
# shape AUDIT-1 was filed under.
#
# It was first applied to take_device and release_device only. The
# A-6 lane then found dbus_native_take_control(0, 0) still exiting
# 139, because take_control and release_control take a session path
# too. Measured: exit=139 before, -22 after. Hence ONE predicate that
# all four call, rather than four copies of a guard that can be
# half-applied again.
fn dbus_session_sess_ok(sess) {
    if (sess == 0) { return 0; }
    return 1;
}

# ---- device-number validation ----
# The C shim gates both TakeDevice and ReleaseDevice on
# devnum_ok(v) == (v >= 0 && v <= UINT32_MAX) BEFORE the 64->32
# narrowing, added at 0.5.1 as audit MED-2 because the cast
# truncated silently. CLAUDE.md says in as many words that a
# PURE_CYRIUS backend must RE-SUPPLY that check.
#
# It did not. The native backend checked only `v < 0`, so a major of
# 2^32 + 1 was marshalled by _dbm_u32 — which writes the low four
# bytes and nothing else — as major 1. samvada would have opened a
# DIFFERENT DEVICE than the consumer asked for, silently, and
# returned success. The differential harness never caught it because
# it compares error codes for in-range values only.
fn dbus_session_devnum_ok(v) {
    if (v < 0)          { return 0; }
    if (v > 4294967295) { return 0; }         # UINT32_MAX
    return 1;
}

# Discard the descriptors that arrived with a message we are about
# to throw away.
#
# There is ONE fd queue and it had TWO fill sites — the reply loop
# and pump_signals — but only ONE drain site, take_device, which
# pops FIFO. logind's ResumeDevice signal carries an fd, and
# pump_signals never surfaces signals (ADR-0004), so that descriptor
# sat at the head of the queue until the next take_device collected
# it BY MISTAKE. Measured before this fix, with a signal fd and a
# reply fd both queued:
#
#   signal fd X inode = 3201875
#   reply  fd Y inode = 3201877
#   take_fd() inode   = 3201875   <-- the SIGNAL's fd
#
# A compositor asking for an input device would have been handed the
# DRM descriptor from an earlier resume. Exactly AUDIT-4's shape: an
# index into a queue whose fill path was never exercised.
#
# The fix is the one the wire format already specifies: a message
# declares its own descriptor count in UNIX_FDS, and SCM_RIGHTS
# descriptors arrive in stream order, so discarding a message means
# discarding exactly that many from the head.
fn dbus_session_drop_fds_of(p) {
    var sc = _dbs_scratch() + 16;
    var off = dbus_unmarshal_find_field(p, dbus_marshal_f_unixfds(), sc);
    if (off < 0) { return 0; }                # absent or malformed: none
    var n = dbus_unmarshal_u32(p, off);
    if (n <= 0) { return 0; }
    # A lying UNIX_FDS must not turn into an unbounded close loop.
    var cap = dbus_frame_fdq_cap();
    if (n > cap) { n = cap; }
    var closed = 0;
    var i = 0;
    while (i < n) {
        var fd = dbus_frame_take_fd();
        if (fd >= 0) {
            sys_close(fd);
            closed = closed + 1;
        }
        i = i + 1;
    }
    return closed;
}

# ---- the call/reply cycle ----
# Send whatever the marshaller has built, then read until the reply
# whose REPLY_SERIAL matches. Unsolicited traffic is DISCARDED, not
# treated as an error: the bus emits NameAcquired on the connect
# path before any match rule exists, and a reader that treats the
# first message as its answer gets the signal instead.
#
# Returns 0 on a METHOD_RETURN (whose message is left addressable
# via dbus_frame_base()), or a negative errno on an ERROR reply or
# transport failure.
fn dbus_session_call(fd, serial) {
    # SEND-TIME WATERMARK, captured before the request goes out.
    # Bytes already sitting in the buffer cannot be a reply to a
    # request that has not been sent yet — no peer can answer before
    # it receives. sd-bus gets this for free by remembering the
    # receive queue's length at send time (sd-bus.c:2448); samvada's
    # framer is a byte buffer, so the equivalent is the count of
    # bytes already pending, decremented as they are consumed.
    #
    # A COUNT, not an offset, on purpose: dbus_frame_maybe_compact()
    # slides the buffer contents and would invalidate any absolute
    # position. The count of outstanding bytes survives it.
    #
    # This closes the pre-plant window that sequential serials would
    # otherwise leave open: an attacker who can get bytes into the
    # buffer early cannot have them answer a later call.
    # Refuse to transmit a message the marshaller could not build.
    # Without this, an over-long or negative length poisons the buffer
    # and dbus_marshal_len() still reports a total — which would put
    # adjacent heap on the wire.
    if (dbus_marshal_bad() != 0) { return -22; }

    var stale = dbus_frame_have();

    # WALL-CLOCK DEADLINE for the whole call. SO_RCVTIMEO (armed at
    # connect) bounds a single receive, but not the call: a peer that
    # dribbles one byte per read satisfies every individual timeout
    # while the call runs unbounded. The deadline is what actually
    # closes that, and it is why the bound is a clock and not the
    # pre-existing "64 spins", which counts MESSAGES.
    #
    # A clock failure disables the deadline rather than failing the
    # call — degrade to the old behaviour, do not invent an error.
    var deadline = 0;
    var t0 = dbus_session_now_ms();
    if (t0 >= 0) { deadline = t0 + dbus_session_timeout_ms(); }

    var total = dbus_marshal_len();
    var w = dbus_socket_write_all(fd, dbus_marshal_buf(), total);
    if (w < 0) { return w; }

    var spins = 0;
    var fdslot = _dbs_scratch() + 40;
    while (spins < 64) {
        var r = dbus_frame_next();
        while (r > 0) {
            var p = dbus_frame_base();
            # dbus_frame_next() returned the message's exact on-wire
            # length; handing it to the unmarshaller is what makes its
            # bounds checks real (pre-1.0 audit, AUDIT-1..3).
            dbus_unmarshal_set_limit(r);
            var ty = dbus_unmarshal_type(p);
            var sig = _dbs_scratch() + 24;
            var rs_off = dbus_unmarshal_find_field(p, dbus_marshal_f_replyser(), sig);
            var mine = 0;
            if (rs_off > 0) {
                if (dbus_unmarshal_u32(p, rs_off) == serial) { mine = 1; }
            }
            # Predates the request: it was in the buffer before we
            # wrote, so whatever it is answering, it is not this.
            # A message that straddles the watermark started arriving
            # before the request left, so it counts as stale too.
            if (mine == 1) {
                if (stale > 0) { mine = 0; }
            }
            # Addressed to someone else, whatever its REPLY_SERIAL says.
            if (mine == 1) {
                var dok = dbus_session_dest_ok(p);
                if (dok == 0) { mine = 0; }
            }
            if (mine == 1) {
                if (ty == dbus_marshal_type_return()) { return 0; }
                if (ty == dbus_marshal_type_error()) {
                    var eo = dbus_unmarshal_find_field(p, dbus_marshal_f_errname(), sig);
                    var rc = -5;
                    if (eo > 0) {
                        var ptr = _dbs_scratch() + 32;
                        var n = dbus_unmarshal_str_at(p, eo, ptr);
                        rc = dbus_session_map_error(load64(ptr), n);
                    }
                    _dbs_last_err = rc;
                    dbus_frame_advance(r);
                    return rc;
                }
            }
            # Not ours — a signal, a pre-existing message, or a
            # reply to something else. Its descriptors go with it.
            dbus_session_drop_fds_of(p);
            if (stale > 0) {
                stale = stale - r;
                if (stale < 0) { stale = 0; }
            }
            dbus_frame_advance(r);
            r = dbus_frame_next();
        }
        if (r == dbus_frame_eof())       { return -107; }
        if (r == dbus_frame_truncated()) { return -71; }
        if (r == dbus_frame_badendian()) { return -71; }
        if (r == dbus_frame_badproto())  { return -71; }

        dbus_frame_maybe_compact();
        # THE REPLY IS AN FD-BEARING MESSAGE, so this read must be a
        # recvmsg. TakeDevice's entire purpose is the descriptor, and
        # Inhibit returns one too. sys_read() delivers the BYTES and
        # lets the kernel discard the SCM_RIGHTS payload: the reply
        # parses perfectly, its UNIX_FDS field still says 1, the body
        # still carries a valid index, and the descriptor is simply
        # gone. Nothing downstream can tell.
        #
        # This was the one message samvada could never receive. It
        # survived five releases because an unseated host answers
        # TakeDevice with AccessDenied, and an ERROR reply carries no
        # fd — so the fd path was never once exercised. Measured on
        # the live bus via Inhibit: UNIX_FDS=1, take_fd() == -1.
        # The pump path always used recvmsg; this one did not.
        # Out of time before committing to another blocking receive.
        if (deadline > 0) {
            var now = dbus_session_now_ms();
            if (now >= deadline) { return -110; }
        }

        var space = dbus_frame_space();
        if (space <= 0) { dbus_frame_set_eof(); }
        if (space > 0) {
            store64(fdslot, (0 - 1));
            var got = dbus_sys_recv_fd_flags(fd, dbus_frame_tail(), space,
              fdslot, 0);
            if (got == 0) { dbus_frame_set_eof(); }
            # SO_RCVTIMEO expired: the whole receive budget passed
            # with nothing arriving. Report it as a timeout, not as
            # the raw -EAGAIN, which would reach the consumer as a
            # nonsensical "try again" on a blocking API.
            if (got == dbus_session_eagain()) { return -110; }
            if (got < 0)  { return got; }
            if (got > 0)  { dbus_frame_commit(got); }
            var qfd = load64(fdslot);
            if (qfd >= 0) { dbus_frame_push_fd(qfd); }
        }
        spins = spins + 1;
    }
    return -110;                                  # -ETIMEDOUT
}

fn _dbs_put(p, s) {
    var n = strlen(s);
    var i = 0;
    while (i < n) { store8(p + i, load8(s + i)); i = i + 1; }
    return n;
}

# Build a logind method call. `path`/`plen` name the object; the
# interface is chosen by `on_mgr`.
fn dbus_session_begin_call(path, plen, member, mlen, on_mgr, serial) {
    var t = alloc(128);
    dbus_marshal_begin(dbus_marshal_type_call(), 0, serial);
    dbus_marshal_field_str(dbus_marshal_f_path(), 111, path, plen);
    dbus_marshal_field_str(dbus_marshal_f_member(), 115, member, mlen);
    var n = 0;
    if (on_mgr != 0) { n = _dbs_put(t, "org.freedesktop.login1.Manager"); }
    if (on_mgr == 0) { n = _dbs_put(t, "org.freedesktop.login1.Session"); }
    dbus_marshal_field_str(dbus_marshal_f_interface(), 115, t, n);
    n = _dbs_put(t, "org.freedesktop.login1");
    dbus_marshal_field_str(dbus_marshal_f_dest(), 115, t, n);
    return 0;
}

# ================= FFI-shaped native backend =================
# Every fn below matches a frozen fncallN shape exactly. The
# `bus` argument is the connected socket fd.

# fncall1(slot, bus_out) -> 0 | -err
fn dbus_native_open_system_bus(bus_out) {
    dbus_frame_init();
    dbus_auth_reset();
    dbus_session_reset();

    var sa = alloc(dbus_socket_sockaddr_un_size());
    var t = alloc(64);
    var n = _dbs_put(t, "/run/dbus/system_bus_socket");
    var alen = dbus_socket_addr_path(sa, t, n);
    if (alen < 0) { return alen; }
    var fd = dbus_socket_connect(sa, alen);
    if (fd < 0) { return fd; }

    var blob = alloc(64);
    var bn = dbus_auth_write_blob(blob);
    var w = dbus_socket_write_all(fd, blob, bn);
    if (w < 0) { sys_close(fd); return w; }

    var st = dbus_auth_need_more();
    var spins = 0;
    while (spins < 32) {
        var got = sys_read(fd, dbus_frame_tail(), dbus_frame_space());
        # SO_RCVTIMEO covers the handshake too: a peer that accepts
        # the connection and then says nothing used to hang here.
        if (got == dbus_session_eagain()) { sys_close(fd); return -110; }
        if (got <= 0) { spins = 99; }
        if (got > 0) {
            dbus_frame_commit(got);
            st = dbus_auth_drain_lines();
            if (st == dbus_auth_ok()) { spins = 99; }
            if (st < 0) {
                if (st != dbus_auth_need_more()) { spins = 99; }
            }
        }
        spins = spins + 1;
    }
    if (st != dbus_auth_ok()) { sys_close(fd); return -13; }

    # Hello, so the bus assigns a unique name. Without it every
    # subsequent call is refused.
    var serial = dbus_session_next_serial();
    var pn = _dbs_put(t, "/org/freedesktop/DBus");
    dbus_marshal_begin(dbus_marshal_type_call(), 0, serial);
    dbus_marshal_field_str(dbus_marshal_f_path(), 111, t, pn);
    var mn = _dbs_put(t, "Hello");
    dbus_marshal_field_str(dbus_marshal_f_member(), 115, t, mn);
    var inn = _dbs_put(t, "org.freedesktop.DBus");
    dbus_marshal_field_str(dbus_marshal_f_interface(), 115, t, inn);
    var dn = _dbs_put(t, "org.freedesktop.DBus");
    dbus_marshal_field_str(dbus_marshal_f_dest(), 115, t, dn);
    dbus_marshal_end_fields();
    dbus_marshal_finish();
    var rc = dbus_session_call(fd, serial);
    if (rc < 0) { sys_close(fd); return rc; }

    # KEEP the assigned unique name. The Hello reply's body is a
    # single STRING and samvada used to advance straight past it —
    # which is precisely why it could not tell whether any later
    # reply was addressed to it. Everything dbus_session_dest_ok()
    # does rests on this one string.
    var hlen = dbus_frame_next();
    dbus_unmarshal_set_limit(hlen);
    var hp = dbus_frame_base();
    dbus_unmarshal_body_begin(hp);
    var uptr = alloc(8);
    var un = dbus_unmarshal_next_str(uptr);
    if (un < 0) {
        dbus_frame_advance(hlen);
        sys_close(fd);
        return -71;                               # -EPROTO: no unique name
    }
    var sr = dbus_session_set_unique(load64(uptr), un);
    if (sr < 0) {
        dbus_frame_advance(hlen);
        sys_close(fd);
        return sr;
    }
    dbus_frame_advance(hlen);

    store64(bus_out, fd);
    return 0;
}

# fncall4(slot, bus, pid, out_buf, out_buf_len) -> 0 | -err
fn dbus_native_get_session_path(bus, pid, out_buf, out_len) {
    if (out_buf == 0)  { return -22; }
    if (out_len <= 0)  { return -22; }
    var t = alloc(128);
    var serial = dbus_session_next_serial();
    var pn = _dbs_put(t, "/org/freedesktop/login1");
    var m = alloc(64);
    var mn = _dbs_put(m, "GetSessionByPID");
    dbus_session_begin_call(t, pn, m, mn, 1, serial);
    var sg = alloc(8);
    var sn = _dbs_put(sg, "u");
    dbus_marshal_field_sig(dbus_marshal_f_signature(), sg, sn);
    dbus_marshal_end_fields();
    dbus_marshal_body_u32(pid);
    dbus_marshal_finish();

    var rc = dbus_session_call(bus, serial);
    if (rc < 0) { return rc; }
    var p = dbus_frame_base();
    dbus_unmarshal_set_limit(dbus_frame_next());
    dbus_unmarshal_body_begin(p);
    var ptr = alloc(8);
    var n = dbus_unmarshal_next_str(ptr);
    if (n < 0) { dbus_frame_advance(dbus_frame_next()); return -71; }
    if (n + 1 > out_len) {
        dbus_frame_advance(dbus_frame_next());
        return -105;                              # -ENOBUFS
    }
    var src = load64(ptr);
    var i = 0;
    while (i < n) { store8(out_buf + i, load8(src + i)); i = i + 1; }
    store8(out_buf + n, 0);
    dbus_frame_advance(dbus_frame_next());
    return 0;
}

# fncall2(slot, bus, sess_cstr) -> 0 | -err
fn dbus_native_take_control(bus, sess) {
    if (dbus_session_sess_ok(sess) == 0) { return -22; }
    var t = alloc(64);
    var mn = _dbs_put(t, "TakeControl");
    var serial = dbus_session_next_serial();
    dbus_session_begin_call(sess, strlen(sess), t, mn, 0, serial);
    var sg = alloc(8);
    var sn = _dbs_put(sg, "b");
    dbus_marshal_field_sig(dbus_marshal_f_signature(), sg, sn);
    dbus_marshal_end_fields();
    dbus_marshal_body_bool(0);                    # force = false
    dbus_marshal_finish();
    var rc = dbus_session_call(bus, serial);
    if (rc == 0) { dbus_frame_advance(dbus_frame_next()); }
    return rc;
}

# fncall2(slot, bus, sess_cstr) -> 0 | -err
fn dbus_native_release_control(bus, sess) {
    if (dbus_session_sess_ok(sess) == 0) { return -22; }
    var t = alloc(64);
    var mn = _dbs_put(t, "ReleaseControl");
    var serial = dbus_session_next_serial();
    dbus_session_begin_call(sess, strlen(sess), t, mn, 0, serial);
    dbus_marshal_end_fields();                    # empty body: NO signature field
    dbus_marshal_finish();
    var rc = dbus_session_call(bus, serial);
    if (rc == 0) { dbus_frame_advance(dbus_frame_next()); }
    return rc;
}

# fncall6(slot, bus, sess_cstr, major, minor, fd_out, active_out) -> 0 | -err
fn dbus_native_take_device(bus, sess, major, minor, fd_out, active_out) {
    if (dbus_session_sess_ok(sess) == 0) { return -22; }
    var maj_ok = dbus_session_devnum_ok(major);
    var min_ok = dbus_session_devnum_ok(minor);
    if (maj_ok == 0) { return -22; }
    if (min_ok == 0) { return -22; }
    var t = alloc(64);
    var mn = _dbs_put(t, "TakeDevice");
    var serial = dbus_session_next_serial();
    dbus_session_begin_call(sess, strlen(sess), t, mn, 0, serial);
    var sg = alloc(8);
    var sn = _dbs_put(sg, "uu");
    dbus_marshal_field_sig(dbus_marshal_f_signature(), sg, sn);
    dbus_marshal_end_fields();
    dbus_marshal_body_u32(major);
    dbus_marshal_body_u32(minor);
    dbus_marshal_finish();

    var rc = dbus_session_call(bus, serial);
    if (rc < 0) { return rc; }
    var p = dbus_frame_base();
    dbus_unmarshal_set_limit(dbus_frame_next());
    dbus_unmarshal_body_begin(p);
    var idx = dbus_unmarshal_next_fd_index();
    var inactive = dbus_unmarshal_next_bool();
    # The descriptor itself came via SCM_RIGHTS and was queued by
    # the framer; the body carries only an index into that queue.
    var fd = dbus_frame_take_fd();
    store64(fd_out, fd);
    store64(active_out, inactive);
    dbus_frame_advance(dbus_frame_next());
    if (fd < 0) { return -9; }                    # -EBADF: no fd arrived
    return 0;
}

# fncall4(slot, bus, sess_cstr, major, minor) -> 0 | -err
fn dbus_native_release_device(bus, sess, major, minor) {
    if (dbus_session_sess_ok(sess) == 0) { return -22; }
    var maj_ok = dbus_session_devnum_ok(major);
    var min_ok = dbus_session_devnum_ok(minor);
    if (maj_ok == 0) { return -22; }
    if (min_ok == 0) { return -22; }
    var t = alloc(64);
    var mn = _dbs_put(t, "ReleaseDevice");
    var serial = dbus_session_next_serial();
    dbus_session_begin_call(sess, strlen(sess), t, mn, 0, serial);
    var sg = alloc(8);
    var sn = _dbs_put(sg, "uu");
    dbus_marshal_field_sig(dbus_marshal_f_signature(), sg, sn);
    dbus_marshal_end_fields();
    dbus_marshal_body_u32(major);
    dbus_marshal_body_u32(minor);
    dbus_marshal_finish();
    var rc = dbus_session_call(bus, serial);
    if (rc == 0) { dbus_frame_advance(dbus_frame_next()); }
    return rc;
}

# fncall1(slot, bus) -> events | -err
# Drains whatever is readable without blocking, and reports how many
# whole messages went past. Bounded like the C shim's, and for the
# same reason: the frozen signature takes no cap argument.
#
# The read is NOT optional, and leaving it out is how the 0.11.0
# differential caught this module diverging from the C shim: the C
# side's sd_bus_process pulls from the socket, so it reported 1
# event where this reported 0 having only looked at an already-empty
# buffer. Same call, same session, two different answers — precisely
# the silent error-parity breach N6 exists to find.
#
# MSG_DONTWAIT is per-call. Setting O_NONBLOCK on the socket instead
# would make the request/reply path non-blocking too and turn every
# method call into a busy-wait.
fn dbus_native_pump_signals(bus) {
    var drained = 0;
    if (bus > 0) {
        dbus_frame_maybe_compact();
        var space = dbus_frame_space();
        if (space > 0) {
            var scratch = _dbs_scratch() + 48;
            store64(scratch, (0 - 1));
            var got = dbus_sys_recv_fd_flags(bus, dbus_frame_tail(), space,
              scratch, dbus_sys_msg_dontwait());
            if (got > 0) { dbus_frame_commit(got); }
            if (got == 0) { dbus_frame_set_eof(); }
            var qfd = load64(scratch);
            if (qfd >= 0) { dbus_frame_push_fd(qfd); }
        }
    }
    var r = dbus_frame_next();
    while (r > 0) {
        drained = drained + 1;
        # Signals are not surfaced (ADR-0004), so a descriptor riding
        # on one has no owner. Closing it here is what keeps it from
        # being collected by the next take_device.
        dbus_unmarshal_set_limit(r);
        dbus_session_drop_fds_of(dbus_frame_base());
        dbus_frame_advance(r);
        if (drained >= 256) { return drained; }
        r = dbus_frame_next();
    }
    return drained;
}

# fncall1(slot, bus) -> 0
fn dbus_native_close_bus(bus) {
    dbus_frame_close_fds();
    if (bus > 0) { sys_close(bus); }
    return 0;
}

# ---- the public native entry point (0.11.0, N6 cutover) ----
# @public
#
# The ONLY way a consumer should reach the native backend. It exists
# because CLAUDE.md forbids exposing FFI types in public signatures:
# without it a native consumer would have to write
#
#     var t = samvada_ffi_alloc();
#     dbus_native_populate(t);
#     samvada_init(t);
#
# which hands them a fn-table pointer — the exact thing the rule
# exists to prevent, and the thing that would make the eventual
# removal of the FFI layer a breaking change for them.
#
# Additive, so nothing that exists today changes: `samvada_init` and
# its frozen signature are untouched, and a consumer still linking
# the C shim keeps working unchanged.
#
#   returns 0, or a negative sd-bus errno
# The table is allocated ONCE and reused.
#
# public-api.md documents init-after-release as the supported
# recovery path, and alloc() never frees — so a fresh 88-byte table
# per call is a permanent leak on a path consumers are told to use.
# Measured across live init/release cycles: 744 bytes per cycle,
# linear and unbounded, of which this is the table's share. Same
# class as the 60 Hz pump leak, just slower.
#
# Repopulating on every call is deliberate: it costs nothing and it
# means a caller that scribbled on the table gets a clean one back
# rather than a stale dispatch.
var _dbs_table = 0;

fn samvada_native_init() {
    if (_dbs_table == 0) { _dbs_table = samvada_ffi_alloc(); }
    if (_dbs_table == 0) { return -12; }
    var rc = dbus_native_populate(_dbs_table);
    if (rc < 0) { return rc; }
    return samvada_init(_dbs_table);
}

# Populate an FFI table with the native backend. kind = PURE_CYRIUS.
fn dbus_native_populate(t) {
    if (t == 0) { return -22; }
    samvada_ffi_set_slot(t, samvada_slot_open_system_bus(),  &dbus_native_open_system_bus);
    samvada_ffi_set_slot(t, samvada_slot_get_session_path(), &dbus_native_get_session_path);
    samvada_ffi_set_slot(t, samvada_slot_take_device(),      &dbus_native_take_device);
    samvada_ffi_set_slot(t, samvada_slot_release_device(),   &dbus_native_release_device);
    samvada_ffi_set_slot(t, samvada_slot_pump_signals(),     &dbus_native_pump_signals);
    samvada_ffi_set_slot(t, samvada_slot_close_bus(),        &dbus_native_close_bus);
    samvada_ffi_set_slot(t, samvada_slot_take_control(),     &dbus_native_take_control);
    samvada_ffi_set_slot(t, samvada_slot_release_control(),  &dbus_native_release_control);
    samvada_ffi_set_slot(t, samvada_slot_kind(), samvada_backend_kind_pure_cyrius());
    return 0;
}
