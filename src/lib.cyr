# @internal — samvada include chain
# lib.cyr — the FFI layout and the public layer
# (samvada_ffi.cyr, samvada.cyr), for src/main.cyr, the
# benches, tools/rxbench.cyr and the tests. It is NOT what
# `cyrius distlib` bundles: dist/samvada.cyr is built from
# cyrius.cyml `[lib] modules` (visibility, samvada_ffi, the
# seven dbus_* modules, samvada). Order matters when modules
# reference each other.
#
# The native protocol modules (src/dbus_*.cyr) are not
# included here: they are listed in cyrius.cyml `[lib]`, and
# the tests and tools/rxbench.cyr include the ones they need
# directly (after this file, where they include it too).

include "src/samvada_ffi.cyr"
include "src/samvada.cyr"
